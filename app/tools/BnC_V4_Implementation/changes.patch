+           'checkpoint.py','train.py','validation_freeze.py','session_report.py','evaluate.py')
+    parent_names=('package.py','evaluate.py','opponent.py','inspect_candidate.py')
+    external=base.parent.parent/'raw_truth/quality_metrics.py'
