#version 450

// SPECTRA 2 Milestone 8H-C
// GPU-primary pre-demosaic chroma Pass 2 + Pass 3 full-frame execution.
// CPU participation is limited to compact field/planning input and No-Regret
// tile decisions; full-frame candidate generation/blending remains Vulkan.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer InputBuffer { float inputMosaic[]; };
layout(std430, binding = 1) buffer CandidateBuffer { float candidateMosaic[]; };
layout(std430, binding = 2) buffer ScratchBuffer { float scratchMosaic[]; };
layout(std430, binding = 3) readonly buffer LensBuffer { float lensShading[]; };
layout(std430, binding = 4) readonly buffer AuxiliaryBuffer { float auxiliary[]; };

struct TileStats {
    vec4 meanSignal;
    vec4 metrics; // residualEnergy, structureEnergy, sampleCount, populatedChannels
};
layout(std430, binding = 5) buffer TileStatsBuffer { TileStats tileStats[]; };
layout(std430, binding = 6) readonly buffer AcceptanceBuffer { float acceptance[]; };
layout(std430, binding = 7) buffer TelemetryBuffer { uint telemetry[]; };

// QUALITY DELTA 0009: full GALOSH-style R=7 LOESS support on the half-resolution
// CFA-quad lattice. A 16x16 output tile plus 7-quad halo is 30x30. Basis +
// luma-variance consume 18 KB shared memory, staying below the conservative
// 32 KB/workgroup budget used by the rest of the mobile Vulkan design.
const int GALOSH_LOESS_RADIUS = 7;
const int GALOSH_TILE_DIM = 16;
const int GALOSH_TILE_W = GALOSH_TILE_DIM + 2 * GALOSH_LOESS_RADIUS;
const int GALOSH_TILE_PIXELS = GALOSH_TILE_W * GALOSH_TILE_W;
shared vec4 galoshBasisTile[GALOSH_TILE_PIXELS];
shared float galoshVarianceLTile[GALOSH_TILE_PIXELS];

layout(push_constant) uniform Push {
    uint frameWidth;
    uint frameHeight;
    uint cfaPattern;
    uint mode; // 0=P2 fine, 1=P2 mid, 2=P2 stats, 3=P2 blend, 4=P3 candidate, 5=P3 stats, 6=P3 blend
    uint lensColumns;
    uint lensRows;
    uint gridCols;       // No-Regret grid
    uint gridRows;
    uint tileWidth;
    uint tileHeight;
    uint fieldCols;      // Pass3 chroma grid columns
    uint fieldRows;      // Pass3 chroma grid rows
    vec4 s;
    vec4 o;
    vec4 params0; // P2: blend, iso, model, flags. P3: banding, chroma, lowConfidence, flags
    vec4 params1; // P2 fine: authority,maxScale,model,visibleAmp. P3 low: authority,maxScale,model,visibleAmp
    vec4 params2; // P2 mid: authority,maxScale,model,visibleAmp. P3 unused
} pc;

const float EPS = 1.0e-12;

bool finite1(float v) { return !(isnan(v) || isinf(v)); }
float saturate(float v) { return clamp(v, 0.0, 1.0); }
uint linearIndex(int x, int y) { return uint(y) * pc.frameWidth + uint(x); }

uint flags() { return uint(max(0.0, pc.params0.w) + 0.5); }
bool flagSet(uint bit) { return (flags() & bit) != 0u; }

int cfaChannel(int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    if (pc.cfaPattern == 0u) return ym == 0 ? (xm == 0 ? 0 : 1) : (xm == 0 ? 2 : 3); // RGGB
    if (pc.cfaPattern == 1u) return ym == 0 ? (xm == 0 ? 1 : 0) : (xm == 0 ? 3 : 2); // GRBG
    if (pc.cfaPattern == 2u) return ym == 0 ? (xm == 0 ? 1 : 3) : (xm == 0 ? 0 : 2); // GBRG
    return ym == 0 ? (xm == 0 ? 3 : 1) : (xm == 0 ? 2 : 0); // BGGR
}

float channelS(int ch) { return ch == 0 ? pc.s.x : (ch == 1 ? pc.s.y : (ch == 2 ? pc.s.z : pc.s.w)); }
float channelO(int ch) { return ch == 0 ? pc.o.x : (ch == 1 ? pc.o.y : (ch == 2 ? pc.o.z : pc.o.w)); }

// SPECTRA Context Fusion: structure is evidence only when it rises above the
// physically predicted mosaic noise floor. In dark CFA data, raw gradients are
// otherwise dominated by shot/read noise and the old signal-normalized gate
// protected exactly the chroma speckle that SPECTRA is supposed to remove.
float contextStructureWeight(float observedGradient, float expectedNoiseGradient, float sensitivity) {
    float floorValue = max(1.0e-5, expectedNoiseGradient);
    float excess = max(0.0, observedGradient - 1.12 * floorValue);
    float normalizedExcess = excess / max(0.0015, 1.35 * floorValue);
    return clamp(exp(-max(0.25, sensitivity) * normalizedExcess), 0.0, 1.0);
}

struct MultiscaleChromaContextDecision {
    float fineStructureEvidence;
    float coarseStructureEvidence;
    float coherentStructureEvidence;
    float stochasticFineEvidence;
    float structureWeight;
};

MultiscaleChromaContextDecision resolveMultiscaleChromaContext(
        float fineObservedGradient, float fineExpectedNoiseGradient,
        float coarseObservedGradient, float coarseExpectedNoiseGradient,
        float sensitivity, float modelConfidence) {
    MultiscaleChromaContextDecision outValue;
    float confidence = clamp(finite1(modelConfidence) ? modelConfidence : 0.0, 0.0, 1.0);
    float uncertaintyEnvelope = 1.0 + 0.30 * (1.0 - confidence);
    float fineWeight = contextStructureWeight(
            fineObservedGradient, fineExpectedNoiseGradient * uncertaintyEnvelope, sensitivity);
    float coarseWeight = contextStructureWeight(
            coarseObservedGradient, coarseExpectedNoiseGradient * uncertaintyEnvelope,
            max(0.25, sensitivity * 0.86));
    outValue.fineStructureEvidence = 1.0 - fineWeight;
    outValue.coarseStructureEvidence = 1.0 - coarseWeight;
    float geometricAgreement = sqrt(max(0.0,
            outValue.fineStructureEvidence * outValue.coarseStructureEvidence));
    outValue.coherentStructureEvidence = clamp(max(
            min(outValue.fineStructureEvidence, outValue.coarseStructureEvidence),
            0.84 * geometricAgreement), 0.0, 1.0);
    outValue.stochasticFineEvidence = clamp(
            outValue.fineStructureEvidence * (1.0 - outValue.coarseStructureEvidence),
            0.0, 1.0);
    float protection = clamp(
            0.94 * outValue.coherentStructureEvidence +
            0.16 * outValue.coarseStructureEvidence -
            0.48 * outValue.stochasticFineEvidence,
            0.0, 1.0);
    outValue.structureWeight = 1.0 - protection;
    return outValue;
}

float inputAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return inputMosaic[linearIndex(x, y)];
}
float candidateAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return candidateMosaic[linearIndex(x, y)];
}
float scratchAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return scratchMosaic[linearIndex(x, y)];
}

// Pass2 flags: bit0 fine enabled, bit1 mid enabled.
float pass2MidSourceAt(int x, int y) { return flagSet(1u) ? candidateAt(x, y) : inputAt(x, y); }
float pass2FinalAt(int x, int y) { return flagSet(2u) ? scratchAt(x, y) : candidateAt(x, y); }
void writePass2Final(uint index, float value) {
    if (flagSet(2u)) scratchMosaic[index] = value;
    else candidateMosaic[index] = value;
}

float lensGainAt(int channel, int x, int y) {
    if (pc.lensColumns == 0u || pc.lensRows == 0u) return 1.0;
    float colF = pc.frameWidth > 1u
        ? float(x) * float(pc.lensColumns - 1u) / float(pc.frameWidth - 1u) : 0.0;
    float rowF = pc.frameHeight > 1u
        ? float(y) * float(pc.lensRows - 1u) / float(pc.frameHeight - 1u) : 0.0;
    int c0 = clamp(int(floor(colF)), 0, int(pc.lensColumns) - 1);
    int r0 = clamp(int(floor(rowF)), 0, int(pc.lensRows) - 1);
    int c1 = min(c0 + 1, int(pc.lensColumns) - 1);
    int r1 = min(r0 + 1, int(pc.lensRows) - 1);
    float tx = clamp(colF - float(c0), 0.0, 1.0);
    float ty = clamp(rowF - float(r0), 0.0, 1.0);
    int ch = clamp(channel, 0, 3);
    uint stride = pc.lensColumns * 4u;
    float g00 = clamp(lensShading[uint(r0) * stride + uint(c0 * 4 + ch)], 0.25, 3.5);
    float g10 = clamp(lensShading[uint(r0) * stride + uint(c1 * 4 + ch)], 0.25, 3.5);
    float g01 = clamp(lensShading[uint(r1) * stride + uint(c0 * 4 + ch)], 0.25, 3.5);
    float g11 = clamp(lensShading[uint(r1) * stride + uint(c1 * 4 + ch)], 0.25, 3.5);
    return clamp(mix(mix(g00, g10, tx), mix(g01, g11, tx), ty), 0.25, 3.5);
}

void sort9(inout float a[9]) {
    for (int i = 1; i < 9; ++i) {
        float key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key) { a[j + 1] = a[j]; --j; }
        a[j + 1] = key;
    }
}

float greenReferenceInput(int x, int y) {
    return 0.25 * (inputAt(x, y - 1) + inputAt(x, y + 1) + inputAt(x - 1, y) + inputAt(x + 1, y));
}
float residualInput(int x, int y) { return inputAt(x, y) - greenReferenceInput(x, y); }

struct CfaBasisSample {
    vec4 basis;    // C0, C1, C2, deltaG
    vec4 variance; // propagated independent sensor variance per axis
    bool valid;
};

float varianceAtChannel(int ch, float value) {
    return max(EPS, channelS(ch) * max(0.0, value) + channelO(ch));
}

CfaBasisSample cfaBasisSampleInput(int x, int y) {
    CfaBasisSample basisSample;
    basisSample.basis = vec4(0.0);
    basisSample.variance = vec4(0.0);
    basisSample.valid = false;
    int baseX = x & ~1;
    int baseY = y & ~1;
    float values[4];
    float variances[4];
    bool populated[4] = bool[4](false, false, false, false);
    for (int by = 0; by < 2; ++by) {
        for (int bx = 0; bx < 2; ++bx) {
            int sx = baseX + bx, sy = baseY + by;
            int ch = cfaChannel(sx, sy);
            float value = inputAt(sx, sy);
            if (ch < 0 || ch > 3 || !finite1(value)) return basisSample;
            values[ch] = value;
            variances[ch] = varianceAtChannel(ch, value);
            populated[ch] = true;
        }
    }
    if (!(populated[0] && populated[1] && populated[2] && populated[3])) return basisSample;
    float r = values[0], g1 = values[1], g2 = values[2], b = values[3];
    basisSample.basis = vec4(
        0.541 * r + 0.436 * g1 + 0.436 * g2 + 0.572 * b,
       -0.794 * r + 0.107 * g1 + 0.107 * g2 + 0.588 * b,
       -0.276 * r + 0.546 * g1 + 0.546 * g2 - 0.572 * b,
        0.707 * g1 - 0.707 * g2);
    vec4 vr = vec4(variances[0], variances[1], variances[2], variances[3]);
    basisSample.variance = vec4(
        0.541*0.541*vr.x + 0.436*0.436*vr.y + 0.436*0.436*vr.z + 0.572*0.572*vr.w,
        0.794*0.794*vr.x + 0.107*0.107*vr.y + 0.107*0.107*vr.z + 0.588*0.588*vr.w,
        0.276*0.276*vr.x + 0.546*0.546*vr.y + 0.546*0.546*vr.z + 0.572*0.572*vr.w,
        0.707*0.707*vr.y + 0.707*0.707*vr.z);
    basisSample.valid = true;
    return basisSample;
}

float cfaLumaSupportWeight(CfaBasisSample center, CfaBasisSample neighbour, float modelConfidence) {
    if (!center.valid || !neighbour.valid) return 0.0;
    float confidence = clamp(finite1(modelConfidence) ? modelConfidence : 0.0, 0.0, 1.0);
    float uncertaintyEnvelope = 1.0 + 0.30 * (1.0 - confidence);
    float differenceSigma = sqrt(max(EPS, center.variance.x + neighbour.variance.x)) * uncertaintyEnvelope;
    float z = abs(neighbour.basis.x - center.basis.x) / max(1.0e-7, differenceSigma);
    const float supportSigma = 1.65;
    return clamp(exp(-0.5 * (z / supportSigma) * (z / supportSigma)), 0.0, 1.0);
}

float cfaOpponentStructureProtection(
        float c1Span, float c2Span, float deltaGSpan,
        float sigmaC1, float sigmaC2, float sigmaDeltaG, float modelConfidence) {
    float confidence = clamp(finite1(modelConfidence) ? modelConfidence : 0.0, 0.0, 1.0);
    float uncertaintyEnvelope = 1.0 + 0.30 * (1.0 - confidence);
    float z1 = max(0.0, c1Span) / max(1.0e-7, 2.0 * sigmaC1 * uncertaintyEnvelope);
    float z2 = max(0.0, c2Span) / max(1.0e-7, 2.0 * sigmaC2 * uncertaintyEnvelope);
    float zg = max(0.0, deltaGSpan) / max(1.0e-7, 2.0 * sigmaDeltaG * uncertaintyEnvelope);
    return smoothstep(1.40, 2.30, max(z1, max(z2, zg)));
}

void sort8(inout float a[8]) {
    for (int i = 1; i < 8; ++i) {
        float key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key) { a[j + 1] = a[j]; --j; }
        a[j + 1] = key;
    }
}

float robustResidualRingInput(int x, int y, int radius) {
    float ring[8] = float[8](
        residualInput(x - radius, y), residualInput(x + radius, y),
        residualInput(x, y - radius), residualInput(x, y + radius),
        residualInput(x - radius, y - radius), residualInput(x + radius, y - radius),
        residualInput(x - radius, y + radius), residualInput(x + radius, y + radius));
    sort8(ring);
    return 0.5 * (ring[3] + ring[4]);
}

struct ChromaResidualConsensusDecision {
    bool supported; float contextualResidual; float contextMix;
};
ChromaResidualConsensusDecision resolveChromaResidualConsensus(
        float centerResidual, float fineTargetResidual, float midResidual, float coarseResidual,
        float localResidualSpread, float noiseSigma, float structureWeight, float modelConfidence) {
    ChromaResidualConsensusDecision d; d.supported = false; d.contextualResidual = fineTargetResidual; d.contextMix = 0.0;
    if (!finite1(centerResidual) || !finite1(fineTargetResidual) || !finite1(midResidual) ||
        !finite1(coarseResidual) || !finite1(localResidualSpread) || !(noiseSigma > 0.0)) return d;
    float structure = saturate(structureWeight);
    if (structure < 0.12) return d;
    float confidence = saturate(modelConfidence);
    float uncertainty = 1.0 + 0.30 * (1.0 - confidence);
    float sigma = max(1.0e-7, noiseSigma * uncertainty);
    d.contextualResidual = 0.62 * midResidual + 0.38 * coarseResidual;
    float agreementZ = abs(midResidual - coarseResidual) / sigma;
    float scaleAgreement = 1.0 - smoothstep(1.15, 3.20, agreementZ);
    float outlierZ = abs(centerResidual - d.contextualResidual) / sigma;
    float stochasticOutlier = smoothstep(0.65, 2.35, outlierZ);
    float spreadZ = max(0.0, localResidualSpread) / sigma;
    float chromaStructure = smoothstep(2.80, 5.80, spreadZ);
    d.contextMix = clamp(0.58 * scaleAgreement * stochasticOutlier *
                         (1.0 - chromaStructure) * sqrt(structure), 0.0, 0.58);
    d.supported = d.contextMix >= 0.01;
    return d;
}

float greenReferenceMid(int x, int y) {
    return 0.25 * (pass2MidSourceAt(x, y - 1) + pass2MidSourceAt(x, y + 1) +
                   pass2MidSourceAt(x - 1, y) + pass2MidSourceAt(x + 1, y));
}
float residualMid(int x, int y) { return pass2MidSourceAt(x, y) - greenReferenceMid(x, y); }

// Delta 23 Pass-2 auxiliary layout: fine R, fine B, mid R, mid B.
// Host-side values are already bounded; clamp again here to make shader authority self-contained.
float pass2OpponentAuthorityMultiplier(int channel, bool fineBand) {
    uint offsetIndex = fineBand ? 0u : 2u;
    if (channel == 0) return clamp(auxiliary[offsetIndex], 0.88, 1.12);
    if (channel == 3) return clamp(auxiliary[offsetIndex + 1u], 0.88, 1.12);
    return 1.0;
}

float crossMeanMid(int x, int y, int radius) {
    return 0.25 * (residualMid(x - radius, y) + residualMid(x + radius, y) +
                   residualMid(x, y - radius) + residualMid(x, y + radius));
}

struct BandDecision { bool supported; float correction; float shrinkage; };
BandDecision resolveBandDecision(bool fine, float coefficient, float noiseSigma, float authority,
                                 float modelConfidence, float structureWeight, float shadowWeight,
                                 float visibleAmp, float impulseScore, float denoisePressure) {
    BandDecision d; d.supported = false; d.correction = 0.0; d.shrinkage = 0.0;
    float sigma = finite1(noiseSigma) && noiseSigma > 0.0 ? noiseSigma : 0.0;
    float confidence = saturate(modelConfidence);
    float authorityConfidence = confidence >= 0.10 ? 0.55 + 0.45 * sqrt(confidence) : 0.0;
    float a = saturate(authority) * authorityConfidence;
    structureWeight = saturate(structureWeight);
    shadowWeight = saturate(shadowWeight);
    visibleAmp = finite1(visibleAmp) ? clamp(visibleAmp, 0.5, 4.0) : 1.0;
    if (sigma <= 0.0 || a <= 0.0 || structureWeight < 0.015 || shadowWeight <= 0.0) return d;
    float effectiveSigma = max(1.0e-7, sigma * (fine ? 1.0 : 0.58));
    float coefficientVariance = coefficient * coefficient;
    float noiseVariance = effectiveSigma * effectiveSigma;
    float signalVariance = max(0.0, coefficientVariance - noiseVariance);
    float retained = coefficientVariance > 1.0e-14
        ? clamp(signalVariance / (coefficientVariance + 1.0e-14), 0.0, 1.0) : 0.0;
    if (!fine) {
        // darktable-style profiled-band principle, independently implemented:
        // treat the mid-band coefficient in physical sigma units. Noise-like
        // coefficients can collapse far more strongly than a Wiener residual,
        // while strong coefficients cross a firm transition and remain unbiased.
        float pressure = saturate(denoisePressure);
        float z = abs(coefficient) / effectiveSigma;
        float lowZ = mix(1.05, 1.45, pressure);
        float highZ = mix(2.85, 3.95, pressure);
        retained = smoothstep(lowZ, highZ, z);
        retained = max(retained, 0.25 * (1.0 - confidence));
    }
    float baseShrinkage = 1.0 - retained;
    if (fine && finite1(impulseScore)) {
        if (impulseScore >= 2.75) baseShrinkage = max(baseShrinkage, 0.72);
        else if (impulseScore >= 1.75) baseShrinkage = max(baseShrinkage, 0.46);
    }
    float visibleBoost = clamp(0.90 + 0.10 * max(0.0, visibleAmp - 1.0), 0.90, 1.15);
    float ceiling = fine ? 0.92 : mix(0.84, 0.94, saturate(denoisePressure));
    d.shrinkage = clamp(baseShrinkage * a * structureWeight * shadowWeight * visibleBoost, 0.0, ceiling);
    d.correction = -coefficient * d.shrinkage;
    d.supported = abs(d.correction) >= 1.0e-9;
    return d;
}

// QUALITY DELTA 0007 — GALOSH-inspired RAW chroma core.
//
// The public GALOSH RAW design separates each aligned 2x2 CFA quad into one
// signal-rich component plus three chroma/detail components and estimates the
// chroma from a luminance-only local regression.  BnCam keeps that core idea
// but stays in its existing linear RAW/noise-model domain: the guide distance
// is normalized by the propagated Poisson-Gaussian variance instead of adding
// a second nonlinear GAT/inverse-GAT round trip to the master RAW.
//
// This is intentionally NOT JPEG/YUV chroma subsampling.  The half-grid exists
// only while a Bayer quad is represented by one L + three opponent components;
// every invocation reconstructs all four original CFA sensels before demosaic.
struct GaloshCfaBlock {
    vec4 samples;   // spatial order p00,p01,p10,p11
    vec4 basis;     // L,C1,C2,C3: orthonormal 2x2 WHT, coefficient 0.5
    float varianceL;
    bool valid;
};

GaloshCfaBlock galoshCfaBlockInput(int quadX, int quadY) {
    GaloshCfaBlock block;
    block.samples = vec4(0.0);
    block.basis = vec4(0.0);
    block.varianceL = 0.0;
    block.valid = false;
    const int baseX = quadX * 2;
    const int baseY = quadY * 2;
    if (baseX < 0 || baseY < 0 || baseX + 1 >= int(pc.frameWidth) || baseY + 1 >= int(pc.frameHeight)) {
        return block;
    }
    const float p00 = inputAt(baseX,     baseY);
    const float p01 = inputAt(baseX + 1, baseY);
    const float p10 = inputAt(baseX,     baseY + 1);
    const float p11 = inputAt(baseX + 1, baseY + 1);
    if (!finite1(p00) || !finite1(p01) || !finite1(p10) || !finite1(p11)) return block;
    block.samples = vec4(p00, p01, p10, p11);
    // Exact orthonormal 2x2 Walsh-Hadamard basis.  L is retained unchanged;
    // only C1/C2/C3 are regressed/shrunk.
    block.basis = 0.5 * vec4(
        p00 + p01 + p10 + p11,
        p00 - p01 + p10 - p11,
        p00 + p01 - p10 - p11,
        p00 - p01 - p10 + p11);
    const float v00 = varianceAtChannel(cfaChannel(baseX,     baseY),     p00);
    const float v01 = varianceAtChannel(cfaChannel(baseX + 1, baseY),     p01);
    const float v10 = varianceAtChannel(cfaChannel(baseX,     baseY + 1), p10);
    const float v11 = varianceAtChannel(cfaChannel(baseX + 1, baseY + 1), p11);
    block.varianceL = 0.25 * (v00 + v01 + v10 + v11);
    block.valid = finite1(block.varianceL) && block.varianceL > 0.0;
    return block;
}

vec4 galoshInverseWht(vec4 basis) {
    return 0.5 * vec4(
        basis.x + basis.y + basis.z + basis.w,
        basis.x - basis.y + basis.z - basis.w,
        basis.x + basis.y - basis.z - basis.w,
        basis.x - basis.y - basis.z + basis.w);
}

int reflectQuadCoordinate(int value, int count) {
    if (count <= 1) return 0;
    if (value < 0) value = -value;
    if (value >= count) value = 2 * count - value - 2;
    return clamp(value, 0, count - 1);
}

struct GaloshLoessResult {
    vec3 targetChroma;
    float effectiveSupport;
    bool valid;
};

void loadGaloshLoessTile() {
    const int quadWidth = int(pc.frameWidth) / 2;
    const int quadHeight = int(pc.frameHeight) / 2;
    const int tileOriginX = int(gl_WorkGroupID.x) * GALOSH_TILE_DIM - GALOSH_LOESS_RADIUS;
    const int tileOriginY = int(gl_WorkGroupID.y) * GALOSH_TILE_DIM - GALOSH_LOESS_RADIUS;
    const int localLinear = int(gl_LocalInvocationID.y) * GALOSH_TILE_DIM + int(gl_LocalInvocationID.x);
    const int workgroupSize = GALOSH_TILE_DIM * GALOSH_TILE_DIM;

    for (int i = localLinear; i < GALOSH_TILE_PIXELS; i += workgroupSize) {
        const int tx = i % GALOSH_TILE_W;
        const int ty = i / GALOSH_TILE_W;
        const int qx = reflectQuadCoordinate(tileOriginX + tx, quadWidth);
        const int qy = reflectQuadCoordinate(tileOriginY + ty, quadHeight);
        const GaloshCfaBlock block = galoshCfaBlockInput(qx, qy);
        galoshBasisTile[i] = block.valid ? block.basis : vec4(0.0);
        galoshVarianceLTile[i] = block.valid ? block.varianceL : -1.0;
    }
    memoryBarrierShared();
    barrier();
}

GaloshLoessResult galoshGuidedChromaRegressionShared(
        GaloshCfaBlock center, float authority, float modelConfidence) {
    GaloshLoessResult result;
    result.targetChroma = center.basis.yzw;
    result.effectiveSupport = 0.0;
    result.valid = false;
    if (!center.valid) return result;

    const int centerX = GALOSH_LOESS_RADIUS + int(gl_LocalInvocationID.x);
    const int centerY = GALOSH_LOESS_RADIUS + int(gl_LocalInvocationID.y);
    const float confidence = saturate(modelConfidence);
    const float uncertaintyEnvelope = 1.0 + 0.30 * (1.0 - confidence);
    const float lumaBandwidthSigma = 3.0;

    float sumW = 0.0;
    float sumL = 0.0;
    float sumLL = 0.0;
    vec3 sumC = vec3(0.0);
    vec3 sumLC = vec3(0.0);
    vec3 cMin = vec3(1.0e30);
    vec3 cMax = vec3(-1.0e30);
    float weightedLumaNoise = 0.0;

    // Full 15x15 half-grid LOESS support. Only luminance/noise-model distance
    // selects neighbours; chroma never rejects a chroma sample as an "edge".
    for (int dy = -GALOSH_LOESS_RADIUS; dy <= GALOSH_LOESS_RADIUS; ++dy) {
        const int ty = centerY + dy;
        for (int dx = -GALOSH_LOESS_RADIUS; dx <= GALOSH_LOESS_RADIUS; ++dx) {
            const int tx = centerX + dx;
            const int tileIndex = ty * GALOSH_TILE_W + tx;
            const float neighbourVarianceL = galoshVarianceLTile[tileIndex];
            if (!(neighbourVarianceL > 0.0) || !finite1(neighbourVarianceL)) continue;
            const vec4 neighbourBasis = galoshBasisTile[tileIndex];
            if (any(isnan(neighbourBasis)) || any(isinf(neighbourBasis))) continue;

            const float diffSigma = sqrt(max(EPS, center.varianceL + neighbourVarianceL)) * uncertaintyEnvelope;
            const float z = (neighbourBasis.x - center.basis.x) / max(1.0e-7, diffSigma);
            const float w = exp(-0.5 * (z / lumaBandwidthSigma) * (z / lumaBandwidthSigma));
            if (!(w > 1.0e-8) || !finite1(w)) continue;

            sumW += w;
            sumL += w * neighbourBasis.x;
            sumLL += w * neighbourBasis.x * neighbourBasis.x;
            sumC += w * neighbourBasis.yzw;
            sumLC += w * neighbourBasis.x * neighbourBasis.yzw;
            cMin = min(cMin, neighbourBasis.yzw);
            cMax = max(cMax, neighbourBasis.yzw);
            weightedLumaNoise += w * neighbourVarianceL;
        }
    }
    if (sumW < 6.0 || !finite1(sumW)) return result;

    const float invW = 1.0 / sumW;
    const float meanL = sumL * invW;
    const float meanLL = sumLL * invW;
    const vec3 meanC = sumC * invW;
    const vec3 meanLC = sumLC * invW;
    const float varL = max(0.0, meanLL - meanL * meanL);
    const float meanNoiseL = max(EPS, weightedLumaNoise * invW);

    // Noise-aware degree-1 local regression. Increased Spectra authority grows
    // the ridge (shrinking spurious L/C covariance) rather than allowing noisy
    // chroma to reduce support. Clamp protects real colour transitions/ringing.
    const float ridge = meanNoiseL * mix(0.70, 2.35, saturate(authority));
    const float denom = max(1.0e-10, varL + ridge);
    const vec3 slope = (meanLC - meanL * meanC) / denom;
    const vec3 intercept = meanC - slope * meanL;
    vec3 predicted = slope * center.basis.x + intercept;
    predicted = clamp(predicted, cMin, cMax);
    if (any(isnan(predicted)) || any(isinf(predicted))) return result;

    result.targetChroma = predicted;
    result.effectiveSupport = sumW;
    result.valid = true;
    return result;
}


// Physical single-frame CFA chroma posterior.  The GALOSH/LOESS model is the
// local structure-supported chroma estimate; the residual around that model is
// retained only when it is statistically too large/coherent to be explained by
// the propagated S/O sensor variance.  This is deliberately not a generic
// chroma blur: low-z stochastic residuals collapse toward the local model while
// strong colour structure survives without shrinkage bias.
float profiledOpponentRetention(
        float modelResidual, float sigma, float noisePressure,
        float modelConfidence, float chromaStructureProtection) {
    const float confidence = saturate(modelConfidence);
    const float thresholdScale = mix(0.72, 1.0, confidence);
    const float z = abs(modelResidual) / max(1.0e-7, sigma);
    const float lowZ = mix(1.18, 1.82, saturate(noisePressure)) * thresholdScale;
    const float highZ = mix(3.10, 4.45, saturate(noisePressure)) * thresholdScale;
    float retained = smoothstep(lowZ, max(lowZ + 0.35, highZ), z);
    // If the model itself is uncertain, never let the posterior become
    // artificially over-confident.  With frame-specific Camera2 S/O this floor
    // naturally vanishes because confidence is 1.0.
    retained = max(retained, 0.32 * (1.0 - confidence));
    // Real iso-luminant colour edges can disagree strongly with a luma-guided
    // regression.  Coherent opponent structure therefore overrides shrinkage.
    retained = max(retained, 0.94 * saturate(chromaStructureProtection));
    return saturate(retained);
}

float galoshLocalChromaStructureProtection(float varianceBasis) {
    const int centerX = int(gl_LocalInvocationID.x) + GALOSH_LOESS_RADIUS;
    const int centerY = int(gl_LocalInvocationID.y) + GALOSH_LOESS_RADIUS;
    const int centerIndex = centerY * GALOSH_TILE_W + centerX;
    const vec3 c = galoshBasisTile[centerIndex].yzw;
    const vec3 l = galoshBasisTile[centerIndex - 1].yzw;
    const vec3 r = galoshBasisTile[centerIndex + 1].yzw;
    const vec3 u = galoshBasisTile[centerIndex - GALOSH_TILE_W].yzw;
    const vec3 d = galoshBasisTile[centerIndex + GALOSH_TILE_W].yzw;
    if (any(isnan(c)) || any(isinf(c)) ||
        any(isnan(l)) || any(isinf(l)) || any(isnan(r)) || any(isinf(r)) ||
        any(isnan(u)) || any(isinf(u)) || any(isnan(d)) || any(isinf(d))) return 0.0;

    const float sigmaPair = sqrt(max(EPS, 2.0 * varianceBasis));
    const float lrContrast = length(l - r);
    const float udContrast = length(u - d);
    const bool horizontalAxis = lrContrast >= udContrast;
    const float crossContrast = horizontalAxis ? lrContrast : udContrast;
    // At a coherent edge the centre belongs to at least one side.  An isolated
    // noisy centre has poor side-to-side contrast and/or is far from both sides.
    const float nearestSide = horizontalAxis
        ? min(length(c - l), length(c - r))
        : min(length(c - u), length(c - d));
    const float crossZ = crossContrast / max(1.0e-7, sigmaPair);
    const float nearestZ = nearestSide / max(1.0e-7, sigmaPair);
    const float edgeEvidence = smoothstep(2.15, 4.65, crossZ);
    const float sideMembership = 1.0 - smoothstep(1.25, 2.65, nearestZ);
    return saturate(edgeEvidence * sideMembership);
}

void writeGaloshCandidateQuad(int quadX, int quadY, vec4 values) {
    const int baseX = quadX * 2;
    const int baseY = quadY * 2;
    if (baseX < int(pc.frameWidth) && baseY < int(pc.frameHeight))
        candidateMosaic[linearIndex(baseX, baseY)] = values.x;
    if (baseX + 1 < int(pc.frameWidth) && baseY < int(pc.frameHeight))
        candidateMosaic[linearIndex(baseX + 1, baseY)] = values.y;
    if (baseX < int(pc.frameWidth) && baseY + 1 < int(pc.frameHeight))
        candidateMosaic[linearIndex(baseX, baseY + 1)] = values.z;
    if (baseX + 1 < int(pc.frameWidth) && baseY + 1 < int(pc.frameHeight))
        candidateMosaic[linearIndex(baseX + 1, baseY + 1)] = values.w;
}

void pass2Fine() {
    // Mode 0 is dispatched on the half-resolution CFA-quad lattice. One GPU
    // invocation owns one 2x2 quad and therefore has exclusive writes to its
    // four reconstructed mosaic samples.  Odd-sized defensive tails are copied
    // unchanged; normal Bayer RAW dimensions are even.
    const int quadX = int(gl_GlobalInvocationID.x);
    const int quadY = int(gl_GlobalInvocationID.y);
    // Every invocation in the workgroup must participate in the cooperative
    // halo load/barrier, including lanes outside the image at edge groups.
    loadGaloshLoessTile();
    const int dispatchQuadWidth = (int(pc.frameWidth) + 1) / 2;
    const int dispatchQuadHeight = (int(pc.frameHeight) + 1) / 2;
    if (quadX >= dispatchQuadWidth || quadY >= dispatchQuadHeight) return;
    const int baseX = quadX * 2;
    const int baseY = quadY * 2;
    if (baseX + 1 >= int(pc.frameWidth) || baseY + 1 >= int(pc.frameHeight)) {
        if (baseX < int(pc.frameWidth) && baseY < int(pc.frameHeight))
            candidateMosaic[linearIndex(baseX, baseY)] = inputAt(baseX, baseY);
        if (baseX + 1 < int(pc.frameWidth) && baseY < int(pc.frameHeight))
            candidateMosaic[linearIndex(baseX + 1, baseY)] = inputAt(baseX + 1, baseY);
        if (baseX < int(pc.frameWidth) && baseY + 1 < int(pc.frameHeight))
            candidateMosaic[linearIndex(baseX, baseY + 1)] = inputAt(baseX, baseY + 1);
        if (baseX + 1 < int(pc.frameWidth) && baseY + 1 < int(pc.frameHeight))
            candidateMosaic[linearIndex(baseX + 1, baseY + 1)] = inputAt(baseX + 1, baseY + 1);
        return;
    }

    const GaloshCfaBlock center = galoshCfaBlockInput(quadX, quadY);
    if (!flagSet(1u) || !center.valid) {
        if (center.valid) writeGaloshCandidateQuad(quadX, quadY, center.samples);
        return;
    }

    const float confidence = saturate(pc.params1.z);
    const float modelAuthority = confidence >= 0.10 ? 0.55 + 0.45 * sqrt(confidence) : 0.0;
    const float visibleBoost = clamp(0.92 + 0.08 * max(0.0, pc.params1.w - 1.0), 0.92, 1.12);
    const float authority = clamp(pc.params1.x * pc.params0.x * modelAuthority * visibleBoost, 0.0, 1.0);
    const GaloshLoessResult loess = galoshGuidedChromaRegressionShared(
            center, authority, confidence);

    atomicAdd(telemetry[0], 4u);
    if (!loess.valid || authority <= 1.0e-4) {
        writeGaloshCandidateQuad(quadX, quadY, center.samples);
        atomicAdd(telemetry[2], 4u);
        return;
    }

    // Profiled posterior around the structure-guided LOESS estimate.  The WHT
    // luminance coefficient remains bit-for-bit unchanged; only opponent axes
    // are cleaned.  Low-z residuals are sensor-noise-consistent and collapse
    // toward LOESS, while high-z or coherent colour-edge residuals survive.
    const float noisePressure = saturate(pc.params0.y);
    const float effectiveSupport = clamp(loess.effectiveSupport, 4.0, 96.0);
    const float posteriorSigma = sqrt(max(EPS, center.varianceL *
            (1.0 + 1.0 / effectiveSupport)));
    const float chromaStructureProtection = galoshLocalChromaStructureProtection(center.varianceL);
    const vec3 residualToModel = center.basis.yzw - loess.targetChroma;
    vec3 retained = vec3(
        profiledOpponentRetention(residualToModel.x, posteriorSigma, noisePressure, confidence, chromaStructureProtection),
        profiledOpponentRetention(residualToModel.y, posteriorSigma, noisePressure, confidence, chromaStructureProtection),
        profiledOpponentRetention(residualToModel.z, posteriorSigma, noisePressure, confidence, chromaStructureProtection));
    const vec3 posteriorChroma = loess.targetChroma + retained * residualToModel;

    const float chromaBlend = clamp(authority * mix(0.88, 1.0, noisePressure) +
            0.12 * noisePressure * modelAuthority, 0.0, 0.985);
    const float c3Blend = min(0.94, 0.88 * chromaBlend);
    vec4 targetBasis = center.basis;
    targetBasis.y = mix(center.basis.y, posteriorChroma.x, chromaBlend);
    targetBasis.z = mix(center.basis.z, posteriorChroma.y, chromaBlend);
    targetBasis.w = mix(center.basis.w, posteriorChroma.z, c3Blend);

    if (chromaBlend >= 0.80) atomicAdd(telemetry[13], 1u);
    if (chromaStructureProtection >= 0.35) atomicAdd(telemetry[14], 1u);
    if (max(retained.x, max(retained.y, retained.z)) <= 0.25 &&
            chromaBlend >= 0.65) atomicAdd(telemetry[15], 1u);

    const vec4 proposed = galoshInverseWht(targetBasis);
    vec4 correction = proposed - center.samples;

    // Use one common correction scale for the whole quad.  Scaling a zero-sum
    // WHT chroma correction uniformly keeps the quad luminance invariant even
    // when a noisy sensel reaches its physical sigma/absolute safety ceiling.
    float correctionScale = 1.0;
    const ivec2 pos[4] = ivec2[4](ivec2(0,0), ivec2(1,0), ivec2(0,1), ivec2(1,1));
    for (int i = 0; i < 4; ++i) {
        const int px = baseX + pos[i].x;
        const int py = baseY + pos[i].y;
        const int ch = cfaChannel(px, py);
        const float sigma = sqrt(max(EPS, varianceAtChannel(ch, center.samples[i])));
        const float shadingAuthority = clamp(0.92 + 0.18 * (lensGainAt(ch, px, py) - 1.0), 0.90, 1.18);
        const float maxShift = clamp(
                (2.85 + 1.20 * saturate(pc.params0.y)) * sigma * shadingAuthority,
                2.0e-5, 0.0180) * pc.params1.y;
        const float magnitude = abs(correction[i]);
        if (magnitude > maxShift && magnitude > 1.0e-12) {
            correctionScale = min(correctionScale, maxShift / magnitude);
        }
        // Prevent the common-scale correction from creating negative linear RAW.
        if (correction[i] < 0.0 && center.samples[i] + correction[i] < 0.0) {
            correctionScale = min(correctionScale,
                    center.samples[i] / max(1.0e-12, -correction[i]));
        }
    }
    correction *= clamp(correctionScale, 0.0, 1.0);
    vec4 outputValues = center.samples + correction;

    uint changed = 0u;
    float maxCorrection = 0.0;
    for (int i = 0; i < 4; ++i) {
        const float magnitude = abs(correction[i]);
        if (magnitude >= 1.0e-7) ++changed;
        maxCorrection = max(maxCorrection, magnitude);
    }
    writeGaloshCandidateQuad(quadX, quadY, outputValues);
    if (changed > 0u) atomicAdd(telemetry[1], changed);
    atomicMax(telemetry[3], floatBitsToUint(maxCorrection));
}

void pass2Mid() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= int(pc.frameWidth) || y >= int(pc.frameHeight)) return;
    uint idx = linearIndex(x, y);
    float original = pass2MidSourceAt(x, y);
    if (!flagSet(2u) || x < 7 || y < 7 || x >= int(pc.frameWidth) - 7 || y >= int(pc.frameHeight) - 7) {
        scratchMosaic[idx] = original; return;
    }
    int ch = cfaChannel(x, y);
    if (ch != 0 && ch != 3) { scratchMosaic[idx] = original; return; }
    float centerGreen = greenReferenceMid(x, y);
    float centerResidual = residualMid(x, y);
    if (!finite1(original) || !finite1(centerGreen) || !finite1(centerResidual)) { scratchMosaic[idx] = original; return; }
    float r2 = crossMeanMid(x, y, 2), r4 = crossMeanMid(x, y, 4), r6 = crossMeanMid(x, y, 6);
    float local2 = (centerResidual + 2.0 * r2) / 3.0;
    float broad4 = (centerResidual + 4.0 * r4) / 5.0;
    float broad6 = (centerResidual + 4.0 * r6) / 5.0;
    float coefficient = local2 - (0.40 * broad4 + 0.60 * broad6);
    if (!finite1(coefficient)) { scratchMosaic[idx] = original; return; }

    float greenS = 0.5 * (pc.s.y + pc.s.z), greenO = 0.5 * (pc.o.y + pc.o.z);
    float channelVariance = max(EPS, channelS(ch) * max(0.0, original) + channelO(ch));
    float greenReferenceVariance = 0.25 * max(EPS, greenS * max(0.0, centerGreen) + greenO);
    float chromaSigma = sqrt(channelVariance + greenReferenceVariance);
    float fineGreenStructure = abs(greenReferenceMid(x + 2, y) - greenReferenceMid(x - 2, y)) +
                               abs(greenReferenceMid(x, y + 2) - greenReferenceMid(x, y - 2));
    float coarseGreenStructure = abs(greenReferenceMid(x + 6, y) - greenReferenceMid(x - 6, y)) +
                                 abs(greenReferenceMid(x, y + 6) - greenReferenceMid(x, y - 6));
    float greenReferenceSigma = sqrt(max(EPS, greenReferenceVariance));
    MultiscaleChromaContextDecision multiscaleChromaContext = resolveMultiscaleChromaContext(
            fineGreenStructure, 2.26 * greenReferenceSigma,
            coarseGreenStructure, 2.26 * greenReferenceSigma, 1.55, pc.params2.z);
    float structureWeight = multiscaleChromaContext.structureWeight;
    // Keep full authority in dark/noisy regions, but do not disable physical
    // mid-band cleanup outright in midtones/highlights. Strong colour/detail
    // coefficients are protected by the sigma-domain firm-retention above.
    float shadowWeight = 0.30 + 0.70 * clamp((0.62 - max(0.0, centerGreen)) / 0.55, 0.0, 1.0);
    float shadingAuthority = clamp(0.92 + 0.15 * (lensGainAt(ch, x, y) - 1.0), 0.90, 1.15);
    float authority = min(1.0, pc.params2.x * shadingAuthority * pc.params0.x *
                              pass2OpponentAuthorityMultiplier(ch, false));
    BandDecision decision = resolveBandDecision(false, coefficient, chromaSigma, authority,
        pc.params2.z, structureWeight, shadowWeight, pc.params2.w, 0.0, pc.params0.y);
    atomicAdd(telemetry[4], 1u);
    if (structureWeight < 0.015 || shadowWeight <= 0.0) atomicAdd(telemetry[6], 1u);
    float applied = 0.0;
    if (decision.supported) {
        float maxShift = clamp((1.25 + 0.85 * pc.params0.y) * chromaSigma * shadingAuthority,
                               1.0e-5, 0.0075) * pc.params2.y;
        applied = clamp(decision.correction, -maxShift, maxShift);
        if (abs(applied) < 1.0e-7) applied = 0.0;
    }
    scratchMosaic[idx] = original + applied;
    if (applied != 0.0) atomicAdd(telemetry[5], 1u);
    atomicMax(telemetry[7], floatBitsToUint(abs(applied)));
}

float pass3LowOpponentAuthorityMultiplier(int channel) {
    uint gridSize = pc.fieldCols * pc.fieldRows;
    uint authorityBase = 4u * pc.frameHeight + 4u * pc.frameWidth + 4u * gridSize;
    if (channel == 0) return clamp(auxiliary[authorityBase], 0.88, 1.12);
    if (channel == 3) return clamp(auxiliary[authorityBase + 1u], 0.88, 1.12);
    return 1.0;
}

float lowFieldGrid(int which, float x, float y) {
    if (pc.fieldCols == 0u || pc.fieldRows == 0u) return 0.0;
    float gx = clamp(x * float(pc.fieldCols) / float(max(pc.frameWidth, 1u)) - 0.5, 0.0, float(pc.fieldCols - 1u));
    float gy = clamp(y * float(pc.fieldRows) / float(max(pc.frameHeight, 1u)) - 0.5, 0.0, float(pc.fieldRows - 1u));
    int x0 = int(floor(gx)), y0 = int(floor(gy));
    int x1 = min(x0 + 1, int(pc.fieldCols) - 1), y1 = min(y0 + 1, int(pc.fieldRows) - 1);
    float tx = gx - float(x0), ty = gy - float(y0);
    uint rowBase = 0u;
    uint colBase = 4u * pc.frameHeight;
    uint gridBase = colBase + 4u * pc.frameWidth;
    uint gridSize = pc.fieldCols * pc.fieldRows;
    uint base = gridBase + uint(which) * gridSize;
    float v00 = auxiliary[base + uint(y0) * pc.fieldCols + uint(x0)];
    float v10 = auxiliary[base + uint(y0) * pc.fieldCols + uint(x1)];
    float v01 = auxiliary[base + uint(y1) * pc.fieldCols + uint(x0)];
    float v11 = auxiliary[base + uint(y1) * pc.fieldCols + uint(x1)];
    return mix(mix(v00, v10, tx), mix(v01, v11, tx), ty);
}

struct LowDecision { bool supported; bool structureRejected; float correction; };
LowDecision resolveLow(float fieldCoefficient, float noiseSigma, float authority, float modelConfidence,
                       float structureWeight, float spatialConfidence, float visibleAmp) {
    LowDecision d; d.supported = false; d.structureRejected = false; d.correction = 0.0;
    structureWeight = saturate(structureWeight); spatialConfidence = saturate(spatialConfidence);
    visibleAmp = finite1(visibleAmp) ? clamp(visibleAmp, 0.5, 4.0) : 1.0;
    float confidence = saturate(modelConfidence);
    if (!(noiseSigma > 0.0) || saturate(authority) <= 0.0 || confidence < 0.10) return d;
    if (structureWeight < 0.03 || spatialConfidence < 0.15) { d.structureRejected = true; return d; }
    // Keep GPU semantics identical to the host reference: confidence controls
    // uncertainty/support, not a second linear opacity. Medium-confidence fields
    // remain correctable; hard low-confidence rejection stays explicit.
    float modelAuthority = 0.55 + 0.45 * sqrt(confidence);
    float fieldAuthority = 0.55 + 0.45 * sqrt(spatialConfidence);
    float a = saturate(authority) * modelAuthority * fieldAuthority;
    float effectiveSigma = max(1.0e-7, noiseSigma * 0.30);
    float visibleRelief = clamp(1.0 - 0.12 * max(0.0, visibleAmp - 1.0), 0.72, 1.0);
    // The field coefficient is already a residual from a broad colour trend and
    // is built only from texture-rejected samples. With strong model/grid
    // confidence we can therefore activate well below one single-pixel sigma.
    float activationFloor = effectiveSigma * mix(0.70, 0.40, a) * visibleRelief;
    float supportedMagnitude = max(0.0, abs(fieldCoefficient) - activationFloor);
    if (supportedMagnitude <= 0.0) return d;
    float signedSupported = fieldCoefficient < 0.0 ? -supportedMagnitude : supportedMagnitude;
    float visibleBoost = clamp(0.90 + 0.10 * max(0.0, visibleAmp - 1.0), 0.90, 1.10);
    float confidenceBoost = mix(0.88, 1.12, spatialConfidence);
    float shrinkage = clamp(a * structureWeight * visibleBoost * confidenceBoost, 0.0, 0.90);
    d.correction = -signedSupported * shrinkage;
    d.supported = abs(d.correction) >= 1.0e-9;
    return d;
}

void pass3Candidate() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= int(pc.frameWidth) || y >= int(pc.frameHeight)) return;
    uint idx = linearIndex(x, y);
    float center = inputMosaic[idx];
    int ch = cfaChannel(x, y);
    uint f = flags(); // P3 flags: bit0 row, bit1 col, bit2 low
    uint rowBase = 0u;
    uint colBase = 4u * pc.frameHeight;
    float correction = 0.0;
    float maxScale = pc.params1.y;
    float totalCorrectionCeiling = 0.0055 * maxScale;
    if ((f & 1u) != 0u) {
        float rowProfile = auxiliary[rowBase + uint(ch) * pc.frameHeight + uint(y)];
        correction += clamp(pc.params0.x * pc.params1.x * rowProfile, -0.0015 * maxScale, 0.0015 * maxScale);
    }
    if ((f & 2u) != 0u) {
        float colProfile = auxiliary[colBase + uint(ch) * pc.frameWidth + uint(x)];
        correction += clamp(pc.params0.x * pc.params1.x * colProfile, -0.0015 * maxScale, 0.0015 * maxScale);
    }
    if ((f & 4u) != 0u && (ch == 0 || ch == 3)) {
        float blotch = lowFieldGrid(ch == 0 ? 0 : 1, float(x), float(y));
        float localGridConfidence = lowFieldGrid(ch == 0 ? 2 : 3, float(x), float(y));
        float sv = channelS(ch), ov = channelO(ch);
        float sigma = finite1(sv) && finite1(ov) && sv > 1.0e-12 && ov >= 0.0
            ? sqrt(max(EPS, sv * max(0.0, center) + ov))
            : 0.002;
        float structureWeight = 0.0;
        if (x >= 2 && y >= 2 && x < int(pc.frameWidth) - 2 && y < int(pc.frameHeight) - 2) {
            float localGreen = 0.25 * (inputAt(x, y - 1) + inputAt(x, y + 1) + inputAt(x - 1, y) + inputAt(x + 1, y));
            float greenGradient = abs(inputAt(x, y + 1) - inputAt(x, y - 1)) + abs(inputAt(x + 1, y) - inputAt(x - 1, y));
            float greenS = 0.5 * (pc.s.y + pc.s.z);
            float greenO = 0.5 * (pc.o.y + pc.o.z);
            float singleGreenSigma = sqrt(max(EPS, greenS * max(0.0, localGreen) + greenO));
            structureWeight = contextStructureWeight(greenGradient, 2.26 * singleGreenSigma, 1.45);
        }
        float spatialConfidence = clamp(pc.params0.z * localGridConfidence, 0.0, 1.0);
        float boundedAuthority = min(1.0, pc.params1.x * pc.params0.y *
                                          pass3LowOpponentAuthorityMultiplier(ch));
        LowDecision d = resolveLow(blotch, sigma, boundedAuthority, pc.params1.z,
                                   structureWeight, spatialConfidence, pc.params1.w);
        atomicAdd(telemetry[9], 1u);
        if (d.structureRejected) atomicAdd(telemetry[10], 1u);
        if (d.supported) {
            float physicalSigmaCeiling = clamp(3.25 * sigma, 0.0005, 0.0200);
            float fieldFractionCeiling = min(0.0200,
                    mix(0.78, 0.92, localGridConfidence) * abs(blotch));
            float maxBlotch = min(physicalSigmaCeiling, fieldFractionCeiling) * maxScale;
            totalCorrectionCeiling = max(totalCorrectionCeiling, maxBlotch);
            float toSubtract = clamp(-d.correction, -maxBlotch, maxBlotch);
            if (abs(toSubtract) >= 1.0e-7) {
                correction += toSubtract;
                atomicAdd(telemetry[11], 1u);
                atomicMax(telemetry[12], floatBitsToUint(abs(toSubtract)));
            }
        }
    }
    float applied = clamp(correction, -totalCorrectionCeiling, totalCorrectionCeiling);
    candidateMosaic[idx] = center - applied;
    if (abs(applied) >= 1.0e-7) atomicAdd(telemetry[8], 1u);
}

float statsSourceAt(int x, int y) {
    if (pc.mode == 2u) return pass2FinalAt(x, y);
    return candidateAt(x, y);
}

float statsGreenReference(int x, int y) {
    return 0.25 * (statsSourceAt(x, y - 1) + statsSourceAt(x, y + 1) +
                   statsSourceAt(x - 1, y) + statsSourceAt(x + 1, y));
}

float statsChromaResidual(int x, int y) {
    int ch = cfaChannel(x, y);
    if (ch != 0 && ch != 3) return 0.0;
    float center = statsSourceAt(x, y);
    float green = statsGreenReference(x, y);
    float left = statsSourceAt(x - 2, y);
    float right = statsSourceAt(x + 2, y);
    float greenLeft = statsGreenReference(x - 2, y);
    float greenRight = statsGreenReference(x + 2, y);
    float opponent = center - green;
    float neighbourOpponent = 0.5 * ((left - greenLeft) + (right - greenRight));
    return opponent - neighbourOpponent;
}

void collectTileStats() {
    uint tileIndex = gl_GlobalInvocationID.x;
    uint tileCount = pc.gridCols * pc.gridRows;
    if (gl_GlobalInvocationID.y != 0u || tileIndex >= tileCount || pc.gridCols == 0u || pc.gridRows == 0u) return;
    uint gx = tileIndex % pc.gridCols, gy = tileIndex / pc.gridCols;
    int y0 = max(4, int(gy * pc.tileHeight));
    int y1 = min(int(pc.frameHeight) - 4, int((gy + 1u) * pc.tileHeight));
    int x0 = max(4, int(gx * pc.tileWidth));
    int x1 = min(int(pc.frameWidth) - 4, int((gx + 1u) * pc.tileWidth));
    if (x1 <= x0 || y1 <= y0) { tileStats[tileIndex].meanSignal = vec4(0.0); tileStats[tileIndex].metrics = vec4(0.0); return; }
    int baseY = y0 + ((y0 & 1) != 0 ? 1 : 0), baseX = x0 + ((x0 & 1) != 0 ? 1 : 0);
    vec4 signalSum = vec4(0.0); uvec4 signalCount = uvec4(0u);
    float residualSum = 0.0, chromaResidualSum = 0.0, structureSum = 0.0;
    uint sampleCount = 0u, chromaSampleCount = 0u;
    for (int y = baseY; y < y1; y += 4) {
        for (int x = baseX; x < x1; x += 4) {
            for (int py = 0; py < 2; ++py) for (int px = 0; px < 2; ++px) {
                int xx = x + px, yy = y + py; if (xx >= x1 || yy >= y1) continue;
                int ch = cfaChannel(xx, yy);
                float center = statsSourceAt(xx, yy), left = statsSourceAt(xx - 2, yy), right = statsSourceAt(xx + 2, yy);
                float up = statsSourceAt(xx, yy - 2), down = statsSourceAt(xx, yy + 2);
                if (!finite1(center) || !finite1(left) || !finite1(right) || !finite1(up) || !finite1(down)) continue;
                signalSum[ch] += clamp(center, 0.0, 1.0); signalCount[ch]++;
                float residual = center - 0.25 * (left + right + up + down);
                residualSum += residual * residual;
                if (ch == 0 || ch == 3) {
                    float chromaResidualValue = statsChromaResidual(xx, yy);
                    if (finite1(chromaResidualValue)) {
                        chromaResidualSum += chromaResidualValue * chromaResidualValue;
                        chromaSampleCount++;
                    }
                }
                float structure = 0.5 * (abs(left - right) + abs(up - down));
                structureSum += structure * structure; sampleCount++;
            }
        }
    }
    vec4 meanSignal = vec4(0.0); uint populated = 0u;
    for (int ch = 0; ch < 4; ++ch) if (signalCount[ch] > 0u) { meanSignal[ch] = signalSum[ch] / float(signalCount[ch]); populated++; }
    float spatialEnergy = sampleCount > 0u ? residualSum / float(sampleCount) : 0.0;
    float chromaEnergy = chromaSampleCount > 0u
        ? chromaResidualSum / float(chromaSampleCount) : spatialEnergy;
    float noRegretEnergy = pc.mode == 2u
        ? chromaEnergy
        : (pc.mode == 5u ? 0.55 * spatialEnergy + 0.45 * chromaEnergy : spatialEnergy);
    tileStats[tileIndex].meanSignal = meanSignal;
    tileStats[tileIndex].metrics = vec4(noRegretEnergy,
                                        sampleCount > 0u ? structureSum / float(sampleCount) : 0.0,
                                        float(sampleCount), float(populated));
}

float interpolatedAcceptance(int x, int y) {
    if (pc.gridCols == 0u || pc.gridRows == 0u || pc.tileWidth == 0u || pc.tileHeight == 0u) return 0.0;
    float gy = (float(y) + 0.5) / float(max(pc.tileHeight, 1u)) - 0.5;
    int gy0 = clamp(int(floor(gy)), 0, int(pc.gridRows) - 1), gy1 = min(gy0 + 1, int(pc.gridRows) - 1);
    float ty = clamp(gy - float(gy0), 0.0, 1.0);
    float gx = (float(x) + 0.5) / float(max(pc.tileWidth, 1u)) - 0.5;
    int gx0 = clamp(int(floor(gx)), 0, int(pc.gridCols) - 1), gx1 = min(gx0 + 1, int(pc.gridCols) - 1);
    float tx = clamp(gx - float(gx0), 0.0, 1.0);
    float a00 = acceptance[uint(gy0) * pc.gridCols + uint(gx0)], a10 = acceptance[uint(gy0) * pc.gridCols + uint(gx1)];
    float a01 = acceptance[uint(gy1) * pc.gridCols + uint(gx0)], a11 = acceptance[uint(gy1) * pc.gridCols + uint(gx1)];
    return clamp(mix(mix(a00, a10, tx), mix(a01, a11, tx), ty), 0.0, 1.0);
}

void noRegretBlendPass2() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= int(pc.frameWidth) || y >= int(pc.frameHeight)) return;
    uint idx = linearIndex(x, y); float w = interpolatedAcceptance(x, y);
    float before = inputMosaic[idx], proposed = pass2FinalAt(x, y);
    writePass2Final(idx, before + w * (proposed - before));
    if (w < 0.999) atomicAdd(telemetry[80], 1u);
}
void noRegretBlendPass3() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= int(pc.frameWidth) || y >= int(pc.frameHeight)) return;
    uint idx = linearIndex(x, y); float w = interpolatedAcceptance(x, y);
    candidateMosaic[idx] = inputMosaic[idx] + w * (candidateMosaic[idx] - inputMosaic[idx]);
    if (w < 0.999) atomicAdd(telemetry[80], 1u);
}

void main() {
    if (pc.mode == 0u) pass2Fine();
    else if (pc.mode == 1u) pass2Mid();
    else if (pc.mode == 2u || pc.mode == 5u) collectTileStats();
    else if (pc.mode == 3u) noRegretBlendPass2();
    else if (pc.mode == 4u) pass3Candidate();
    else if (pc.mode == 6u) noRegretBlendPass3();
}
