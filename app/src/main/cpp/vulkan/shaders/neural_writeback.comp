#version 450

// C4 activations use two uint words per logical vec4. Values are FP16 in memory
// but arithmetic is FP32 for deterministic, portable accumulation.
vec4 loadC4(const uint words[], uint vecIndex) {
    uint i = vecIndex * 2u;
    return vec4(unpackHalf2x16(words[i]), unpackHalf2x16(words[i+1u]));
}
void storeC4(inout uint words[], uint vecIndex, vec4 v) {
    uint i = vecIndex * 2u;
    words[i] = packHalf2x16(v.xy);
    words[i+1u] = packHalf2x16(v.zw);
}
float loadHalf(const uint words[], uint halfIndex) {
    vec2 p = unpackHalf2x16(words[halfIndex >> 1u]);
    return ((halfIndex & 1u) == 0u) ? p.x : p.y;
}

layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Raw{float data[];}raw;
layout(set=0,binding=1,std430) readonly buffer Conditioning{uint data[];}cond;
layout(set=0,binding=2,std430) readonly buffer Z{uint data[];}zbuf;
layout(set=0,binding=3,std430) readonly buffer Q{uint data[];}qbuf;
layout(set=0,binding=4,std430) writeonly buffer Clean{float data[];}clean;
layout(set=0,binding=5,std430) writeonly buffer Post{float data[];}post;
layout(set=0,binding=6,std430) writeonly buffer Residual{float data[];}resid;
layout(set=0,binding=7,std430) writeonly buffer Mask{uint data[];}maskOut;
layout(set=0,binding=8,std430) writeonly buffer Head{float data[];}headOut;
layout(push_constant)uniform PC{uint tileW;uint tileH;uint validX;uint validY;uint validW;uint validH;uint fullW;uint fullH;int globalX;int globalY;float kSigma;float qMin;float qMax;float authority;float clipThreshold;float nearThreshold;uint writeResidual;uint writeEvidence;}pc;
void main(){uint lx=gl_GlobalInvocationID.x,ly=gl_GlobalInvocationID.y;if(lx>=pc.validW||ly>=pc.validH)return;uint tx=pc.validX+lx,ty=pc.validY+ly;int gx=pc.globalX+int(lx),gy=pc.globalY+int(ly);if(gx<0||gy<0||gx>=int(pc.fullW)||gy>=int(pc.fullH))return;uint localPix=ty*pc.tileW+tx,globalPix=uint(gy)*pc.fullW+uint(gx);vec4 x=vec4(raw.data[globalPix*4u],raw.data[globalPix*4u+1u],raw.data[globalPix*4u+2u],raw.data[globalPix*4u+3u]);vec4 logs=loadC4(cond.data,localPix*4u+1u),sigma=exp(logs),z=loadC4(zbuf.data,localPix),q=clamp(loadC4(qbuf.data,localPix),vec4(pc.qMin),vec4(pc.qMax));float head=loadC4(cond.data,localPix*4u+3u).y;vec4 zb=vec4(pc.kSigma)*tanh(z/vec4(pc.kSigma));vec4 delta=sigma*zb*head*clamp(pc.authority,0.0,1.0);vec4 y=clamp(x-delta,vec4(0),vec4(1));vec4 varPre=sigma*sigma,varModel=varPre*exp(q);vec4 varActual=mix(varPre,varModel,clamp(pc.authority,0.0,1.0));for(uint c=0u;c<4u;++c){clean.data[globalPix*4u+c]=y[c];post.data[globalPix*4u+c]=varActual[c];if(pc.writeResidual!=0u)resid.data[globalPix*4u+c]=x[c]-y[c];}if(pc.writeEvidence!=0u){uint m=0u;for(uint c=0u;c<4u;++c){if(x[c]>=pc.clipThreshold)m|=(1u<<c);if(x[c]>=pc.nearThreshold)m|=(1u<<(4u+c));}maskOut.data[globalPix]=m;headOut.data[globalPix]=head;}}
