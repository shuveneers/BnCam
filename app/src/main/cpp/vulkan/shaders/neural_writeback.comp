#version 450

// Runtime-sized SSBO arrays cannot be passed as unsized GLSL function parameters on
// the Android NDK glslc Vulkan 1.1 path. Keep the exact C4 packing semantics but
// expand accesses at the call site instead.
#define loadC4(WORDS, VEC_INDEX) \
    vec4(unpackHalf2x16(WORDS[(VEC_INDEX) * 2u]), \
         unpackHalf2x16(WORDS[(VEC_INDEX) * 2u + 1u]))
#define loadHalf(WORDS, HALF_INDEX) \
    ((((HALF_INDEX) & 1u) == 0u) \
        ? unpackHalf2x16(WORDS[(HALF_INDEX) >> 1u]).x \
        : unpackHalf2x16(WORDS[(HALF_INDEX) >> 1u]).y)

layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Raw{float data[];}raw;
layout(set=0,binding=1,std430) readonly buffer Conditioning{uint data[];}cond;
layout(set=0,binding=2,std430) readonly buffer Z{uint data[];}zbuf;
layout(set=0,binding=3,std430) readonly buffer Q{uint data[];}qbuf;
layout(set=0,binding=4,std430) writeonly buffer Clean{float data[];}clean;
layout(set=0,binding=5,std430) writeonly buffer Post{float data[];}post;
layout(set=0,binding=6,std430) writeonly buffer Residual{float data[];}resid;
layout(set=0,binding=7,std430) writeonly buffer Mask{uint data[];}maskOut;
layout(set=0,binding=8,std430) writeonly buffer Head{float data[];}headOut;
layout(set=0,binding=9,std430) readonly buffer Confidence{uint data[];}confidenceBuf;

const float INV_SQRT2 = 0.70710678118654752440;

vec4 boundedNativeDelta(uint localPix, float kSigma) {
    vec4 logs = loadC4(cond.data, localPix * 4u + 1u);
    vec4 sigma = exp(logs);
    vec4 z = loadC4(zbuf.data, localPix);
    float head = loadC4(cond.data, localPix * 4u + 3u).y;
    vec4 zb = vec4(kSigma) * tanh(z / vec4(kSigma));
    return sigma * zb * head;
}

vec4 residualBasis(vec4 v) {
    return vec4(
        0.5 * (v.r + v.g + v.b + v.a),
        INV_SQRT2 * (v.r - v.a),
        0.5 * (v.r - v.g - v.b + v.a),
        INV_SQRT2 * (v.g - v.b));
}
vec4 residualInverse(vec4 q) {
    return vec4(
        0.5*q.x + INV_SQRT2*q.y + 0.5*q.z,
        0.5*q.x - 0.5*q.z + INV_SQRT2*q.w,
        0.5*q.x - 0.5*q.z - INV_SQRT2*q.w,
        0.5*q.x - INV_SQRT2*q.y + 0.5*q.z);
}
vec4 componentControlled(vec4 residual, float lumaAuthority, float chromaAuthority) {
    vec4 q = residualBasis(residual);
    q.x *= lumaAuthority;
    q.yzw *= chromaAuthority;
    return residualInverse(q);
}


layout(push_constant)uniform PC{
    uint tileW; uint tileH; uint validX; uint validY; uint validW; uint validH;
    uint fullW; uint fullH; int globalX; int globalY;
    float kSigma; float qMin; float qMax;
    float authority; float lumaAuthority; float chromaAuthority;
    float detailProtection; float lowFrequencyCleanup; float adaptiveResponse;
    float adaptiveFullEvidenceSnr; float adaptiveIdentitySnr;
    float clipThreshold; float nearThreshold;
    uint writeResidual; uint writeEvidence; uint hasConfidence;
}pc;

void main(){
    uint lx=gl_GlobalInvocationID.x,ly=gl_GlobalInvocationID.y;
    if(lx>=pc.validW||ly>=pc.validH)return;
    uint tx=pc.validX+lx,ty=pc.validY+ly;
    int gx=pc.globalX+int(lx),gy=pc.globalY+int(ly);
    if(gx<0||gy<0||gx>=int(pc.fullW)||gy>=int(pc.fullH))return;
    uint localPix=ty*pc.tileW+tx,globalPix=uint(gy)*pc.fullW+uint(gx);
    vec4 x=vec4(raw.data[globalPix*4u],raw.data[globalPix*4u+1u],raw.data[globalPix*4u+2u],raw.data[globalPix*4u+3u]);
    vec4 logs=loadC4(cond.data,localPix*4u+1u),sigma=exp(logs);
    vec4 q=clamp(loadC4(qbuf.data,localPix),vec4(pc.qMin),vec4(pc.qMax));
    float head=loadC4(cond.data,localPix*4u+3u).y;

    // Fixed 3x3 decomposition of the ONE Student residual. The tile halo already
    // covers these taps, so this creates no second denoiser or extra full-frame pass.
    vec4 nativeDelta=boundedNativeDelta(localPix,pc.kSigma);
    vec4 coarse=vec4(0.0);
    for(int oy=-1;oy<=1;++oy){
        uint sy=uint(clamp(int(ty)+oy,0,int(pc.tileH)-1));
        for(int ox=-1;ox<=1;++ox){
            uint sx=uint(clamp(int(tx)+ox,0,int(pc.tileW)-1));
            coarse+=boundedNativeDelta(sy*pc.tileW+sx,pc.kSigma);
        }
    }
    coarse*=1.0/9.0;
    vec4 fine=nativeDelta-coarse;
    vec4 controlled=componentControlled(fine,clamp(pc.lumaAuthority,0.0,1.0),clamp(pc.chromaAuthority,0.0,1.0));
    controlled+=clamp(pc.lowFrequencyCleanup,0.0,1.0)*componentControlled(coarse,clamp(pc.lumaAuthority,0.0,1.0),clamp(pc.chromaAuthority,0.0,1.0));

    // Physical noise evidence, never sensor/lens identity, owns the clean-frame gate.
    // Use this SNR envelope exactly once.  The retired Phase-6 sqrt(inverse-SNR) multiplier
    // described the same physics a second time and collapsed real Neural corrections toward
    // identity.  SNR >= identity threshold remains exact identity for texture protection.
    vec4 snr=abs(x)/max(sigma,vec4(1.0e-8));
    vec4 noiseEvidence=vec4(1.0)-smoothstep(
        vec4(pc.adaptiveFullEvidenceSnr),vec4(pc.adaptiveIdentitySnr),snr);
    vec4 adaptiveGain=noiseEvidence;

    // Detail Protection is a correction gate, not sharpening. Low correction
    // confidence and posterior uncertainty can only reduce mutation authority.
    float correctionConfidence=1.0;
    if(pc.hasConfidence!=0u){
        float confidenceLogit=loadC4(confidenceBuf.data,localPix).x;
        correctionConfidence=1.0/(1.0+exp(-clamp(confidenceLogit,-12.0,12.0)));
    }
    vec4 varPre=sigma*sigma,varModel=varPre*exp(q);
    vec4 posteriorRisk=clamp((varModel-varPre)/max(max(varModel,varPre),vec4(1.0e-12)),vec4(0.0),vec4(1.0));
    vec4 structureRisk=max(vec4(1.0-correctionConfidence),posteriorRisk);
    vec4 detailGate=vec4(1.0)-clamp(pc.detailProtection,0.0,1.0)*structureRisk;

    vec4 delta=controlled*clamp(pc.authority,0.0,1.0)*adaptiveGain*detailGate;
    // boundedNativeDelta already applies the original headroom gate.
    vec4 y=clamp(x-delta,vec4(0.0),vec4(1.0));

    // Conservative posterior publication: when the model claims lower variance,
    // only the weakest active component authority may claim that reduction.
    float componentMin=min(clamp(pc.lumaAuthority,0.0,1.0),clamp(pc.chromaAuthority,0.0,1.0));
    float componentMax=max(clamp(pc.lumaAuthority,0.0,1.0),clamp(pc.chromaAuthority,0.0,1.0));
    vec4 minApplied=clamp(pc.authority,0.0,1.0)*componentMin*adaptiveGain*detailGate;
    vec4 maxApplied=clamp(pc.authority,0.0,1.0)*componentMax*adaptiveGain*detailGate;
    bvec4 modelLower=lessThanEqual(varModel,varPre);
    vec4 posteriorMix=mix(maxApplied,minApplied,modelLower);
    vec4 varActual=mix(varPre,varModel,clamp(posteriorMix,vec4(0.0),vec4(1.0)));

    for(uint c=0u;c<4u;++c){
        clean.data[globalPix*4u+c]=y[c];
        post.data[globalPix*4u+c]=max(varActual[c],0.0);
        if(pc.writeResidual!=0u)resid.data[globalPix*4u+c]=x[c]-y[c];
    }
    if(pc.writeEvidence!=0u){
        uint m=0u;
        for(uint c=0u;c<4u;++c){
            if(x[c]>=pc.clipThreshold)m|=(1u<<c);
            if(x[c]>=pc.nearThreshold)m|=(1u<<(4u+c));
        }
        maskOut.data[globalPix]=m;
        headOut.data[globalPix]=head;
    }
}
