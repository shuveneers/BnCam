#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    uint words[];
} inputBuffer;

layout(set = 0, binding = 1, std430) readonly buffer ToneLutBuffer {
    uint values[];
} toneLut;

layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer {
    uint words[];
} outputBuffer;

layout(set = 0, binding = 3, std430) readonly buffer HdrAccumulatorBuffer {
    float values[];
} hdrAccumulator;

layout(set = 0, binding = 4, std430) readonly buffer HdrWeightBuffer {
    float values[];
} hdrWeights;

layout(set = 0, binding = 5, std430) buffer GainLogBuffer {
    float values[];
} gainLog;

layout(set = 0, binding = 6, std430) writeonly buffer GainmapBuffer {
    uint words[];
} gainmapBuffer;

layout(set = 0, binding = 7, std430) buffer UltraHdrTelemetryBuffer {
    uint values[];
} ultraHdrTelemetry;

layout(set = 0, binding = 8, std430) readonly buffer PortraitMaskBuffer {
    float values[];
} portraitMask;

layout(push_constant) uniform PushConstants {
    uint inputWidth;
    uint inputHeight;
    uint outputWidth;
    uint outputHeight;
    uint rotationDegrees;
    uint outputPixelCount;
    float wbRed;
    float wbGreen;
    float wbBlue;
    float saturationControl;
    float contrastControl;
    float vibranceControl;
    float profileDetailAmount;
    float profileDetailRadius;
    float profileDetailDetail;
    float profileDetailMasking;
    uint ultraHdrMode;
    uint gainmapWidth;
    uint gainmapHeight;
    uint gainmapPixelCount;
    uint portraitEnabled;
    uint portraitMaskWidth;
    uint portraitMaskHeight;
    uint portraitMaskRotationDegrees;
    float portraitTargetLeft;
    float portraitTargetTop;
    float portraitTargetRight;
    float portraitTargetBottom;
    float profileNrLumaBlend;
    float profileNrLumaProtection;
    float profileNrChromaBlend;
    float profileNrChromaProtection;
} pc;

// FASE 13 compact residual-noise telemetry. Words 0..7 remain owned/reserved by
// Ultra HDR; YUV analysis owns 8..63. Q24 retains sub-code-value sigma precision.
const uint kYuvHistBins = 16u;
const uint kYuvHistYBase = 8u;
const uint kYuvHistUBase = 24u;
const uint kYuvHistVBase = 40u;
const uint kYuvLumaSamplesWord = 56u;
const uint kYuvChromaSamplesWord = 57u;
const uint kYuvSigmaYWord = 58u;
const uint kYuvSigmaUWord = 59u;
const uint kYuvSigmaVWord = 60u;
const uint kYuvLumaAuthorityWord = 61u;
const uint kYuvChromaAuthorityWord = 62u;
const uint kYuvConfidenceWord = 63u;
const float kYuvQ24 = 16777216.0;
const float kAbsLaplacianP35ToSigma = 2.722573141;

uint readByte(uint byteIndex) {
    uint word = inputBuffer.words[byteIndex >> 2u];
    uint shift = (byteIndex & 3u) * 8u;
    return (word >> shift) & 0xffu;
}

uint pack4(uint b0, uint b1, uint b2, uint b3) {
    return (b0 & 0xffu) |
           ((b1 & 0xffu) << 8u) |
           ((b2 & 0xffu) << 16u) |
           ((b3 & 0xffu) << 24u);
}

uvec2 sourceCoordinate(uint outputX, uint outputY) {
    if (pc.rotationDegrees == 90u) {
        return uvec2(outputY, pc.inputHeight - 1u - outputX);
    }
    if (pc.rotationDegrees == 180u) {
        return uvec2(pc.inputWidth - 1u - outputX, pc.inputHeight - 1u - outputY);
    }
    if (pc.rotationDegrees == 270u) {
        return uvec2(pc.inputWidth - 1u - outputY, outputX);
    }
    return uvec2(outputX, outputY);
}

float contrastCurve(float value, float signedControl) {
    float v = clamp(value, 0.0, 1.0);
    float factor = exp2(clamp(signedControl, -1.0, 1.0) * 0.75);
    if (abs(factor - 1.0) < 1.0e-4) return v;
    if (v < 0.5) {
        return 0.5 * pow(max(0.0, 2.0 * v), factor);
    }
    return 1.0 - 0.5 * pow(max(0.0, 2.0 * (1.0 - v)), factor);
}

vec3 applyProfile(vec3 rgb) {
    float r = clamp(rgb.r * pc.wbRed, 0.0, 1.0);
    float g = clamp(rgb.g * pc.wbGreen, 0.0, 1.0);
    float b = clamp(rgb.b * pc.wbBlue, 0.0, 1.0);

    float saturationControl = clamp(pc.saturationControl, -1.0, 1.0);
    float contrastControl = clamp(pc.contrastControl, -1.0, 1.0);
    float vibranceControl = clamp(pc.vibranceControl, -1.0, 1.0);
    if (abs(saturationControl) < 1.0e-4 &&
        abs(contrastControl) < 1.0e-4 &&
        abs(vibranceControl) < 1.0e-4) {
        return vec3(r, g, b);
    }

    float y = max(0.0, 0.2126 * r + 0.7152 * g + 0.0722 * b);
    if (abs(contrastControl) >= 1.0e-4) {
        float mappedY = contrastCurve(y, contrastControl);
        float scale = y > 1.0e-6 ? mappedY / y : 1.0;
        r *= scale;
        g *= scale;
        b *= scale;
        y = mappedY;
    }
    if (abs(saturationControl) >= 1.0e-4) {
        float saturationFactor = exp2(saturationControl * 0.85);
        r = y + (r - y) * saturationFactor;
        g = y + (g - y) * saturationFactor;
        b = y + (b - y) * saturationFactor;
    }
    if (abs(vibranceControl) >= 1.0e-4) {
        float maximum = max(r, max(g, b));
        float minimum = min(r, min(g, b));
        float currentSaturation = (maximum - minimum) / max(1.0e-4, maximum);
        float protection = clamp(1.0 - currentSaturation, 0.0, 1.0);
        float authority = vibranceControl >= 0.0
            ? vibranceControl * (0.20 + 0.80 * protection)
            : vibranceControl * (0.55 + 0.45 * protection);
        float vibranceFactor = exp2(authority * 0.90);
        r = y + (r - y) * vibranceFactor;
        g = y + (g - y) * vibranceFactor;
        b = y + (b - y) * vibranceFactor;
    }
    return clamp(vec3(r, g, b), vec3(0.0), vec3(1.0));
}

vec2 sourceUvForOutput(uint outputX, uint outputY) {
    uvec2 source = sourceCoordinate(outputX, outputY);
    return (vec2(source) + vec2(0.5)) / vec2(pc.inputWidth, pc.inputHeight);
}

vec2 portraitUprightUv(vec2 sourceUv) {
    uint rotation = pc.portraitMaskRotationDegrees % 360u;
    if (rotation == 90u) return vec2(1.0 - sourceUv.y, sourceUv.x);
    if (rotation == 180u) return vec2(1.0 - sourceUv.x, 1.0 - sourceUv.y);
    if (rotation == 270u) return vec2(sourceUv.y, 1.0 - sourceUv.x);
    return sourceUv;
}

float portraitMaskRawAtSourceUv(vec2 sourceUv) {
    if (pc.portraitEnabled == 0u || pc.portraitMaskWidth < 2u || pc.portraitMaskHeight < 2u) return 0.0;
    vec2 uv = portraitUprightUv(clamp(sourceUv, vec2(0.0), vec2(1.0)));
    vec2 lo = vec2(pc.portraitTargetLeft, pc.portraitTargetTop);
    vec2 hi = vec2(pc.portraitTargetRight, pc.portraitTargetBottom);
    vec2 span = max(hi - lo, vec2(1.0e-6));
    vec2 local = (uv - lo) / span;
    if (local.x < 0.0 || local.x > 1.0 || local.y < 0.0 || local.y > 1.0) return 0.0;
    vec2 p = clamp(local, vec2(0.0), vec2(1.0)) *
            vec2(float(pc.portraitMaskWidth - 1u), float(pc.portraitMaskHeight - 1u));
    uvec2 p0 = uvec2(floor(p));
    uvec2 p1 = min(p0 + uvec2(1u), uvec2(pc.portraitMaskWidth - 1u, pc.portraitMaskHeight - 1u));
    vec2 f = fract(p);
    float m00 = portraitMask.values[p0.y * pc.portraitMaskWidth + p0.x];
    float m10 = portraitMask.values[p0.y * pc.portraitMaskWidth + p1.x];
    float m01 = portraitMask.values[p1.y * pc.portraitMaskWidth + p0.x];
    float m11 = portraitMask.values[p1.y * pc.portraitMaskWidth + p1.x];
    return clamp(mix(mix(m00, m10, f.x), mix(m01, m11, f.x), f.y), 0.0, 1.0);
}

float portraitAlphaAtOutput(uint outputX, uint outputY) {
    if (pc.portraitEnabled == 0u) return 0.0;
    vec2 sourceUv = sourceUvForOutput(outputX, outputY);
    vec2 dx = vec2(1.25 / float(pc.inputWidth), 0.0);
    vec2 dy = vec2(0.0, 1.25 / float(pc.inputHeight));
    float c = portraitMaskRawAtSourceUv(sourceUv);
    float refined = (2.0 * c +
            portraitMaskRawAtSourceUv(sourceUv + dx) + portraitMaskRawAtSourceUv(sourceUv - dx) +
            portraitMaskRawAtSourceUv(sourceUv + dy) + portraitMaskRawAtSourceUv(sourceUv - dy)) / 6.0;
    return clamp(max(smoothstep(0.16, 0.70, refined), smoothstep(0.52, 0.90, c)), 0.0, 1.0);
}

float portraitDistanceAtOutput(uint outputX, uint outputY) {
    vec2 uv = portraitUprightUv(sourceUvForOutput(outputX, outputY));
    vec2 lo = vec2(pc.portraitTargetLeft, pc.portraitTargetTop);
    vec2 hi = vec2(pc.portraitTargetRight, pc.portraitTargetBottom);
    vec2 d = max(max(lo - uv, uv - hi), vec2(0.0));
    return length(d);
}

const vec2 kPortraitPoisson[12] = vec2[12](
    vec2(-0.326, -0.406), vec2(-0.840, -0.074), vec2(-0.696, 0.457),
    vec2(-0.203, 0.621), vec2(0.962, -0.195), vec2(0.473, -0.480),
    vec2(0.519, 0.767), vec2(0.185, -0.893), vec2(0.507, 0.064),
    vec2(0.896, 0.412), vec2(-0.322, -0.933), vec2(-0.792, -0.598)
);

float inputYAtOutput(int outputX, int outputY) {
    uint x = uint(clamp(outputX, 0, int(pc.outputWidth) - 1));
    uint y = uint(clamp(outputY, 0, int(pc.outputHeight) - 1));
    uvec2 source = sourceCoordinate(x, y);
    uint yIndex = source.y * pc.inputWidth + source.x;
    return float(readByte(yIndex)) / 255.0;
}

float yuvTelemetryFloat(uint word) {
    return float(ultraHdrTelemetry.values[word]) / kYuvQ24;
}

uint yuvQ24(float value) {
    return uint(clamp(roundEven(clamp(value, 0.0, 1.0) * kYuvQ24), 0.0, kYuvQ24));
}

float yuvMeasuredSigmaY() {
    return clamp(yuvTelemetryFloat(kYuvSigmaYWord), 0.0, 0.08);
}

vec2 yuvMeasuredSigmaUv() {
    return clamp(vec2(
        yuvTelemetryFloat(kYuvSigmaUWord),
        yuvTelemetryFloat(kYuvSigmaVWord)), vec2(0.0), vec2(0.08));
}

float yuvMeasuredLumaAuthority() {
    return clamp(yuvTelemetryFloat(kYuvLumaAuthorityWord), 0.0, 0.75);
}

float yuvMeasuredChromaAuthority() {
    return clamp(yuvTelemetryFloat(kYuvChromaAuthorityWord), 0.0, 0.85);
}

float yuvResidualPreserve(float residualSnr, float protection, bool chroma) {
    float p = clamp(protection, 0.0, 1.0);
    float low = chroma ? mix(1.55, 0.95, p) : mix(1.25, 0.75, p);
    float high = chroma ? mix(3.80, 2.60, p) : mix(3.20, 2.00, p);
    return smoothstep(low, high, max(0.0, residualSnr));
}

float denoisedInputYAtOutput(int outputX, int outputY) {
    float center = inputYAtOutput(outputX, outputY);
    float authority = yuvMeasuredLumaAuthority();
    if (authority <= 1.0e-6) return center;

    float n = inputYAtOutput(outputX, outputY - 1);
    float s = inputYAtOutput(outputX, outputY + 1);
    float w = inputYAtOutput(outputX - 1, outputY);
    float e = inputYAtOutput(outputX + 1, outputY);

    float sigmaY = max(yuvMeasuredSigmaY(), 1.0 / 255.0);
    float protection = max(clamp(pc.profileNrLumaProtection, 0.0, 1.0), 0.65);
    float guideScale = sigmaY * mix(3.10, 1.85, protection) + 1.0 / 255.0;
    float wn = exp(-0.5 * pow((n - center) / guideScale, 2.0));
    float ws = exp(-0.5 * pow((s - center) / guideScale, 2.0));
    float ww = exp(-0.5 * pow((w - center) / guideScale, 2.0));
    float we = exp(-0.5 * pow((e - center) / guideScale, 2.0));
    float weightSum = wn + ws + ww + we;
    if (weightSum <= 1.0e-5) return center;

    float predictor = (wn * n + ws * s + ww * w + we * e) / weightSum;
    float residual = center - predictor;
    float residualSnr = abs(residual) / max(1.15 * sigmaY, 1.0 / 255.0);
    float preserve = yuvResidualPreserve(residualSnr, protection, false);
    float correction = residual * authority * (1.0 - preserve);
    float correctionCap = sigmaY * mix(2.10, 1.45, protection);
    return clamp(center - clamp(correction, -correctionCap, correctionCap), 0.0, 1.0);
}

float toneMappedYAtOutput(int outputX, int outputY) {
    uint index = uint(clamp(roundEven(denoisedInputYAtOutput(outputX, outputY) * 255.0), 0.0, 255.0));
    return float(toneLut.values[index] & 0xffu) / 255.0;
}

vec2 inputUvAtOutput(int outputX, int outputY) {
    uint x = uint(clamp(outputX, 0, int(pc.outputWidth) - 1));
    uint y = uint(clamp(outputY, 0, int(pc.outputHeight) - 1));
    uvec2 source = sourceCoordinate(x, y);
    uint chromaBase = pc.inputWidth * pc.inputHeight;
    uint chromaIndex = chromaBase + (source.y >> 1u) * pc.inputWidth + (source.x >> 1u) * 2u;
    float v = float(readByte(chromaIndex)) / 255.0;
    float u = float(readByte(chromaIndex + 1u)) / 255.0;
    return vec2(u, v);
}

vec2 denoisedUvAtOutput(uint outputX, uint outputY) {
    vec2 center = inputUvAtOutput(int(outputX), int(outputY));
    float authority = yuvMeasuredChromaAuthority();
    if (authority <= 1.0e-6) return center;

    vec2 n = inputUvAtOutput(int(outputX), int(outputY) - 2);
    vec2 s = inputUvAtOutput(int(outputX), int(outputY) + 2);
    vec2 w = inputUvAtOutput(int(outputX) - 2, int(outputY));
    vec2 e = inputUvAtOutput(int(outputX) + 2, int(outputY));
    float yCenter = inputYAtOutput(int(outputX), int(outputY));
    float yn = inputYAtOutput(int(outputX), int(outputY) - 2);
    float ys = inputYAtOutput(int(outputX), int(outputY) + 2);
    float yw = inputYAtOutput(int(outputX) - 2, int(outputY));
    float ye = inputYAtOutput(int(outputX) + 2, int(outputY));

    float sigmaY = max(yuvMeasuredSigmaY(), 1.0 / 255.0);
    vec2 sigmaUv = max(yuvMeasuredSigmaUv(), vec2(0.65 / 255.0));
    float protection = max(clamp(pc.profileNrChromaProtection, 0.0, 1.0), 0.55);
    float guideScale = sigmaY * mix(4.00, 2.15, protection) + 2.0 / 255.0;
    float wn = exp(-0.5 * pow((yn - yCenter) / guideScale, 2.0));
    float ws = exp(-0.5 * pow((ys - yCenter) / guideScale, 2.0));
    float ww = exp(-0.5 * pow((yw - yCenter) / guideScale, 2.0));
    float we = exp(-0.5 * pow((ye - yCenter) / guideScale, 2.0));
    float weightSum = wn + ws + ww + we;
    if (weightSum <= 1.0e-5) return center;

    vec2 predictor = (wn * n + ws * s + ww * w + we * e) / weightSum;
    vec2 residual = center - predictor;
    vec2 residualSigma = 1.25 * sigmaUv;
    float q = sqrt(
        pow(residual.x / max(residualSigma.x, 1.0 / 255.0), 2.0) +
        pow(residual.y / max(residualSigma.y, 1.0 / 255.0), 2.0));
    float preserve = yuvResidualPreserve(q, protection, true);

    // Near-black authority is SNR-based rather than an absolute black threshold. A dark
    // but coherent colour remains untouched when its UV residual is statistically real.
    float lumaSnr = max(0.0, yCenter) / sigmaY;
    float nearBlack = 1.0 - smoothstep(4.0, 12.0, lumaSnr);
    float localAuthority = clamp(authority * (1.0 + 0.25 * nearBlack), 0.0, 0.90);
    vec2 cap = sigmaUv * mix(vec2(3.20), vec2(2.35), vec2(protection));
    vec2 correction = residual * localAuthority * (1.0 - preserve);
    correction = clamp(correction, -cap, cap);
    return clamp(center - correction, vec2(0.0), vec2(1.0));
}

float yuvLaplacianY(int x, int y) {
    float tl = inputYAtOutput(x - 1, y - 1);
    float t  = inputYAtOutput(x,     y - 1);
    float tr = inputYAtOutput(x + 1, y - 1);
    float l  = inputYAtOutput(x - 1, y);
    float c  = inputYAtOutput(x,     y);
    float r  = inputYAtOutput(x + 1, y);
    float bl = inputYAtOutput(x - 1, y + 1);
    float b  = inputYAtOutput(x,     y + 1);
    float br = inputYAtOutput(x + 1, y + 1);
    return abs(tl - 2.0 * t + tr - 2.0 * l + 4.0 * c - 2.0 * r + bl - 2.0 * b + br);
}

float yuvLocalRangeY(int x, int y) {
    float mn = 1.0;
    float mx = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            float value = inputYAtOutput(x + dx, y + dy);
            mn = min(mn, value);
            mx = max(mx, value);
        }
    }
    return mx - mn;
}

vec2 yuvLaplacianUv(int x, int y) {
    vec2 tl = inputUvAtOutput(x - 2, y - 2);
    vec2 t  = inputUvAtOutput(x,     y - 2);
    vec2 tr = inputUvAtOutput(x + 2, y - 2);
    vec2 l  = inputUvAtOutput(x - 2, y);
    vec2 c  = inputUvAtOutput(x,     y);
    vec2 r  = inputUvAtOutput(x + 2, y);
    vec2 bl = inputUvAtOutput(x - 2, y + 2);
    vec2 b  = inputUvAtOutput(x,     y + 2);
    vec2 br = inputUvAtOutput(x + 2, y + 2);
    return abs(tl - 2.0 * t + tr - 2.0 * l + 4.0 * c - 2.0 * r + bl - 2.0 * b + br);
}

uint yuvHistogramBin(float normalizedLaplacian) {
    float codeValue = clamp(normalizedLaplacian * 255.0, 0.0, 255.0);
    return min(uint(floor(codeValue + 0.5)), kYuvHistBins - 1u);
}

void accumulateYuvResidualSample(uint pixelIndex) {
    uint x = pixelIndex % pc.outputWidth;
    uint y = pixelIndex / pc.outputWidth;
    if ((x & 15u) != 8u || (y & 15u) != 8u) return;
    if (x < 2u || y < 2u || x + 2u >= pc.outputWidth || y + 2u >= pc.outputHeight) return;

    float flatRange = yuvLocalRangeY(int(x), int(y));
    if (flatRange <= 32.0 / 255.0) {
        atomicAdd(ultraHdrTelemetry.values[kYuvHistYBase + yuvHistogramBin(yuvLaplacianY(int(x), int(y)))], 1u);
        atomicAdd(ultraHdrTelemetry.values[kYuvLumaSamplesWord], 1u);
    }

    float yc = inputYAtOutput(int(x), int(y));
    float guideRange = max(max(
        abs(yc - inputYAtOutput(int(x) - 2, int(y))),
        abs(yc - inputYAtOutput(int(x) + 2, int(y)))), max(
        abs(yc - inputYAtOutput(int(x), int(y) - 2)),
        abs(yc - inputYAtOutput(int(x), int(y) + 2))));
    if (guideRange <= 32.0 / 255.0) {
        vec2 lapUv = yuvLaplacianUv(int(x), int(y));
        atomicAdd(ultraHdrTelemetry.values[kYuvHistUBase + yuvHistogramBin(lapUv.x)], 1u);
        atomicAdd(ultraHdrTelemetry.values[kYuvHistVBase + yuvHistogramBin(lapUv.y)], 1u);
        atomicAdd(ultraHdrTelemetry.values[kYuvChromaSamplesWord], 1u);
    }
}

float yuvHistogramP35CodeValue(uint base, uint count) {
    if (count == 0u) return 0.0;
    uint target = max(1u, (count * 35u + 99u) / 100u);
    uint cumulative = 0u;
    for (uint i = 0u; i < kYuvHistBins; ++i) {
        cumulative += ultraHdrTelemetry.values[base + i];
        if (cumulative >= target) return float(i);
    }
    return float(kYuvHistBins - 1u);
}

void finalizeYuvResidualModel() {
    uint yCount = ultraHdrTelemetry.values[kYuvLumaSamplesWord];
    uint cCount = ultraHdrTelemetry.values[kYuvChromaSamplesWord];
    float yConfidence = smoothstep(24.0, 256.0, float(yCount));
    float cConfidence = smoothstep(16.0, 128.0, float(cCount));
    float confidence = min(yConfidence, cConfidence);

    float sigmaY = yuvHistogramP35CodeValue(kYuvHistYBase, yCount) /
            (kAbsLaplacianP35ToSigma * 255.0);
    float sigmaU = yuvHistogramP35CodeValue(kYuvHistUBase, cCount) /
            (kAbsLaplacianP35ToSigma * 255.0);
    float sigmaV = yuvHistogramP35CodeValue(kYuvHistVBase, cCount) /
            (kAbsLaplacianP35ToSigma * 255.0);
    sigmaY = clamp(sigmaY, 0.0, 0.08);
    sigmaU = clamp(sigmaU, 0.0, 0.08);
    sigmaV = clamp(sigmaV, 0.0, 0.08);

    float lumaPressure = smoothstep(0.70, 4.00, sigmaY * 255.0);
    float sigmaC = sqrt(max(0.0, 0.5 * (sigmaU * sigmaU + sigmaV * sigmaV)));
    float chromaPressure = smoothstep(0.50, 4.00, sigmaC * 255.0);
    float measuredLuma = clamp(0.38 * lumaPressure * confidence, 0.0, 0.38);
    float measuredChroma = clamp(0.70 * chromaPressure * confidence, 0.0, 0.70);

    // Request fields now contain creative profile authority only. The physical baseline is
    // entirely residual-measured here, so capture ISO cannot double-denoise a vendor-clean YUV.
    float lumaAuthority = clamp(max(measuredLuma, pc.profileNrLumaBlend), 0.0, 0.75);
    float chromaAuthority = clamp(max(measuredChroma, pc.profileNrChromaBlend), 0.0, 0.85);

    ultraHdrTelemetry.values[kYuvSigmaYWord] = yuvQ24(sigmaY);
    ultraHdrTelemetry.values[kYuvSigmaUWord] = yuvQ24(sigmaU);
    ultraHdrTelemetry.values[kYuvSigmaVWord] = yuvQ24(sigmaV);
    ultraHdrTelemetry.values[kYuvLumaAuthorityWord] = yuvQ24(lumaAuthority);
    ultraHdrTelemetry.values[kYuvChromaAuthorityWord] = yuvQ24(chromaAuthority);
    ultraHdrTelemetry.values[kYuvConfidenceWord] = yuvQ24(confidence);
}

// Lightweight neutral YUV luma sample used only for standalone Edge qualification.
// It deliberately avoids recursive denoise/tone calls for neighbouring edge samples.
float edgeNeutralYAtOutput(int outputX, int outputY) {
    uint index = uint(clamp(roundEven(inputYAtOutput(outputX, outputY) * 255.0), 0.0, 255.0));
    return float(toneLut.values[index] & 0xffu) / 255.0;
}

float profileEdgeYAtOutput(uint outputX, uint outputY) {
    float authority = clamp(pc.profileDetailMasking, -1.0, 1.0);
    float base = toneMappedYAtOutput(int(outputX), int(outputY));
    if (abs(authority) <= 1.0e-6) return base;

    int x = int(outputX);
    int y = int(outputY);
    float c = edgeNeutralYAtOutput(x, y);
    float n = edgeNeutralYAtOutput(x, y - 1);
    float s = edgeNeutralYAtOutput(x, y + 1);
    float w = edgeNeutralYAtOutput(x - 1, y);
    float e = edgeNeutralYAtOutput(x + 1, y);
    float nw = edgeNeutralYAtOutput(x - 1, y - 1);
    float ne = edgeNeutralYAtOutput(x + 1, y - 1);
    float sw = edgeNeutralYAtOutput(x - 1, y + 1);
    float se = edgeNeutralYAtOutput(x + 1, y + 1);
    float n2 = edgeNeutralYAtOutput(x, y - 2);
    float s2 = edgeNeutralYAtOutput(x, y + 2);
    float w2 = edgeNeutralYAtOutput(x - 2, y);
    float e2 = edgeNeutralYAtOutput(x + 2, y);
    float n4 = edgeNeutralYAtOutput(x, y - 4);
    float s4 = edgeNeutralYAtOutput(x, y + 4);
    float w4 = edgeNeutralYAtOutput(x - 4, y);
    float e4 = edgeNeutralYAtOutput(x + 4, y);

    float gx = 0.125 * ((ne + 2.0 * e + se) - (nw + 2.0 * w + sw));
    float gy = 0.125 * ((sw + 2.0 * s + se) - (nw + 2.0 * n + ne));
    float gradient = sqrt(max(0.0, gx * gx + gy * gy));
    float gx2 = 0.25 * (e2 - w2);
    float gy2 = 0.25 * (s2 - n2);
    float coarseGradient = sqrt(max(0.0, gx2 * gx2 + gy2 * gy2));
    float gx4 = 0.125 * (e4 - w4);
    float gy4 = 0.125 * (s4 - n4);
    float broadGradient = sqrt(max(0.0, gx4 * gx4 + gy4 * gy4));
    float gradientAlignment = clamp((gx * gx2 + gy * gy2) /
            max(gradient * coarseGradient, 1.0e-8), -1.0, 1.0);
    float broadAlignment = clamp((gx * gx4 + gy * gy4) /
            max(gradient * broadGradient, 1.0e-8), -1.0, 1.0);
    float scalePersistence = coarseGradient / max(gradient, 1.0e-6);
    float broadPersistence = broadGradient / max(gradient, 1.0e-6);

    float gxA = 0.5 * (e - w);
    float gyA = 0.5 * (s - n);
    float gxB = 0.5 * (ne - nw);
    float gyB = 0.5 * (se - ne);
    float gxC = 0.5 * (se - sw);
    float gyC = 0.5 * (sw - nw);
    float jxx = gxA * gxA + 0.50 * (gxB * gxB + gxC * gxC);
    float jyy = gyA * gyA + 0.50 * (gyB * gyB + gyC * gyC);
    float jxy = gxA * gyA + 0.50 * (gxB * gyB + gxC * gyC);
    float energy = jxx + jyy;
    float coherence = sqrt(max(0.0, (jxx - jyy) * (jxx - jyy) + 4.0 * jxy * jxy)) /
            max(energy, 1.0e-8);

    float sigma = max(yuvMeasuredSigmaY(), 1.0 / 255.0);
    float fineGradientGate = smoothstep(max(0.012, 1.90 * sigma),
                                        max(0.045, 5.80 * sigma), gradient);
    float coarseGradientGate = smoothstep(max(0.008, 1.35 * sigma),
                                          max(0.030, 4.20 * sigma), coarseGradient);
    float broadGradientGate = smoothstep(max(0.004, 1.00 * sigma),
                                         max(0.016, 2.80 * sigma), broadGradient);
    float coherenceGate = smoothstep(0.58, 0.90, coherence);
    float alignmentGate = smoothstep(0.62, 0.94, gradientAlignment);
    float broadAlignmentGate = smoothstep(0.55, 0.90, broadAlignment);
    float persistenceGate = smoothstep(0.20, 0.48, scalePersistence);
    float broadPersistenceGate = smoothstep(0.08, 0.22, broadPersistence);

    // Resolve opposite sides of the edge normal and estimate their plateaus. Negative Edge
    // increases the effective radius by trusting farther samples; positive Edge tightens it.
    float ax = abs(gx);
    float ay = abs(gy);
    float diagonalRatio = min(ax, ay) / max(max(ax, ay), 1.0e-6);
    float minus1;
    float plus1;
    float minus2;
    float plus2;
    float minus4;
    float plus4;
    if (diagonalRatio > 0.58) {
        if (gx * gy >= 0.0) {
            if (gx >= 0.0) {
                minus1 = nw; plus1 = se;
                minus2 = 0.5 * (w2 + n2); plus2 = 0.5 * (e2 + s2);
                minus4 = 0.5 * (w4 + n4); plus4 = 0.5 * (e4 + s4);
            } else {
                minus1 = se; plus1 = nw;
                minus2 = 0.5 * (e2 + s2); plus2 = 0.5 * (w2 + n2);
                minus4 = 0.5 * (e4 + s4); plus4 = 0.5 * (w4 + n4);
            }
        } else {
            if (gx >= 0.0) {
                minus1 = sw; plus1 = ne;
                minus2 = 0.5 * (w2 + s2); plus2 = 0.5 * (e2 + n2);
                minus4 = 0.5 * (w4 + s4); plus4 = 0.5 * (e4 + n4);
            } else {
                minus1 = ne; plus1 = sw;
                minus2 = 0.5 * (e2 + n2); plus2 = 0.5 * (w2 + s2);
                minus4 = 0.5 * (e4 + n4); plus4 = 0.5 * (w4 + s4);
            }
        }
    } else if (ax >= ay) {
        if (gx >= 0.0) {
            minus1 = w; plus1 = e; minus2 = w2; plus2 = e2; minus4 = w4; plus4 = e4;
        } else {
            minus1 = e; plus1 = w; minus2 = e2; plus2 = w2; minus4 = e4; plus4 = w4;
        }
    } else {
        if (gy >= 0.0) {
            minus1 = n; plus1 = s; minus2 = n2; plus2 = s2; minus4 = n4; plus4 = s4;
        } else {
            minus1 = s; plus1 = n; minus2 = s2; plus2 = n2; minus4 = s4; plus4 = n4;
        }
    }

    float radiusAuthority = pow(abs(authority), 0.78);
    float farWeight = authority < 0.0
            ? mix(0.38, 0.62, radiusAuthority)
            : mix(0.38, 0.28, radiusAuthority);
    float nearWeight = authority < 0.0
            ? mix(0.22, 0.12, radiusAuthority)
            : mix(0.22, 0.30, radiusAuthority);
    float midWeight = 1.0 - nearWeight - farWeight;
    float plateauMinus = nearWeight * minus1 + midWeight * minus2 + farWeight * minus4;
    float plateauPlus = nearWeight * plus1 + midWeight * plus2 + farWeight * plus4;
    float lowPlateau = min(plateauMinus, plateauPlus);
    float highPlateau = max(plateauMinus, plateauPlus);
    float stepHeight = highPlateau - lowPlateau;
    float stepGate = smoothstep(max(0.014, 2.10 * sigma),
                                max(0.060, 7.00 * sigma), stepHeight);
    if (stepHeight <= 1.0e-6) return base;

    float t = clamp((c - lowPlateau) / stepHeight, 0.0, 1.0);
    float interior = min(t, 1.0 - t);
    float transitionGate = smoothstep(0.015, 0.115, interior);
    float profile = 2.0 * t - 1.0;
    float gamma = authority < 0.0
            ? mix(1.0, 3.15, radiusAuthority)
            : mix(1.0, 0.34, radiusAuthority);
    float remappedProfile = sign(profile) * pow(abs(profile), gamma);
    float targetT = 0.5 + 0.5 * remappedProfile;
    float targetY = mix(lowPlateau, highPlateau, targetT);
    float structuralGate = fineGradientGate * coarseGradientGate * broadGradientGate *
            coherenceGate * alignmentGate * broadAlignmentGate * persistenceGate *
            broadPersistenceGate * stepGate * transitionGate;
    float edgeDelta = (targetY - c) * structuralGate;
    // Edge changes transition width only; no overshoot/halo is allowed on either sign.
    return clamp(base + edgeDelta, lowPlateau, highPlateau);
}


// Phase 3 standalone signed Detail. YUV uses a compact 3x3 microtexture classifier so the
// stage remains lightweight enough for vendor Vulkan drivers. It explicitly prefers
// high-curvature / low-step-persistence structure and rejects coherent step edges.
float profileMicroDetailYAtOutput(uint outputX, uint outputY) {
    // Compatibility transport: exact 0 is neutral; [-1,-0.5) encodes negative Detail and
    // [-0.5,0) encodes positive Detail without reactivating retired unsigned consumers.
    float detailTransport = clamp(pc.profileDetailDetail, -1.0, 0.0);
    float authority = 0.0;
    if (abs(detailTransport) > 1.0e-7) {
        authority = detailTransport < -0.5
                ? clamp(2.0 * (detailTransport + 0.5), -1.0, 0.0)
                : clamp(-2.0 * detailTransport, 0.0, 1.0);
    }

    // Strict stage order remains Edge -> Detail -> Global Sharpness.
    float edgeY = profileEdgeYAtOutput(outputX, outputY);
    if (abs(authority) <= 1.0e-6) return edgeY;

    int x = int(outputX);
    int y = int(outputY);
    float c  = edgeNeutralYAtOutput(x, y);
    float n  = edgeNeutralYAtOutput(x, y - 1);
    float s  = edgeNeutralYAtOutput(x, y + 1);
    float w  = edgeNeutralYAtOutput(x - 1, y);
    float e  = edgeNeutralYAtOutput(x + 1, y);
    float nw = edgeNeutralYAtOutput(x - 1, y - 1);
    float ne = edgeNeutralYAtOutput(x + 1, y - 1);
    float sw = edgeNeutralYAtOutput(x - 1, y + 1);
    float se = edgeNeutralYAtOutput(x + 1, y + 1);

    // 3x3 Gaussian residual: compact fine-structure evidence in the neutral YUV domain.
    // The residual is transferred onto edgeY rather than rebuilding tone/denoise neighbours.
    float crossMean = 0.25 * (n + s + w + e);
    float diagMean = 0.25 * (nw + ne + sw + se);
    float gaussianMean = 0.25 * c + 0.50 * crossMean + 0.25 * diagMean;
    float microResidual = c - gaussianMean;

    // Sobel structure tensor. A real object edge has a coherent first derivative; microtexture
    // is selected primarily by curvature/residual energy rather than by directional gradient.
    float gx = 0.125 * ((ne + 2.0 * e + se) - (nw + 2.0 * w + sw));
    float gy = 0.125 * ((sw + 2.0 * s + se) - (nw + 2.0 * n + ne));
    float gradient = sqrt(max(0.0, gx * gx + gy * gy));

    float gxA = 0.5 * (e - w);
    float gyA = 0.5 * (s - n);
    float gxB = 0.5 * (ne - nw);
    float gyB = 0.5 * (se - ne);
    float gxC = 0.5 * (se - sw);
    float gyC = 0.5 * (sw - nw);
    float jxx = gxA * gxA + 0.50 * (gxB * gxB + gxC * gxC);
    float jyy = gyA * gyA + 0.50 * (gyB * gyB + gyC * gyC);
    float jxy = gxA * gyA + 0.50 * (gxB * gyB + gxC * gyC);
    float energy = jxx + jyy;
    float coherence = sqrt(max(0.0, (jxx - jyy) * (jxx - jyy) + 4.0 * jxy * jxy)) /
            max(energy, 1.0e-8);

    float localMin = min(c, min(min(min(n, s), min(w, e)), min(min(nw, ne), min(sw, se))));
    float localMax = max(c, max(max(max(n, s), max(w, e)), max(max(nw, ne), max(sw, se))));
    float localRange = max(0.0, localMax - localMin);
    float sigma = max(yuvMeasuredSigmaY(), 1.0 / 255.0);
    float residualSnr = abs(microResidual) / sigma;
    float gradientSnr = gradient / sigma;

    float residualGate = smoothstep(1.45, 3.40, residualSnr);
    float rangeGate = smoothstep(3.2, 8.0, localRange / sigma);

    // Step-edge rejection: coherent directional energy with a first derivative much stronger
    // than local curvature is a contour, not microtexture. Fine lines/hair retain strong
    // curvature and therefore do not get rejected merely for being directional.
    float firstToSecond = gradient / max(abs(microResidual), 1.25 * sigma);
    float coherentStep = smoothstep(0.50, 0.82, coherence) *
            smoothstep(1.3, 4.0, gradientSnr) *
            smoothstep(0.85, 2.10, firstToSecond);
    float textureGate = residualGate * rangeGate * (1.0 - clamp(coherentStep, 0.0, 1.0));
    float strength = pow(abs(authority), 0.78);

    if (authority < 0.0) {
        // Reduce only the qualified fine residual; do not broaden structural contours.
        float targetY = edgeY - microResidual;
        return mix(edgeY, targetY, 0.90 * strength * textureGate);
    }

    // Reject period-2/checker-like oscillation on the positive side. This protects demosaic/YUV
    // artifacts and sensor grain from being promoted as texture while leaving irregular detail.
    float crossOscillation = abs(c - crossMean);
    float checkerContrast = abs(diagMean - crossMean);
    float lowFirstDerivative = 1.0 - smoothstep(max(0.006, 1.5 * sigma),
                                               max(0.030, 5.0 * sigma), gradient);
    float diagonalEchoRatio = abs(c - diagMean) / max(crossOscillation, 1.25 * sigma);
    float diagonalEcho = 1.0 - smoothstep(0.12, 0.42, diagonalEchoRatio);
    float checkerEvidence = smoothstep(max(0.006, 1.4 * sigma),
                                       max(0.028, 4.5 * sigma), crossOscillation) *
            smoothstep(max(0.004, 1.0 * sigma),
                       max(0.022, 3.5 * sigma), checkerContrast) *
            diagonalEcho * lowFirstDerivative;
    float positiveTextureGate = textureGate * (1.0 - 0.92 * clamp(checkerEvidence, 0.0, 1.0));

    float positiveNoiseSafety = 1.0 - 0.72 * smoothstep(0.018, 0.055, sigma);
    float rawDelta = microResidual * (0.55 + 1.05 * authority) * strength *
            positiveNoiseSafety * positiveTextureGate;
    float cap = min(0.075, 0.008 + 0.24 * localRange);
    float delta = clamp(rawDelta, -cap, cap);
    return clamp(edgeY + delta, edgeY - localRange, edgeY + localRange);
}

float profileDetailedYAtOutput(uint outputX, uint outputY) {
    float amount = clamp(pc.profileDetailAmount, -1.0, 1.0);
    // Strict order: Edge -> Detail -> Global Sharpness.
    float center = profileMicroDetailYAtOutput(outputX, outputY);
    if (abs(amount) <= 1.0e-6) return center;

    int x = int(outputX);
    int y = int(outputY);
    float n = toneMappedYAtOutput(x, y - 1);
    float s = toneMappedYAtOutput(x, y + 1);
    float w = toneMappedYAtOutput(x - 1, y);
    float e = toneMappedYAtOutput(x + 1, y);
    float nw = toneMappedYAtOutput(x - 1, y - 1);
    float ne = toneMappedYAtOutput(x + 1, y - 1);
    float sw = toneMappedYAtOutput(x - 1, y + 1);
    float se = toneMappedYAtOutput(x + 1, y + 1);
    float w2 = toneMappedYAtOutput(x - 2, y);
    float e2 = toneMappedYAtOutput(x + 2, y);
    float n2 = toneMappedYAtOutput(x, y - 2);
    float s2 = toneMappedYAtOutput(x, y + 2);

    float crossMean = 0.25 * (n + s + w + e);
    float boxMean = 0.125 * (n + s + w + e + nw + ne + sw + se);
    float farCross = 0.25 * (n2 + s2 + w2 + e2);
    float localMin = min(center, min(min(min(n, s), min(w, e)), min(min(nw, ne), min(sw, se))));
    float localMax = max(center, max(max(max(n, s), max(w, e)), max(max(nw, ne), max(sw, se))));
    localMin = min(localMin, min(min(n2, s2), min(w2, e2)));
    localMax = max(localMax, max(max(n2, s2), max(w2, e2)));
    float localRange = max(0.0, localMax - localMin);

    if (amount < 0.0) {
        float softness = pow(clamp(-amount, 0.0, 1.0), 0.72);
        float edgeSigma = mix(0.040, 0.115, softness);
        float inv2EdgeSigmaSq = 1.0 / max(2.0 * edgeSigma * edgeSigma, 1.0e-6);
        float centerWeight = mix(2.40, 0.65, softness);
        float sum = center * centerWeight;
        float weightSum = centerWeight;

        float dv;
        float bw;
        dv = n - center; bw = 1.00 * exp(-dv * dv * inv2EdgeSigmaSq); sum += n * bw; weightSum += bw;
        dv = s - center; bw = 1.00 * exp(-dv * dv * inv2EdgeSigmaSq); sum += s * bw; weightSum += bw;
        dv = w - center; bw = 1.00 * exp(-dv * dv * inv2EdgeSigmaSq); sum += w * bw; weightSum += bw;
        dv = e - center; bw = 1.00 * exp(-dv * dv * inv2EdgeSigmaSq); sum += e * bw; weightSum += bw;
        dv = nw - center; bw = 0.72 * exp(-dv * dv * inv2EdgeSigmaSq); sum += nw * bw; weightSum += bw;
        dv = ne - center; bw = 0.72 * exp(-dv * dv * inv2EdgeSigmaSq); sum += ne * bw; weightSum += bw;
        dv = sw - center; bw = 0.72 * exp(-dv * dv * inv2EdgeSigmaSq); sum += sw * bw; weightSum += bw;
        dv = se - center; bw = 0.72 * exp(-dv * dv * inv2EdgeSigmaSq); sum += se * bw; weightSum += bw;
        dv = n2 - center; bw = 0.46 * exp(-dv * dv * inv2EdgeSigmaSq); sum += n2 * bw; weightSum += bw;
        dv = s2 - center; bw = 0.46 * exp(-dv * dv * inv2EdgeSigmaSq); sum += s2 * bw; weightSum += bw;
        dv = w2 - center; bw = 0.46 * exp(-dv * dv * inv2EdgeSigmaSq); sum += w2 * bw; weightSum += bw;
        dv = e2 - center; bw = 0.46 * exp(-dv * dv * inv2EdgeSigmaSq); sum += e2 * bw; weightSum += bw;

        float softY = sum / max(weightSum, 1.0e-6);
        float broadY = 0.46 * softY + 0.34 * boxMean + 0.20 * farCross;
        float softBlend = 0.94 * pow(softness, 0.78);
        return clamp(mix(center, broadY, softBlend), 0.0, 1.0);
    }

    float fineMean = 0.68 * crossMean + 0.32 * boxMean;
    float mediumMean = 0.58 * boxMean + 0.42 * farCross;
    float highPass = 0.74 * (center - fineMean) + 0.26 * (center - mediumMean);
    float gx = 0.5 * (e - w);
    float gy = 0.5 * (s - n);
    float gradient = sqrt(max(0.0, gx * gx + gy * gy));
    float sigmaY = clamp(max(yuvMeasuredSigmaY(), 1.0 / 255.0), 1.0 / 255.0, 0.025);
    float residualGate = smoothstep(0.80, 2.00, abs(highPass) / sigmaY);
    float edgeGate = smoothstep(0.70, 1.85, gradient / sigmaY);
    float rangeGate = smoothstep(0.004, 0.022, localRange);
    float structureGate = max(rangeGate * 0.55, max(residualGate, edgeGate));
    float sharpStrength = amount * (1.05 + 1.75 * amount);
    float rawDelta = highPass * sharpStrength * structureGate;
    float adaptiveHalo = min(0.14, 0.018 + 0.46 * localRange);
    float delta = clamp(rawDelta, -adaptiveHalo, adaptiveHalo);
    return clamp(center + delta, 0.0, 1.0);
}

vec3 renderRgbUnblurred(uint outputX, uint outputY) {
    uint yValue = uint(clamp(roundEven(profileDetailedYAtOutput(outputX, outputY) * 255.0), 0.0, 255.0));
    vec2 filteredUv = denoisedUvAtOutput(outputX, outputY);
    float y = float(yValue);
    float u = clamp(roundEven(filteredUv.x * 255.0), 0.0, 255.0) - 128.0;
    float v = clamp(roundEven(filteredUv.y * 255.0), 0.0, 255.0) - 128.0;
    // Android Camera2 default YUV contract: JFIF / Rec.601 full-range -> sRGB.
    // Do not apply studio/video-range Y-16 scaling to a default Camera2 YUV_420_888 frame.
    float r8 = clamp(y + 1.402000 * v, 0.0, 255.0);
    float g8 = clamp(y - 0.344136 * u - 0.714136 * v, 0.0, 255.0);
    float b8 = clamp(y + 1.772000 * u, 0.0, 255.0);
    return applyProfile(vec3(r8, g8, b8) / 255.0);
}

vec3 renderRgbPortrait(uint outputX, uint outputY) {
    vec3 original = renderRgbUnblurred(outputX, outputY);
    if (pc.portraitEnabled == 0u) return original;
    float alpha = portraitAlphaAtOutput(outputX, outputY);
    if (alpha >= 0.985) return original;
    float minDim = max(1.0, min(float(pc.outputWidth), float(pc.outputHeight)));
    float distanceGain = mix(0.58, 1.0, smoothstep(0.015, 0.22, portraitDistanceAtOutput(outputX, outputY)));
    float radius = clamp(minDim * 0.0125 * distanceGain, 3.0, 30.0);
    vec3 sum = original * (1.0 - alpha) * 0.7;
    float weightSum = (1.0 - alpha) * 0.7;
    for (int i = 0; i < 12; ++i) {
        int sx = clamp(int(outputX) + int(round(kPortraitPoisson[i].x * radius)), 0, int(pc.outputWidth) - 1);
        int sy = clamp(int(outputY) + int(round(kPortraitPoisson[i].y * radius)), 0, int(pc.outputHeight) - 1);
        float sampleAlpha = portraitAlphaAtOutput(uint(sx), uint(sy));
        float w = (1.0 - smoothstep(0.22, 0.68, sampleAlpha)) *
                (1.0 - 0.24 * length(kPortraitPoisson[i]));
        sum += renderRgbUnblurred(uint(sx), uint(sy)) * max(w, 0.0);
        weightSum += max(w, 0.0);
    }
    vec3 blurred = weightSum > 1.0e-5 ? sum / weightSum : original;
    return mix(blurred, original, alpha);
}

uvec3 renderBgr(uint outputPixelIndex) {
    uint outputX = outputPixelIndex % pc.outputWidth;
    uint outputY = outputPixelIndex / pc.outputWidth;
    vec3 rgb = renderRgbPortrait(outputX, outputY);
    return uvec3(
        uint(clamp(roundEven(rgb.b * 255.0), 0.0, 255.0)),
        uint(clamp(roundEven(rgb.g * 255.0), 0.0, 255.0)),
        uint(clamp(roundEven(rgb.r * 255.0), 0.0, 255.0))
    );
}

float hdrLumaUnblurred(uint outputX, uint outputY) {
    uvec2 source = sourceCoordinate(outputX, outputY);
    uint sourceIndex = source.y * pc.inputWidth + source.x;
    float weight = max(hdrWeights.values[sourceIndex], 1.0e-6);
    return max(0.0, hdrAccumulator.values[sourceIndex] / weight) / 255.0;
}

float hdrLumaAtOutput(uint outputX, uint outputY) {
    float original = hdrLumaUnblurred(outputX, outputY);
    if (pc.portraitEnabled == 0u) return original;
    float alpha = portraitAlphaAtOutput(outputX, outputY);
    if (alpha >= 0.985) return original;
    float minDim = max(1.0, min(float(pc.outputWidth), float(pc.outputHeight)));
    float distanceGain = mix(0.58, 1.0, smoothstep(0.015, 0.22, portraitDistanceAtOutput(outputX, outputY)));
    float radius = clamp(minDim * 0.0125 * distanceGain, 3.0, 30.0);
    float sum = original * (1.0 - alpha) * 0.7;
    float weightSum = (1.0 - alpha) * 0.7;
    for (int i = 0; i < 12; ++i) {
        int sx = clamp(int(outputX) + int(round(kPortraitPoisson[i].x * radius)), 0, int(pc.outputWidth) - 1);
        int sy = clamp(int(outputY) + int(round(kPortraitPoisson[i].y * radius)), 0, int(pc.outputHeight) - 1);
        float sampleAlpha = portraitAlphaAtOutput(uint(sx), uint(sy));
        float w = (1.0 - smoothstep(0.22, 0.68, sampleAlpha)) *
                (1.0 - 0.24 * length(kPortraitPoisson[i]));
        sum += hdrLumaUnblurred(uint(sx), uint(sy)) * max(w, 0.0);
        weightSum += max(w, 0.0);
    }
    float blurred = weightSum > 1.0e-5 ? sum / weightSum : original;
    return mix(blurred, original, alpha);
}

float sdrLumaAtOutput(uint outputX, uint outputY) {
    uint pixelIndex = outputY * pc.outputWidth + outputX;
    uvec3 bgr = renderBgr(pixelIndex);
    return (0.0722 * float(bgr.x) + 0.7152 * float(bgr.y) + 0.2126 * float(bgr.z)) / 255.0;
}

float gainLogForMapPixel(uint mapPixelIndex) {
    uint mapX = mapPixelIndex % pc.gainmapWidth;
    uint mapY = mapPixelIndex / pc.gainmapWidth;
    uint outputStartX = mapX * 4u;
    uint outputStartY = mapY * 4u;
    float hdrSum = 0.0;
    float sdrSum = 0.0;
    float samples = 0.0;
    for (uint dy = 0u; dy < 4u; ++dy) {
        uint y = outputStartY + dy;
        if (y >= pc.outputHeight) break;
        for (uint dx = 0u; dx < 4u; ++dx) {
            uint x = outputStartX + dx;
            if (x >= pc.outputWidth) break;
            hdrSum += hdrLumaAtOutput(x, y);
            sdrSum += sdrLumaAtOutput(x, y);
            samples += 1.0;
        }
    }
    if (samples <= 0.0) return 0.0;
    float hdrY = hdrSum / samples;
    float sdrY = sdrSum / samples;
    const float offset = 1.0 / 64.0;
    float ratio = clamp((hdrY + offset) / max(sdrY + offset, 1.0e-6), 1.0, 16.0);
    return log2(ratio);
}

void main() {
    uint blockIndex = gl_GlobalInvocationID.x;

    if (pc.ultraHdrMode == 2u) {
        uint firstPixel = blockIndex * 4u;
        for (uint lane = 0u; lane < 4u; ++lane) {
            uint pixelIndex = firstPixel + lane;
            if (pixelIndex >= pc.outputPixelCount) break;
            accumulateYuvResidualSample(pixelIndex);
        }
        return;
    }

    if (pc.ultraHdrMode == 3u) {
        if (blockIndex == 0u) finalizeYuvResidualModel();
        return;
    }

    if (pc.ultraHdrMode == 1u) {
        if (pc.gainmapWidth == 0u || pc.gainmapHeight == 0u) return;
        uint wordsPerRow = (pc.gainmapWidth + 3u) / 4u;
        uint totalWords = wordsPerRow * pc.gainmapHeight;
        if (blockIndex >= totalWords) return;
        uint row = blockIndex / wordsPerRow;
        uint wordInRow = blockIndex % wordsPerRow;
        float maxLog = float(ultraHdrTelemetry.values[0]) / 65536.0;
        uint packed = 0u;
        for (uint lane = 0u; lane < 4u; ++lane) {
            uint x = wordInRow * 4u + lane;
            uint value = 0u;
            if (x < pc.gainmapWidth) {
                uint mapPixel = row * pc.gainmapWidth + x;
                float normalized = maxLog > 1.0e-6
                        ? clamp(gainLog.values[mapPixel] / maxLog, 0.0, 1.0)
                        : 0.0;
                value = uint(clamp(roundEven(normalized * 255.0), 0.0, 255.0));
            }
            packed |= (value & 0xffu) << (lane * 8u);
        }
        gainmapBuffer.words[blockIndex] = packed;
        return;
    }

    uint firstPixel = blockIndex * 4u;
    if (firstPixel < pc.outputPixelCount) {
        uint bytes[12];
        for (uint i = 0u; i < 12u; ++i) bytes[i] = 0u;

        for (uint lane = 0u; lane < 4u; ++lane) {
            uint pixelIndex = firstPixel + lane;
            if (pixelIndex >= pc.outputPixelCount) break;
            uvec3 bgr = renderBgr(pixelIndex);
            uint base = lane * 3u;
            bytes[base + 0u] = bgr.x;
            bytes[base + 1u] = bgr.y;
            bytes[base + 2u] = bgr.z;
        }

        uint wordBase = blockIndex * 3u;
        outputBuffer.words[wordBase + 0u] = pack4(bytes[0], bytes[1], bytes[2], bytes[3]);
        outputBuffer.words[wordBase + 1u] = pack4(bytes[4], bytes[5], bytes[6], bytes[7]);
        outputBuffer.words[wordBase + 2u] = pack4(bytes[8], bytes[9], bytes[10], bytes[11]);
    }

    if (pc.gainmapPixelCount > 0u && blockIndex < pc.gainmapPixelCount) {
        float logGain = gainLogForMapPixel(blockIndex);
        gainLog.values[blockIndex] = logGain;
        uint fixedLog = uint(clamp(roundEven(logGain * 65536.0), 0.0, 4.0 * 65536.0));
        atomicMax(ultraHdrTelemetry.values[0], fixedLog);
    }
}
