void main(){uint og=gl_GlobalInvocationID.x;if(og>=(pc.outC+3u)/4u)return;uint inGroups=(pc.inC+3u)/4u;vec4 a=loadC4(bs.data,pc.biasC4Base+og);for(uint ig=0u;ig<inGroups;++ig){vec4 v=vec4(0);for(uint j=0u;j<4u;++j){uint c=ig*4u+j;if(c<pc.inC)v[j]=globalC.c[pc.globalFloatBase+c];}uint block=(og*inGroups+ig)*16u;for(uint o=0u;o<4u;++o){vec4 w=vec4(loadHalf(wt.data,pc.weightHalfBase+block+o*4u),loadHalf(wt.data,pc.weightHalfBase+block+o*4u+1u),loadHalf(wt.data,pc.weightHalfBase+block+o*4u+2u),loadHalf(wt.data,pc.weightHalfBase+block+o*4u+3u));a[o]+=dot(v,w);}}storeC4(outP.data,og,a);}
