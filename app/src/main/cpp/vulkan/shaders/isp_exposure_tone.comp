#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InputRgbBuffer {
    vec4 inputPixels[]; // Scene-linear float RGBA (headroom up to 2.0+)
};

layout(std430, set = 0, binding = 1) buffer OutputRgbBuffer {
    vec4 outputPixels[]; // Tone-mapped RGBA float
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float exposureGain; // e.g. 1.0 (0.0 to +3.0 EV)
    float gamma;        // e.g. 2.2 for sRGB transfer function
} pc;

// Troy Sobotka / Blender AgX Display Rendering Transform (DRT)
const mat3 AGX_INSET_MATRIX = mat3(
    0.842479062253094, 0.0423282422610123, 0.0423756549057051,
    0.0784335999999992, 0.878468636469772, 0.0784336,
    0.0792237451477643, 0.0791661274605434, 0.879142973793104
);

const mat3 AGX_OUTSET_MATRIX = mat3(
    1.19687902425898, -0.0528968517594562, -0.0529716355084938,
    -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
    -0.0990297440797205, -0.0989611768448433, 1.15107367264116
);

vec3 agxDefaultContrastApprox(vec3 x) {
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return + 15.5 * x4 * x2
           - 40.14 * x4 * x
           + 31.96 * x4
           - 6.868 * x2 * x
           + 0.4298 * x2
           + 0.1191 * x
           - 0.00232;
}

vec3 applyAgXTonemap(vec3 colorLinear) {
    const float min_ev = -12.47393;
    const float max_ev = +4.026069;

    // 1. Inset matrix: rotate linear sRGB into wide-gamut AgX working space
    vec3 val = AGX_INSET_MATRIX * max(colorLinear, vec3(1.0e-6));

    // 2. Log2 encoding over 16.5 EV dynamic range
    vec3 logVal = clamp(log2(val), min_ev, max_ev);
    val = (logVal - min_ev) / (max_ev - min_ev);

    // 3. Sigmoid contrast curve (polynomial approximation)
    val = clamp(agxDefaultContrastApprox(val), vec3(0.0), vec3(1.0));

    // 4. Outset matrix: convert back to linear display space
    val = AGX_OUTSET_MATRIX * val;
    // AgX's base sigmoid is a 2.2 display encoding. Convert it back to display-linear
    // before later display-linear profile/gamut work and before the final sRGB OETF.
    val = sign(val) * pow(abs(val), vec3(2.2));

    return val;
}

vec3 compressToUnitGamutPreserveLuma(vec3 rgb) {
    float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    if (!(y > 1.0e-8)) return vec3(0.0);
    if (y > 1.0) { rgb /= y; y = 1.0; }
    float mx = max(rgb.r, max(rgb.g, rgb.b));
    float mn = min(rgb.r, min(rgb.g, rgb.b));
    if (mx <= 1.0 && mn >= 0.0) return rgb;
    float authority = 1.0;
    if (mx > y + 1.0e-6) authority = min(authority, (1.0 - y) / (mx - y));
    if (mn < y - 1.0e-6) authority = min(authority, y / (y - mn));
    return clamp(vec3(y) + (rgb - vec3(y)) * clamp(authority, 0.0, 1.0), vec3(0.0), vec3(1.0));
}

float linearToSrgb(float c) {
    if (c <= 0.0031308) {
        return c * 12.92;
    } else {
        return 1.055 * pow(c, 1.0 / pc.gamma) - 0.055;
    }
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) return;

    uint pixelIdx = y * pc.width + x;
    vec3 linearRgb = inputPixels[pixelIdx].rgb * pc.exposureGain;

    // Apply AgX Display Rendering Transform in scene-linear domain
    vec3 toneMappedLinear = compressToUnitGamutPreserveLuma(applyAgXTonemap(linearRgb));

    // sRGB Gamma transfer curve
    vec3 finalRgb = vec3(
        linearToSrgb(toneMappedLinear.r),
        linearToSrgb(toneMappedLinear.g),
        linearToSrgb(toneMappedLinear.b)
    );

    outputPixels[pixelIdx] = vec4(clamp(finalRgb, 0.0, 1.0), 1.0);
}
