#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputMosaic { float inputMosaic[]; };
layout(std430, binding = 1) buffer DemosaicRgb { float outputRgb[]; };
layout(std430, binding = 2) buffer ColorRgb { float colorRgb[]; };
layout(std430, binding = 3) writeonly buffer ColorStats { float colorStats[]; };
layout(std430, binding = 4) writeonly buffer ResidualCandidates { float residualCandidates[]; };
// Delta 46 transport-only binding. Record = (R-G correction, B-G correction, valid, reserved).
layout(std430, binding = 5) readonly buffer CloudCorrectionMap { vec4 cloudCorrectionMap[]; };
// Phase 9 compact counters. Per-pixel clipping/gamut evidence stays resident on GPU.
layout(std430, binding = 6) buffer ColorTelemetry { uint colorTelemetry[]; };
// Phase 2 trusted DNG camera profile. Header = 16 floats, then dense Data1 and optional Data2.
layout(std430, binding = 7) readonly buffer HueSatProfile { float hueSatProfile[]; };

layout(push_constant) uniform Params {
    uint frameWidth;
    uint frameHeight;
    uint cfaPattern;
    uint mode;          // Phase 9: mode 4 reads demosaic RGB; mode 11 reads post-colour RGB. // 0 bilinear, 1 Malvar, 2 Neural JDD, 3 AWB+CCM, 4 residual, 5/6 AMaZE, 7/8 Auto Hybrid, 9/10 Phase6
    float wbR;
    float wbG;
    float wbB;
    float padding0;
    float ccm0; float ccm1; float ccm2; float ccm3;
    float ccm4; float ccm5; float ccm6; float ccm7;
    // In demosaic modes padding1..3 transport physical noiseSigmaY,
    // noiseSigmaChroma and noisePressure respectively. Mode 3 continues to use
    // ccm0..ccm8 only, so the fixed 128-byte push layout remains unchanged.
    float ccm8; float padding1; float padding2; float padding3;
    uint residualStride;
    uint residualColumns;
    uint residualRows;
    uint padding4;
    // Delta 25+ evidence contract. Pure Malvar 2004 ignores it; adaptive RCD/AMAZE
    // may consume it in reconstructed R/B chroma paths. Sampled CFA values remain authoritative.
    // Demosaic modes: immutable CFA evidence contract. Mode 3 (AWB+CCM) reuses these slots
    // for the mandatory developed-RAW baseline: blendRG/blendBG/sigmaRG/sigmaBG and
    // sourceClipMapReady/sigmaY/modelConfidence/planReady. No luma filtering is authorized.
    vec4 cfaEvidence0;
    vec4 cfaEvidence1;
} pc;

shared float sumRawR[256]; shared float sumRawG[256]; shared float sumRawB[256];
shared float sumWbR[256];  shared float sumWbG[256];  shared float sumWbB[256];
shared float sumCcmR[256]; shared float sumCcmG[256]; shared float sumCcmB[256];
shared float sumCloudAbsRG[256]; shared float sumCloudAbsBG[256]; shared float sumCloudAffected[256];

int safeCoord(int v, int n) { return clamp(v, 0, n - 1); }

int reflectIndexHalfSample(int value, int length) {
    if (length <= 1) return 0;
    int v = value;
    // The kernels only reach two pixels outside the frame, but keeping this generic mirrors
    // OpenCV BORDER_REFLECT (half-sample symmetric) used by the CPU bilinear oracle.
    for (int i = 0; i < 8 && (v < 0 || v >= length); ++i) {
        v = v < 0 ? -v - 1 : 2 * length - v - 1;
    }
    return clamp(v, 0, length - 1);
}

uint cfaColorAt(uint pattern, int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    uint p = min(pattern, 3u);
    if (p == 0u) return ym == 0 ? (xm == 0 ? 0u : 1u) : (xm == 0 ? 1u : 2u); // RGGB
    if (p == 1u) return ym == 0 ? (xm == 0 ? 1u : 0u) : (xm == 0 ? 2u : 1u); // GRBG
    if (p == 2u) return ym == 0 ? (xm == 0 ? 1u : 2u) : (xm == 0 ? 0u : 1u); // GBRG
    return ym == 0 ? (xm == 0 ? 2u : 1u) : (xm == 0 ? 1u : 0u); // BGGR
}

float sampleClamped(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return inputMosaic[uint(sy) * pc.frameWidth + uint(sx)];
}

float sampleBilinearChannelReflect(int x, int y, uint channel) {
    int sx = reflectIndexHalfSample(x, int(pc.frameWidth));
    int sy = reflectIndexHalfSample(y, int(pc.frameHeight));
    if (cfaColorAt(pc.cfaPattern, sx, sy) != channel) return 0.0;
    return inputMosaic[uint(sy) * pc.frameWidth + uint(sx)];
}

float finiteLinear(float value) {
    return isinf(value) || isnan(value) ? 0.0 : value;
}

float demosaicNoiseSigmaY() {
    return max(0.0, finiteLinear(pc.padding1));
}

float demosaicNoiseSigmaChroma() {
    return max(0.0, finiteLinear(pc.padding2));
}

float demosaicNoisePressure() {
    return clamp(finiteLinear(pc.padding3), 0.0, 1.0);
}

vec3 bilinearAt(int x, int y) {
    bool border = x == 0 || y == 0 || x == int(pc.frameWidth) - 1 || y == int(pc.frameHeight) - 1;
    if (border) {
        float rCenter = 4.0 * sampleBilinearChannelReflect(x, y, 0u);
        float rAxial = 2.0 * (sampleBilinearChannelReflect(x - 1, y, 0u) +
                              sampleBilinearChannelReflect(x + 1, y, 0u) +
                              sampleBilinearChannelReflect(x, y - 1, 0u) +
                              sampleBilinearChannelReflect(x, y + 1, 0u));
        float rDiagonal = sampleBilinearChannelReflect(x - 1, y - 1, 0u) +
                          sampleBilinearChannelReflect(x + 1, y - 1, 0u) +
                          sampleBilinearChannelReflect(x - 1, y + 1, 0u) +
                          sampleBilinearChannelReflect(x + 1, y + 1, 0u);
        float bCenter = 4.0 * sampleBilinearChannelReflect(x, y, 2u);
        float bAxial = 2.0 * (sampleBilinearChannelReflect(x - 1, y, 2u) +
                              sampleBilinearChannelReflect(x + 1, y, 2u) +
                              sampleBilinearChannelReflect(x, y - 1, 2u) +
                              sampleBilinearChannelReflect(x, y + 1, 2u));
        float bDiagonal = sampleBilinearChannelReflect(x - 1, y - 1, 2u) +
                          sampleBilinearChannelReflect(x + 1, y - 1, 2u) +
                          sampleBilinearChannelReflect(x - 1, y + 1, 2u) +
                          sampleBilinearChannelReflect(x + 1, y + 1, 2u);
        float g = 0.25 * (4.0 * sampleBilinearChannelReflect(x, y, 1u) +
                          sampleBilinearChannelReflect(x - 1, y, 1u) +
                          sampleBilinearChannelReflect(x + 1, y, 1u) +
                          sampleBilinearChannelReflect(x, y - 1, 1u) +
                          sampleBilinearChannelReflect(x, y + 1, 1u));
        return vec3(finiteLinear(0.25 * (rCenter + rAxial + rDiagonal)),
                    finiteLinear(g),
                    finiteLinear(0.25 * (bCenter + bAxial + bDiagonal)));
    }

    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float c = sampleClamped(x, y);
    float r; float g; float b;
    if (color == 0u) {
        r = c;
        g = 0.25 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1) +
                    sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
        b = 0.25 * (sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                    sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1));
    } else if (color == 2u) {
        b = c;
        g = 0.25 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1) +
                    sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
        r = 0.25 * (sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                    sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1));
    } else {
        g = c;
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        if (horizontalRed) {
            r = 0.5 * (sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
            b = 0.5 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1));
        } else {
            b = 0.5 * (sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
            r = 0.5 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1));
        }
    }
    return vec3(finiteLinear(r), finiteLinear(g), finiteLinear(b));
}




// Pure deterministic Malvar-He-Cutler 2004. No CFA-evidence/noise authority in this route.
vec3 malvarAt(int x, int y) {
    const float scale = 0.125;
    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float c = sampleClamped(x, y);
    float axial1 = sampleClamped(x - 1, y) + sampleClamped(x + 1, y) +
                   sampleClamped(x, y - 1) + sampleClamped(x, y + 1);
    float axial2 = sampleClamped(x - 2, y) + sampleClamped(x + 2, y) +
                   sampleClamped(x, y - 2) + sampleClamped(x, y + 2);
    float diagonals = sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                      sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1);
    float greenRB = (4.0 * c + 2.0 * axial1 - axial2) * scale;
    float oppositeRB = (6.0 * c + 2.0 * diagonals - 1.5 * axial2) * scale;
    float horizontal1 = sampleClamped(x - 1, y) + sampleClamped(x + 1, y);
    float horizontal2 = sampleClamped(x - 2, y) + sampleClamped(x + 2, y);
    float vertical1 = sampleClamped(x, y - 1) + sampleClamped(x, y + 1);
    float vertical2 = sampleClamped(x, y - 2) + sampleClamped(x, y + 2);
    float chromaH = (5.0 * c + 4.0 * horizontal1 - horizontal2 - diagonals + 0.5 * vertical2) * scale;
    float chromaV = (5.0 * c + 4.0 * vertical1 - vertical2 - diagonals + 0.5 * horizontal2) * scale;

    float r; float g; float b;
    if (color == 0u) {
        r = c; g = greenRB; b = oppositeRB;
    } else if (color == 2u) {
        r = oppositeRB; g = greenRB; b = c;
    } else {
        g = c;
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        r = horizontalRed ? chromaH : chromaV;
        b = horizontalRed ? chromaV : chromaH;
    }
    return vec3(finiteLinear(r), finiteLinear(g), finiteLinear(b));
}





// Delta 26: only RCD missing-chroma interpolation consumes the Delta-25 CFA evidence.
// Green reconstruction remains identical to Delta 25.







// Phase 4: retired Neural JDD pixel mutation code removed.
// Legacy mode 2, if ever received, is coerced to the non-denoising Malvar reconstruction path.

float amazeSigmaY() { return demosaicNoiseSigmaY(); }
float amazeSigmaChroma() { return demosaicNoiseSigmaChroma(); }

float amazeRetainHighOrderDetail(float term) {
    float sigma = amazeSigmaY();
    if (sigma <= 1.0e-7) return term;
    float z = abs(term) / max(1.0e-6, sigma);
    float t = clamp((z - 1.25) / 2.50, 0.0, 1.0);
    float retention = t * t * (3.0 - 2.0 * t);
    return term * retention;
}

float amazeChromaRisk(uint channel) {
    if (pc.cfaEvidence0.x < 0.5 || (channel != 0u && channel != 2u)) return 0.0;
    float band = clamp(0.55 * pc.cfaEvidence0.w + 0.30 * pc.cfaEvidence1.x +
                       0.15 * pc.cfaEvidence1.y, 0.0, 1.0);
    float opponent = channel == 0u ? pc.cfaEvidence1.z : pc.cfaEvidence1.w;
    float relief = 1.0 - 0.30 * clamp(pc.cfaEvidence0.z, 0.0, 1.0);
    return clamp((0.60 * band + 0.40 * clamp(opponent, 0.0, 1.0)) * relief, 0.0, 1.0);
}

float amazeAdaptiveOneSided(float center, float adjacentGreen, float farSame, float ha) {
    const float eps = 1.0e-5;
    if (center * farSame <= 0.0 || abs(farSame) <= eps) return ha;
    float ratio = center / farSame;
    if (!(ratio > 0.20 && ratio < 5.00) || isnan(ratio) || isinf(ratio)) return ha;
    float geometric = adjacentGreen * sqrt(max(0.0, ratio));
    float logDistance = abs(log2(max(ratio, eps)));
    float t = clamp((logDistance - 0.45) / 0.80, 0.0, 1.0);
    float reliability = 1.0 - t * t * (3.0 - 2.0 * t);
    return finiteLinear(ha + 0.45 * reliability * (geometric - ha));
}

vec2 amazeAxisGuide(int x, int y, bool horizontal) {
    int dx = horizontal ? 1 : 0;
    int dy = horizontal ? 0 : 1;
    float center = sampleClamped(x, y);
    float n = sampleClamped(x - dx, y - dy);
    float p = sampleClamped(x + dx, y + dy);
    float fn = sampleClamped(x - 2 * dx, y - 2 * dy);
    float fp = sampleClamped(x + 2 * dx, y + 2 * dy);
    float curvature = amazeRetainHighOrderDetail(2.0 * center - fn - fp);
    float ha = 0.5 * (n + p) + 0.25 * curvature;
    float han = n + 0.5 * amazeRetainHighOrderDetail(center - fn);
    float hap = p + 0.5 * amazeRetainHighOrderDetail(center - fp);
    float an = amazeAdaptiveOneSided(center, n, fn, han);
    float ap = amazeAdaptiveOneSided(center, p, fp, hap);
    float sigma = amazeSigmaY();
    float costN = max(1.0e-5, abs(n - p) + abs(center - fn) +
                      0.5 * abs(n - sampleClamped(x - 3 * dx, y - 3 * dy)) - 1.10 * sigma);
    float costP = max(1.0e-5, abs(n - p) + abs(center - fp) +
                      0.5 * abs(p - sampleClamped(x + 3 * dx, y + 3 * dy)) - 1.10 * sigma);
    float wn = 1.0 / (costN * costN + 1.0e-10);
    float wp = 1.0 / (costP * costP + 1.0e-10);
    float adaptive = (wn * an + wp * ap) / max(1.0e-8, wn + wp);
    float texture = abs(fn - fp) + abs(n - p);
    float t = clamp((texture - (0.015 + 2.0 * sigma)) /
                    max(1.0e-6, (0.080 + 8.0 * sigma) - (0.015 + 2.0 * sigma)), 0.0, 1.0);
    float adaptiveAuthority = 1.0 - t * t * (3.0 - 2.0 * t);
    float g = finiteLinear(ha + 0.55 * adaptiveAuthority * (adaptive - ha));
    float cost = max(1.0e-5, abs(n - p) + 0.65 * abs(curvature) +
                     0.35 * abs(fn - fp) - 0.90 * sigma);
    return vec2(g, cost);
}

float amazeNyquistPreScore(int x, int y) {
    float c = sampleClamped(x, y);
    float h2 = abs(2.0 * c - sampleClamped(x - 2, y) - sampleClamped(x + 2, y));
    float v2 = abs(2.0 * c - sampleClamped(x, y - 2) - sampleClamped(x, y + 2));
    float h1 = abs(sampleClamped(x - 1, y) - sampleClamped(x + 1, y));
    float v1 = abs(sampleClamped(x, y - 1) - sampleClamped(x, y + 1));
    float d1 = abs(sampleClamped(x - 1, y - 1) - sampleClamped(x + 1, y + 1));
    float d2 = abs(sampleClamped(x + 1, y - 1) - sampleClamped(x - 1, y + 1));
    float axial = h2 + v2 + 0.50 * (h1 + v1);
    float anisotropy = abs((h2 + 0.5 * h1) - (v2 + 0.5 * v1)) /
                       max(1.0e-6, h2 + v2 + 0.5 * (h1 + v1));
    float isotropy = 1.0 - clamp(anisotropy, 0.0, 1.0);
    float sigma = amazeSigmaY();
    float energy = axial + 0.45 * (d1 + d2);
    float e0 = 0.004 + 3.0 * sigma;
    float e1 = 0.035 + 12.0 * sigma;
    float et = clamp((energy - e0) / max(1.0e-6, e1 - e0), 0.0, 1.0);
    float energyGate = et * et * (3.0 - 2.0 * et);
    float it = clamp((isotropy - 0.35) / 0.47, 0.0, 1.0);
    float isotropyGate = it * it * (3.0 - 2.0 * it);
    return clamp(energyGate * isotropyGate, 0.0, 1.0);
}

void amazeGuidePass(int x, int y) {
    uint idx = uint(y) * pc.frameWidth + uint(x);
    uint base = idx * 3u;
    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float nyq = amazeNyquistPreScore(x, y);
    float green;
    if (color == 1u) {
        green = sampleClamped(x, y);
    } else {
        vec2 h = amazeAxisGuide(x, y, true);
        vec2 v = amazeAxisGuide(x, y, false);
        float wh = 1.0 / (h.y * h.y + 1.0e-10);
        float wv = 1.0 / (v.y * v.y + 1.0e-10);
        green = (wh * h.x + wv * v.x) / max(1.0e-8, wh + wv);
        green += 0.25 * nyq * (0.5 * (h.x + v.x) - green);
        float left = sampleClamped(x - 1, y);
        float right = sampleClamped(x + 1, y);
        float up = sampleClamped(x, y - 1);
        float down = sampleClamped(x, y + 1);
        float lo = min(min(left, right), min(up, down));
        float hi = max(max(left, right), max(up, down));
        float guard = max(3.0 * amazeSigmaY(), 0.18 * max(1.0e-5, hi - lo));
        green = clamp(green, lo - guard, hi + guard);
    }
    float gx = abs(sampleClamped(x + 1, y) - sampleClamped(x - 1, y));
    float gy = abs(sampleClamped(x, y + 1) - sampleClamped(x, y - 1));
    float gd1 = abs(sampleClamped(x + 1, y + 1) - sampleClamped(x - 1, y - 1));
    float gd2 = abs(sampleClamped(x + 1, y - 1) - sampleClamped(x - 1, y + 1));
    float sigma = amazeSigmaY();
    float structureRaw = 0.40 * max(gx, gy) + 0.25 * min(gx, gy) + 0.175 * (gd1 + gd2);
    float structureLo = 0.012 + 2.5 * sigma;
    float structureHi = 0.095 + 9.0 * sigma;
    float structure = smoothstep(structureLo, max(structureLo + 1.0e-5, structureHi), structureRaw);
    colorRgb[base + 0u] = finiteLinear(green);
    colorRgb[base + 1u] = nyq;
    colorRgb[base + 2u] = clamp(structure, 0.0, 1.0);
}

float amazeGuideGreen(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return colorRgb[(uint(sy) * pc.frameWidth + uint(sx)) * 3u + 0u];
}

float amazeGuideNyquist(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return clamp(colorRgb[(uint(sy) * pc.frameWidth + uint(sx)) * 3u + 1u], 0.0, 1.0);
}

float amazeSmoothedNyquist(int x, int y) {
    return clamp(0.50 * amazeGuideNyquist(x, y) + 0.125 * (
            amazeGuideNyquist(x - 2, y) + amazeGuideNyquist(x + 2, y) +
            amazeGuideNyquist(x, y - 2) + amazeGuideNyquist(x, y + 2)), 0.0, 1.0);
}

float amazeGuideStructure(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return clamp(colorRgb[(uint(sy) * pc.frameWidth + uint(sx)) * 3u + 2u], 0.0, 1.0);
}

float autoHybridSmoothedStructure(int x, int y) {
    return clamp(0.50 * amazeGuideStructure(x, y) + 0.125 * (
            amazeGuideStructure(x - 2, y) + amazeGuideStructure(x + 2, y) +
            amazeGuideStructure(x, y - 2) + amazeGuideStructure(x, y + 2)), 0.0, 1.0);
}

bool amazeDifferenceAt(int x, int y, uint channel, out float difference) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    if (cfaColorAt(pc.cfaPattern, sx, sy) != channel) return false;
    difference = sampleClamped(sx, sy) - amazeGuideGreen(sx, sy);
    return !(isnan(difference) || isinf(difference));
}

float amazeChromaWeight(float greenDelta, float disagreement, float risk) {
    float sigma = amazeSigmaChroma();
    float gradient = max(0.0, greenDelta + (0.30 + 0.25 * risk) * disagreement - sigma);
    float floorValue = max(1.5e-4 + 5.0e-4 * risk, 0.60 * sigma);
    float v = floorValue + gradient;
    return 1.0 / max(1.0e-12, v * v);
}

float amazeClamp4(float value, vec4 samples) {
    float lo = min(min(samples.x, samples.y), min(samples.z, samples.w));
    float hi = max(max(samples.x, samples.y), max(samples.z, samples.w));
    float guard = max(3.0 * amazeSigmaChroma(), 0.18 * max(1.0e-6, hi - lo));
    return clamp(value, lo - guard, hi + guard);
}

float amazeAxialDifference(int x, int y, uint channel, bool horizontal) {
    int dx = horizontal ? 1 : 0;
    int dy = horizontal ? 0 : 1;
    float dm=0.0, dp=0.0, dm3=0.0, dp3=0.0;
    bool vm = amazeDifferenceAt(x - dx, y - dy, channel, dm);
    bool vp = amazeDifferenceAt(x + dx, y + dy, channel, dp);
    if (!vm && vp) dm = dp;
    if (!vp && vm) dp = dm;
    if (!vm && !vp) return 0.0;
    if (!amazeDifferenceAt(x - 3 * dx, y - 3 * dy, channel, dm3)) dm3 = dm;
    if (!amazeDifferenceAt(x + 3 * dx, y + 3 * dy, channel, dp3)) dp3 = dp;
    float gc = amazeGuideGreen(x, y);
    float gm = amazeGuideGreen(x - dx, y - dy);
    float gp = amazeGuideGreen(x + dx, y + dy);
    float risk = amazeChromaRisk(channel);
    float disagreement = abs(dm - dp);
    float wm = amazeChromaWeight(abs(gc - gm), disagreement, risk);
    float wp = amazeChromaWeight(abs(gc - gp), disagreement, risk);
    float nearEstimate = (wm * dm + wp * dp) / max(1.0e-8, wm + wp);
    float highOrder = (-dm3 + 9.0 * dm + 9.0 * dp - dp3) * (1.0 / 16.0);
    float sigma = amazeSigmaChroma();
    float tex = abs(gm - gp) + disagreement;
    float t = clamp((tex - (0.010 + 2.0 * sigma)) /
                    max(1.0e-6, (0.060 + 8.0 * sigma) - (0.010 + 2.0 * sigma)), 0.0, 1.0);
    float smoothAuthority = 1.0 - t * t * (3.0 - 2.0 * t);
    float d = nearEstimate + 0.30 * smoothAuthority * (1.0 - risk) * (highOrder - nearEstimate);
    float area = 0.375 * (dm + dp) + 0.125 * (dm3 + dp3);
    d += 0.68 * amazeSmoothedNyquist(x, y) * (area - d);
    return amazeClamp4(d, vec4(dm, dp, dm3, dp3));
}

float amazeDiagonalDifference(int x, int y, uint channel) {
    float dNW=0.0,dNE=0.0,dSW=0.0,dSE=0.0;
    bool vNW=amazeDifferenceAt(x-1,y-1,channel,dNW);
    bool vNE=amazeDifferenceAt(x+1,y-1,channel,dNE);
    bool vSW=amazeDifferenceAt(x-1,y+1,channel,dSW);
    bool vSE=amazeDifferenceAt(x+1,y+1,channel,dSE);
    float mean = 0.0; float count = 0.0;
    if(vNW){mean+=dNW;count+=1.0;} if(vNE){mean+=dNE;count+=1.0;}
    if(vSW){mean+=dSW;count+=1.0;} if(vSE){mean+=dSE;count+=1.0;}
    if(count<0.5) return 0.0;
    mean/=count;
    if(!vNW)dNW=mean; if(!vNE)dNE=mean; if(!vSW)dSW=mean; if(!vSE)dSE=mean;
    float fNW=dNW,fNE=dNE,fSW=dSW,fSE=dSE;
    if(!amazeDifferenceAt(x-3,y-3,channel,fNW))fNW=dNW;
    if(!amazeDifferenceAt(x+3,y-3,channel,fNE))fNE=dNE;
    if(!amazeDifferenceAt(x-3,y+3,channel,fSW))fSW=dSW;
    if(!amazeDifferenceAt(x+3,y+3,channel,fSE))fSE=dSE;
    float diagA=0.5*(dNW+dSE), diagB=0.5*(dNE+dSW);
    float gNW=amazeGuideGreen(x-1,y-1),gNE=amazeGuideGreen(x+1,y-1);
    float gSW=amazeGuideGreen(x-1,y+1),gSE=amazeGuideGreen(x+1,y+1);
    float risk=amazeChromaRisk(channel); float disagreement=abs(diagA-diagB);
    float wA=amazeChromaWeight(abs(gNW-gSE),disagreement,risk);
    float wB=amazeChromaWeight(abs(gNE-gSW),disagreement,risk);
    float d=(wA*diagA+wB*diagB)/max(1.0e-8,wA+wB);
    float highA=(-fNW+9.0*dNW+9.0*dSE-fSE)*(1.0/16.0);
    float highB=(-fNE+9.0*dNE+9.0*dSW-fSW)*(1.0/16.0);
    float sigma=amazeSigmaChroma();
    float tex=abs(gNW-gSE)+abs(gNE-gSW)+disagreement;
    float t=clamp((tex-(0.012+2.0*sigma))/max(1.0e-6,(0.070+8.0*sigma)-(0.012+2.0*sigma)),0.0,1.0);
    float smoothAuthority=1.0-t*t*(3.0-2.0*t);
    float high=(wA*highA+wB*highB)/max(1.0e-8,wA+wB);
    d+=0.24*smoothAuthority*(1.0-risk)*(high-d);
    float area=0.1875*(dNW+dNE+dSW+dSE)+0.0625*(fNW+fNE+fSW+fSE);
    d+=0.72*amazeSmoothedNyquist(x,y)*(area-d);
    float nearClamp=amazeClamp4(d,vec4(dNW,dNE,dSW,dSE));
    float farLo=min(min(fNW,fNE),min(fSW,fSE));
    float farHi=max(max(fNW,fNE),max(fSW,fSE));
    float guard=max(3.0*amazeSigmaChroma(),0.18*max(1.0e-6,farHi-farLo));
    return clamp(nearClamp,farLo-guard,farHi+guard);
}

vec3 amazeReconstructAt(int x, int y) {
    uint color=cfaColorAt(pc.cfaPattern,x,y);
    float g=amazeGuideGreen(x,y);
    float r=g,b=g;
    if(color==0u){ r=sampleClamped(x,y); b=g+amazeDiagonalDifference(x,y,2u); }
    else if(color==2u){ b=sampleClamped(x,y); r=g+amazeDiagonalDifference(x,y,0u); }
    else {
        bool horizontalRed=cfaColorAt(pc.cfaPattern,x-1,y)==0u;
        r=g+amazeAxialDifference(x,y,0u,horizontalRed);
        b=g+amazeAxialDifference(x,y,2u,!horizontalRed);
    }
    return vec3(finiteLinear(r),finiteLinear(g),finiteLinear(b));
}

vec3 autoHybridGlobalPrior() {
    vec3 prior = max(vec3(pc.ccm0, pc.ccm1, pc.ccm2), vec3(0.0));
    float sum = prior.r + prior.g + prior.b;
    return sum > 1.0e-6 ? prior / sum : vec3(1.0 / 3.0);
}

float autoHybridSecondLargest(vec3 v) {
    float hi = max(v.r, max(v.g, v.b));
    float lo = min(v.r, min(v.g, v.b));
    return v.r + v.g + v.b - hi - lo;
}

vec3 autoHybridAt(int x, int y) {
    vec3 prior3 = autoHybridGlobalPrior();
    float priorMalvar = max(0.0, prior3.r);
    float priorAmaze = max(0.0, prior3.b);
    float priorSum = priorMalvar + priorAmaze;
    if (priorSum > 1.0e-6) {
        priorMalvar /= priorSum;
        priorAmaze /= priorSum;
    } else {
        priorMalvar = 0.5;
        priorAmaze = 0.5;
    }

    float structure = autoHybridSmoothedStructure(x, y);
    float nyquist = amazeSmoothedNyquist(x, y);
    float noise = demosaicNoisePressure();
    float chromaRisk = 0.5 * (amazeChromaRisk(0u) + amazeChromaRisk(2u));
    float center = clamp(sampleClamped(x, y), 0.0, 1.0);
    float lowSignal = 1.0 - smoothstep(0.035, 0.18, center);

    // Phase 3: Auto Hybrid is reconstruction-only. Malvar is the stable/noise-robust
    // interpolation anchor and AMaZE receives authority on coherent high-frequency/Nyquist
    // structure. Neural JDD is deliberately absent: Neural Denoise already owns RAW denoise.
    float malvar = priorMalvar * (0.86 + 0.30 * noise + 0.16 * chromaRisk +
                                  0.10 * lowSignal + 0.08 * (1.0 - structure));
    float amaze = priorAmaze * (0.74 + 0.58 * structure + 0.72 * nyquist -
                                0.42 * noise - 0.18 * chromaRisk - 0.08 * lowSignal);
    malvar = max(malvar, 0.015);
    amaze = max(amaze, 0.015);
    float weightSum = max(1.0e-6, malvar + amaze);
    malvar /= weightSum;
    amaze /= weightSum;

    // Near ties are pulled toward the scene prior to avoid regional flicker.
    float nearTie = 1.0 - smoothstep(0.045, 0.16, abs(malvar - amaze));
    malvar = mix(malvar, priorMalvar, 0.35 * nearTie);
    amaze = mix(amaze, priorAmaze, 0.35 * nearTie);
    malvar = max(malvar, 0.035 * priorMalvar);
    amaze = max(amaze, 0.035 * priorAmaze);
    weightSum = max(1.0e-6, malvar + amaze);
    malvar /= weightSum;
    amaze /= weightSum;

    vec3 malvarRgb = malvarAt(x, y);
    vec3 amazeRgb = amazeReconstructAt(x, y);
    vec3 value = malvar * malvarRgb + amaze * amazeRgb;
    return vec3(finiteLinear(value.r), finiteLinear(value.g), finiteLinear(value.b));
}


vec3 residentRgbAt(int x, int y) {
    int sx = clamp(x, 0, int(pc.frameWidth) - 1);
    int sy = clamp(y, 0, int(pc.frameHeight) - 1);
    uint index = (uint(sy) * pc.frameWidth + uint(sx)) * 3u;
    return vec3(outputRgb[index + 0u], outputRgb[index + 1u], outputRgb[index + 2u]);
}

vec3 colorRgbAt(int x, int y) {
    int sx = clamp(x, 0, int(pc.frameWidth) - 1);
    int sy = clamp(y, 0, int(pc.frameHeight) - 1);
    uint index = (uint(sy) * pc.frameWidth + uint(sx)) * 3u;
    return vec3(colorRgb[index + 0u], colorRgb[index + 1u], colorRgb[index + 2u]);
}

const float PHASE9_SENSOR_CLIP_THRESHOLD = 0.985; // hard-clip telemetry threshold only
const float PHASE9_COLOR_CONFIDENCE_START = 0.960;
const float PHASE9_COLOR_CONFIDENCE_ZERO = 0.995;

uint phase9SensorClipMask(vec3 raw) {
    uint mask = 0u;
    if (raw.r >= PHASE9_SENSOR_CLIP_THRESHOLD) mask |= 1u;
    if (raw.g >= PHASE9_SENSOR_CLIP_THRESHOLD) mask |= 2u;
    if (raw.b >= PHASE9_SENSOR_CLIP_THRESHOLD) mask |= 4u;
    return mask;
}

int phase9BitCount3(uint mask) {
    return int((mask & 1u) != 0u) + int((mask & 2u) != 0u) + int((mask & 4u) != 0u);
}

float phase9Luma(vec3 rgb) {
    return 0.2126 * rgb.r + 0.7152 * rgb.g + 0.0722 * rgb.b;
}


// ---- Phase 2 calibrated DNG ProfileHueSatMap --------------------------------
// The upstream matrix is already the paired DNG ForwardMatrix characterization represented in
// linear sRGB. These fixed matrices only bridge that PCS representation to/from linear RIMM.
vec3 hsmLinearSrgbToRimm(vec3 rgb) {
    return vec3(
        0.529364575 * rgb.r + 0.330145317 * rgb.g + 0.140532947 * rgb.b,
        0.098381997 * rgb.r + 0.873443911 * rgb.g + 0.028163017 * rgb.b,
        0.016878012 * rgb.r + 0.117656626 * rgb.g + 0.865257607 * rgb.b);
}
vec3 hsmRimmToLinearSrgb(vec3 rgb) {
    return vec3(
         2.034043804 * rgb.r - 0.727518881 * rgb.g - 0.306684004 * rgb.b,
        -0.228832038 * rgb.r + 1.231781960 * rgb.g - 0.002926809 * rgb.b,
        -0.008560528 * rgb.r - 0.153305031 * rgb.g + 1.162105494 * rgb.b);
}
float hsmSrgbEncode(float x) {
    x = clamp(x, 0.0, 1.0);
    return x <= 0.0031308 ? 12.92 * x : 1.055 * pow(x, 1.0 / 2.4) - 0.055;
}
float hsmSrgbDecode(float x) {
    x = clamp(x, 0.0, 1.0);
    return x <= 0.04045 ? x / 12.92 : pow((x + 0.055) / 1.055, 2.4);
}
vec3 hsmRgbToHsv(vec3 rgb) {
    float mx = max(rgb.r, max(rgb.g, rgb.b));
    float mn = min(rgb.r, min(rgb.g, rgb.b));
    float d = mx - mn;
    float h = 0.0;
    if (d > 1.0e-12) {
        if (mx == rgb.r) h = 60.0 * mod((rgb.g - rgb.b) / d, 6.0);
        else if (mx == rgb.g) h = 60.0 * (((rgb.b - rgb.r) / d) + 2.0);
        else h = 60.0 * (((rgb.r - rgb.g) / d) + 4.0);
    }
    h = mod(h + 360.0, 360.0);
    float sat = mx > 1.0e-12 ? d / mx : 0.0;
    return vec3(h, clamp(sat, 0.0, 1.0), max(0.0, mx));
}
vec3 hsmHsvToRgb(vec3 hsv) {
    float h = mod(hsv.x + 360.0, 360.0);
    float sat = clamp(hsv.y, 0.0, 1.0);
    float val = max(0.0, hsv.z);
    float c = val * sat;
    float x = c * (1.0 - abs(mod(h / 60.0, 2.0) - 1.0));
    float m = val - c;
    vec3 rgb;
    if (h < 60.0) rgb = vec3(c, x, 0.0);
    else if (h < 120.0) rgb = vec3(x, c, 0.0);
    else if (h < 180.0) rgb = vec3(0.0, c, x);
    else if (h < 240.0) rgb = vec3(0.0, x, c);
    else if (h < 300.0) rgb = vec3(x, 0.0, c);
    else rgb = vec3(c, 0.0, x);
    return rgb + vec3(m);
}
bool hsmProfileEnabled() { return hueSatProfile[0] > 0.5; }
uint hsmH() { return uint(max(1.0, floor(hueSatProfile[1] + 0.5))); }
uint hsmS() { return uint(max(2.0, floor(hueSatProfile[2] + 0.5))); }
uint hsmV() { return uint(max(1.0, floor(hueSatProfile[3] + 0.5))); }
uint hsmEncoding() { return uint(clamp(floor(hueSatProfile[4] + 0.5), 0.0, 1.0)); }
uint hsmEntryCount() { return uint(max(1.0, floor(hueSatProfile[8] + 0.5))); }
uint hsmCellIndex(uint h, uint sat, uint val) { return (val * hsmH() + h) * hsmS() + sat; }
vec3 hsmTableEntry(uint cell) {
    uint base1 = 16u + cell * 3u;
    vec3 a = vec3(hueSatProfile[base1], hueSatProfile[base1 + 1u], hueSatProfile[base1 + 2u]);
    if (hueSatProfile[7] <= 0.5) return a;
    uint base2 = 16u + hsmEntryCount() * 3u + cell * 3u;
    vec3 b = vec3(hueSatProfile[base2], hueSatProfile[base2 + 1u], hueSatProfile[base2 + 2u]);
    float w1 = clamp(hueSatProfile[5], 0.0, 1.0);
    float w2 = clamp(hueSatProfile[6], 0.0, 1.0);
    float sumW = max(1.0e-8, w1 + w2);
    return (w1 * a + w2 * b) / sumW;
}
vec3 hsmLerp(vec3 a, vec3 b, float t) { return a + (b - a) * clamp(t, 0.0, 1.0); }
vec3 hsmSample(float hueDegrees, float saturation, float linearValue) {
    uint H = hsmH(); uint S = hsmS(); uint V = hsmV();
    float hueCoord = (mod(hueDegrees + 360.0, 360.0) / 360.0) * float(H);
    float hueFloor = floor(hueCoord);
    uint h0 = uint(hueFloor) % H; uint h1 = (h0 + 1u) % H; float hf = hueCoord - hueFloor;
    float satCoord = clamp(saturation, 0.0, 1.0) * float(S - 1u);
    uint s0 = uint(floor(satCoord)); uint s1 = min(s0 + 1u, S - 1u); float sf = satCoord - float(s0);
    float lookupV = clamp(linearValue, 0.0, 1.0);
    if (V > 1u && hsmEncoding() == 1u) lookupV = hsmSrgbEncode(lookupV);
    float valCoord = V > 1u ? lookupV * float(V - 1u) : 0.0;
    uint v0 = uint(floor(valCoord)); uint v1 = min(v0 + 1u, V - 1u); float vf = valCoord - float(v0);
    vec3 c000 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s0,v0)), hsmTableEntry(hsmCellIndex(h1,s0,v0)), hf);
    vec3 c010 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s1,v0)), hsmTableEntry(hsmCellIndex(h1,s1,v0)), hf);
    vec3 c001 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s0,v1)), hsmTableEntry(hsmCellIndex(h1,s0,v1)), hf);
    vec3 c011 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s1,v1)), hsmTableEntry(hsmCellIndex(h1,s1,v1)), hf);
    return hsmLerp(hsmLerp(c000,c010,sf), hsmLerp(c001,c011,sf), vf);
}
vec3 applyCalibratedDngHueSatMap(vec3 pairedLinearSrgb, out bool applied) {
    applied = false;
    if (!hsmProfileEnabled()) return pairedLinearSrgb;
    // HSM HSV coordinates are [0,1]. Preserve BnCam scene-linear headroom by factoring out a
    // common RIMM scale, applying the calibrated map to the normalized chromaticity/value ratio,
    // then restoring that scale before the final gamut-protection stage.
    // linear sRGB is only the paired PCS transport representation. Preserve signed
    // components until the wider RIMM conversion; clamping in sRGB would discard valid
    // profile gamut before the calibrated HSM sees it.
    vec3 rimm = max(hsmLinearSrgbToRimm(pairedLinearSrgb), vec3(0.0));
    float headroom = max(1.0, max(rimm.r, max(rimm.g, rimm.b)));
    vec3 hsv = hsmRgbToHsv(rimm / headroom);
    vec3 delta = hsmSample(hsv.x, hsv.y, hsv.z);
    hsv.x = mod(hsv.x + delta.x + 360.0, 360.0);
    hsv.y = clamp(hsv.y * max(0.0, delta.y), 0.0, 1.0);
    bool encodedValue = hsmV() > 1u && hsmEncoding() == 1u;
    float valueDomain = encodedValue ? hsmSrgbEncode(hsv.z) : max(0.0, hsv.z);
    valueDomain = min(1.0, valueDomain * max(0.0, delta.z));
    hsv.z = encodedValue ? hsmSrgbDecode(valueDomain) : valueDomain;
    vec3 correctedRimm = hsmHsvToRgb(hsv) * headroom;
    applied = true;
    return hsmRimmToLinearSrgb(correctedRimm);
}

bool phase9MagentaRisk(vec3 rgb) {
    float maximum = max(rgb.r, max(rgb.g, rgb.b));
    if (!(maximum > 0.35)) return false;
    float rbFloor = min(rgb.r, rgb.b);
    float greenDeficit = rbFloor - rgb.g;
    float relativeDeficit = greenDeficit / max(maximum, 1.0e-5);
    return phase9Luma(rgb) > 0.30 && rbFloor > 0.62 * maximum && relativeDeficit > 0.085;
}

float phase9ColorConfidence(vec3 raw, uint hardClipMask) {
    if (any(isnan(raw)) || any(isinf(raw))) return 0.0;
    float peak = max(raw.r, max(raw.g, raw.b));
    float pressure = smoothstep(PHASE9_COLOR_CONFIDENCE_START,
                                PHASE9_COLOR_CONFIDENCE_ZERO, peak);
    // Legacy/fallback evidence only in D124. Production RAW uses the source-Bayer
    // confidence map captured before RAW-finalize exposure/lens mutations.
    if (phase9BitCount3(hardClipMask) == 3) return 0.0;
    return clamp(1.0 - pressure, 0.0, 1.0);
}

bool phase9SourceRawConfidenceAvailable() {
    // Mode 3 repurposes cfaEvidence1.x as a generation-validated availability bit.
    return pc.cfaEvidence1.x > 0.5;
}

float phase9SourceRawConfidenceCell(int cellX, int cellY) {
    int width = int((pc.frameWidth + 1u) / 2u);
    int height = int((pc.frameHeight + 1u) / 2u);
    int sx = clamp(cellX, 0, width - 1);
    int sy = clamp(cellY, 0, height - 1);
    float value = inputMosaic[uint(sy * width + sx)];
    return (isnan(value) || isinf(value)) ? 0.0 : clamp(value, 0.0, 1.0);
}

float phase9SourceRawColorConfidence(int x, int y) {
    // Bilinear interpolation across the 2x2 Bayer cell confidence map eliminates
    // pixel-block quantization, giving continuous C0 confidence transitions.
    float cx = float(x) * 0.5 - 0.25;
    float cy = float(y) * 0.5 - 0.25;
    int x0 = int(floor(cx));
    int y0 = int(floor(cy));
    float fx = fract(cx);
    float fy = fract(cy);
    float c00 = phase9SourceRawConfidenceCell(x0, y0);
    float c10 = phase9SourceRawConfidenceCell(x0 + 1, y0);
    float c01 = phase9SourceRawConfidenceCell(x0, y0 + 1);
    float c11 = phase9SourceRawConfidenceCell(x0 + 1, y0 + 1);
    float centerConf = mix(mix(c00, c10, fx), mix(c01, c11, fx), fy);
    float minNeighbour = min(min(c00, c10), min(c01, c11));
    float confidence = mix(centerConf, min(centerConf, minNeighbour), 0.35);
    return clamp(confidence, 0.0, 1.0);
}

vec3 phase9ApplyClippingAwareHighlightColor(
        vec3 postCcmLinearRgb, float colorConfidence, out bool applied) {
    applied = false;
    if (any(isnan(postCcmLinearRgb)) || any(isinf(postCcmLinearRgb))) return vec3(0.0);
    float confidence = clamp(colorConfidence, 0.0, 1.0);
    if (confidence >= 0.999999) return postCcmLinearRgb;
    float y = phase9Luma(postCcmLinearRgb);
    // Smooth S-curve transition so confidence rolloff is soft and natural,
    // preventing posterized white patches and letting Khronos smoothly desaturate specular peaks.
    float t = smoothstep(0.0, 1.0, confidence);
    vec3 safeRgb = mix(vec3(y), postCcmLinearRgb, t);
    applied = any(greaterThan(abs(safeRgb - postCcmLinearRgb), vec3(1.0e-7)));
    // No upper clamp: neutral highlights above 1.0 remain valid scene-linear headroom.
    return safeRgb;
}

vec3 phase9ProtectSignedCcmLowerGamut(vec3 signedRgb, out bool excursion, out bool applied) {
    excursion = min(signedRgb.r, min(signedRgb.g, signedRgb.b)) < -1.0e-6;
    applied = false;
    if (!excursion || any(isnan(signedRgb)) || any(isinf(signedRgb))) {
        if (any(isnan(signedRgb)) || any(isinf(signedRgb))) {
            applied = true;
            return vec3(0.0);
        }
        // Scene-linear headroom >1 is deliberately preserved for the later tone owner.
        return signedRgb;
    }
    float y = phase9Luma(signedRgb);
    if (!(y > 1.0e-7)) {
        applied = true;
        return vec3(0.0);
    }
    float minimum = min(signedRgb.r, min(signedRgb.g, signedRgb.b));
    float chromaScale = clamp(y / max(y - minimum, 1.0e-8), 0.0, 1.0);
    vec3 protectedRgb = vec3(y) + (signedRgb - vec3(y)) * chromaScale;
    // Only numerical lower-bound cleanup; no upper/output clamp belongs to Phase 9.
    protectedRgb = max(protectedRgb, vec3(0.0));
    applied = true;
    return protectedRgb;
}

vec3 opponentAtRgb(vec3 pixel) {
    return vec3(
            0.2126 * pixel.r + 0.7152 * pixel.g + 0.0722 * pixel.b,
            pixel.r - pixel.g,
            pixel.b - pixel.g);
}

// Mandatory baseline RAW chroma cleanup is intentionally narrower than SPECTRA: it changes
// only noise-model-supported R-G/B-G residuals, preserves green/luma, and applies independent
// local structure gates. SPECTRA remains the optional enhancement owner above this baseline.

bool baselineChromaPlanEnabled() {
    return pc.cfaEvidence1.w > 0.5 &&
           (pc.cfaEvidence0.x > 1.0e-6 || pc.cfaEvidence0.y > 1.0e-6);
}

vec2 baselineOpponent(vec3 pixel) {
    return vec2(pixel.r - pixel.g, pixel.b - pixel.g);
}

float baselineNeighbourWeight(vec3 center, vec3 neighbour, float sigmaY, float spatialWeight) {
    float greenScale = max(0.0020, 2.5 * sigmaY);
    float z = abs(neighbour.g - center.g) / greenScale;
    float edgeWeight = 1.0 / (1.0 + z * z);
    return spatialWeight * edgeWeight;
}

float baselineDirectionCorrection(
        float centerOpponent,
        float localOpponent,
        float neighbourSpread,
        float greenStructure,
        float sigmaChroma,
        float sigmaY,
        float globalBlend,
        float modelConfidence) {
    if (!(sigmaChroma > 1.0e-7) || !(globalBlend > 1.0e-6) || !(modelConfidence > 1.0e-5)) {
        return 0.0;
    }

    float residual = centerOpponent - localOpponent;
    float sigma = max(1.0e-5, sigmaChroma);
    float residualZ = abs(residual) / sigma;
    // Small/medium residuals consistent with the physical noise model are eligible. Strong
    // chroma transitions are treated as signal even in a flat-green region.
    float noiseLike = 1.0 - smoothstep(1.65, 3.25, residualZ);

    float safeSigmaY = max(0.0015, sigmaY);
    float greenZ = greenStructure / safeSigmaY;
    // Real luminance/green structure is an immediate detail veto. The green sample itself is
    // never altered by this pass.
    float greenDetailGate = 1.0 - smoothstep(2.0, 6.0, greenZ);

    float chromaSpreadZ = neighbourSpread / sigma;
    // Protect pure colour texture/edges even when green carries little contrast.
    float chromaDetailGate = 1.0 - smoothstep(2.5, 6.0, chromaSpreadZ);

    float localAuthority = clamp(globalBlend, 0.0, 0.60) *
            clamp(modelConfidence, 0.0, 1.0) *
            noiseLike * greenDetailGate * chromaDetailGate;
    float correction = residual * localAuthority;
    float maximumCorrection = 1.65 * sigma * clamp(globalBlend, 0.0, 0.60);
    return clamp(correction, -maximumCorrection, maximumCorrection);
}

vec3 baselineDetailPreservingChromaAt(
        int x, int y, vec3 center, out vec2 appliedOpponent) {
    appliedOpponent = vec2(0.0);
    if (!baselineChromaPlanEnabled()) return center;
    if (any(isnan(center)) || any(isinf(center))) return center;

    // Preserve very dark numerical-floor pixels and highlight/clipping structure. Baseline
    // chroma cleanup is for stochastic residuals, not highlight reconstruction.
    float peak = max(center.r, max(center.g, center.b));
    if (peak < 0.0020 || peak > 0.94) return center;

    vec3 n0 = residentRgbAt(x - 1, y);
    vec3 n1 = residentRgbAt(x + 1, y);
    vec3 n2 = residentRgbAt(x, y - 1);
    vec3 n3 = residentRgbAt(x, y + 1);
    vec3 n4 = residentRgbAt(x - 1, y - 1);
    vec3 n5 = residentRgbAt(x + 1, y - 1);
    vec3 n6 = residentRgbAt(x - 1, y + 1);
    vec3 n7 = residentRgbAt(x + 1, y + 1);

    float sigmaY = max(0.0, pc.cfaEvidence1.y);
    float w0 = baselineNeighbourWeight(center, n0, sigmaY, 1.0);
    float w1 = baselineNeighbourWeight(center, n1, sigmaY, 1.0);
    float w2 = baselineNeighbourWeight(center, n2, sigmaY, 1.0);
    float w3 = baselineNeighbourWeight(center, n3, sigmaY, 1.0);
    float w4 = baselineNeighbourWeight(center, n4, sigmaY, 0.7071);
    float w5 = baselineNeighbourWeight(center, n5, sigmaY, 0.7071);
    float w6 = baselineNeighbourWeight(center, n6, sigmaY, 0.7071);
    float w7 = baselineNeighbourWeight(center, n7, sigmaY, 0.7071);
    float weightSum = max(1.0e-6, w0+w1+w2+w3+w4+w5+w6+w7);

    vec2 o0 = baselineOpponent(n0);
    vec2 o1 = baselineOpponent(n1);
    vec2 o2 = baselineOpponent(n2);
    vec2 o3 = baselineOpponent(n3);
    vec2 o4 = baselineOpponent(n4);
    vec2 o5 = baselineOpponent(n5);
    vec2 o6 = baselineOpponent(n6);
    vec2 o7 = baselineOpponent(n7);
    vec2 local = (w0*o0+w1*o1+w2*o2+w3*o3+w4*o4+w5*o5+w6*o6+w7*o7) / weightSum;

    float greenStructure = max(
            max(max(abs(n0.g-center.g), abs(n1.g-center.g)),
                max(abs(n2.g-center.g), abs(n3.g-center.g))),
            max(max(abs(n4.g-center.g), abs(n5.g-center.g)),
                max(abs(n6.g-center.g), abs(n7.g-center.g))));

    float spreadRg = max(
            max(max(abs(o0.x-local.x), abs(o1.x-local.x)),
                max(abs(o2.x-local.x), abs(o3.x-local.x))),
            max(max(abs(o4.x-local.x), abs(o5.x-local.x)),
                max(abs(o6.x-local.x), abs(o7.x-local.x))));
    float spreadBg = max(
            max(max(abs(o0.y-local.y), abs(o1.y-local.y)),
                max(abs(o2.y-local.y), abs(o3.y-local.y))),
            max(max(abs(o4.y-local.y), abs(o5.y-local.y)),
                max(abs(o6.y-local.y), abs(o7.y-local.y))));

    vec2 centerOpponent = baselineOpponent(center);
    float confidence = clamp(pc.cfaEvidence1.z, 0.0, 1.0);
    float correctionRg = baselineDirectionCorrection(
            centerOpponent.x, local.x, spreadRg, greenStructure,
            max(0.0, pc.cfaEvidence0.z), sigmaY,
            max(0.0, pc.cfaEvidence0.x), confidence);
    float correctionBg = baselineDirectionCorrection(
            centerOpponent.y, local.y, spreadBg, greenStructure,
            max(0.0, pc.cfaEvidence0.w), sigmaY,
            max(0.0, pc.cfaEvidence0.y), confidence);

    appliedOpponent = vec2(correctionRg, correctionBg);
    // Green is copied bit-for-bit. Only stochastic opponent residual authority can move R/B.
    return vec3(center.r - correctionRg, center.g, center.b - correctionBg);
}

bool finiteBoundedRgb(vec3 pixel) {
    return all(not(isnan(pixel))) && all(not(isinf(pixel))) &&
           all(greaterThan(pixel, vec3(-0.05))) && all(lessThan(pixel, vec3(0.98)));
}

void writeResidualCandidate(uvec2 sampleGid, bool postColourDomain) {
    if (sampleGid.x >= pc.residualColumns || sampleGid.y >= pc.residualRows) return;
    uint sampleIndex = sampleGid.y * pc.residualColumns + sampleGid.x;
    uint base = sampleIndex * 8u;
    residualCandidates[base + 0u] = 0.0;
    residualCandidates[base + 1u] = 0.0;
    residualCandidates[base + 2u] = 0.0;
    residualCandidates[base + 3u] = 0.0;
    residualCandidates[base + 4u] = 0.0;
    residualCandidates[base + 5u] = 0.0;
    residualCandidates[base + 6u] = 0.0;
    residualCandidates[base + 7u] = 0.0;

    int x = 2 + int(sampleGid.x * pc.residualStride);
    int y = 2 + int(sampleGid.y * pc.residualStride);
    if (x >= int(pc.frameWidth) - 2 || y >= int(pc.frameHeight) - 2) return;

    // Mode 4 is the immutable post-demosaic observation and MUST read outputRgb.
    // Mode 11 is the post-AWB/CCM observation and reads colorRgb. AMaZE/AUTO_HYBRID
    // use colorRgb as guide/Phase-6 scratch during demosaic, so collapsing these domains
    // silently turns guide data into fake chroma residual evidence.
    vec3 centerPixel = postColourDomain ? colorRgbAt(x, y) : residentRgbAt(x, y);
    vec3 leftPixel = postColourDomain ? colorRgbAt(x - 1, y) : residentRgbAt(x - 1, y);
    vec3 rightPixel = postColourDomain ? colorRgbAt(x + 1, y) : residentRgbAt(x + 1, y);
    vec3 upPixel = postColourDomain ? colorRgbAt(x, y - 1) : residentRgbAt(x, y - 1);
    vec3 downPixel = postColourDomain ? colorRgbAt(x, y + 1) : residentRgbAt(x, y + 1);
    if (!finiteBoundedRgb(centerPixel) || !finiteBoundedRgb(leftPixel) ||
        !finiteBoundedRgb(rightPixel) || !finiteBoundedRgb(upPixel) ||
        !finiteBoundedRgb(downPixel)) return;

    vec3 center = opponentAtRgb(centerPixel);
    vec3 left = opponentAtRgb(leftPixel);
    vec3 right = opponentAtRgb(rightPixel);
    vec3 up = opponentAtRgb(upPixel);
    vec3 down = opponentAtRgb(downPixel);
    if (center.x < 0.008 || center.x > 0.90) return;

    vec3 hp = center - 0.25 * (left + right + up + down);
    if (any(isnan(hp)) || any(isinf(hp))) return;
    vec3 maxDelta = max(max(abs(center - left), abs(center - right)),
                        max(abs(center - up), abs(center - down)));
    float structure = max(maxDelta.x, 0.45 * max(maxDelta.y, maxDelta.z));
    uint tileX = min(15u, uint(x) * 16u / max(1u, pc.frameWidth));
    uint tileY = min(11u, uint(y) * 12u / max(1u, pc.frameHeight));

    residualCandidates[base + 0u] = hp.x;
    residualCandidates[base + 1u] = hp.y;
    residualCandidates[base + 2u] = hp.z;
    residualCandidates[base + 3u] = structure;
    residualCandidates[base + 4u] = float(tileY * 16u + tileX);
    // Keep the compact record at eight floats: invalid records remain 0.0, while valid
    // records encode 1.0 + center linear luma in slot 5 (range [1,2]).
    residualCandidates[base + 5u] = 1.0 + clamp(center.x, 0.0, 1.0);
    residualCandidates[base + 6u] = center.y;
    residualCandidates[base + 7u] = center.z;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (pc.mode == 4u) {
        writeResidualCandidate(gid, false); // POST_DEMOSAIC_RGB: outputRgb is authoritative.
        return;
    }
    if (pc.mode == 11u) {
        writeResidualCandidate(gid, true); // POST_COLOUR_TRANSFORM_RGB: colorRgb is authoritative.
        return;
    }

    bool inside = gid.x < pc.frameWidth && gid.y < pc.frameHeight;
    uint localIndex = gl_LocalInvocationIndex;

    if (pc.mode == 5u) {
        if (!inside) return;
        amazeGuidePass(int(gid.x), int(gid.y));
        return;
    }

    if (pc.mode == 6u) {
        if (!inside) return;
        vec3 rgb = amazeReconstructAt(int(gid.x), int(gid.y));
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    if (pc.mode == 7u) {
        if (!inside) return;
        amazeGuidePass(int(gid.x), int(gid.y));
        return;
    }

    if (pc.mode == 8u) {
        if (!inside) return;
        vec3 rgb = autoHybridAt(int(gid.x), int(gid.y));
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    if (pc.mode < 3u) {
        if (!inside) return;
        int x = int(gid.x);
        int y = int(gid.y);
        vec3 rgb = pc.mode == 0u ? bilinearAt(x, y) : malvarAt(x, y);
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    vec3 raw = vec3(0.0);
    vec3 wb = vec3(0.0);
    vec3 ccm = vec3(0.0);
    vec2 cloudAppliedOpponent = vec2(0.0);
    if (inside) {
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        vec3 rawInput = vec3(outputRgb[index + 0u], outputRgb[index + 1u], outputRgb[index + 2u]);
        raw = rawInput; // Immutable pre-WB sensor-domain/demosaic RGB for classification and stats.
        uint sensorClipMask = phase9SensorClipMask(rawInput);
        int sensorClipChannels = phase9BitCount3(sensorClipMask);
        float legacyDemosaicConfidence = phase9ColorConfidence(rawInput, sensorClipMask);
        bool legacyConfidenceCandidate = legacyDemosaicConfidence < 0.999999;
        if (legacyConfidenceCandidate) atomicAdd(colorTelemetry[0], 1u);
        if (sensorClipChannels == 1) atomicAdd(colorTelemetry[1], 1u);
        if (sensorClipChannels >= 2) atomicAdd(colorTelemetry[2], 1u);
        if (sensorClipChannels == 3) atomicAdd(colorTelemetry[10], 1u);
        if (legacyDemosaicConfidence > 1.0e-6 && legacyDemosaicConfidence < 0.999999) {
            atomicAdd(colorTelemetry[11], 1u);
        }

        bool sourceRawConfidence = phase9SourceRawConfidenceAvailable();
        float sourceColorConfidence = sourceRawConfidence
                ? phase9SourceRawColorConfidence(int(gid.x), int(gid.y))
                : legacyDemosaicConfidence;
        if (sourceRawConfidence) {
            if (sourceColorConfidence < 0.999999) atomicAdd(colorTelemetry[12], 1u);
            if (sourceColorConfidence <= 1.0e-6) atomicAdd(colorTelemetry[13], 1u);
            if (sourceColorConfidence > 1.0e-6 && sourceColorConfidence < 0.999999) {
                atomicAdd(colorTelemetry[14], 1u);
            }
            if (abs(sourceColorConfidence - legacyDemosaicConfidence) > 0.05) {
                atomicAdd(colorTelemetry[15], 1u);
            }
        }
        float colorConfidence = sourceRawConfidence
                ? sourceColorConfidence
                : legacyDemosaicConfidence;

        // Always-on developed-RAW baseline. This is independent of SPECTRA and does not
        // filter green/luma. The global plan came from physical S/O + compact residual evidence;
        // this shader makes a second local signal-vs-noise decision before touching R-G/B-G.
        vec3 rawForWb = baselineDetailPreservingChromaAt(
                int(gid.x), int(gid.y), rawInput, cloudAppliedOpponent);

        // Counterfactual only: distinguishes WB-induced over-unity and old post-CCM magenta risk
        // from actual sensor-domain clipping. Neither condition is treated as lost sensor data.
        vec3 legacyWb = rawForWb * vec3(pc.wbR, pc.wbG, pc.wbB);
        if (sensorClipChannels == 0 && any(greaterThan(legacyWb, vec3(1.0)))) {
            atomicAdd(colorTelemetry[3], 1u);
        }
        vec3 legacySignedCcm = vec3(
                pc.ccm0 * legacyWb.r + pc.ccm1 * legacyWb.g + pc.ccm2 * legacyWb.b,
                pc.ccm3 * legacyWb.r + pc.ccm4 * legacyWb.g + pc.ccm5 * legacyWb.b,
                pc.ccm6 * legacyWb.r + pc.ccm7 * legacyWb.g + pc.ccm8 * legacyWb.b);
        // Keep Phase-7/8 compact means on their previously verified domain. Production pixels use
        // the Phase-9 protected path below, but these diagnostics remain pre-Phase9 counterfactuals.
        wb = legacyWb;
        ccm = max(legacySignedCcm, vec3(0.0));
        if (phase9MagentaRisk(ccm)) atomicAdd(colorTelemetry[7], 1u);

        // ClippingAwareHighlightColor: WB and the camera matrix operate normally. D124 feeds
        // the safety mix from generation-matched source-Bayer clipping provenance captured
        // before RAW-finalize lens/exposure mutations. The demosaiced ceiling detector above
        // remains diagnostic/fallback only. This cannot change luminance or exposure.
        vec3 signedCcm = legacySignedCcm;
        bool originalCcmExcursion = min(signedCcm.r, min(signedCcm.g, signedCcm.b)) < -1.0e-6;
        if (originalCcmExcursion) atomicAdd(colorTelemetry[4], 1u);
        bool confidenceApplied = false;
        vec3 confidenceSafeCcm = phase9ApplyClippingAwareHighlightColor(
                signedCcm, colorConfidence, confidenceApplied);
        if (confidenceApplied) atomicAdd(colorTelemetry[5], 1u);

        // Keep the paired DNG PCS transform signed until the optional HSM has crossed into
        // the wider RIMM domain. Clamping/compressing negative linear-sRGB components before
        // the HSM would throw away valid profile gamut. The existing lower-gamut guard remains
        // the sole output safety owner and runs once after camera characterization.
        vec3 profileInputCcm = confidenceSafeCcm;
        bool calibratedHueSatApplied = false;
        vec3 profileCcm = applyCalibratedDngHueSatMap(profileInputCcm, calibratedHueSatApplied);
        if (calibratedHueSatApplied) atomicAdd(colorTelemetry[16], 1u);

        bool profileExcursion = false;
        bool profileGamutCompressed = false;
        vec3 protectedCcm = phase9ProtectSignedCcmLowerGamut(
                profileCcm, profileExcursion, profileGamutCompressed);
        if (profileGamutCompressed) atomicAdd(colorTelemetry[6], 1u);
        if (phase9MagentaRisk(protectedCcm)) atomicAdd(colorTelemetry[8], 1u);
        if (max(protectedCcm.r, max(protectedCcm.g, protectedCcm.b)) > 1.0) atomicAdd(colorTelemetry[9], 1u);

        colorRgb[index + 0u] = finiteLinear(protectedCcm.r);
        colorRgb[index + 1u] = finiteLinear(protectedCcm.g);
        colorRgb[index + 2u] = finiteLinear(protectedCcm.b);
    }

    sumRawR[localIndex] = inside ? raw.r : 0.0;
    sumRawG[localIndex] = inside ? raw.g : 0.0;
    sumRawB[localIndex] = inside ? raw.b : 0.0;
    sumWbR[localIndex] = inside ? wb.r : 0.0;
    sumWbG[localIndex] = inside ? wb.g : 0.0;
    sumWbB[localIndex] = inside ? wb.b : 0.0;
    sumCcmR[localIndex] = inside ? ccm.r : 0.0;
    sumCcmG[localIndex] = inside ? ccm.g : 0.0;
    sumCcmB[localIndex] = inside ? ccm.b : 0.0;
    sumCloudAbsRG[localIndex] = inside ? abs(cloudAppliedOpponent.x) : 0.0;
    sumCloudAbsBG[localIndex] = inside ? abs(cloudAppliedOpponent.y) : 0.0;
    sumCloudAffected[localIndex] = inside &&
            max(abs(cloudAppliedOpponent.x), abs(cloudAppliedOpponent.y)) > 1.0e-7 ? 1.0 : 0.0;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            uint other = localIndex + stride;
            sumRawR[localIndex] += sumRawR[other];
            sumRawG[localIndex] += sumRawG[other];
            sumRawB[localIndex] += sumRawB[other];
            sumWbR[localIndex] += sumWbR[other];
            sumWbG[localIndex] += sumWbG[other];
            sumWbB[localIndex] += sumWbB[other];
            sumCcmR[localIndex] += sumCcmR[other];
            sumCcmG[localIndex] += sumCcmG[other];
            sumCcmB[localIndex] += sumCcmB[other];
            sumCloudAbsRG[localIndex] += sumCloudAbsRG[other];
            sumCloudAbsBG[localIndex] += sumCloudAbsBG[other];
            sumCloudAffected[localIndex] += sumCloudAffected[other];
        }
        barrier();
    }
    if (localIndex == 0u) {
        uint groupsX = (pc.frameWidth + 15u) / 16u;
        uint groupIndex = gl_WorkGroupID.y * groupsX + gl_WorkGroupID.x;
        uint base = groupIndex * 12u;
        colorStats[base + 0u] = sumRawR[0];
        colorStats[base + 1u] = sumRawG[0];
        colorStats[base + 2u] = sumRawB[0];
        colorStats[base + 3u] = sumWbR[0];
        colorStats[base + 4u] = sumWbG[0];
        colorStats[base + 5u] = sumWbB[0];
        colorStats[base + 6u] = sumCcmR[0];
        colorStats[base + 7u] = sumCcmG[0];
        colorStats[base + 8u] = sumCcmB[0];
        colorStats[base + 9u] = sumCloudAbsRG[0];
        colorStats[base + 10u] = sumCloudAbsBG[0];
        colorStats[base + 11u] = sumCloudAffected[0];
    }
}
