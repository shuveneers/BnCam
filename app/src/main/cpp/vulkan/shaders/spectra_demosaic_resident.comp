#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputMosaic { float inputMosaic[]; };
layout(std430, binding = 1) buffer DemosaicRgb { float outputRgb[]; };
layout(std430, binding = 2) writeonly buffer ColorRgb { float colorRgb[]; };
layout(std430, binding = 3) writeonly buffer ColorStats { float colorStats[]; };
layout(std430, binding = 4) writeonly buffer ResidualCandidates { float residualCandidates[]; };
// Delta 46 transport-only binding. Record = (R-G correction, B-G correction, valid, reserved).
layout(std430, binding = 5) readonly buffer CloudCorrectionMap { vec4 cloudCorrectionMap[]; };

layout(push_constant) uniform Params {
    uint frameWidth;
    uint frameHeight;
    uint cfaPattern;
    uint mode; // 0 bilinear, 1 Malvar Inspired, 2 RCD Inspired, 3 AWB+CCM, 4 residual, 5 AMAZE Inspired
    float wbR;
    float wbG;
    float wbB;
    float padding0;
    float ccm0; float ccm1; float ccm2; float ccm3;
    float ccm4; float ccm5; float ccm6; float ccm7;
    // In demosaic modes padding1..3 transport physical noiseSigmaY,
    // noiseSigmaChroma and noisePressure respectively. Mode 3 continues to use
    // ccm0..ccm8 only, so the fixed 128-byte push layout remains unchanged.
    float ccm8; float padding1; float padding2; float padding3;
    uint residualStride;
    uint residualColumns;
    uint residualRows;
    uint padding4;
    // Delta 25+ evidence contract. Malvar/RCD/AMAZE Inspired consume it only in reconstructed
    // R/B chroma paths; sampled CFA values and each algorithm's green/luma reconstruction stay unchanged.
    // Demosaic modes: immutable CFA evidence contract. Mode 3 (AWB+CCM) reuses
    // cfaEvidence0.xy for bounded pre-WB R-G/B-G cleanup maxima after demosaic is complete.
    vec4 cfaEvidence0; // demosaic: available/common/structure/fine; mode3: localBlendR/localBlendB/cloudReady/cloudMaxAbs
    vec4 cfaEvidence1; // midConfidence, lowConfidence, redOpponentConfidence, blueOpponentConfidence
} pc;

shared float sumRawR[256]; shared float sumRawG[256]; shared float sumRawB[256];
shared float sumWbR[256];  shared float sumWbG[256];  shared float sumWbB[256];
shared float sumCcmR[256]; shared float sumCcmG[256]; shared float sumCcmB[256];
shared float sumCloudAbsRG[256]; shared float sumCloudAbsBG[256]; shared float sumCloudAffected[256];

int safeCoord(int v, int n) { return clamp(v, 0, n - 1); }

int reflectIndexHalfSample(int value, int length) {
    if (length <= 1) return 0;
    int v = value;
    // The kernels only reach two pixels outside the frame, but keeping this generic mirrors
    // OpenCV BORDER_REFLECT (half-sample symmetric) used by the CPU bilinear oracle.
    for (int i = 0; i < 8 && (v < 0 || v >= length); ++i) {
        v = v < 0 ? -v - 1 : 2 * length - v - 1;
    }
    return clamp(v, 0, length - 1);
}

uint cfaColorAt(uint pattern, int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    uint p = min(pattern, 3u);
    if (p == 0u) return ym == 0 ? (xm == 0 ? 0u : 1u) : (xm == 0 ? 1u : 2u); // RGGB
    if (p == 1u) return ym == 0 ? (xm == 0 ? 1u : 0u) : (xm == 0 ? 2u : 1u); // GRBG
    if (p == 2u) return ym == 0 ? (xm == 0 ? 1u : 2u) : (xm == 0 ? 0u : 1u); // GBRG
    return ym == 0 ? (xm == 0 ? 2u : 1u) : (xm == 0 ? 1u : 0u); // BGGR
}

float sampleClamped(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return inputMosaic[uint(sy) * pc.frameWidth + uint(sx)];
}

float sampleBilinearChannelReflect(int x, int y, uint channel) {
    int sx = reflectIndexHalfSample(x, int(pc.frameWidth));
    int sy = reflectIndexHalfSample(y, int(pc.frameHeight));
    if (cfaColorAt(pc.cfaPattern, sx, sy) != channel) return 0.0;
    return inputMosaic[uint(sy) * pc.frameWidth + uint(sx)];
}

float finiteLinear(float value) {
    return isinf(value) || isnan(value) ? 0.0 : value;
}

float demosaicNoiseSigmaY() {
    return max(0.0, finiteLinear(pc.padding1));
}

float demosaicNoiseSigmaChroma() {
    return max(0.0, finiteLinear(pc.padding2));
}

float demosaicNoisePressure() {
    return clamp(finiteLinear(pc.padding3), 0.0, 1.0);
}

vec3 bilinearAt(int x, int y) {
    bool border = x == 0 || y == 0 || x == int(pc.frameWidth) - 1 || y == int(pc.frameHeight) - 1;
    if (border) {
        float rCenter = 4.0 * sampleBilinearChannelReflect(x, y, 0u);
        float rAxial = 2.0 * (sampleBilinearChannelReflect(x - 1, y, 0u) +
                              sampleBilinearChannelReflect(x + 1, y, 0u) +
                              sampleBilinearChannelReflect(x, y - 1, 0u) +
                              sampleBilinearChannelReflect(x, y + 1, 0u));
        float rDiagonal = sampleBilinearChannelReflect(x - 1, y - 1, 0u) +
                          sampleBilinearChannelReflect(x + 1, y - 1, 0u) +
                          sampleBilinearChannelReflect(x - 1, y + 1, 0u) +
                          sampleBilinearChannelReflect(x + 1, y + 1, 0u);
        float bCenter = 4.0 * sampleBilinearChannelReflect(x, y, 2u);
        float bAxial = 2.0 * (sampleBilinearChannelReflect(x - 1, y, 2u) +
                              sampleBilinearChannelReflect(x + 1, y, 2u) +
                              sampleBilinearChannelReflect(x, y - 1, 2u) +
                              sampleBilinearChannelReflect(x, y + 1, 2u));
        float bDiagonal = sampleBilinearChannelReflect(x - 1, y - 1, 2u) +
                          sampleBilinearChannelReflect(x + 1, y - 1, 2u) +
                          sampleBilinearChannelReflect(x - 1, y + 1, 2u) +
                          sampleBilinearChannelReflect(x + 1, y + 1, 2u);
        float g = 0.25 * (4.0 * sampleBilinearChannelReflect(x, y, 1u) +
                          sampleBilinearChannelReflect(x - 1, y, 1u) +
                          sampleBilinearChannelReflect(x + 1, y, 1u) +
                          sampleBilinearChannelReflect(x, y - 1, 1u) +
                          sampleBilinearChannelReflect(x, y + 1, 1u));
        return vec3(finiteLinear(0.25 * (rCenter + rAxial + rDiagonal)),
                    finiteLinear(g),
                    finiteLinear(0.25 * (bCenter + bAxial + bDiagonal)));
    }

    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float c = sampleClamped(x, y);
    float r; float g; float b;
    if (color == 0u) {
        r = c;
        g = 0.25 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1) +
                    sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
        b = 0.25 * (sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                    sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1));
    } else if (color == 2u) {
        b = c;
        g = 0.25 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1) +
                    sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
        r = 0.25 * (sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                    sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1));
    } else {
        g = c;
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        if (horizontalRed) {
            r = 0.5 * (sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
            b = 0.5 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1));
        } else {
            b = 0.5 * (sampleClamped(x - 1, y) + sampleClamped(x + 1, y));
            r = 0.5 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1));
        }
    }
    return vec3(finiteLinear(r), finiteLinear(g), finiteLinear(b));
}

float malvarChromaRisk(uint channel) {
    if (pc.cfaEvidence0.x < 0.5 || (channel != 0u && channel != 2u)) return 0.0;
    float bandPressure = clamp(
            0.30 * pc.cfaEvidence0.w +
            0.40 * pc.cfaEvidence1.x +
            0.30 * pc.cfaEvidence1.y,
            0.0, 1.0);
    float opponentPressure = channel == 0u ? pc.cfaEvidence1.z : pc.cfaEvidence1.w;
    float structureRelief = 1.0 - 0.45 * clamp(pc.cfaEvidence0.z, 0.0, 1.0);
    return clamp((0.70 * bandPressure + 0.30 * clamp(opponentPressure, 0.0, 1.0)) *
                 structureRelief, 0.0, 1.0);
}

float malvarRobustMissingColor(int x, int y, uint channel) {
    uint centerColor = cfaColorAt(pc.cfaPattern, x, y);
    if (centerColor == channel) return sampleClamped(x, y);
    if (centerColor == 1u) {
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        bool horizontal = channel == 0u ? horizontalRed : !horizontalRed;
        return horizontal
                ? 0.5 * (sampleClamped(x - 1, y) + sampleClamped(x + 1, y))
                : 0.5 * (sampleClamped(x, y - 1) + sampleClamped(x, y + 1));
    }
    return 0.25 * (sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                   sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1));
}

float malvarStabilizeMissingColor(int x, int y, uint channel, float baseline, float chromaRisk) {
    if (cfaColorAt(pc.cfaPattern, x, y) == channel || chromaRisk <= 0.0) return baseline;
    float robust = malvarRobustMissingColor(x, y, channel);
    float risk = clamp(chromaRisk, 0.0, 1.0);
    float blend = 0.14 * risk;
    float sigma = demosaicNoiseSigmaChroma();
    if (sigma > 1.0e-6) {
        float z = abs(baseline - robust) / sigma;
        float noiseLike = 1.0 - smoothstep(1.50, 4.00, z);
        float noiseSupport = max(demosaicNoisePressure(), smoothstep(7.5e-4, 6.0e-3, sigma));
        blend += 0.12 * risk * noiseLike * noiseSupport;
    }
    return finiteLinear(mix(baseline, robust, clamp(blend, 0.0, 0.26)));
}

vec3 malvarAt(int x, int y) {
    const float scale = 0.125;
    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float c = sampleClamped(x, y);
    float axial1 = sampleClamped(x - 1, y) + sampleClamped(x + 1, y) +
                   sampleClamped(x, y - 1) + sampleClamped(x, y + 1);
    float axial2 = sampleClamped(x - 2, y) + sampleClamped(x + 2, y) +
                   sampleClamped(x, y - 2) + sampleClamped(x, y + 2);
    float diagonals = sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                      sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1);
    float greenRB = (4.0 * c + 2.0 * axial1 - axial2) * scale;
    float oppositeRB = (6.0 * c + 2.0 * diagonals - 1.5 * axial2) * scale;
    float horizontal1 = sampleClamped(x - 1, y) + sampleClamped(x + 1, y);
    float horizontal2 = sampleClamped(x - 2, y) + sampleClamped(x + 2, y);
    float vertical1 = sampleClamped(x, y - 1) + sampleClamped(x, y + 1);
    float vertical2 = sampleClamped(x, y - 2) + sampleClamped(x, y + 2);
    float chromaH = (5.0 * c + 4.0 * horizontal1 - horizontal2 - diagonals + 0.5 * vertical2) * scale;
    float chromaV = (5.0 * c + 4.0 * vertical1 - vertical2 - diagonals + 0.5 * horizontal2) * scale;

    float r; float g; float b;
    if (color == 0u) {
        r = c; g = greenRB; b = oppositeRB;
    } else if (color == 2u) {
        r = oppositeRB; g = greenRB; b = c;
    } else {
        g = c;
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        r = horizontalRed ? chromaH : chromaV;
        b = horizontalRed ? chromaV : chromaH;
    }
    r = malvarStabilizeMissingColor(x, y, 0u, r, malvarChromaRisk(0u));
    b = malvarStabilizeMissingColor(x, y, 2u, b, malvarChromaRisk(2u));
    return vec3(finiteLinear(r), finiteLinear(g), finiteLinear(b));
}


float rcdLowPass(int x, int y) {
    float corners = sampleClamped(x - 1, y - 1) + sampleClamped(x + 1, y - 1) +
                    sampleClamped(x - 1, y + 1) + sampleClamped(x + 1, y + 1);
    float axial = sampleClamped(x - 1, y) + sampleClamped(x + 1, y) +
                  sampleClamped(x, y - 1) + sampleClamped(x, y + 1);
    return (4.0 * sampleClamped(x, y) + 2.0 * axial + corners) * (1.0 / 16.0);
}

float rcdRatioGreen(float adjacentGreen, float centerLowPass, float farLowPass) {
    const float epsilon = 1.0e-5;
    float denominator = centerLowPass + farLowPass;
    if (abs(denominator) < epsilon) denominator = denominator < 0.0 ? -epsilon : epsilon;
    float correction = clamp((centerLowPass - farLowPass) / denominator, -0.75, 0.75);
    float sigma = demosaicNoiseSigmaY();
    if (sigma > 1.0e-7) {
        float localSignal = abs(centerLowPass) + abs(farLowPass);
        correction *= smoothstep(2.5 * sigma, 8.0 * sigma, localSignal);
    }
    return finiteLinear(adjacentGreen * (1.0 + correction));
}

float rcdWeight(float gradient) {
    float sigma = demosaicNoiseSigmaY();
    float support = max(demosaicNoisePressure(), smoothstep(7.5e-4, 6.0e-3, demosaicNoiseSigmaChroma()));
    float debiasedGradient = max(0.0, gradient - 1.25 * sigma);
    float adaptiveFloor = max(2.0e-4, 0.70 * sigma * support);
    float stabilized = adaptiveFloor + debiasedGradient;
    return 1.0 / max(1.0e-12, stabilized * stabilized);
}

// Delta 26: only RCD missing-chroma interpolation consumes the Delta-25 CFA evidence.
// Green reconstruction remains identical to Delta 25.
float rcdNoiseAwareChromaRisk(uint channel) {
    if (pc.cfaEvidence0.x < 0.5 || (channel != 0u && channel != 2u)) return 0.0;
    float bandPressure = clamp(0.45 * pc.cfaEvidence0.w +
                               0.35 * pc.cfaEvidence1.x +
                               0.20 * pc.cfaEvidence1.y, 0.0, 1.0);
    float opponentPressure = channel == 0u ? pc.cfaEvidence1.z : pc.cfaEvidence1.w;
    float structureRelief = 1.0 - 0.35 * clamp(pc.cfaEvidence0.z, 0.0, 1.0);
    return clamp((0.65 * bandPressure + 0.35 * clamp(opponentPressure, 0.0, 1.0)) *
                 structureRelief, 0.0, 1.0);
}

float rcdChromaWeight(float gradient, float chromaRisk) {
    float risk = clamp(chromaRisk, 0.0, 1.0);
    float sigma = demosaicNoiseSigmaChroma();
    float support = max(demosaicNoisePressure(), smoothstep(7.5e-4, 6.0e-3, sigma));
    float floorValue = max(2.0e-4 + 4.0e-4 * risk, 0.65 * sigma * support);
    float debiasedGradient = max(0.0, gradient - 1.10 * sigma);
    float stabilized = floorValue + debiasedGradient;
    return 1.0 / max(1.0e-12, stabilized * stabilized);
}

float rcdGreenAt(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    if (cfaColorAt(pc.cfaPattern, sx, sy) == 1u) return sampleClamped(sx, sy);

    float centerLp = rcdLowPass(sx, sy);
    float west = rcdRatioGreen(sampleClamped(sx - 1, sy), centerLp, rcdLowPass(sx - 2, sy));
    float east = rcdRatioGreen(sampleClamped(sx + 1, sy), centerLp, rcdLowPass(sx + 2, sy));
    float north = rcdRatioGreen(sampleClamped(sx, sy - 1), centerLp, rcdLowPass(sx, sy - 2));
    float south = rcdRatioGreen(sampleClamped(sx, sy + 1), centerLp, rcdLowPass(sx, sy + 2));
    float hGradient = abs(rcdLowPass(sx - 2, sy) - rcdLowPass(sx + 2, sy)) +
                      0.5 * abs(sampleClamped(sx - 1, sy) - sampleClamped(sx + 1, sy));
    float vGradient = abs(rcdLowPass(sx, sy - 2) - rcdLowPass(sx, sy + 2)) +
                      0.5 * abs(sampleClamped(sx, sy - 1) - sampleClamped(sx, sy + 1));
    float wH = rcdWeight(hGradient);
    float wV = rcdWeight(vGradient);
    float green = (wH * 0.5 * (west + east) + wV * 0.5 * (north + south)) / max(1.0e-8, wH + wV);
    float localMin = min(min(sampleClamped(sx - 1, sy), sampleClamped(sx + 1, sy)),
                         min(sampleClamped(sx, sy - 1), sampleClamped(sx, sy + 1)));
    float localMax = max(max(sampleClamped(sx - 1, sy), sampleClamped(sx + 1, sy)),
                         max(sampleClamped(sx, sy - 1), sampleClamped(sx, sy + 1)));
    float guard = 0.10 * max(1.0e-5, localMax - localMin);
    return finiteLinear(clamp(green, localMin - guard, localMax + guard));
}

float rcdAxialColor(int x, int y, uint channel, bool horizontal, float centerGreen) {
    float chromaRisk = rcdNoiseAwareChromaRisk(channel);
    int dx = horizontal ? 1 : 0;
    int dy = horizontal ? 0 : 1;
    int x0 = safeCoord(x - dx, int(pc.frameWidth));
    int y0 = safeCoord(y - dy, int(pc.frameHeight));
    int x1 = safeCoord(x + dx, int(pc.frameWidth));
    int y1 = safeCoord(y + dy, int(pc.frameHeight));
    float g0 = rcdGreenAt(x0, y0);
    float g1 = rcdGreenAt(x1, y1);
    bool valid0 = cfaColorAt(pc.cfaPattern, x0, y0) == channel;
    bool valid1 = cfaColorAt(pc.cfaPattern, x1, y1) == channel;
    float d0 = valid0 ? sampleClamped(x0, y0) - g0 : 0.0;
    float d1 = valid1 ? sampleClamped(x1, y1) - g1 : 0.0;
    float w0 = rcdChromaWeight(abs(centerGreen - g0), chromaRisk);
    float w1 = rcdChromaWeight(abs(centerGreen - g1), chromaRisk);
    float weightedDifference = (w0 * d0 + w1 * d1) / max(1.0e-8, w0 + w1);
    float robustDifference = valid0 && valid1 ? 0.5 * (d0 + d1) : weightedDifference;
    float robustBlend = 0.18 * clamp(chromaRisk, 0.0, 1.0);
    float difference = mix(weightedDifference, robustDifference, robustBlend);
    return finiteLinear(centerGreen + difference);
}

float rcdDiagonalColor(int x, int y, uint channel, float centerGreen) {
    float chromaRisk = rcdNoiseAwareChromaRisk(channel);
    ivec2 offsets[4] = ivec2[4](ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1));
    float weightedDifference = 0.0;
    float totalWeight = 0.0;
    float simpleDifference = 0.0;
    float validDifferenceCount = 0.0;
    for (int i = 0; i < 4; ++i) {
        int sx = safeCoord(x + offsets[i].x, int(pc.frameWidth));
        int sy = safeCoord(y + offsets[i].y, int(pc.frameHeight));
        if (cfaColorAt(pc.cfaPattern, sx, sy) != channel) continue;
        float neighborGreen = rcdGreenAt(sx, sy);
        float difference = sampleClamped(sx, sy) - neighborGreen;
        float weight = rcdChromaWeight(abs(centerGreen - neighborGreen), chromaRisk);
        weightedDifference += weight * difference;
        totalWeight += weight;
        simpleDifference += difference;
        validDifferenceCount += 1.0;
    }
    float directionalDifference = weightedDifference / max(1.0e-8, totalWeight);
    float robustDifference = validDifferenceCount > 0.0
        ? simpleDifference / validDifferenceCount : directionalDifference;
    float robustBlend = 0.18 * clamp(chromaRisk, 0.0, 1.0);
    float difference = mix(directionalDifference, robustDifference, robustBlend);
    return finiteLinear(centerGreen + difference);
}

vec3 rcdAt(int x, int y) {
    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float sampled = sampleClamped(x, y);
    float g = rcdGreenAt(x, y);
    float r;
    float b;
    if (color == 0u) {
        r = sampled;
        b = rcdDiagonalColor(x, y, 2u, g);
    } else if (color == 2u) {
        b = sampled;
        r = rcdDiagonalColor(x, y, 0u, g);
    } else {
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        r = rcdAxialColor(x, y, 0u, horizontalRed, g);
        b = rcdAxialColor(x, y, 2u, !horizontalRed, g);
    }
    return vec3(finiteLinear(r), finiteLinear(g), finiteLinear(b));
}


float amazeWeight(float gradient) {
    float sigma = demosaicNoiseSigmaY();
    float support = max(demosaicNoisePressure(), smoothstep(7.5e-4, 6.0e-3, demosaicNoiseSigmaChroma()));
    float debiasedGradient = max(0.0, gradient - 1.10 * sigma);
    float adaptiveFloor = max(1.5e-4, 0.55 * sigma * support);
    float stabilized = adaptiveFloor + debiasedGradient;
    return 1.0 / max(1.0e-12, stabilized * stabilized);
}

float amazeRetainHighOrderDetail(float term) {
    float sigma = demosaicNoiseSigmaY();
    if (sigma <= 1.0e-6) return term;
    float z = abs(term) / sigma;
    return term * smoothstep(1.25, 3.75, z);
}

float amazeChromaRisk(uint channel) {
    if (pc.cfaEvidence0.x < 0.5 || (channel != 0u && channel != 2u)) return 0.0;
    float bandPressure = clamp(
            0.55 * pc.cfaEvidence0.w +
            0.30 * pc.cfaEvidence1.x +
            0.15 * pc.cfaEvidence1.y,
            0.0, 1.0);
    float opponentPressure = channel == 0u ? pc.cfaEvidence1.z : pc.cfaEvidence1.w;
    float structureRelief = 1.0 - 0.30 * clamp(pc.cfaEvidence0.z, 0.0, 1.0);
    return clamp((0.60 * bandPressure + 0.40 * clamp(opponentPressure, 0.0, 1.0)) *
                 structureRelief, 0.0, 1.0);
}

float amazeChromaWeight(float gradient, float chromaRisk) {
    float risk = clamp(chromaRisk, 0.0, 1.0);
    float sigma = demosaicNoiseSigmaChroma();
    float support = max(demosaicNoisePressure(), smoothstep(7.5e-4, 6.0e-3, sigma));
    float floorValue = max(1.5e-4 + 5.0e-4 * risk, 0.60 * sigma * support);
    float debiasedGradient = max(0.0, gradient - 1.00 * sigma);
    float stabilized = floorValue + debiasedGradient;
    return 1.0 / max(1.0e-12, stabilized * stabilized);
}

float amazeGreenAt(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    if (cfaColorAt(pc.cfaPattern, sx, sy) == 1u) return sampleClamped(sx, sy);

    float center = sampleClamped(sx, sy);
    float left = sampleClamped(sx - 1, sy);
    float right = sampleClamped(sx + 1, sy);
    float up = sampleClamped(sx, sy - 1);
    float down = sampleClamped(sx, sy + 1);
    float left2 = sampleClamped(sx - 2, sy);
    float right2 = sampleClamped(sx + 2, sy);
    float up2 = sampleClamped(sx, sy - 2);
    float down2 = sampleClamped(sx, sy + 2);

    float hSecond = 2.0 * center - left2 - right2;
    float vSecond = 2.0 * center - up2 - down2;
    float hCandidate = 0.5 * (left + right) + 0.25 * amazeRetainHighOrderDetail(hSecond);
    float vCandidate = 0.5 * (up + down) + 0.25 * amazeRetainHighOrderDetail(vSecond);
    float hGradient = abs(left - right) + abs(2.0 * center - left2 - right2) +
                      0.5 * (abs(left2 - left) + abs(right2 - right));
    float vGradient = abs(up - down) + abs(2.0 * center - up2 - down2) +
                      0.5 * (abs(up2 - up) + abs(down2 - down));
    float wH = amazeWeight(hGradient);
    float wV = amazeWeight(vGradient);
    float green = (wH * hCandidate + wV * vCandidate) / max(1.0e-8, wH + wV);

    float diagonalEnergy = abs(sampleClamped(sx - 1, sy - 1) - sampleClamped(sx + 1, sy + 1)) +
                           abs(sampleClamped(sx + 1, sy - 1) - sampleClamped(sx - 1, sy + 1));
    float gradientSum = hGradient + vGradient + 1.0e-6;
    float anisotropy = abs(hGradient - vGradient) / gradientSum;
    if (diagonalEnergy > 1.10 * gradientSum && anisotropy < 0.18) {
        green = 0.75 * green + 0.25 * malvarAt(sx, sy).g;
    }

    float localMin = min(min(left, right), min(up, down));
    float localMax = max(max(left, right), max(up, down));
    float guard = 0.15 * max(1.0e-5, localMax - localMin);
    return finiteLinear(clamp(green, localMin - guard, localMax + guard));
}

float amazeAxialColor(int x, int y, uint channel, bool horizontal, float centerGreen) {
    float risk = amazeChromaRisk(channel);
    int dx = horizontal ? 1 : 0;
    int dy = horizontal ? 0 : 1;
    int x0 = safeCoord(x - dx, int(pc.frameWidth));
    int y0 = safeCoord(y - dy, int(pc.frameHeight));
    int x1 = safeCoord(x + dx, int(pc.frameWidth));
    int y1 = safeCoord(y + dy, int(pc.frameHeight));
    float g0 = amazeGreenAt(x0, y0);
    float g1 = amazeGreenAt(x1, y1);
    float d0 = cfaColorAt(pc.cfaPattern, x0, y0) == channel ? sampleClamped(x0, y0) - g0 : 0.0;
    float d1 = cfaColorAt(pc.cfaPattern, x1, y1) == channel ? sampleClamped(x1, y1) - g1 : 0.0;
    float differenceDisagreement = abs(d0 - d1);
    float disagreementWeight = 0.35 + 0.20 * risk;
    float w0 = amazeChromaWeight(abs(centerGreen - g0) + disagreementWeight * differenceDisagreement, risk);
    float w1 = amazeChromaWeight(abs(centerGreen - g1) + disagreementWeight * differenceDisagreement, risk);
    float directionalDifference = (w0 * d0 + w1 * d1) / max(1.0e-8, w0 + w1);
    bool bothSamplesValid = cfaColorAt(pc.cfaPattern, x0, y0) == channel &&
                            cfaColorAt(pc.cfaPattern, x1, y1) == channel;
    float robustDifference = bothSamplesValid ? 0.5 * (d0 + d1) : directionalDifference;
    float robustBlend = 0.22 * risk;
    float difference = directionalDifference + robustBlend * (robustDifference - directionalDifference);
    return finiteLinear(centerGreen + difference);
}

float amazeDiagonalColor(int x, int y, uint channel, float centerGreen) {
    ivec2 offsets[4] = ivec2[4](ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1));
    float risk = amazeChromaRisk(channel);
    float disagreementWeight = 0.30 + 0.25 * risk;
    float weightedDifference = 0.0;
    float totalWeight = 0.0;
    float simpleDifference = 0.0;
    float validDifferenceCount = 0.0;
    for (int i = 0; i < 4; ++i) {
        int sx = safeCoord(x + offsets[i].x, int(pc.frameWidth));
        int sy = safeCoord(y + offsets[i].y, int(pc.frameHeight));
        if (cfaColorAt(pc.cfaPattern, sx, sy) != channel) continue;
        float neighborGreen = amazeGreenAt(sx, sy);
        float difference = sampleClamped(sx, sy) - neighborGreen;
        int ox = safeCoord(x - offsets[i].x, int(pc.frameWidth));
        int oy = safeCoord(y - offsets[i].y, int(pc.frameHeight));
        float oppositeGreen = amazeGreenAt(ox, oy);
        float oppositeDifference = cfaColorAt(pc.cfaPattern, ox, oy) == channel
                ? sampleClamped(ox, oy) - oppositeGreen : difference;
        float gradient = abs(centerGreen - neighborGreen) +
                         disagreementWeight * abs(difference - oppositeDifference);
        float weight = amazeChromaWeight(gradient, risk);
        weightedDifference += weight * difference;
        totalWeight += weight;
        simpleDifference += difference;
        validDifferenceCount += 1.0;
    }
    float directionalDifference = weightedDifference / max(1.0e-8, totalWeight);
    float robustDifference = validDifferenceCount > 0.0
            ? simpleDifference / validDifferenceCount
            : directionalDifference;
    float robustBlend = 0.22 * risk;
    float difference = directionalDifference + robustBlend * (robustDifference - directionalDifference);
    return finiteLinear(centerGreen + difference);
}

vec3 amazeAt(int x, int y) {
    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float sampled = sampleClamped(x, y);
    float g = amazeGreenAt(x, y);
    float r;
    float b;
    if (color == 0u) {
        r = sampled;
        b = amazeDiagonalColor(x, y, 2u, g);
    } else if (color == 2u) {
        b = sampled;
        r = amazeDiagonalColor(x, y, 0u, g);
    } else {
        bool horizontalRed = cfaColorAt(pc.cfaPattern, x - 1, y) == 0u;
        r = amazeAxialColor(x, y, 0u, horizontalRed, g);
        b = amazeAxialColor(x, y, 2u, !horizontalRed, g);
    }
    return vec3(finiteLinear(r), finiteLinear(g), finiteLinear(b));
}


vec3 residentRgbAt(int x, int y) {
    int sx = clamp(x, 0, int(pc.frameWidth) - 1);
    int sy = clamp(y, 0, int(pc.frameHeight) - 1);
    uint index = (uint(sy) * pc.frameWidth + uint(sx)) * 3u;
    return vec3(outputRgb[index + 0u], outputRgb[index + 1u], outputRgb[index + 2u]);
}

vec3 opponentAtRgb(vec3 pixel) {
    return vec3(
            0.2126 * pixel.r + 0.7152 * pixel.g + 0.0722 * pixel.b,
            pixel.r - pixel.g,
            pixel.b - pixel.g);
}

// Delta 47: spatially varying low-frequency opponent correction. The map is already
// median-centred and risk/authority bounded on CPU. The shader adds only local structural
// safeguards; green is never changed by this correction.
vec2 samplePreWbCloudCorrection(int x, int y, out float support) {
    support = 0.0;
    if (pc.cfaEvidence0.z <= 0.5 || pc.cfaEvidence0.w <= 0.0) return vec2(0.0);
    const float gridCols = 16.0;
    const float gridRows = 12.0;
    float gx = clamp(((float(x) + 0.5) / max(1.0, float(pc.frameWidth))) * gridCols - 0.5,
                     0.0, gridCols - 1.0);
    float gy = clamp(((float(y) + 0.5) / max(1.0, float(pc.frameHeight))) * gridRows - 0.5,
                     0.0, gridRows - 1.0);
    int x0 = int(floor(gx));
    int y0 = int(floor(gy));
    int x1 = min(x0 + 1, 15);
    int y1 = min(y0 + 1, 11);
    float tx = gx - float(x0);
    float ty = gy - float(y0);
    vec4 r00 = cloudCorrectionMap[y0 * 16 + x0];
    vec4 r10 = cloudCorrectionMap[y0 * 16 + x1];
    vec4 r01 = cloudCorrectionMap[y1 * 16 + x0];
    vec4 r11 = cloudCorrectionMap[y1 * 16 + x1];
    float w00 = (1.0 - tx) * (1.0 - ty) * step(0.5, r00.z);
    float w10 = tx * (1.0 - ty) * step(0.5, r10.z);
    float w01 = (1.0 - tx) * ty * step(0.5, r01.z);
    float w11 = tx * ty * step(0.5, r11.z);
    support = w00 + w10 + w01 + w11;
    if (support < 0.25) return vec2(0.0);
    vec2 correction = (w00 * r00.xy + w10 * r10.xy + w01 * r01.xy + w11 * r11.xy) /
                      max(support, 1.0e-5);
    float maxAbs = clamp(pc.cfaEvidence0.w, 0.0, 0.010);
    return clamp(correction, vec2(-maxAbs), vec2(maxAbs));
}

vec3 preWbCloudCorrect(int x, int y, vec3 center) {
    float mapSupport = 0.0;
    vec2 correction = samplePreWbCloudCorrection(x, y, mapSupport);
    if (mapSupport < 0.25 || max(abs(correction.x), abs(correction.y)) <= 1.0e-7) return center;

    vec3 left = residentRgbAt(x - 1, y);
    vec3 right = residentRgbAt(x + 1, y);
    vec3 up = residentRgbAt(x, y - 1);
    vec3 down = residentRgbAt(x, y + 1);
    float maxGreenDelta = max(max(abs(center.g - left.g), abs(center.g - right.g)),
                              max(abs(center.g - up.g), abs(center.g - down.g)));
    float greenScale = 0.015 + 0.18 * max(center.g, 0.0);
    float structureGate = 1.0 - smoothstep(0.18, 0.90, maxGreenDelta / greenScale);

    vec2 oppL = vec2(left.r - left.g, left.b - left.g);
    vec2 oppR = vec2(right.r - right.g, right.b - right.g);
    vec2 oppU = vec2(up.r - up.g, up.b - up.g);
    vec2 oppD = vec2(down.r - down.g, down.b - down.g);
    vec2 opponentMin = min(min(oppL, oppR), min(oppU, oppD));
    vec2 opponentMax = max(max(oppL, oppR), max(oppU, oppD));
    vec2 opponentSpan = opponentMax - opponentMin;
    float chromaScale = 0.020 + 0.08 * max(center.g, 0.0);
    vec2 colourEdgeGate = vec2(1.0) - smoothstep(
            vec2(chromaScale), vec2(4.0 * chromaScale), opponentSpan);

    vec2 guarded = correction * structureGate * colourEdgeGate;
    vec3 corrected = center;
    corrected.r = max(0.0, center.r + guarded.x);
    corrected.b = max(0.0, center.b + guarded.y);
    return vec3(finiteLinear(corrected.r), finiteLinear(center.g), finiteLinear(corrected.b));
}

// Delta 35: conservative pre-WB opponent stabilization fused into the existing AWB+CCM
// dispatch. The requested blend is already globally bounded by SPECTRA evidence; local green
// structure and opponent span can only reduce it further. Green/luma is never reconstructed here.
vec3 preWbOpponentStabilize(int x, int y, vec3 center) {
    float requestedR = clamp(pc.cfaEvidence0.x, 0.0, 0.12);
    float requestedB = clamp(pc.cfaEvidence0.y, 0.0, 0.12);
    if (max(requestedR, requestedB) <= 0.0001) return center;

    vec3 left = residentRgbAt(x - 1, y);
    vec3 right = residentRgbAt(x + 1, y);
    vec3 up = residentRgbAt(x, y - 1);
    vec3 down = residentRgbAt(x, y + 1);

    float maxGreenDelta = max(max(abs(center.g - left.g), abs(center.g - right.g)),
                              max(abs(center.g - up.g), abs(center.g - down.g)));
    float greenScale = 0.015 + 0.18 * max(center.g, 0.0);
    float structureGate = 1.0 - smoothstep(0.18, 0.90, maxGreenDelta / greenScale);

    // Neighbours on a different luminance side contribute less to the opponent target.
    float wl = 1.0 / (1.0 + 4.0 * pow(abs(center.g - left.g) / greenScale, 2.0));
    float wr = 1.0 / (1.0 + 4.0 * pow(abs(center.g - right.g) / greenScale, 2.0));
    float wu = 1.0 / (1.0 + 4.0 * pow(abs(center.g - up.g) / greenScale, 2.0));
    float wd = 1.0 / (1.0 + 4.0 * pow(abs(center.g - down.g) / greenScale, 2.0));
    float weightSum = max(1.0e-5, wl + wr + wu + wd);

    vec2 oppL = vec2(left.r - left.g, left.b - left.g);
    vec2 oppR = vec2(right.r - right.g, right.b - right.g);
    vec2 oppU = vec2(up.r - up.g, up.b - up.g);
    vec2 oppD = vec2(down.r - down.g, down.b - down.g);
    vec2 targetOpponent = (wl * oppL + wr * oppR + wu * oppU + wd * oppD) / weightSum;

    vec2 opponentMin = min(min(oppL, oppR), min(oppU, oppD));
    vec2 opponentMax = max(max(oppL, oppR), max(oppU, oppD));
    vec2 opponentSpan = opponentMax - opponentMin;
    float chromaScale = 0.020 + 0.08 * max(center.g, 0.0);
    vec2 colourEdgeGate = vec2(1.0) - smoothstep(
            vec2(chromaScale), vec2(4.0 * chromaScale), opponentSpan);

    float blendR = requestedR * structureGate * colourEdgeGate.x;
    float blendB = requestedB * structureGate * colourEdgeGate.y;
    vec3 stabilized = center;
    stabilized.r = max(0.0, mix(center.r, center.g + targetOpponent.x, blendR));
    stabilized.b = max(0.0, mix(center.b, center.g + targetOpponent.y, blendB));
    return vec3(finiteLinear(stabilized.r), finiteLinear(center.g), finiteLinear(stabilized.b));
}

bool finiteBoundedRgb(vec3 pixel) {
    return all(not(isnan(pixel))) && all(not(isinf(pixel))) &&
           all(greaterThan(pixel, vec3(-0.05))) && all(lessThan(pixel, vec3(0.98)));
}

void writeResidualCandidate(uvec2 sampleGid) {
    if (sampleGid.x >= pc.residualColumns || sampleGid.y >= pc.residualRows) return;
    uint sampleIndex = sampleGid.y * pc.residualColumns + sampleGid.x;
    uint base = sampleIndex * 8u;
    residualCandidates[base + 0u] = 0.0;
    residualCandidates[base + 1u] = 0.0;
    residualCandidates[base + 2u] = 0.0;
    residualCandidates[base + 3u] = 0.0;
    residualCandidates[base + 4u] = 0.0;
    residualCandidates[base + 5u] = 0.0;
    residualCandidates[base + 6u] = 0.0;
    residualCandidates[base + 7u] = 0.0;

    int x = 2 + int(sampleGid.x * pc.residualStride);
    int y = 2 + int(sampleGid.y * pc.residualStride);
    if (x >= int(pc.frameWidth) - 2 || y >= int(pc.frameHeight) - 2) return;

    vec3 centerPixel = residentRgbAt(x, y);
    vec3 leftPixel = residentRgbAt(x - 1, y);
    vec3 rightPixel = residentRgbAt(x + 1, y);
    vec3 upPixel = residentRgbAt(x, y - 1);
    vec3 downPixel = residentRgbAt(x, y + 1);
    if (!finiteBoundedRgb(centerPixel) || !finiteBoundedRgb(leftPixel) ||
        !finiteBoundedRgb(rightPixel) || !finiteBoundedRgb(upPixel) ||
        !finiteBoundedRgb(downPixel)) return;

    vec3 center = opponentAtRgb(centerPixel);
    vec3 left = opponentAtRgb(leftPixel);
    vec3 right = opponentAtRgb(rightPixel);
    vec3 up = opponentAtRgb(upPixel);
    vec3 down = opponentAtRgb(downPixel);
    if (center.x < 0.008 || center.x > 0.90) return;

    vec3 hp = center - 0.25 * (left + right + up + down);
    if (any(isnan(hp)) || any(isinf(hp))) return;
    vec3 maxDelta = max(max(abs(center - left), abs(center - right)),
                        max(abs(center - up), abs(center - down)));
    float structure = max(maxDelta.x, 0.45 * max(maxDelta.y, maxDelta.z));
    uint tileX = min(15u, uint(x) * 16u / max(1u, pc.frameWidth));
    uint tileY = min(11u, uint(y) * 12u / max(1u, pc.frameHeight));

    residualCandidates[base + 0u] = hp.x;
    residualCandidates[base + 1u] = hp.y;
    residualCandidates[base + 2u] = hp.z;
    residualCandidates[base + 3u] = structure;
    residualCandidates[base + 4u] = float(tileY * 16u + tileX);
    // Keep the compact record at eight floats: invalid records remain 0.0, while valid
    // records encode 1.0 + center linear luma in slot 5 (range [1,2]).
    residualCandidates[base + 5u] = 1.0 + clamp(center.x, 0.0, 1.0);
    residualCandidates[base + 6u] = center.y;
    residualCandidates[base + 7u] = center.z;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (pc.mode == 4u) {
        writeResidualCandidate(gid);
        return;
    }

    bool inside = gid.x < pc.frameWidth && gid.y < pc.frameHeight;
    uint localIndex = gl_LocalInvocationIndex;

    if (pc.mode < 3u || pc.mode == 5u) {
        if (!inside) return;
        int x = int(gid.x);
        int y = int(gid.y);
        vec3 rgb = pc.mode == 0u ? bilinearAt(x, y) :
                   (pc.mode == 1u ? malvarAt(x, y) :
                   (pc.mode == 2u ? rcdAt(x, y) : amazeAt(x, y)));
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    vec3 raw = vec3(0.0);
    vec3 wb = vec3(0.0);
    vec3 ccm = vec3(0.0);
    vec2 cloudAppliedOpponent = vec2(0.0);
    if (inside) {
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        vec3 rawInput = vec3(outputRgb[index + 0u], outputRgb[index + 1u], outputRgb[index + 2u]);
        raw = rawInput; // Preserve legacy pre-WB statistics on the demosaic output itself.
        vec3 locallyStabilized = preWbOpponentStabilize(int(gid.x), int(gid.y), rawInput);
        vec3 rawForWb = preWbCloudCorrect(int(gid.x), int(gid.y), locallyStabilized);
        cloudAppliedOpponent = vec2(
                rawForWb.r - locallyStabilized.r,
                rawForWb.b - locallyStabilized.b);
        wb = rawForWb * vec3(pc.wbR, pc.wbG, pc.wbB);
        ccm = max(vec3(0.0), vec3(
                pc.ccm0 * wb.r + pc.ccm1 * wb.g + pc.ccm2 * wb.b,
                pc.ccm3 * wb.r + pc.ccm4 * wb.g + pc.ccm5 * wb.b,
                pc.ccm6 * wb.r + pc.ccm7 * wb.g + pc.ccm8 * wb.b));
        colorRgb[index + 0u] = finiteLinear(ccm.r);
        colorRgb[index + 1u] = finiteLinear(ccm.g);
        colorRgb[index + 2u] = finiteLinear(ccm.b);
    }

    sumRawR[localIndex] = inside ? raw.r : 0.0;
    sumRawG[localIndex] = inside ? raw.g : 0.0;
    sumRawB[localIndex] = inside ? raw.b : 0.0;
    sumWbR[localIndex] = inside ? wb.r : 0.0;
    sumWbG[localIndex] = inside ? wb.g : 0.0;
    sumWbB[localIndex] = inside ? wb.b : 0.0;
    sumCcmR[localIndex] = inside ? ccm.r : 0.0;
    sumCcmG[localIndex] = inside ? ccm.g : 0.0;
    sumCcmB[localIndex] = inside ? ccm.b : 0.0;
    sumCloudAbsRG[localIndex] = inside ? abs(cloudAppliedOpponent.x) : 0.0;
    sumCloudAbsBG[localIndex] = inside ? abs(cloudAppliedOpponent.y) : 0.0;
    sumCloudAffected[localIndex] = inside &&
            max(abs(cloudAppliedOpponent.x), abs(cloudAppliedOpponent.y)) > 1.0e-7 ? 1.0 : 0.0;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            uint other = localIndex + stride;
            sumRawR[localIndex] += sumRawR[other];
            sumRawG[localIndex] += sumRawG[other];
            sumRawB[localIndex] += sumRawB[other];
            sumWbR[localIndex] += sumWbR[other];
            sumWbG[localIndex] += sumWbG[other];
            sumWbB[localIndex] += sumWbB[other];
            sumCcmR[localIndex] += sumCcmR[other];
            sumCcmG[localIndex] += sumCcmG[other];
            sumCcmB[localIndex] += sumCcmB[other];
            sumCloudAbsRG[localIndex] += sumCloudAbsRG[other];
            sumCloudAbsBG[localIndex] += sumCloudAbsBG[other];
            sumCloudAffected[localIndex] += sumCloudAffected[other];
        }
        barrier();
    }
    if (localIndex == 0u) {
        uint groupsX = (pc.frameWidth + 15u) / 16u;
        uint groupIndex = gl_WorkGroupID.y * groupsX + gl_WorkGroupID.x;
        uint base = groupIndex * 12u;
        colorStats[base + 0u] = sumRawR[0];
        colorStats[base + 1u] = sumRawG[0];
        colorStats[base + 2u] = sumRawB[0];
        colorStats[base + 3u] = sumWbR[0];
        colorStats[base + 4u] = sumWbG[0];
        colorStats[base + 5u] = sumWbB[0];
        colorStats[base + 6u] = sumCcmR[0];
        colorStats[base + 7u] = sumCcmG[0];
        colorStats[base + 8u] = sumCcmB[0];
        colorStats[base + 9u] = sumCloudAbsRG[0];
        colorStats[base + 10u] = sumCloudAbsBG[0];
        colorStats[base + 11u] = sumCloudAffected[0];
    }
}
