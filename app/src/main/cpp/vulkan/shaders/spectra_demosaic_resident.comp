vec3 neuralJddResidualAt(int x, int y) {
    float features[34];
    for (int i = 0; i < 34; ++i) features[i] = 0.0;
    int featureIndex = 0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            features[featureIndex++] = sampleClamped(x + dx, y + dy);
        }
    }
    int sitePhase = ((y & 1) << 1) | (x & 1);
    features[25 + sitePhase] = 1.0;
    features[29 + int(min(pc.cfaPattern, 3u))] = 1.0;
    features[33] = clamp(demosaicNoiseSigmaChroma(), 0.0, 0.05);

    float hidden1[12];
    for (int i = 0; i < 12; ++i) {
        float sum = JDD_B1[i];
        for (int j = 0; j < 34; ++j) sum += JDD_W1[i * 34 + j] * features[j];
        hidden1[i] = max(0.0, sum);
    }
    float hidden2[6];
    for (int i = 0; i < 6; ++i) {
        float sum = JDD_B2[i];
        for (int j = 0; j < 12; ++j) sum += JDD_W2[i * 12 + j] * hidden1[j];
        hidden2[i] = max(0.0, sum);
    }
    vec3 residual = vec3(JDD_B3[0], JDD_B3[1], JDD_B3[2]);
    for (int channel = 0; channel < 3; ++channel) {
        float sum = residual[channel];
        for (int j = 0; j < 6; ++j) sum += JDD_W3[channel * 6 + j] * hidden2[j];
        residual[channel] = clamp(sum, -0.25, 0.25);
    }
    return vec3(finiteLinear(residual.r), finiteLinear(residual.g), finiteLinear(residual.b));

}

vec3 neuralJddAt(int x, int y) {
    vec3 baseline = malvarAt(x, y);
    vec3 value = baseline + neuralJddResidualAt(x, y);
    return vec3(finiteLinear(value.r), finiteLinear(value.g), finiteLinear(value.b));
}

float amazeSigmaY() { return demosaicNoiseSigmaY(); }
float amazeSigmaChroma() { return demosaicNoiseSigmaChroma(); }

float amazeRetainHighOrderDetail(float term) {
    float sigma = amazeSigmaY();
    if (sigma <= 1.0e-7) return term;
    float z = abs(term) / max(1.0e-6, sigma);
    float t = clamp((z - 1.25) / 2.50, 0.0, 1.0);
    float retention = t * t * (3.0 - 2.0 * t);
    return term * retention;
}

float amazeChromaRisk(uint channel) {
    if (pc.cfaEvidence0.x < 0.5 || (channel != 0u && channel != 2u)) return 0.0;
    float band = clamp(0.55 * pc.cfaEvidence0.w + 0.30 * pc.cfaEvidence1.x +
                       0.15 * pc.cfaEvidence1.y, 0.0, 1.0);
    float opponent = channel == 0u ? pc.cfaEvidence1.z : pc.cfaEvidence1.w;
    float relief = 1.0 - 0.30 * clamp(pc.cfaEvidence0.z, 0.0, 1.0);
    return clamp((0.60 * band + 0.40 * clamp(opponent, 0.0, 1.0)) * relief, 0.0, 1.0);
}

float amazeAdaptiveOneSided(float center, float adjacentGreen, float farSame, float ha) {
    const float eps = 1.0e-5;
    if (center * farSame <= 0.0 || abs(farSame) <= eps) return ha;
    float ratio = center / farSame;
    if (!(ratio > 0.20 && ratio < 5.00) || isnan(ratio) || isinf(ratio)) return ha;
    float geometric = adjacentGreen * sqrt(max(0.0, ratio));
    float logDistance = abs(log2(max(ratio, eps)));
    float t = clamp((logDistance - 0.45) / 0.80, 0.0, 1.0);
    float reliability = 1.0 - t * t * (3.0 - 2.0 * t);
    return finiteLinear(ha + 0.45 * reliability * (geometric - ha));
}

vec2 amazeAxisGuide(int x, int y, bool horizontal) {
    int dx = horizontal ? 1 : 0;
    int dy = horizontal ? 0 : 1;
    float center = sampleClamped(x, y);
    float n = sampleClamped(x - dx, y - dy);
    float p = sampleClamped(x + dx, y + dy);
    float fn = sampleClamped(x - 2 * dx, y - 2 * dy);
    float fp = sampleClamped(x + 2 * dx, y + 2 * dy);
    float curvature = amazeRetainHighOrderDetail(2.0 * center - fn - fp);
    float ha = 0.5 * (n + p) + 0.25 * curvature;
    float han = n + 0.5 * amazeRetainHighOrderDetail(center - fn);
    float hap = p + 0.5 * amazeRetainHighOrderDetail(center - fp);
    float an = amazeAdaptiveOneSided(center, n, fn, han);
    float ap = amazeAdaptiveOneSided(center, p, fp, hap);
    float sigma = amazeSigmaY();
    float costN = max(1.0e-5, abs(n - p) + abs(center - fn) +
                      0.5 * abs(n - sampleClamped(x - 3 * dx, y - 3 * dy)) - 1.10 * sigma);
    float costP = max(1.0e-5, abs(n - p) + abs(center - fp) +
                      0.5 * abs(p - sampleClamped(x + 3 * dx, y + 3 * dy)) - 1.10 * sigma);
    float wn = 1.0 / (costN * costN + 1.0e-10);
    float wp = 1.0 / (costP * costP + 1.0e-10);
    float adaptive = (wn * an + wp * ap) / max(1.0e-8, wn + wp);
    float texture = abs(fn - fp) + abs(n - p);
    float t = clamp((texture - (0.015 + 2.0 * sigma)) /
                    max(1.0e-6, (0.080 + 8.0 * sigma) - (0.015 + 2.0 * sigma)), 0.0, 1.0);
    float adaptiveAuthority = 1.0 - t * t * (3.0 - 2.0 * t);
    float g = finiteLinear(ha + 0.55 * adaptiveAuthority * (adaptive - ha));
    float cost = max(1.0e-5, abs(n - p) + 0.65 * abs(curvature) +
                     0.35 * abs(fn - fp) - 0.90 * sigma);
    return vec2(g, cost);
}

float amazeNyquistPreScore(int x, int y) {
    float c = sampleClamped(x, y);
    float h2 = abs(2.0 * c - sampleClamped(x - 2, y) - sampleClamped(x + 2, y));
    float v2 = abs(2.0 * c - sampleClamped(x, y - 2) - sampleClamped(x, y + 2));
    float h1 = abs(sampleClamped(x - 1, y) - sampleClamped(x + 1, y));
    float v1 = abs(sampleClamped(x, y - 1) - sampleClamped(x, y + 1));
    float d1 = abs(sampleClamped(x - 1, y - 1) - sampleClamped(x + 1, y + 1));
    float d2 = abs(sampleClamped(x + 1, y - 1) - sampleClamped(x - 1, y + 1));
    float axial = h2 + v2 + 0.50 * (h1 + v1);
    float anisotropy = abs((h2 + 0.5 * h1) - (v2 + 0.5 * v1)) /
                       max(1.0e-6, h2 + v2 + 0.5 * (h1 + v1));
    float isotropy = 1.0 - clamp(anisotropy, 0.0, 1.0);
    float sigma = amazeSigmaY();
    float energy = axial + 0.45 * (d1 + d2);
    float e0 = 0.004 + 3.0 * sigma;
    float e1 = 0.035 + 12.0 * sigma;
    float et = clamp((energy - e0) / max(1.0e-6, e1 - e0), 0.0, 1.0);
    float energyGate = et * et * (3.0 - 2.0 * et);
    float it = clamp((isotropy - 0.35) / 0.47, 0.0, 1.0);
    float isotropyGate = it * it * (3.0 - 2.0 * it);
    return clamp(energyGate * isotropyGate, 0.0, 1.0);
}

void amazeGuidePass(int x, int y) {
    uint idx = uint(y) * pc.frameWidth + uint(x);
    uint base = idx * 3u;
    uint color = cfaColorAt(pc.cfaPattern, x, y);
    float nyq = amazeNyquistPreScore(x, y);
    float green;
    if (color == 1u) {
        green = sampleClamped(x, y);
    } else {
        vec2 h = amazeAxisGuide(x, y, true);
        vec2 v = amazeAxisGuide(x, y, false);
        float wh = 1.0 / (h.y * h.y + 1.0e-10);
        float wv = 1.0 / (v.y * v.y + 1.0e-10);
        green = (wh * h.x + wv * v.x) / max(1.0e-8, wh + wv);
        green += 0.25 * nyq * (0.5 * (h.x + v.x) - green);
        float left = sampleClamped(x - 1, y);
        float right = sampleClamped(x + 1, y);
        float up = sampleClamped(x, y - 1);
        float down = sampleClamped(x, y + 1);
        float lo = min(min(left, right), min(up, down));
        float hi = max(max(left, right), max(up, down));
        float guard = max(3.0 * amazeSigmaY(), 0.18 * max(1.0e-5, hi - lo));
        green = clamp(green, lo - guard, hi + guard);
    }
    float gx = abs(sampleClamped(x + 1, y) - sampleClamped(x - 1, y));
    float gy = abs(sampleClamped(x, y + 1) - sampleClamped(x, y - 1));
    float gd1 = abs(sampleClamped(x + 1, y + 1) - sampleClamped(x - 1, y - 1));
    float gd2 = abs(sampleClamped(x + 1, y - 1) - sampleClamped(x - 1, y + 1));
    float sigma = amazeSigmaY();
    float structureRaw = 0.40 * max(gx, gy) + 0.25 * min(gx, gy) + 0.175 * (gd1 + gd2);
    float structureLo = 0.012 + 2.5 * sigma;
    float structureHi = 0.095 + 9.0 * sigma;
    float structure = smoothstep(structureLo, max(structureLo + 1.0e-5, structureHi), structureRaw);
    colorRgb[base + 0u] = finiteLinear(green);
    colorRgb[base + 1u] = nyq;
    colorRgb[base + 2u] = clamp(structure, 0.0, 1.0);
}

float amazeGuideGreen(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return colorRgb[(uint(sy) * pc.frameWidth + uint(sx)) * 3u + 0u];
}

float amazeGuideNyquist(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return clamp(colorRgb[(uint(sy) * pc.frameWidth + uint(sx)) * 3u + 1u], 0.0, 1.0);
}

float amazeSmoothedNyquist(int x, int y) {
    return clamp(0.50 * amazeGuideNyquist(x, y) + 0.125 * (
            amazeGuideNyquist(x - 2, y) + amazeGuideNyquist(x + 2, y) +
            amazeGuideNyquist(x, y - 2) + amazeGuideNyquist(x, y + 2)), 0.0, 1.0);
}

float amazeGuideStructure(int x, int y) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    return clamp(colorRgb[(uint(sy) * pc.frameWidth + uint(sx)) * 3u + 2u], 0.0, 1.0);
}

float autoHybridSmoothedStructure(int x, int y) {
    return clamp(0.50 * amazeGuideStructure(x, y) + 0.125 * (
            amazeGuideStructure(x - 2, y) + amazeGuideStructure(x + 2, y) +
            amazeGuideStructure(x, y - 2) + amazeGuideStructure(x, y + 2)), 0.0, 1.0);
}

bool amazeDifferenceAt(int x, int y, uint channel, out float difference) {
    int sx = safeCoord(x, int(pc.frameWidth));
    int sy = safeCoord(y, int(pc.frameHeight));
    if (cfaColorAt(pc.cfaPattern, sx, sy) != channel) return false;
    difference = sampleClamped(sx, sy) - amazeGuideGreen(sx, sy);
    return !(isnan(difference) || isinf(difference));
}

float amazeChromaWeight(float greenDelta, float disagreement, float risk) {
    float sigma = amazeSigmaChroma();
    float gradient = max(0.0, greenDelta + (0.30 + 0.25 * risk) * disagreement - sigma);
    float floorValue = max(1.5e-4 + 5.0e-4 * risk, 0.60 * sigma);
    float v = floorValue + gradient;
    return 1.0 / max(1.0e-12, v * v);
}

float amazeClamp4(float value, vec4 samples) {
    float lo = min(min(samples.x, samples.y), min(samples.z, samples.w));
    float hi = max(max(samples.x, samples.y), max(samples.z, samples.w));
    float guard = max(3.0 * amazeSigmaChroma(), 0.18 * max(1.0e-6, hi - lo));
    return clamp(value, lo - guard, hi + guard);
}

float amazeAxialDifference(int x, int y, uint channel, bool horizontal) {
    int dx = horizontal ? 1 : 0;
    int dy = horizontal ? 0 : 1;
    float dm=0.0, dp=0.0, dm3=0.0, dp3=0.0;
    bool vm = amazeDifferenceAt(x - dx, y - dy, channel, dm);
    bool vp = amazeDifferenceAt(x + dx, y + dy, channel, dp);
    if (!vm && vp) dm = dp;
    if (!vp && vm) dp = dm;
    if (!vm && !vp) return 0.0;
    if (!amazeDifferenceAt(x - 3 * dx, y - 3 * dy, channel, dm3)) dm3 = dm;
    if (!amazeDifferenceAt(x + 3 * dx, y + 3 * dy, channel, dp3)) dp3 = dp;
    float gc = amazeGuideGreen(x, y);
    float gm = amazeGuideGreen(x - dx, y - dy);
    float gp = amazeGuideGreen(x + dx, y + dy);
    float risk = amazeChromaRisk(channel);
    float disagreement = abs(dm - dp);
    float wm = amazeChromaWeight(abs(gc - gm), disagreement, risk);
    float wp = amazeChromaWeight(abs(gc - gp), disagreement, risk);
    float nearEstimate = (wm * dm + wp * dp) / max(1.0e-8, wm + wp);
    float highOrder = (-dm3 + 9.0 * dm + 9.0 * dp - dp3) * (1.0 / 16.0);
    float sigma = amazeSigmaChroma();
    float tex = abs(gm - gp) + disagreement;
    float t = clamp((tex - (0.010 + 2.0 * sigma)) /
                    max(1.0e-6, (0.060 + 8.0 * sigma) - (0.010 + 2.0 * sigma)), 0.0, 1.0);
    float smoothAuthority = 1.0 - t * t * (3.0 - 2.0 * t);
    float d = nearEstimate + 0.30 * smoothAuthority * (1.0 - risk) * (highOrder - nearEstimate);
    float area = 0.375 * (dm + dp) + 0.125 * (dm3 + dp3);
    d += 0.68 * amazeSmoothedNyquist(x, y) * (area - d);
    return amazeClamp4(d, vec4(dm, dp, dm3, dp3));
}

float amazeDiagonalDifference(int x, int y, uint channel) {
    float dNW=0.0,dNE=0.0,dSW=0.0,dSE=0.0;
    bool vNW=amazeDifferenceAt(x-1,y-1,channel,dNW);
    bool vNE=amazeDifferenceAt(x+1,y-1,channel,dNE);
    bool vSW=amazeDifferenceAt(x-1,y+1,channel,dSW);
    bool vSE=amazeDifferenceAt(x+1,y+1,channel,dSE);
    float mean = 0.0; float count = 0.0;
    if(vNW){mean+=dNW;count+=1.0;} if(vNE){mean+=dNE;count+=1.0;}
    if(vSW){mean+=dSW;count+=1.0;} if(vSE){mean+=dSE;count+=1.0;}
    if(count<0.5) return 0.0;
    mean/=count;
    if(!vNW)dNW=mean; if(!vNE)dNE=mean; if(!vSW)dSW=mean; if(!vSE)dSE=mean;
    float fNW=dNW,fNE=dNE,fSW=dSW,fSE=dSE;
    if(!amazeDifferenceAt(x-3,y-3,channel,fNW))fNW=dNW;
    if(!amazeDifferenceAt(x+3,y-3,channel,fNE))fNE=dNE;
    if(!amazeDifferenceAt(x-3,y+3,channel,fSW))fSW=dSW;
    if(!amazeDifferenceAt(x+3,y+3,channel,fSE))fSE=dSE;
    float diagA=0.5*(dNW+dSE), diagB=0.5*(dNE+dSW);
    float gNW=amazeGuideGreen(x-1,y-1),gNE=amazeGuideGreen(x+1,y-1);
    float gSW=amazeGuideGreen(x-1,y+1),gSE=amazeGuideGreen(x+1,y+1);
    float risk=amazeChromaRisk(channel); float disagreement=abs(diagA-diagB);
    float wA=amazeChromaWeight(abs(gNW-gSE),disagreement,risk);
    float wB=amazeChromaWeight(abs(gNE-gSW),disagreement,risk);
    float d=(wA*diagA+wB*diagB)/max(1.0e-8,wA+wB);
    float highA=(-fNW+9.0*dNW+9.0*dSE-fSE)*(1.0/16.0);
    float highB=(-fNE+9.0*dNE+9.0*dSW-fSW)*(1.0/16.0);
    float sigma=amazeSigmaChroma();
    float tex=abs(gNW-gSE)+abs(gNE-gSW)+disagreement;
    float t=clamp((tex-(0.012+2.0*sigma))/max(1.0e-6,(0.070+8.0*sigma)-(0.012+2.0*sigma)),0.0,1.0);
    float smoothAuthority=1.0-t*t*(3.0-2.0*t);
    float high=(wA*highA+wB*highB)/max(1.0e-8,wA+wB);
    d+=0.24*smoothAuthority*(1.0-risk)*(high-d);
    float area=0.1875*(dNW+dNE+dSW+dSE)+0.0625*(fNW+fNE+fSW+fSE);
    d+=0.72*amazeSmoothedNyquist(x,y)*(area-d);
    float nearClamp=amazeClamp4(d,vec4(dNW,dNE,dSW,dSE));
    float farLo=min(min(fNW,fNE),min(fSW,fSE));
    float farHi=max(max(fNW,fNE),max(fSW,fSE));
    float guard=max(3.0*amazeSigmaChroma(),0.18*max(1.0e-6,farHi-farLo));
    return clamp(nearClamp,farLo-guard,farHi+guard);
}

vec3 amazeReconstructAt(int x, int y) {
    uint color=cfaColorAt(pc.cfaPattern,x,y);
    float g=amazeGuideGreen(x,y);
    float r=g,b=g;
    if(color==0u){ r=sampleClamped(x,y); b=g+amazeDiagonalDifference(x,y,2u); }
    else if(color==2u){ b=sampleClamped(x,y); r=g+amazeDiagonalDifference(x,y,0u); }
    else {
        bool horizontalRed=cfaColorAt(pc.cfaPattern,x-1,y)==0u;
        r=g+amazeAxialDifference(x,y,0u,horizontalRed);
        b=g+amazeAxialDifference(x,y,2u,!horizontalRed);
    }
    return vec3(finiteLinear(r),finiteLinear(g),finiteLinear(b));
}

vec3 autoHybridGlobalPrior() {
    vec3 prior = max(vec3(pc.ccm0, pc.ccm1, pc.ccm2), vec3(0.0));
    float sum = prior.r + prior.g + prior.b;
    return sum > 1.0e-6 ? prior / sum : vec3(1.0 / 3.0);
}

float autoHybridSecondLargest(vec3 v) {
    float hi = max(v.r, max(v.g, v.b));
    float lo = min(v.r, min(v.g, v.b));
    return v.r + v.g + v.b - hi - lo;
}

vec3 autoHybridAt(int x, int y) {
    vec3 prior = autoHybridGlobalPrior();
    float structure = autoHybridSmoothedStructure(x, y);
    float nyquist = amazeSmoothedNyquist(x, y);
    float noise = demosaicNoisePressure();
    float chromaRisk = 0.5 * (amazeChromaRisk(0u) + amazeChromaRisk(2u));
    float center = clamp(sampleClamped(x, y), 0.0, 1.0);
    float lowSignal = 1.0 - smoothstep(0.035, 0.18, center);

    // Local evidence modifies, but never replaces, the global prior. Malvar is the stable
    // anchor, Neural JDD receives authority in noisy/chroma-risk regions, and AMaZE receives
    // authority on coherent high-frequency/Nyquist structure when noise pressure is controlled.
    float malvar = prior.r * (0.86 + 0.30 * noise + 0.16 * chromaRisk +
                              0.10 * lowSignal + 0.08 * (1.0 - structure));
    float neural = prior.g * (0.78 + 0.62 * noise + 0.24 * chromaRisk +
                              0.16 * lowSignal + 0.10 * structure - 0.18 * nyquist);
    float amaze = prior.b * (0.74 + 0.58 * structure + 0.72 * nyquist -
                             0.42 * noise - 0.18 * chromaRisk - 0.08 * lowSignal);
    vec3 weights = max(vec3(malvar, neural, amaze), vec3(0.015));
    weights /= max(1.0e-6, weights.r + weights.g + weights.b);

    // Spatial confidence regularization: structure/Nyquist are already 5-point smoothed. This
    // dominance dead-band pulls near-ties toward the scene prior, suppressing patch boundaries
    // and winner flicker without creating a hard regional selector.
    float top = max(weights.r, max(weights.g, weights.b));
    float second = autoHybridSecondLargest(weights);
    float nearTie = 1.0 - smoothstep(0.045, 0.16, top - second);
    weights = mix(weights, prior, 0.35 * nearTie);
    weights = max(weights, 0.035 * prior);
    weights /= max(1.0e-6, weights.r + weights.g + weights.b);

    vec3 malvarRgb = malvarAt(x, y);
    vec3 neuralRgb = malvarRgb + neuralJddResidualAt(x, y);
    vec3 amazeRgb = amazeReconstructAt(x, y);
    vec3 value = weights.r * malvarRgb + weights.g * neuralRgb + weights.b * amazeRgb;
    return vec3(finiteLinear(value.r), finiteLinear(value.g), finiteLinear(value.b));
}


vec3 residentRgbAt(int x, int y) {
    int sx = clamp(x, 0, int(pc.frameWidth) - 1);
    int sy = clamp(y, 0, int(pc.frameHeight) - 1);
    uint index = (uint(sy) * pc.frameWidth + uint(sx)) * 3u;
    return vec3(outputRgb[index + 0u], outputRgb[index + 1u], outputRgb[index + 2u]);
}

vec3 colorRgbAt(int x, int y) {
    int sx = clamp(x, 0, int(pc.frameWidth) - 1);
    int sy = clamp(y, 0, int(pc.frameHeight) - 1);
    uint index = (uint(sy) * pc.frameWidth + uint(sx)) * 3u;
    return vec3(colorRgb[index + 0u], colorRgb[index + 1u], colorRgb[index + 2u]);
}

const float PHASE9_SENSOR_CLIP_THRESHOLD = 0.985; // hard-clip telemetry threshold only
const float PHASE9_COLOR_CONFIDENCE_START = 0.960;
const float PHASE9_COLOR_CONFIDENCE_ZERO = 0.995;

uint phase9SensorClipMask(vec3 raw) {
    uint mask = 0u;
    if (raw.r >= PHASE9_SENSOR_CLIP_THRESHOLD) mask |= 1u;
    if (raw.g >= PHASE9_SENSOR_CLIP_THRESHOLD) mask |= 2u;
    if (raw.b >= PHASE9_SENSOR_CLIP_THRESHOLD) mask |= 4u;
    return mask;
}

int phase9BitCount3(uint mask) {
    return int((mask & 1u) != 0u) + int((mask & 2u) != 0u) + int((mask & 4u) != 0u);
}

float phase9Luma(vec3 rgb) {
    return 0.2126 * rgb.r + 0.7152 * rgb.g + 0.0722 * rgb.b;
}

bool phase9MagentaRisk(vec3 rgb) {
    float maximum = max(rgb.r, max(rgb.g, rgb.b));
    if (!(maximum > 0.35)) return false;
    float rbFloor = min(rgb.r, rgb.b);
    float greenDeficit = rbFloor - rgb.g;
    float relativeDeficit = greenDeficit / max(maximum, 1.0e-5);
    return phase9Luma(rgb) > 0.30 && rbFloor > 0.62 * maximum && relativeDeficit > 0.085;
}

float phase9ColorConfidence(vec3 raw, uint hardClipMask) {
    if (any(isnan(raw)) || any(isinf(raw))) return 0.0;
    float peak = max(raw.r, max(raw.g, raw.b));
    float pressure = smoothstep(PHASE9_COLOR_CONFIDENCE_START,
                                PHASE9_COLOR_CONFIDENCE_ZERO, peak);
    // Once every sensor/demosaic channel is already at the hard ceiling, no measured
    // channel ratio remains trustworthy. Do not let WB manufacture chroma from [1,1,1].
    if (phase9BitCount3(hardClipMask) == 3) return 0.0;
    return clamp(1.0 - pressure, 0.0, 1.0);
}

vec3 phase9ApplyClippingAwareHighlightColor(
        vec3 postCcmLinearRgb, float colorConfidence, out bool applied) {
    applied = false;
    if (any(isnan(postCcmLinearRgb)) || any(isinf(postCcmLinearRgb))) return vec3(0.0);
    float confidence = clamp(colorConfidence, 0.0, 1.0);
    if (confidence >= 0.999999) return postCcmLinearRgb;
    float y = phase9Luma(postCcmLinearRgb);
    vec3 safeRgb = mix(vec3(y), postCcmLinearRgb, confidence);
    applied = any(greaterThan(abs(safeRgb - postCcmLinearRgb), vec3(1.0e-7)));
    // No upper clamp: neutral highlights above 1.0 remain valid scene-linear headroom.
    return safeRgb;
}

vec3 phase9ProtectSignedCcmLowerGamut(vec3 signedRgb, out bool excursion, out bool applied) {
    excursion = min(signedRgb.r, min(signedRgb.g, signedRgb.b)) < -1.0e-6;
    applied = false;
    if (!excursion || any(isnan(signedRgb)) || any(isinf(signedRgb))) {
        if (any(isnan(signedRgb)) || any(isinf(signedRgb))) {
            applied = true;
            return vec3(0.0);
        }
        // Scene-linear headroom >1 is deliberately preserved for the later tone owner.
        return signedRgb;
    }
    float y = phase9Luma(signedRgb);
    if (!(y > 1.0e-7)) {
        applied = true;
        return vec3(0.0);
    }
    float minimum = min(signedRgb.r, min(signedRgb.g, signedRgb.b));
    float chromaScale = clamp(y / max(y - minimum, 1.0e-8), 0.0, 1.0);
    vec3 protectedRgb = vec3(y) + (signedRgb - vec3(y)) * chromaScale;
    // Only numerical lower-bound cleanup; no upper/output clamp belongs to Phase 9.
    protectedRgb = max(protectedRgb, vec3(0.0));
    applied = true;
    return protectedRgb;
}

vec3 opponentAtRgb(vec3 pixel) {
    return vec3(
            0.2126 * pixel.r + 0.7152 * pixel.g + 0.0722 * pixel.b,
            pixel.r - pixel.g,
            pixel.b - pixel.g);
}

// Phase 6: physically significant residual chroma artifact classifier. This is deliberately
// topology-specific: it never averages green/luma and never treats saturation alone as noise.
struct Phase6Decision {
    float correction;
    float isolated;
    float zipper;
    float edgeProtected;
    float saturatedProtected;
};

float phase6Median4(float a, float b, float c, float d) {
    float lo0 = min(a, b);
    float hi0 = max(a, b);
    float lo1 = min(c, d);
    float hi1 = max(c, d);
    return 0.5 * (max(lo0, lo1) + min(hi0, hi1));
}

Phase6Decision phase6ClassifyChannel(
        float center, float n0, float n1, float n2, float n3,
        float n4, float n5, float n6, float n7,
        float centerGreen, float g0, float g1, float g2, float g3,
        float g4, float g5, float g6, float g7) {
    Phase6Decision d;
    d.correction = 0.0;
    d.isolated = 0.0;
    d.zipper = 0.0;
    d.edgeProtected = 0.0;
    d.saturatedProtected = 0.0;

    float sigma = max(demosaicNoiseSigmaChroma(), 2.5e-5);
    float sigmaY = max(demosaicNoiseSigmaY(), 2.5e-5);
    float target = phase6Median4(n0, n1, n2, n3);
    float localMin = min(min(min(n0, n1), min(n2, n3)), min(min(n4, n5), min(n6, n7)));
    float localMax = max(max(max(n0, n1), max(n2, n3)), max(max(n4, n5), max(n6, n7)));
    float delta = center - target;
    float outsideEnvelope = center < localMin ? center - localMin :
                            (center > localMax ? center - localMax : 0.0);

    float supportTolerance = 2.35 * sigma + 0.045 * abs(center) + 7.5e-4;
    float supportCount = 0.0;
    supportCount += abs(n0 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n1 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n2 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n3 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n4 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n5 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n6 - center) <= supportTolerance ? 1.0 : 0.0;
    supportCount += abs(n7 - center) <= supportTolerance ? 1.0 : 0.0;

    float horizontalSecond = abs(n0 - 2.0 * center + n1);
    float verticalSecond = abs(n2 - 2.0 * center + n3);
    float zipperMetric = max(horizontalSecond, verticalSecond);
    float axialSpan = max(max(n0, n1), max(n2, n3)) - min(min(n0, n1), min(n2, n3));

    float maximumGreenDelta = max(max(max(abs(g0 - centerGreen), abs(g1 - centerGreen)),
                                      max(abs(g2 - centerGreen), abs(g3 - centerGreen))),
                                  max(max(abs(g4 - centerGreen), abs(g5 - centerGreen)),
                                      max(abs(g6 - centerGreen), abs(g7 - centerGreen))));
    float structure = smoothstep(2.0 * sigmaY + 0.004, 7.0 * sigmaY + 0.055, maximumGreenDelta);
    float directionalSupport = min(min(abs(center - n0), abs(center - n1)),
                                   min(abs(center - n2), abs(center - n3)));
    float directionalTolerance = 2.75 * sigma + 0.035 * abs(center) + 7.5e-4;
    bool coherentColourSupport = supportCount >= 2.0 || directionalSupport <= directionalTolerance;
    bool edgeProtected = coherentColourSupport && (axialSpan > 2.0 * sigma || structure > 0.20);
    bool saturatedProtected = abs(center) >= max(0.075, 6.0 * sigma) && supportCount >= 2.0;

    float isolatedScore = 1.0 - smoothstep(0.75, 2.75, supportCount);
    float residualScore = smoothstep(2.0 * sigma, 5.5 * sigma + 0.002, abs(delta));
    float overshootScore = smoothstep(1.35 * sigma, 4.0 * sigma + 0.0015, abs(outsideEnvelope));
    float zipperScore = smoothstep(2.5 * sigma + 0.30 * axialSpan,
                                   6.0 * sigma + 0.70 * axialSpan + 0.002,
                                   zipperMetric) * isolatedScore;

    d.isolated = isolatedScore > 0.62 && max(residualScore, overshootScore) > 0.35 ? 1.0 : 0.0;
    d.zipper = zipperScore > 0.38 ? 1.0 : 0.0;
    d.edgeProtected = edgeProtected ? 1.0 : 0.0;
    d.saturatedProtected = saturatedProtected ? 1.0 : 0.0;

    float confidence = max(overshootScore, max(zipperScore, residualScore * isolatedScore));
    if (edgeProtected) confidence *= 0.10 + 0.22 * overshootScore;
    if (saturatedProtected) confidence *= 0.08;
    if (coherentColourSupport) confidence *= 1.0 - 0.45 * structure;
    confidence = clamp(confidence, 0.0, clamp(pc.ccm3, 0.0, 0.95));
    if (confidence < 0.015) return d;

    float correctionCap = min(clamp(pc.ccm4, 0.0, 0.15),
                              0.006 + 6.0 * sigma + 0.045 * abs(target));
    d.correction = clamp(delta, -correctionCap, correctionCap) * confidence;
    return d;
}

void phase6ClassifyAndStore(uvec2 gid, bool inside) {
    uint localIndex = gl_LocalInvocationIndex;
    float processed = 0.0;
    float candidate = 0.0;
    float isolated = 0.0;
    float zipper = 0.0;
    float edgeProtected = 0.0;
    float saturatedProtected = 0.0;
    float absCorrectionRg = 0.0;
    float absCorrectionBg = 0.0;
    float maxCorrection = 0.0;

    if (inside) {
        int x = int(gid.x);
        int y = int(gid.y);
        uint scratchBase = (gid.y * pc.frameWidth + gid.x) * 2u;
        colorRgb[scratchBase + 0u] = 0.0;
        colorRgb[scratchBase + 1u] = 0.0;
        processed = 1.0;
        if (x > 0 && y > 0 && x < int(pc.frameWidth) - 1 && y < int(pc.frameHeight) - 1) {
            vec3 c = residentRgbAt(x, y);
            vec3 p0 = residentRgbAt(x - 1, y);
            vec3 p1 = residentRgbAt(x + 1, y);
            vec3 p2 = residentRgbAt(x, y - 1);
            vec3 p3 = residentRgbAt(x, y + 1);
            vec3 p4 = residentRgbAt(x - 1, y - 1);
            vec3 p5 = residentRgbAt(x + 1, y - 1);
            vec3 p6 = residentRgbAt(x - 1, y + 1);
            vec3 p7 = residentRgbAt(x + 1, y + 1);
            float rg = c.r - c.g;
            float bg = c.b - c.g;
            Phase6Decision dr = phase6ClassifyChannel(
                    rg, p0.r-p0.g, p1.r-p1.g, p2.r-p2.g, p3.r-p3.g,
                    p4.r-p4.g, p5.r-p5.g, p6.r-p6.g, p7.r-p7.g,
                    c.g, p0.g, p1.g, p2.g, p3.g, p4.g, p5.g, p6.g, p7.g);
            Phase6Decision db = phase6ClassifyChannel(
                    bg, p0.b-p0.g, p1.b-p1.g, p2.b-p2.g, p3.b-p3.g,
                    p4.b-p4.g, p5.b-p5.g, p6.b-p6.g, p7.b-p7.g,
                    c.g, p0.g, p1.g, p2.g, p3.g, p4.g, p5.g, p6.g, p7.g);
            colorRgb[scratchBase + 0u] = dr.correction;
            colorRgb[scratchBase + 1u] = db.correction;
            absCorrectionRg = abs(dr.correction);
            absCorrectionBg = abs(db.correction);
            maxCorrection = max(absCorrectionRg, absCorrectionBg);
            candidate = maxCorrection > 1.0e-7 ? 1.0 : 0.0;
            isolated = max(dr.isolated, db.isolated);
            zipper = max(dr.zipper, db.zipper);
            edgeProtected = max(dr.edgeProtected, db.edgeProtected);
            saturatedProtected = max(dr.saturatedProtected, db.saturatedProtected);
        }
    }

    // Compact per-workgroup telemetry; host reduces only ~frame/256 records, never full RGB.
    sumRawR[localIndex] = processed;
    sumRawG[localIndex] = candidate;
    sumRawB[localIndex] = isolated;
    sumWbR[localIndex] = zipper;
    sumWbG[localIndex] = edgeProtected;
    sumWbB[localIndex] = saturatedProtected;
    sumCcmR[localIndex] = absCorrectionRg;
    sumCcmG[localIndex] = absCorrectionBg;
    sumCcmB[localIndex] = maxCorrection;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            uint other = localIndex + stride;
            sumRawR[localIndex] += sumRawR[other];
            sumRawG[localIndex] += sumRawG[other];
            sumRawB[localIndex] += sumRawB[other];
            sumWbR[localIndex] += sumWbR[other];
            sumWbG[localIndex] += sumWbG[other];
            sumWbB[localIndex] += sumWbB[other];
            sumCcmR[localIndex] += sumCcmR[other];
            sumCcmG[localIndex] += sumCcmG[other];
            sumCcmB[localIndex] = max(sumCcmB[localIndex], sumCcmB[other]);
        }
        barrier();
    }
    if (localIndex == 0u) {
        uint groupsX = (pc.frameWidth + 15u) / 16u;
        uint groupIndex = gl_WorkGroupID.y * groupsX + gl_WorkGroupID.x;
        uint base = groupIndex * 9u;
        colorStats[base + 0u] = sumRawR[0];
        colorStats[base + 1u] = sumRawG[0];
        colorStats[base + 2u] = sumRawB[0];
        colorStats[base + 3u] = sumWbR[0];
        colorStats[base + 4u] = sumWbG[0];
        colorStats[base + 5u] = sumWbB[0];
        colorStats[base + 6u] = sumCcmR[0];
        colorStats[base + 7u] = sumCcmG[0];
        colorStats[base + 8u] = sumCcmB[0];
    }
}

void phase6ApplyCorrection(uvec2 gid) {
    if (gid.x >= pc.frameWidth || gid.y >= pc.frameHeight) return;
    uint pixelIndex = gid.y * pc.frameWidth + gid.x;
    uint rgbBase = pixelIndex * 3u;
    uint scratchBase = pixelIndex * 2u;
    float correctionRg = colorRgb[scratchBase + 0u];
    float correctionBg = colorRgb[scratchBase + 1u];
    vec3 center = vec3(outputRgb[rgbBase + 0u], outputRgb[rgbBase + 1u], outputRgb[rgbBase + 2u]);
    outputRgb[rgbBase + 0u] = finiteLinear(center.r - correctionRg);
    outputRgb[rgbBase + 1u] = center.g; // strict green/luma-anchor preservation
    outputRgb[rgbBase + 2u] = finiteLinear(center.b - correctionBg);
}

// Delta 47: spatially varying low-frequency opponent correction. The map is already
// median-centred and risk/authority bounded on CPU. The shader adds only local structural
// safeguards; green is never changed by this correction.
vec2 samplePreWbCloudCorrection(int x, int y, out float support) {
    support = 0.0;
    if (pc.cfaEvidence0.z <= 0.5 || pc.cfaEvidence0.w <= 0.0) return vec2(0.0);
    const float gridCols = 16.0;
    const float gridRows = 12.0;
    float gx = clamp(((float(x) + 0.5) / max(1.0, float(pc.frameWidth))) * gridCols - 0.5,
                     0.0, gridCols - 1.0);
    float gy = clamp(((float(y) + 0.5) / max(1.0, float(pc.frameHeight))) * gridRows - 0.5,
                     0.0, gridRows - 1.0);
    int x0 = int(floor(gx));
    int y0 = int(floor(gy));
    int x1 = min(x0 + 1, 15);
    int y1 = min(y0 + 1, 11);
    float tx = gx - float(x0);
    float ty = gy - float(y0);
    vec4 r00 = cloudCorrectionMap[y0 * 16 + x0];
    vec4 r10 = cloudCorrectionMap[y0 * 16 + x1];
    vec4 r01 = cloudCorrectionMap[y1 * 16 + x0];
    vec4 r11 = cloudCorrectionMap[y1 * 16 + x1];
    float w00 = (1.0 - tx) * (1.0 - ty) * step(0.5, r00.z);
    float w10 = tx * (1.0 - ty) * step(0.5, r10.z);
    float w01 = (1.0 - tx) * ty * step(0.5, r01.z);
    float w11 = tx * ty * step(0.5, r11.z);
    support = w00 + w10 + w01 + w11;
    if (support < 0.25) return vec2(0.0);
    vec2 correction = (w00 * r00.xy + w10 * r10.xy + w01 * r01.xy + w11 * r11.xy) /
                      max(support, 1.0e-5);
    float maxAbs = clamp(pc.cfaEvidence0.w, 0.0, 0.010);
    return clamp(correction, vec2(-maxAbs), vec2(maxAbs));
}

vec3 preWbCloudCorrect(int x, int y, vec3 center) {
    float mapSupport = 0.0;
    vec2 correction = samplePreWbCloudCorrection(x, y, mapSupport);
    if (mapSupport < 0.25 || max(abs(correction.x), abs(correction.y)) <= 1.0e-7) return center;

    vec3 left = residentRgbAt(x - 1, y);
    vec3 right = residentRgbAt(x + 1, y);
    vec3 up = residentRgbAt(x, y - 1);
    vec3 down = residentRgbAt(x, y + 1);
    float maxGreenDelta = max(max(abs(center.g - left.g), abs(center.g - right.g)),
                              max(abs(center.g - up.g), abs(center.g - down.g)));
    float greenScale = 0.015 + 0.18 * max(center.g, 0.0);
    float structureGate = 1.0 - smoothstep(0.18, 0.90, maxGreenDelta / greenScale);

    vec2 oppL = vec2(left.r - left.g, left.b - left.g);
    vec2 oppR = vec2(right.r - right.g, right.b - right.g);
    vec2 oppU = vec2(up.r - up.g, up.b - up.g);
    vec2 oppD = vec2(down.r - down.g, down.b - down.g);
    vec2 opponentMin = min(min(oppL, oppR), min(oppU, oppD));
    vec2 opponentMax = max(max(oppL, oppR), max(oppU, oppD));
    vec2 opponentSpan = opponentMax - opponentMin;
    float chromaScale = 0.020 + 0.08 * max(center.g, 0.0);
    vec2 colourEdgeGate = vec2(1.0) - smoothstep(
            vec2(chromaScale), vec2(4.0 * chromaScale), opponentSpan);

    vec2 guarded = correction * structureGate * colourEdgeGate;
    vec3 corrected = center;
    corrected.r = max(0.0, center.r + guarded.x);
    corrected.b = max(0.0, center.b + guarded.y);
    return vec3(finiteLinear(corrected.r), finiteLinear(center.g), finiteLinear(corrected.b));
}

// Delta 35: conservative pre-WB opponent stabilization fused into the existing AWB+CCM
// dispatch. The requested blend is already globally bounded by SPECTRA evidence; local green
// structure and opponent span can only reduce it further. Green/luma is never reconstructed here.
vec3 preWbOpponentStabilize(int x, int y, vec3 center) {
    float requestedR = clamp(pc.cfaEvidence0.x, 0.0, 0.12);
    float requestedB = clamp(pc.cfaEvidence0.y, 0.0, 0.12);
    if (max(requestedR, requestedB) <= 0.0001) return center;

    vec3 left = residentRgbAt(x - 1, y);
    vec3 right = residentRgbAt(x + 1, y);
    vec3 up = residentRgbAt(x, y - 1);
    vec3 down = residentRgbAt(x, y + 1);

    float maxGreenDelta = max(max(abs(center.g - left.g), abs(center.g - right.g)),
                              max(abs(center.g - up.g), abs(center.g - down.g)));
    float greenScale = 0.015 + 0.18 * max(center.g, 0.0);
    float structureGate = 1.0 - smoothstep(0.18, 0.90, maxGreenDelta / greenScale);

    // Neighbours on a different luminance side contribute less to the opponent target.
    float wl = 1.0 / (1.0 + 4.0 * pow(abs(center.g - left.g) / greenScale, 2.0));
    float wr = 1.0 / (1.0 + 4.0 * pow(abs(center.g - right.g) / greenScale, 2.0));
    float wu = 1.0 / (1.0 + 4.0 * pow(abs(center.g - up.g) / greenScale, 2.0));
    float wd = 1.0 / (1.0 + 4.0 * pow(abs(center.g - down.g) / greenScale, 2.0));
    float weightSum = max(1.0e-5, wl + wr + wu + wd);

    vec2 oppL = vec2(left.r - left.g, left.b - left.g);
    vec2 oppR = vec2(right.r - right.g, right.b - right.g);
    vec2 oppU = vec2(up.r - up.g, up.b - up.g);
    vec2 oppD = vec2(down.r - down.g, down.b - down.g);
    vec2 targetOpponent = (wl * oppL + wr * oppR + wu * oppU + wd * oppD) / weightSum;

    vec2 opponentMin = min(min(oppL, oppR), min(oppU, oppD));
    vec2 opponentMax = max(max(oppL, oppR), max(oppU, oppD));
    vec2 opponentSpan = opponentMax - opponentMin;
    float chromaScale = 0.020 + 0.08 * max(center.g, 0.0);
    vec2 colourEdgeGate = vec2(1.0) - smoothstep(
            vec2(chromaScale), vec2(4.0 * chromaScale), opponentSpan);

    float blendR = requestedR * structureGate * colourEdgeGate.x;
    float blendB = requestedB * structureGate * colourEdgeGate.y;
    vec3 stabilized = center;
    stabilized.r = max(0.0, mix(center.r, center.g + targetOpponent.x, blendR));
    stabilized.b = max(0.0, mix(center.b, center.g + targetOpponent.y, blendB));
    return vec3(finiteLinear(stabilized.r), finiteLinear(center.g), finiteLinear(stabilized.b));
}

bool finiteBoundedRgb(vec3 pixel) {
    return all(not(isnan(pixel))) && all(not(isinf(pixel))) &&
           all(greaterThan(pixel, vec3(-0.05))) && all(lessThan(pixel, vec3(0.98)));
}

void writeResidualCandidate(uvec2 sampleGid, bool postColourDomain) {
    if (sampleGid.x >= pc.residualColumns || sampleGid.y >= pc.residualRows) return;
    uint sampleIndex = sampleGid.y * pc.residualColumns + sampleGid.x;
    uint base = sampleIndex * 8u;
    residualCandidates[base + 0u] = 0.0;
    residualCandidates[base + 1u] = 0.0;
    residualCandidates[base + 2u] = 0.0;
    residualCandidates[base + 3u] = 0.0;
    residualCandidates[base + 4u] = 0.0;
    residualCandidates[base + 5u] = 0.0;
    residualCandidates[base + 6u] = 0.0;
    residualCandidates[base + 7u] = 0.0;

    int x = 2 + int(sampleGid.x * pc.residualStride);
    int y = 2 + int(sampleGid.y * pc.residualStride);
    if (x >= int(pc.frameWidth) - 2 || y >= int(pc.frameHeight) - 2) return;

    // Mode 4 is the immutable post-demosaic observation and MUST read outputRgb.
    // Mode 11 is the post-AWB/CCM observation and reads colorRgb. AMaZE/AUTO_HYBRID
    // use colorRgb as guide/Phase-6 scratch during demosaic, so collapsing these domains
    // silently turns guide data into fake chroma residual evidence.
    vec3 centerPixel = postColourDomain ? colorRgbAt(x, y) : residentRgbAt(x, y);
    vec3 leftPixel = postColourDomain ? colorRgbAt(x - 1, y) : residentRgbAt(x - 1, y);
    vec3 rightPixel = postColourDomain ? colorRgbAt(x + 1, y) : residentRgbAt(x + 1, y);
    vec3 upPixel = postColourDomain ? colorRgbAt(x, y - 1) : residentRgbAt(x, y - 1);
    vec3 downPixel = postColourDomain ? colorRgbAt(x, y + 1) : residentRgbAt(x, y + 1);
    if (!finiteBoundedRgb(centerPixel) || !finiteBoundedRgb(leftPixel) ||
        !finiteBoundedRgb(rightPixel) || !finiteBoundedRgb(upPixel) ||
        !finiteBoundedRgb(downPixel)) return;

    vec3 center = opponentAtRgb(centerPixel);
    vec3 left = opponentAtRgb(leftPixel);
    vec3 right = opponentAtRgb(rightPixel);
    vec3 up = opponentAtRgb(upPixel);
    vec3 down = opponentAtRgb(downPixel);
    if (center.x < 0.008 || center.x > 0.90) return;

    vec3 hp = center - 0.25 * (left + right + up + down);
    if (any(isnan(hp)) || any(isinf(hp))) return;
    vec3 maxDelta = max(max(abs(center - left), abs(center - right)),
                        max(abs(center - up), abs(center - down)));
    float structure = max(maxDelta.x, 0.45 * max(maxDelta.y, maxDelta.z));
    uint tileX = min(15u, uint(x) * 16u / max(1u, pc.frameWidth));
    uint tileY = min(11u, uint(y) * 12u / max(1u, pc.frameHeight));

    residualCandidates[base + 0u] = hp.x;
    residualCandidates[base + 1u] = hp.y;
    residualCandidates[base + 2u] = hp.z;
    residualCandidates[base + 3u] = structure;
    residualCandidates[base + 4u] = float(tileY * 16u + tileX);
    // Keep the compact record at eight floats: invalid records remain 0.0, while valid
    // records encode 1.0 + center linear luma in slot 5 (range [1,2]).
    residualCandidates[base + 5u] = 1.0 + clamp(center.x, 0.0, 1.0);
    residualCandidates[base + 6u] = center.y;
    residualCandidates[base + 7u] = center.z;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (pc.mode == 4u) {
        writeResidualCandidate(gid, false); // POST_DEMOSAIC_RGB: outputRgb is authoritative.
        return;
    }
    if (pc.mode == 11u) {
        writeResidualCandidate(gid, true); // POST_COLOUR_TRANSFORM_RGB: colorRgb is authoritative.
        return;
    }

    bool inside = gid.x < pc.frameWidth && gid.y < pc.frameHeight;
    uint localIndex = gl_LocalInvocationIndex;

    if (pc.mode == 9u) {
        phase6ClassifyAndStore(gid, inside);
        return;
    }
    if (pc.mode == 10u) {
        phase6ApplyCorrection(gid);
        return;
    }

    if (pc.mode == 5u) {
        if (!inside) return;
        amazeGuidePass(int(gid.x), int(gid.y));
        return;
    }

    if (pc.mode == 6u) {
        if (!inside) return;
        vec3 rgb = amazeReconstructAt(int(gid.x), int(gid.y));
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    if (pc.mode == 7u) {
        if (!inside) return;
        amazeGuidePass(int(gid.x), int(gid.y));
        return;
    }

    if (pc.mode == 8u) {
        if (!inside) return;
        vec3 rgb = autoHybridAt(int(gid.x), int(gid.y));
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    if (pc.mode < 3u) {
        if (!inside) return;
        int x = int(gid.x);
        int y = int(gid.y);
        vec3 rgb = pc.mode == 0u ? bilinearAt(x, y) :
                   (pc.mode == 1u ? malvarAt(x, y) : neuralJddAt(x, y));
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        outputRgb[index + 0u] = rgb.r;
        outputRgb[index + 1u] = rgb.g;
        outputRgb[index + 2u] = rgb.b;
        return;
    }

    vec3 raw = vec3(0.0);
    vec3 wb = vec3(0.0);
    vec3 ccm = vec3(0.0);
    vec2 cloudAppliedOpponent = vec2(0.0);
    if (inside) {
        uint index = (gid.y * pc.frameWidth + gid.x) * 3u;
        vec3 rawInput = vec3(outputRgb[index + 0u], outputRgb[index + 1u], outputRgb[index + 2u]);
        raw = rawInput; // Immutable pre-WB sensor-domain/demosaic RGB for classification and stats.
        uint sensorClipMask = phase9SensorClipMask(rawInput);
        int sensorClipChannels = phase9BitCount3(sensorClipMask);
        float colorConfidence = phase9ColorConfidence(rawInput, sensorClipMask);
        bool confidenceCandidate = colorConfidence < 0.999999;
        if (confidenceCandidate) atomicAdd(colorTelemetry[0], 1u);
        if (sensorClipChannels == 1) atomicAdd(colorTelemetry[1], 1u);
        if (sensorClipChannels >= 2) atomicAdd(colorTelemetry[2], 1u);
        if (sensorClipChannels == 3) atomicAdd(colorTelemetry[10], 1u);
        if (colorConfidence > 1.0e-6 && colorConfidence < 0.999999) {
            atomicAdd(colorTelemetry[11], 1u);
        }

        vec3 locallyStabilized = preWbOpponentStabilize(int(gid.x), int(gid.y), rawInput);
        vec3 rawForWb = preWbCloudCorrect(int(gid.x), int(gid.y), locallyStabilized);
        cloudAppliedOpponent = vec2(
                rawForWb.r - locallyStabilized.r,
                rawForWb.b - locallyStabilized.b);

        // Counterfactual only: distinguishes WB-induced over-unity and old post-CCM magenta risk
        // from actual sensor-domain clipping. Neither condition is treated as lost sensor data.
        vec3 legacyWb = rawForWb * vec3(pc.wbR, pc.wbG, pc.wbB);
        if (sensorClipChannels == 0 && any(greaterThan(legacyWb, vec3(1.0)))) {
            atomicAdd(colorTelemetry[3], 1u);
        }
        vec3 legacySignedCcm = vec3(
                pc.ccm0 * legacyWb.r + pc.ccm1 * legacyWb.g + pc.ccm2 * legacyWb.b,
                pc.ccm3 * legacyWb.r + pc.ccm4 * legacyWb.g + pc.ccm5 * legacyWb.b,
                pc.ccm6 * legacyWb.r + pc.ccm7 * legacyWb.g + pc.ccm8 * legacyWb.b);
        // Keep Phase-7/8 compact means on their previously verified domain. Production pixels use
        // the Phase-9 protected path below, but these diagnostics remain pre-Phase9 counterfactuals.
        wb = legacyWb;
        ccm = max(legacySignedCcm, vec3(0.0));
        if (phase9MagentaRisk(ccm)) atomicAdd(colorTelemetry[7], 1u);

        // ClippingAwareHighlightColor: WB and the camera matrix operate normally. The only
        // safety action is a post-CCM, scene-linear chroma confidence mix derived strictly
        // from immutable pre-WB ceiling evidence. This cannot change luminance or exposure.
        vec3 signedCcm = legacySignedCcm;
        bool originalCcmExcursion = min(signedCcm.r, min(signedCcm.g, signedCcm.b)) < -1.0e-6;
        if (originalCcmExcursion) atomicAdd(colorTelemetry[4], 1u);
        bool confidenceApplied = false;
        vec3 confidenceSafeCcm = phase9ApplyClippingAwareHighlightColor(
                signedCcm, colorConfidence, confidenceApplied);
        if (confidenceApplied) atomicAdd(colorTelemetry[5], 1u);

        bool ccmExcursion = false;
        bool gamutCompressed = false;
        vec3 protectedCcm = phase9ProtectSignedCcmLowerGamut(
                confidenceSafeCcm, ccmExcursion, gamutCompressed);
        // counter[4] deliberately records the original signed CCM excursion above, before
        // clipping-confidence safety can reduce chroma and hide that diagnostic distinction.
        if (gamutCompressed) atomicAdd(colorTelemetry[6], 1u);
        if (phase9MagentaRisk(protectedCcm)) atomicAdd(colorTelemetry[8], 1u);
        if (max(protectedCcm.r, max(protectedCcm.g, protectedCcm.b)) > 1.0) atomicAdd(colorTelemetry[9], 1u);

        colorRgb[index + 0u] = finiteLinear(protectedCcm.r);
        colorRgb[index + 1u] = finiteLinear(protectedCcm.g);
        colorRgb[index + 2u] = finiteLinear(protectedCcm.b);
    }

    sumRawR[localIndex] = inside ? raw.r : 0.0;
    sumRawG[localIndex] = inside ? raw.g : 0.0;
    sumRawB[localIndex] = inside ? raw.b : 0.0;
    sumWbR[localIndex] = inside ? wb.r : 0.0;
    sumWbG[localIndex] = inside ? wb.g : 0.0;
    sumWbB[localIndex] = inside ? wb.b : 0.0;
    sumCcmR[localIndex] = inside ? ccm.r : 0.0;
    sumCcmG[localIndex] = inside ? ccm.g : 0.0;
    sumCcmB[localIndex] = inside ? ccm.b : 0.0;
    sumCloudAbsRG[localIndex] = inside ? abs(cloudAppliedOpponent.x) : 0.0;
    sumCloudAbsBG[localIndex] = inside ? abs(cloudAppliedOpponent.y) : 0.0;
    sumCloudAffected[localIndex] = inside &&
            max(abs(cloudAppliedOpponent.x), abs(cloudAppliedOpponent.y)) > 1.0e-7 ? 1.0 : 0.0;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (localIndex < stride) {
            uint other = localIndex + stride;
            sumRawR[localIndex] += sumRawR[other];
            sumRawG[localIndex] += sumRawG[other];
            sumRawB[localIndex] += sumRawB[other];
            sumWbR[localIndex] += sumWbR[other];
            sumWbG[localIndex] += sumWbG[other];
            sumWbB[localIndex] += sumWbB[other];
            sumCcmR[localIndex] += sumCcmR[other];
            sumCcmG[localIndex] += sumCcmG[other];
            sumCcmB[localIndex] += sumCcmB[other];
            sumCloudAbsRG[localIndex] += sumCloudAbsRG[other];
            sumCloudAbsBG[localIndex] += sumCloudAbsBG[other];
            sumCloudAffected[localIndex] += sumCloudAffected[other];
        }
        barrier();
    }
    if (localIndex == 0u) {
        uint groupsX = (pc.frameWidth + 15u) / 16u;
        uint groupIndex = gl_WorkGroupID.y * groupsX + gl_WorkGroupID.x;
        uint base = groupIndex * 12u;
        colorStats[base + 0u] = sumRawR[0];
        colorStats[base + 1u] = sumRawG[0];
        colorStats[base + 2u] = sumRawB[0];
        colorStats[base + 3u] = sumWbR[0];
        colorStats[base + 4u] = sumWbG[0];
        colorStats[base + 5u] = sumWbB[0];
        colorStats[base + 6u] = sumCcmR[0];
        colorStats[base + 7u] = sumCcmG[0];
        colorStats[base + 8u] = sumCcmB[0];
        colorStats[base + 9u] = sumCloudAbsRG[0];
        colorStats[base + 10u] = sumCloudAbsBG[0];
        colorStats[base + 11u] = sumCloudAffected[0];
    }
}
