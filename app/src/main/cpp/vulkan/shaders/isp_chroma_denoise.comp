#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InputRgbBuffer {
    vec4 inputPixels[]; // Linear RGBA float (R, G, B, 1.0)
};

layout(std430, set = 0, binding = 1) buffer OutputRgbBuffer {
    vec4 outputPixels[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float chromaStrength; // Chroma noise suppression strength (e.g. 0.75)
} pc;

vec3 rgbToYuv(vec3 rgb) {
    float y = 0.299 * rgb.r + 0.587 * rgb.g + 0.114 * rgb.b;
    float u = -0.14713 * rgb.r - 0.28886 * rgb.g + 0.436 * rgb.b;
    float v = 0.615 * rgb.r - 0.51499 * rgb.g - 0.10001 * rgb.b;
    return vec3(y, u, v);
}

vec3 yuvToRgb(vec3 yuv) {
    float r = yuv.x + 1.13983 * yuv.z;
    float g = yuv.x - 0.39465 * yuv.y - 0.58060 * yuv.z;
    float b = yuv.x + 2.03211 * yuv.y;
    return vec3(r, g, b);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= int(pc.width) || y >= int(pc.height)) return;

    int pixelIdx = y * int(pc.width) + x;
    vec3 centerRgb = inputPixels[pixelIdx].rgb;
    vec3 centerYuv = rgbToYuv(centerRgb);

    vec2 sumChroma = vec2(0.0);
    float sumWeight = 0.0;

    int radius = 2; // 5x5 spatial window for chroma smoothing

    for (int dy = -radius; dy <= radius; ++dy) {
        int cy = clamp(y + dy, 0, int(pc.height) - 1);
        for (int dx = -radius; dx <= radius; ++dx) {
            int cx = clamp(x + dx, 0, int(pc.width) - 1);

            int nIdx = cy * int(pc.width) + cx;
            vec3 neighborRgb = inputPixels[nIdx].rgb;
            vec3 neighborYuv = rgbToYuv(neighborRgb);

            float w = 1.0 / (1.0 + float(dx * dx + dy * dy));
            sumChroma += neighborYuv.yz * w;
            sumWeight += w;
        }
    }

    vec2 avgChroma = (sumWeight > 1e-6) ? (sumChroma / sumWeight) : centerYuv.yz;
    vec2 filteredChroma = mix(centerYuv.yz, avgChroma, clamp(pc.chromaStrength, 0.0, 1.0));

    vec3 denoisedRgb = yuvToRgb(vec3(centerYuv.x, filteredChroma.x, filteredChroma.y));
    outputPixels[pixelIdx] = vec4(max(vec3(0.0), denoisedRgb), 1.0);
}
