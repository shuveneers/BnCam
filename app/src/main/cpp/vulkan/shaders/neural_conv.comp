#version 450

// Runtime-sized SSBO arrays cannot be passed as unsized GLSL function parameters on
// the Android NDK glslc Vulkan 1.1 path. Keep the exact C4 packing semantics but
// expand accesses at the call site instead.
#define loadC4(WORDS, VEC_INDEX) \
    vec4(unpackHalf2x16(WORDS[(VEC_INDEX) * 2u]), \
         unpackHalf2x16(WORDS[(VEC_INDEX) * 2u + 1u]))
#define loadHalf(WORDS, HALF_INDEX) \
    ((((HALF_INDEX) & 1u) == 0u) \
        ? unpackHalf2x16(WORDS[(HALF_INDEX) >> 1u]).x \
        : unpackHalf2x16(WORDS[(HALF_INDEX) >> 1u]).y)
#define storeC4(WORDS, VEC_INDEX, VALUE) \
    do { \
        uint _bncamStoreIndex = (VEC_INDEX); \
        vec4 _bncamStoreValue = (VALUE); \
        WORDS[_bncamStoreIndex * 2u] = packHalf2x16(_bncamStoreValue.xy); \
        WORDS[_bncamStoreIndex * 2u + 1u] = packHalf2x16(_bncamStoreValue.zw); \
    } while (false)

layout(local_size_x=8, local_size_y=4, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint data[]; } src;
layout(set=0,binding=1,std430) readonly buffer Weights { uint data[]; } wt;
layout(set=0,binding=2,std430) readonly buffer Bias { uint data[]; } bs;
layout(set=0,binding=3,std430) writeonly buffer Output { uint data[]; } dst;
layout(push_constant) uniform PC { uint inW;uint inH;uint inC;uint outW;uint outH;uint outC;uint kernel;uint stride;uint upsample2x;uint weightHalfBase;uint biasC4Base;int inputGlobalX;int inputGlobalY;uint domainW;uint domainH;uint enforceDomain; } pc;
vec4 sampleInput(int x,int y,uint ig){if(pc.upsample2x!=0u){int uw=int(pc.inW*2u),uh=int(pc.inH*2u);if(x<0||y<0||x>=uw||y>=uh)return vec4(0);x/=2;y/=2;}else if(x<0||y<0||x>=int(pc.inW)||y>=int(pc.inH))return vec4(0);if(pc.enforceDomain!=0u){int gx=pc.inputGlobalX+x,gy=pc.inputGlobalY+y;if(gx<0||gy<0||gx>=int(pc.domainW)||gy>=int(pc.domainH))return vec4(0);}uint groups=(pc.inC+3u)/4u;return loadC4(src.data,(uint(y)*pc.inW+uint(x))*groups+ig);}
void main(){uint ox=gl_GlobalInvocationID.x,oy=gl_GlobalInvocationID.y,og=gl_GlobalInvocationID.z;if(ox>=pc.outW||oy>=pc.outH||og>=(pc.outC+3u)/4u)return;uint inGroups=(pc.inC+3u)/4u;vec4 acc=loadC4(bs.data,pc.biasC4Base+og);int rad=int(pc.kernel/2u);for(uint ig=0u;ig<inGroups;++ig)for(uint ky=0u;ky<pc.kernel;++ky)for(uint kx=0u;kx<pc.kernel;++kx){int ix=int(ox*pc.stride+kx)-rad,iy=int(oy*pc.stride+ky)-rad;vec4 v=sampleInput(ix,iy,ig);uint block=((((og*inGroups+ig)*pc.kernel+ky)*pc.kernel+kx)*16u);for(uint o=0u;o<4u;++o){vec4 w=vec4(loadHalf(wt.data,pc.weightHalfBase+block+o*4u),loadHalf(wt.data,pc.weightHalfBase+block+o*4u+1u),loadHalf(wt.data,pc.weightHalfBase+block+o*4u+2u),loadHalf(wt.data,pc.weightHalfBase+block+o*4u+3u));acc[o]+=dot(v,w);}}uint outGroups=(pc.outC+3u)/4u;storeC4(dst.data,(oy*pc.outW+ox)*outGroups+og,acc);}
