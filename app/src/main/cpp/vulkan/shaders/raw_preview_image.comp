const uint PREVIEW_SCENE_EXPOSURE_WORDS = 6u;
// Phase 11E: strict sensor saturation evidence is separate from the 11B near-clip counter.
const uint RAW_TRUE_SATURATED_COUNT_INDEX = PREVIEW_SCENE_EXPOSURE_START_INDEX + PREVIEW_SCENE_EXPOSURE_WORDS;
const uint SENSOR_EXPOSURE_TELEMETRY_WORDS = 1u;
const uint ANALYSIS_NV21_START_INDEX = RAW_TRUE_SATURATED_COUNT_INDEX + SENSOR_EXPOSURE_TELEMETRY_WORDS;
const float RAW_TRUE_SATURATION_THRESHOLD = 0.9995;
const uint PREVIEW_LOCAL_TONE_DECIMATION = 8u;

uint sourceFormat() { return pc.sourceLayout & 0xffffu; }
uint sourcePixelStride() { return max(2u, pc.sourceLayout >> 16u); }
uint cfaPattern() { return pc.cfaAndMode & 0xffu; }
uint dispatchMode() { return (pc.cfaAndMode >> 8u) & 0xffu; }
float greenEvenOddRatio() {
    float encoded = float((pc.cfaAndMode >> 16u) & 0xffu) / 255.0;
    return mix(0.50, 2.0, encoded);
}
float greenRowCalibrationScale(uint localY) {
    float ratio = clamp(greenEvenOddRatio(), 0.50, 2.0);
    return (localY & 1u) == 0u ? (2.0 * ratio) / (ratio + 1.0) : 2.0 / (ratio + 1.0);
}
float focusPriority() { return float((pc.cfaAndMode >> 24u) & 0xffu) / 255.0; }
uint sourceCropLeft() { return pc.sourceCropPacked & 0xffffu; }
uint sourceCropTop() { return pc.sourceCropPacked >> 16u; }
bool compactNv21Enabled() { return pc.histogramStride < 0.0; }
uint compactNv21Width() { return (pc.previewWidth / 4u) & ~1u; }
uint compactNv21Height() { return (pc.previewHeight / 4u) & ~1u; }

uint loadByte(uint address) {
    uint word = inputWords[address >> 2u];
    return (word >> ((address & 3u) * 8u)) & 0xffu;
}

uint readRaw(uint x, uint y) {
    uint row = y * pc.sourceRowStrideBytes;
    if (sourceFormat() == RAW10_FORMAT) {
        uint block = (x >> 2u) * 5u;
        uint lane = x & 3u;
        uint high = loadByte(row + block + lane);
        uint packedLow = loadByte(row + block + 4u);
        return (high << 2u) | ((packedLow >> (lane * 2u)) & 3u);
    }
    uint address = row + x * sourcePixelStride();
    return loadByte(address) | (loadByte(address + 1u) << 8u);
}

float siteBlack(uint site) {
    if (site == 0u) return pc.black0;
    if (site == 1u) return pc.black1;
    if (site == 2u) return pc.black2;
    return pc.black3;
}

int mirrorCoord(int p, int extent) {
    if (extent <= 1) return 0;
    int period = 2 * (extent - 1);
    int q = p % period;
    if (q < 0) q += period;
    return q < extent ? q : period - q;
}

bool isGreenSite(uint pattern, uint localX, uint localY) {
    uint p = min(pattern, 3u);
    uint xm = localX & 1u;
    uint ym = localY & 1u;
    if (p == 0u || p == 3u) return xm != ym; // RGGB / BGGR
    return xm == ym;                          // GRBG / GBRG
}

const float RAW_HIGHLIGHT_CLIP_THRESHOLD = 0.995;
const float RAW_HIGHLIGHT_SUPPORT_LIMIT = 0.992;
const float RAW_HIGHLIGHT_RECONSTRUCT_CAP = 1.35;

uint cfaColorLocal(int localX, int localY) {
    // Match the parity of the actual clamped sensor sample at image edges.
    int width = int(max(2u, pc.previewWidth * max(1u, pc.cfaCellDecimation)));
    int height = int(max(2u, pc.previewHeight * max(1u, pc.cfaCellDecimation)));
    int lx = clamp(localX, 0, width - 1);
    int ly = clamp(localY, 0, height - 1);
    int xm = lx & 1;
    int ym = ly & 1;
    uint p = min(cfaPattern(), 3u);
    if (p == 0u) return ym == 0 ? (xm == 0 ? 0u : 1u) : (xm == 0 ? 1u : 2u);
    if (p == 1u) return ym == 0 ? (xm == 0 ? 1u : 0u) : (xm == 0 ? 2u : 1u);
    if (p == 2u) return ym == 0 ? (xm == 0 ? 1u : 2u) : (xm == 0 ? 0u : 1u);
    return ym == 0 ? (xm == 0 ? 2u : 1u) : (xm == 0 ? 1u : 0u);
}

float rawSensorNormalizedDirect(int localX, int localY) {
    int lx = clamp(localX, 0, int(max(2u, pc.previewWidth * max(1u, pc.cfaCellDecimation))) - 1);
    int ly = clamp(localY, 0, int(max(2u, pc.previewHeight * max(1u, pc.cfaCellDecimation))) - 1);
    uint sx = min(pc.sourceWidth - 1u, sourceCropLeft() + uint(lx));
    uint sy = min(pc.sourceHeight - 1u, sourceCropTop() + uint(ly));
    uint site = ((uint(ly) & 1u) << 1u) | (uint(lx) & 1u);
    float black = clamp(siteBlack(site), 0.0, max(0.0, pc.whiteLevel - 1.0));
    return clamp((float(readRaw(sx, sy)) - black) /
            max(1.0, pc.whiteLevel - black), 0.0, 1.0);
}

float unclippedGreenCross(int x, int y) {
    float sum = 0.0;
    float weight = 0.0;
    for (int axis = 0; axis < 4; ++axis) {
        int dx = axis == 0 ? -1 : (axis == 1 ? 1 : 0);
        int dy = axis == 2 ? -1 : (axis == 3 ? 1 : 0);
        int sx = x + dx;
        int sy = y + dy;
        if (cfaColorLocal(sx, sy) != 1u) continue;
        float v = rawSensorNormalizedDirect(sx, sy);
        if (v < RAW_HIGHLIGHT_SUPPORT_LIMIT) {
            sum += v;
            weight += 1.0;
        }
    }
    return weight > 0.0 ? sum / weight : -1.0;
}

void addHighlightSupport(
        int x, int y, uint color, float supportWeight,
        inout float valueSum, inout float valueWeight, inout float valueMax,
        inout float ratioSum, inout float ratioWeight) {
    if (cfaColorLocal(x, y) != color) return;
    float v = rawSensorNormalizedDirect(x, y);
    if (v >= RAW_HIGHLIGHT_SUPPORT_LIMIT) return;
    valueSum += supportWeight * v;
    valueWeight += supportWeight;
    valueMax = max(valueMax, v);
    if (color != 1u) {
        float g = unclippedGreenCross(x, y);
        if (g > 0.025 && g < RAW_HIGHLIGHT_SUPPORT_LIMIT) {
            ratioSum += supportWeight * (v / g);
            ratioWeight += supportWeight;
        }
    }
}

float reconstructRawHighlightDirect(
        int localX, int localY, out bool sensorClipped, out bool reconstructed) {
    float center = rawSensorNormalizedDirect(localX, localY);
    sensorClipped = center >= RAW_HIGHLIGHT_CLIP_THRESHOLD;
    reconstructed = false;
    if (!sensorClipped) return center;

    uint color = cfaColorLocal(localX, localY);
    float valueSum = 0.0;
    float valueWeight = 0.0;
    float valueMax = 0.0;
    float ratioSum = 0.0;
    float ratioWeight = 0.0;
    addHighlightSupport(localX - 2, localY, color, 1.00, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX + 2, localY, color, 1.00, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX, localY - 2, color, 1.00, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX, localY + 2, color, 1.00, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX - 2, localY - 2, color, 0.70, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX + 2, localY - 2, color, 0.70, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX - 2, localY + 2, color, 0.70, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX + 2, localY + 2, color, 0.70, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX - 4, localY, color, 0.40, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX + 4, localY, color, 0.40, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX, localY - 4, color, 0.40, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    addHighlightSupport(localX, localY + 4, color, 0.40, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    if (color == 1u) {
        addHighlightSupport(localX - 1, localY - 1, color, 0.85, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
        addHighlightSupport(localX + 1, localY - 1, color, 0.85, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
        addHighlightSupport(localX - 1, localY + 1, color, 0.85, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
        addHighlightSupport(localX + 1, localY + 1, color, 0.85, valueSum, valueWeight, valueMax, ratioSum, ratioWeight);
    }
    if (valueWeight < 1.50) return center;
    float supportMean = valueSum / valueWeight;
    float estimate = valueMax + 0.80 * max(0.0, valueMax - supportMean);
    if (color != 1u && ratioWeight >= 1.50) {
        float localGreen = unclippedGreenCross(localX, localY);
        if (localGreen > 0.025) estimate = max(estimate, localGreen * (ratioSum / ratioWeight));
    }
    estimate = clamp(estimate, center, RAW_HIGHLIGHT_RECONSTRUCT_CAP);
    reconstructed = estimate > center + 0.002;
    return reconstructed ? estimate : center;
}

float rawNormalizedLocal(int localX, int localY) {
    int width = int(max(2u, pc.previewWidth * max(1u, pc.cfaCellDecimation)));
    int height = int(max(2u, pc.previewHeight * max(1u, pc.cfaCellDecimation)));
    int lx = clamp(localX, 0, width - 1);
    int ly = clamp(localY, 0, height - 1);
    bool sensorClipped = false;
    bool reconstructed = false;
    // Preserve the one-fetch clean path. Neighbour evidence is collected only for a hard-clipped CFA
    // site; the co-located RGB common scalar is applied immediately after demosaic, before WB/CCM.
    float normalized = reconstructRawHighlightDirect(lx, ly, sensorClipped, reconstructed);
    if (isGreenSite(cfaPattern(), uint(lx), uint(ly))) {
        normalized *= greenRowCalibrationScale(uint(ly));
    }
    return clamp(normalized, 0.0, RAW_HIGHLIGHT_RECONSTRUCT_CAP);
}

float previewPhysicalNoiseSigma(float signal);
float previewPhysicalNoisePressure(float signal);

float normalizedAt(int previewX, int previewY) {
    uint x = uint(mirrorCoord(previewX, int(pc.previewWidth)));
    uint y = uint(mirrorCoord(previewY, int(pc.previewHeight)));
    uint d = max(1u, pc.cfaCellDecimation);
    int baseX = int((x >> 1u) * 2u * d + (x & 1u));
    int baseY = int((y >> 1u) * 2u * d + (y & 1u));
    if (d <= 1u) return rawNormalizedLocal(baseX, baseY);

    // Phase 11D: CFA-preserving decimation is anti-aliasing only. At low physical noise a
    // flat/clean region is exact identity; stronger low-pass authority requires either real
    // alias-prone same-CFA structure or frozen S/O noise evidence.
    int step = max(2, (int(d) / 2) * 2);
    float c = rawNormalizedLocal(baseX, baseY);
    float n = rawNormalizedLocal(baseX, baseY - step);
    float s = rawNormalizedLocal(baseX, baseY + step);
    float w = rawNormalizedLocal(baseX - step, baseY);
    float e = rawNormalizedLocal(baseX + step, baseY);
    float spread = max(max(abs(c - n), abs(c - s)), max(abs(c - w), abs(c - e)));
    float aliasRisk = smoothstep(0.055, 0.18, spread);
    float noisePressure = previewPhysicalNoisePressure(max(c, 1.0e-4));
    float filterAuthority = clamp(
            0.24 * aliasRisk +
            0.76 * noisePressure * (1.0 - 0.55 * aliasRisk),
            0.0, 0.90);
    float filtered = (4.0 * c + n + s + w + e) / 8.0;
    return mix(c, filtered, filterAuthority);
}

uint cfaColorAt(int x, int y) { return cfaColorLocal(x, y); }

vec3 demosaicAt(int x, int y) {
    uint color = cfaColorAt(x, y);
    float c = normalizedAt(x, y);
    float n1 = normalizedAt(x, y - 1);
    float s1 = normalizedAt(x, y + 1);
    float w1 = normalizedAt(x - 1, y);
    float e1 = normalizedAt(x + 1, y);
    float n2 = normalizedAt(x, y - 2);
    float s2 = normalizedAt(x, y + 2);
    float w2 = normalizedAt(x - 2, y);
    float e2 = normalizedAt(x + 2, y);
    float nw = normalizedAt(x - 1, y - 1);
    float ne = normalizedAt(x + 1, y - 1);
    float sw = normalizedAt(x - 1, y + 1);
    float se = normalizedAt(x + 1, y + 1);

    float r, g, b;
    if (color == 0u) {
        r = c;
        g = 0.25 * (n1 + s1 + w1 + e1) + 0.5 * c - 0.125 * (n2 + s2 + w2 + e2);
        b = 0.25 * (nw + ne + sw + se) + 0.75 * c - 0.15 * (n2 + s2 + w2 + e2);
    } else if (color == 2u) {
        b = c;
        g = 0.25 * (n1 + s1 + w1 + e1) + 0.5 * c - 0.125 * (n2 + s2 + w2 + e2);
        r = 0.25 * (nw + ne + sw + se) + 0.75 * c - 0.15 * (n2 + s2 + w2 + e2);
    } else {
        g = c;
        bool horizontalRed = cfaColorAt(x - 1, y) == 0u || cfaColorAt(x + 1, y) == 0u;
        if (horizontalRed) {
            r = 0.5 * (w1 + e1) + 0.25 * c - 0.125 * (w2 + e2);
            b = 0.5 * (n1 + s1) + 0.25 * c - 0.125 * (n2 + s2);
        } else {
            r = 0.5 * (n1 + s1) + 0.25 * c - 0.125 * (n2 + s2);
            b = 0.5 * (w1 + e1) + 0.25 * c - 0.125 * (w2 + e2);
        }
    }

    // Strongly suppress Malvar zippering only where the directional green estimate disagrees.
    if (color != 1u) {
        float hg = abs(w1 - e1) + 0.25 * abs(w2 - e2);
        float vg = abs(n1 - s1) + 0.25 * abs(n2 - s2);
        float hw = 1.0 / (0.0025 + hg);
        float vw = 1.0 / (0.0025 + vg);
        float directional = (0.5 * (w1 + e1) * hw + 0.5 * (n1 + s1) * vw) / max(1.0e-6, hw + vw);
        float a = smoothstep(0.004, 0.030, abs(g - directional));
        g = mix(g, directional, mix(0.55, 0.88, a));
    }
    return max(vec3(0.0), vec3(r, g, b));
}

float sensorGreenAt(int x, int y) {
    uint c = cfaColorAt(x, y);
    if (c == 1u) return normalizedAt(x, y);
    float n = normalizedAt(x, y - 1);
    float s = normalizedAt(x, y + 1);
    float w = normalizedAt(x - 1, y);
    float e = normalizedAt(x + 1, y);
    float hw = 1.0 / (0.0025 + abs(w - e));
    float vw = 1.0 / (0.0025 + abs(n - s));
    return (0.5 * (w + e) * hw + 0.5 * (n + s) * vw) / max(1.0e-6, hw + vw);
}

vec3 protectPreviewSignedLowerGamut(vec3 rgb) {
    if (any(isnan(rgb)) || any(isinf(rgb))) return vec3(0.0);
    float minimum = min(rgb.r, min(rgb.g, rgb.b));
    if (minimum >= -1.0e-6) return rgb;
    float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    if (!(y > 1.0e-7)) return vec3(0.0);
    float chromaScale = clamp(y / max(y - minimum, 1.0e-8), 0.0, 1.0);
    return max(vec3(0.0), vec3(y) + (rgb - vec3(y)) * chromaScale);
}


// ---- Calibrated DNG ProfileHueSatMap (capture-parity ABI) --------------------
// The upstream matrix is already the paired DNG ForwardMatrix characterization represented in
// linear sRGB. These fixed matrices bridge that PCS transport representation to/from linear RIMM.
vec3 hsmLinearSrgbToRimm(vec3 rgb) {
    return vec3(
        0.529364575 * rgb.r + 0.330145317 * rgb.g + 0.140532947 * rgb.b,
        0.098381997 * rgb.r + 0.873443911 * rgb.g + 0.028163017 * rgb.b,
        0.016878012 * rgb.r + 0.117656626 * rgb.g + 0.865257607 * rgb.b);
}
vec3 hsmRimmToLinearSrgb(vec3 rgb) {
    return vec3(
         2.034043804 * rgb.r - 0.727518881 * rgb.g - 0.306684004 * rgb.b,
        -0.228832038 * rgb.r + 1.231781960 * rgb.g - 0.002926809 * rgb.b,
        -0.008560528 * rgb.r - 0.153305031 * rgb.g + 1.162105494 * rgb.b);
}
float hsmSrgbEncode(float x) {
    x = clamp(x, 0.0, 1.0);
    return x <= 0.0031308 ? 12.92 * x : 1.055 * pow(x, 1.0 / 2.4) - 0.055;
}
float hsmSrgbDecode(float x) {
    x = clamp(x, 0.0, 1.0);
    return x <= 0.04045 ? x / 12.92 : pow((x + 0.055) / 1.055, 2.4);
}
vec3 hsmRgbToHsv(vec3 rgb) {
    float mx = max(rgb.r, max(rgb.g, rgb.b));
    float mn = min(rgb.r, min(rgb.g, rgb.b));
    float d = mx - mn;
    float h = 0.0;
    if (d > 1.0e-12) {
        if (mx == rgb.r) h = 60.0 * mod((rgb.g - rgb.b) / d, 6.0);
        else if (mx == rgb.g) h = 60.0 * (((rgb.b - rgb.r) / d) + 2.0);
        else h = 60.0 * (((rgb.r - rgb.g) / d) + 4.0);
    }
    h = mod(h + 360.0, 360.0);
    float sat = mx > 1.0e-12 ? d / mx : 0.0;
    return vec3(h, clamp(sat, 0.0, 1.0), max(0.0, mx));
}
vec3 hsmHsvToRgb(vec3 hsv) {
    float h = mod(hsv.x + 360.0, 360.0);
    float sat = clamp(hsv.y, 0.0, 1.0);
    float val = max(0.0, hsv.z);
    float c = val * sat;
    float x = c * (1.0 - abs(mod(h / 60.0, 2.0) - 1.0));
    float m = val - c;
    vec3 rgb;
    if (h < 60.0) rgb = vec3(c, x, 0.0);
    else if (h < 120.0) rgb = vec3(x, c, 0.0);
    else if (h < 180.0) rgb = vec3(0.0, c, x);
    else if (h < 240.0) rgb = vec3(0.0, x, c);
    else if (h < 300.0) rgb = vec3(x, 0.0, c);
    else rgb = vec3(c, 0.0, x);
    return rgb + vec3(m);
}
bool hsmProfileEnabled() { return hueSatProfile[0] > 0.5; }
uint hsmH() { return uint(max(1.0, floor(hueSatProfile[1] + 0.5))); }
uint hsmS() { return uint(max(2.0, floor(hueSatProfile[2] + 0.5))); }
uint hsmV() { return uint(max(1.0, floor(hueSatProfile[3] + 0.5))); }
uint hsmEncoding() { return uint(clamp(floor(hueSatProfile[4] + 0.5), 0.0, 1.0)); }
uint hsmEntryCount() { return uint(max(1.0, floor(hueSatProfile[8] + 0.5))); }
uint hsmCellIndex(uint h, uint sat, uint val) { return (val * hsmH() + h) * hsmS() + sat; }
vec3 hsmTableEntry(uint cell) {
    uint base1 = 16u + cell * 3u;
    vec3 a = vec3(hueSatProfile[base1], hueSatProfile[base1 + 1u], hueSatProfile[base1 + 2u]);
    if (hueSatProfile[7] <= 0.5) return a;
    uint base2 = 16u + hsmEntryCount() * 3u + cell * 3u;
    vec3 b = vec3(hueSatProfile[base2], hueSatProfile[base2 + 1u], hueSatProfile[base2 + 2u]);
    float w1 = clamp(hueSatProfile[5], 0.0, 1.0);
    float w2 = clamp(hueSatProfile[6], 0.0, 1.0);
    float sumW = max(1.0e-8, w1 + w2);
    return (w1 * a + w2 * b) / sumW;
}
vec3 hsmLerp(vec3 a, vec3 b, float t) { return a + (b - a) * clamp(t, 0.0, 1.0); }
vec3 hsmSample(float hueDegrees, float saturation, float linearValue) {
    uint H = hsmH(); uint S = hsmS(); uint V = hsmV();
    float hueCoord = (mod(hueDegrees + 360.0, 360.0) / 360.0) * float(H);
    float hueFloor = floor(hueCoord);
    uint h0 = uint(hueFloor) % H; uint h1 = (h0 + 1u) % H; float hf = hueCoord - hueFloor;
    float satCoord = clamp(saturation, 0.0, 1.0) * float(S - 1u);
    uint s0 = uint(floor(satCoord)); uint s1 = min(s0 + 1u, S - 1u); float sf = satCoord - float(s0);
    float lookupV = clamp(linearValue, 0.0, 1.0);
    if (V > 1u && hsmEncoding() == 1u) lookupV = hsmSrgbEncode(lookupV);
    float valCoord = V > 1u ? lookupV * float(V - 1u) : 0.0;
    uint v0 = uint(floor(valCoord)); uint v1 = min(v0 + 1u, V - 1u); float vf = valCoord - float(v0);
    vec3 c000 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s0,v0)), hsmTableEntry(hsmCellIndex(h1,s0,v0)), hf);
    vec3 c010 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s1,v0)), hsmTableEntry(hsmCellIndex(h1,s1,v0)), hf);
    vec3 c001 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s0,v1)), hsmTableEntry(hsmCellIndex(h1,s0,v1)), hf);
    vec3 c011 = hsmLerp(hsmTableEntry(hsmCellIndex(h0,s1,v1)), hsmTableEntry(hsmCellIndex(h1,s1,v1)), hf);
    return hsmLerp(hsmLerp(c000,c010,sf), hsmLerp(c001,c011,sf), vf);
}
vec3 applyCalibratedDngHueSatMap(vec3 pairedLinearSrgb) {
    if (!hsmProfileEnabled()) return pairedLinearSrgb;
    // Preserve signed linear-sRGB until the wider RIMM conversion. This is capture parity: a
    // pre-HSM lower-gamut clamp would discard valid profile gamut. Scene-linear headroom above
    // 1.0 is factored out and restored after the normalized HSM lookup.
    vec3 rimm = max(hsmLinearSrgbToRimm(pairedLinearSrgb), vec3(0.0));
    float headroom = max(1.0, max(rimm.r, max(rimm.g, rimm.b)));
    vec3 hsv = hsmRgbToHsv(rimm / headroom);
    vec3 delta = hsmSample(hsv.x, hsv.y, hsv.z);
    hsv.x = mod(hsv.x + delta.x + 360.0, 360.0);
    hsv.y = clamp(hsv.y * max(0.0, delta.y), 0.0, 1.0);
    bool encodedValue = hsmV() > 1u && hsmEncoding() == 1u;
    float valueDomain = encodedValue ? hsmSrgbEncode(hsv.z) : max(0.0, hsv.z);
    valueDomain = min(1.0, valueDomain * max(0.0, delta.z));
    hsv.z = encodedValue ? hsmSrgbDecode(valueDomain) : valueDomain;
    vec3 correctedRimm = hsmHsvToRgb(hsv) * headroom;
    return hsmRimmToLinearSrgb(correctedRimm);
}

vec3 commonScaleReconstructedHighlight(vec3 sensorRgb, bool recordTelemetry) {
    float peak = max(sensorRgb.r, max(sensorRgb.g, sensorRgb.b));
    if (!(peak > 1.0)) return sensorRgb;
    if (recordTelemetry) atomicAdd(statsBuffer[COMMON_SCALE_INDEX], 1u);
    // One scalar for all three sensor channels: preserve reconstructed chromaticity instead of
    // independently clipping the channel that exceeded sensor white.
    return sensorRgb / peak;
}

vec3 colorTransform(vec3 sensorRgb) {
    // Phase 11G color parity with full preview/capture: exact WB + paired Camera2/DNG matrix,
    // genuine DNG ProfileHueSatMap when present, then one signed lower-gamut guard.
    vec3 v = sensorRgb * vec3(pc.wbR, pc.wbG, pc.wbB);
    vec3 signedCcm = vec3(
        pc.ccm0 * v.r + pc.ccm1 * v.g + pc.ccm2 * v.b,
        pc.ccm3 * v.r + pc.ccm4 * v.g + pc.ccm5 * v.b,
        pc.ccm6 * v.r + pc.ccm7 * v.g + pc.ccm8 * v.b);
    vec3 characterized = applyCalibratedDngHueSatMap(signedCcm);
    return protectPreviewSignedLowerGamut(characterized);
}

float toneLutSample(float x) {
    float p = clamp(x, 0.0, 1.0) * 4095.0;
    uint i0 = uint(floor(p));
    uint i1 = min(4095u, i0 + 1u);
    return mix(toneLut[i0], toneLut[i1], fract(p));
}

float profileExposureMultiplier() {
    float c = clamp(uintBitsToFloat(statsBuffer[PROFILE_TONE_EXPOSURE_INDEX]), -1.0, 1.0);
    return exp2(2.0 * c);
}

float autoExposureMultiplier() {
    float g = uintBitsToFloat(statsBuffer[EXPOSURE_INDEX]);
    if (isnan(g) || isinf(g) || g <= 0.0) return 1.0;
    return clamp(g, exp2(-0.50), exp2(1.25));
}

float previewGtmLuma(float luma) {
    float shoulderStart = clamp(uintBitsToFloat(statsBuffer[TONE_RESERVED_0_INDEX]), 0.67, 0.86);
    float shoulderStrength = uintBitsToFloat(statsBuffer[TONE_RESERVED_1_INDEX]);
    if (isnan(shoulderStrength) || isinf(shoulderStrength) || shoulderStrength <= 1.0e-5) {
        return max(0.0, luma);
    }
    return previewGtmMapLuma(max(0.0, luma), shoulderStart, clamp(shoulderStrength, 0.55, 0.93));
}

vec3 applyPreviewGtm(vec3 exposedRgb) {
    float yOld = max(1.0e-7, dot(exposedRgb, vec3(0.2126, 0.7152, 0.0722)));
    float yNew = previewGtmLuma(yOld);
    return exposedRgb * (yNew / yOld);
}

// Same gentle post-GTM display-boundary mapping as capture Phase 11F.
vec3 khronosNeutral(vec3 color) {
    const float startCompression = 0.88;
    const float desaturation = 0.15;
    const float shoulderPrepStart = 0.72;
    color = max(color, vec3(0.0));

    float inputPeak = max(color.r, max(color.g, color.b));
    float x = min(color.r, min(color.g, color.b));
    float canonicalOffset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    float shoulderPrepAuthority = smoothstep(shoulderPrepStart, startCompression, inputPeak);
    color -= vec3(canonicalOffset * shoulderPrepAuthority);

    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) return color;
    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / max(peak, 1.0e-8);
    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, vec3(newPeak), g);
}

uint previewLocalToneMapWidth() {
    return (pc.previewWidth + PREVIEW_LOCAL_TONE_DECIMATION - 1u) / PREVIEW_LOCAL_TONE_DECIMATION;
}

uint previewLocalToneMapHeight() {
    return (pc.previewHeight + PREVIEW_LOCAL_TONE_DECIMATION - 1u) / PREVIEW_LOCAL_TONE_DECIMATION;
}

float previewCalibratedExposedGtmLumaAt(int x, int y) {
    int sx = clamp(x, 0, int(pc.previewWidth) - 1);
    int sy = clamp(y, 0, int(pc.previewHeight) - 1);
    float sensorLuma = sensorGreenAt(sx, sy);
    vec3 calibrated = colorTransform(vec3(sensorLuma));
    float calibratedLuma = max(1.0e-4, dot(calibrated, vec3(0.2126, 0.7152, 0.0722)));
    return max(1.0e-4, previewGtmLuma(calibratedLuma * autoExposureMultiplier()));
}

void buildPreviewFllfBase(uvec2 gid) {
    uint mapWidth = previewLocalToneMapWidth();
    uint mapHeight = previewLocalToneMapHeight();
    if (gid.x >= mapWidth || gid.y >= mapHeight) return;

    int centerX = min(int(pc.previewWidth) - 1,
            int(gid.x * PREVIEW_LOCAL_TONE_DECIMATION + PREVIEW_LOCAL_TONE_DECIMATION / 2u));
    int centerY = min(int(pc.previewHeight) - 1,
            int(gid.y * PREVIEW_LOCAL_TONE_DECIMATION + PREVIEW_LOCAL_TONE_DECIMATION / 2u));
    float centerLuma = previewCalibratedExposedGtmLumaAt(centerX, centerY);
    float centerLog = log2(max(centerLuma, 1.0e-6));
    float weightedLog = centerLog * 2.35;
    float weightSum = 2.35;
    int step = int(PREVIEW_LOCAL_TONE_DECIMATION);
    ivec2 offsets[4] = ivec2[4](ivec2(step, 0), ivec2(-step, 0), ivec2(0, step), ivec2(0, -step));
    for (int i = 0; i < 4; ++i) {
        float neighborLuma = previewCalibratedExposedGtmLumaAt(
                centerX + offsets[i].x, centerY + offsets[i].y);
        float neighborLog = log2(max(neighborLuma, 1.0e-6));
        float rangeWeight = exp(-1.55 * abs(neighborLog - centerLog));
        float weight = rangeWeight * 0.76;
        weightedLog += neighborLog * weight;
        weightSum += weight;
    }
    localToneBase[gid.y * mapWidth + gid.x] =
            max(1.0e-6, exp2(weightedLog / max(weightSum, 1.0e-5)));
}

float previewFllfBaseAt(int x, int y) {
    int mapWidth = int(previewLocalToneMapWidth());
    int mapHeight = int(previewLocalToneMapHeight());
    int sx = clamp(x, 0, mapWidth - 1);
    int sy = clamp(y, 0, mapHeight - 1);
    return localToneBase[uint(sy * mapWidth + sx)];
}

float samplePreviewFllfBase(uvec2 gid) {
    float scale = 1.0 / float(PREVIEW_LOCAL_TONE_DECIMATION);
    vec2 p = (vec2(gid) + vec2(0.5)) * scale - vec2(0.5);
    ivec2 p0 = ivec2(floor(p));
    vec2 f = fract(p);
    float b00 = previewFllfBaseAt(p0.x, p0.y);
    float b10 = previewFllfBaseAt(p0.x + 1, p0.y);
    float b01 = previewFllfBaseAt(p0.x, p0.y + 1);
    float b11 = previewFllfBaseAt(p0.x + 1, p0.y + 1);
    return mix(mix(b00, b10, f.x), mix(b01, b11, f.x), f.y);
}

vec3 applyPreviewFllf(uvec2 gid, vec3 exposedGtmRgb) {
    float strength = clamp(uintBitsToFloat(statsBuffer[FLLF_STRENGTH_INDEX]), 0.0, 0.90);
    if (!(strength > 1.0e-4)) return exposedGtmRgb;
    float sceneKey = clamp(uintBitsToFloat(statsBuffer[TONE_SCENE_KEY_INDEX]), 0.125, 0.178);
    float maxLiftEv = clamp(uintBitsToFloat(statsBuffer[FLLF_MAX_LIFT_EV_INDEX]), 0.0, 1.10);
    float maxCompressEv = clamp(uintBitsToFloat(statsBuffer[FLLF_MAX_COMPRESS_EV_INDEX]), 0.0, 1.10);
    float centerLuma = max(1.0e-6, dot(exposedGtmRgb, vec3(0.2126, 0.7152, 0.0722)));
    float localBase = max(1.0e-6, samplePreviewFllfBase(gid));
    float requestedEv = clamp(log2(sceneKey / localBase), -maxCompressEv, maxLiftEv);
    float localNeedGate = smoothstep(0.045, 0.16, abs(requestedEv));
    float deepBlackGuard = requestedEv > 0.0 ? smoothstep(0.014, 0.055, centerLuma) : 1.0;
    float positiveHighlightGuard = requestedEv > 0.0 ? (1.0 - 0.88 * smoothstep(0.48, 0.90, centerLuma)) : 1.0;
    float sigmaY = previewPhysicalNoiseSigma(localBase);
    float noiseConfidence = clamp(uintBitsToFloat(statsBuffer[PHYSICAL_NOISE_CONFIDENCE_INDEX]), 0.0, 1.0);
    float sigmaEv = sigmaY / max(1.0e-5, 0.69314718056 * localBase);
    float noiseCoreEv = clamp((0.80 + 0.70 * noiseConfidence) * sigmaEv, 0.0, 0.34);
    float requestedCorrection = requestedEv * strength * localNeedGate * deepBlackGuard * positiveHighlightGuard;
    float noiseSignificance = smoothstep(noiseCoreEv, max(noiseCoreEv + 0.025, 2.6 * noiseCoreEv), abs(requestedCorrection));
    if (requestedCorrection > 0.0) requestedCorrection *= noiseSignificance;
    float laplacianBand = log2(centerLuma + 1.0e-6) - log2(localBase + 1.0e-6);
    float edgeStopEv = clamp(0.56 + 0.18 * previewPhysicalNoisePressure(localBase), 0.54, 0.76);
    float edge = smoothstep(0.62 * edgeStopEv, 1.28 * edgeStopEv, abs(laplacianBand));
    float appliedEv = clamp(requestedCorrection * (1.0 - 0.84 * edge), -maxCompressEv, maxLiftEv);
    return exposedGtmRgb * exp2(appliedEv);
}

vec3 applyProfileToneLook(vec3 rgb) {
    float y = max(0.0, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
    if (y > 1.0e-6) {
        float curveY = toneLutSample(clamp(y, 0.0, 1.0));
        rgb *= curveY / y;
        y = max(0.0, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
    }
    if (abs(pc.profileContrast) > 0.0001 && y > 1.0e-6) {
        float factor = exp2(clamp(pc.profileContrast, -1.0, 1.0) * 0.75);
        float mapped = y < 0.5
                ? 0.5 * pow(max(0.0, 2.0 * y), factor)
                : 1.0 - 0.5 * pow(max(0.0, 2.0 * (1.0 - y)), factor);
        rgb *= mapped / y;
    }
    return rgb;
}

bool profileCreativeCarrierEncoded(float value) {
    return value <= -1.5;
}

uint profileCreativePayload(float value) {
    return uint(clamp(round(-value - 2.0), 0.0, 8388607.0));
}

float profileDecodeSigned8(uint code) {
    int signedCode = int(code) - 128;
    return signedCode >= 0
            ? clamp(float(signedCode) / 127.0, 0.0, 1.0)
            : clamp(float(signedCode) / 128.0, -1.0, 0.0);
}

float profileDecodedSaturation(float carrier) {
    if (!profileCreativeCarrierEncoded(carrier)) return clamp(carrier, -1.0, 1.0);
    return profileDecodeSigned8(profileCreativePayload(carrier) & 0xffu);
}

float profileDecodedPop(float carrier) {
    if (!profileCreativeCarrierEncoded(carrier)) return 0.0;
    return float((profileCreativePayload(carrier) >> 8u) & 0x7fu) / 127.0;
}

float profileDecodedColorRecovery(float carrier) {
    if (!profileCreativeCarrierEncoded(carrier)) return 0.0;
    return profileDecodeSigned8((profileCreativePayload(carrier) >> 15u) & 0xffu);
}

float profileColorRelativeSaturation(vec3 rgb) {
    float maximum = max(rgb.r, max(rgb.g, rgb.b));
    float minimum = min(rgb.r, min(rgb.g, rgb.b));
    return clamp((maximum - minimum) / max(abs(maximum), 1.0e-4), 0.0, 1.0);
}

float profileColorChromaRange(vec3 rgb) {
    return max(0.0, max(rgb.r, max(rgb.g, rgb.b)) - min(rgb.r, min(rgb.g, rgb.b)));
}

float profileColorLumaWindow(float y) {
    return smoothstep(0.025, 0.12, y) * (1.0 - smoothstep(0.82, 0.98, y));
}

vec3 applyProfileColorRecovery(vec3 rgb, float signedControl) {
    float control = clamp(signedControl, -1.0, 1.0);
    if (abs(control) < 1.0e-4) return rgb;

    float y = max(0.0, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
    float chroma = profileColorChromaRange(rgb);
    float saturation = profileColorRelativeSaturation(rgb);
    float evidence = smoothstep(0.012, 0.055, chroma);
    float mutedHeadroom = 1.0 - smoothstep(0.40, 0.78, saturation);
    float authority = control * evidence * mutedHeadroom * profileColorLumaWindow(y);
    float stops = authority * (control >= 0.0 ? 0.48 : 0.36);
    return vec3(y) + (rgb - vec3(y)) * exp2(stops);
}

vec3 applyProfilePopPreview(vec3 rgb, float controlValue, float sourceLuma, float localBase) {
    float control = clamp(controlValue, 0.0, 1.0);
    // Exact neutral path: Pop=0 performs no local-base dependent work.
    if (control <= 1.0e-4) return rgb;

    float center = max(0.0, sourceLuma);
    float base = max(0.0, localBase);
    float evDetail = log2((center + 0.004) / (base + 0.004));
    float magnitude = abs(evDetail);

    // The resident FLLF base is already a range-aware mid-scale neighbourhood estimate.
    // Reuse it instead of re-demosaicing eight neighbours per preview pixel. This keeps Pop
    // structural and inexpensive enough for the high-FPS RAW viewfinder.
    float structure = smoothstep(0.025, 0.18, magnitude);
    float hardEdgeGuard = 1.0 - 0.72 * smoothstep(0.58, 1.30, magnitude);
    float noiseSigma = previewPhysicalNoiseSigma(max(base, 1.0e-4));
    float snr = center / max(noiseSigma, 1.0e-4);
    float noiseGuard = smoothstep(1.4, 4.5, snr);

    float y = max(0.0, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
    float shadowGuard = smoothstep(0.035, 0.13, y);
    float highlightGuard = 1.0 - smoothstep(0.72, 0.965, y);
    float toneWindow = shadowGuard * highlightGuard;
    float authority = pow(control, 1.15) * structure * hardEdgeGuard * noiseGuard * toneWindow;

    float popEv = clamp(evDetail * 0.50 * authority, -0.18, 0.18);
    float targetY = clamp(y * exp2(popEv), 0.0, 1.0);
    vec3 outRgb = rgb * clamp(y > 1.0e-6 ? targetY / y : 1.0, 0.82, 1.22);

    float outY = max(0.0, dot(outRgb, vec3(0.2126, 0.7152, 0.0722)));
    float chroma = profileColorChromaRange(outRgb);
    float saturation = profileColorRelativeSaturation(outRgb);
    float chromaEvidence = smoothstep(0.025, 0.12, chroma) *
            (1.0 - smoothstep(0.62, 0.90, saturation));
    float chromaGain = 1.0 + 0.055 * control * structure * toneWindow * chromaEvidence;
    return vec3(outY) + (outRgb - vec3(outY)) * chromaGain;
}


vec3 applyProfileColorPreview(vec3 rgb, float popSourceLuma, float popLocalBase) {
    float y = max(0.0, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
    float baseSaturation = profileColorRelativeSaturation(rgb);
    float toneLumaWeight = smoothstep(0.008, 0.07, y) * (1.0 - smoothstep(0.72, 0.98, y));
    float saturationProtection = 1.0 - 0.45 * baseSaturation;
    float adaptiveSaturationBoost = 0.28 * toneLumaWeight * saturationProtection;
    float adaptiveVibranceBoost = 0.14 * toneLumaWeight * (1.0 - 0.70 * baseSaturation);
    rgb = vec3(y) + (rgb - vec3(y)) *
            (1.0 + adaptiveSaturationBoost + adaptiveVibranceBoost);

    float saturationControl = profileDecodedSaturation(pc.profileSaturation);
    float vibranceControl = clamp(pc.profileVibrance, -1.0, 1.0);
    float colorRecoveryControl = profileDecodedColorRecovery(pc.profileSaturation);
    float popControl = profileDecodedPop(pc.profileSaturation);

    if (abs(vibranceControl) >= 1.0e-4) {
        float protection = clamp(1.0 - baseSaturation, 0.0, 1.0);
        float authority = vibranceControl >= 0.0
                ? vibranceControl * (0.20 + 0.80 * protection)
                : vibranceControl * (0.55 + 0.45 * protection);
        rgb = vec3(y) + (rgb - vec3(y)) * exp2(authority * 0.90);
    }
    if (abs(saturationControl) >= 1.0e-4) {
        rgb = vec3(y) + (rgb - vec3(y)) * exp2(saturationControl * 0.85);
    }
    if (abs(colorRecoveryControl) >= 1.0e-4) {
        rgb = applyProfileColorRecovery(rgb, colorRecoveryControl);
    }
    if (popControl > 1.0e-4) {
        rgb = applyProfilePopPreview(rgb, popControl, popSourceLuma, popLocalBase);
    }
    return rgb;
}

vec3 gamutCompress(vec3 rgb) {
    rgb = max(rgb, vec3(0.0));
    float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    if (!(y > 1.0e-8)) return vec3(0.0);
    if (y > 1.0) { rgb /= y; y = 1.0; }
    float mx = max(rgb.r, max(rgb.g, rgb.b));
    float mn = min(rgb.r, min(rgb.g, rgb.b));
    if (mx <= 1.0 && mn >= 0.0) return rgb;
    float a = 1.0;
    if (mx > y + 1.0e-6) a = min(a, (1.0 - y) / (mx - y));
    if (mn < y - 1.0e-6) a = min(a, y / (y - mn));
    return clamp(vec3(y) + (rgb - vec3(y)) * clamp(a, 0.0, 1.0), vec3(0.0), vec3(1.0));
}

vec3 srgbEncode(vec3 x) {
    x = clamp(x, vec3(0.0), vec3(1.0));
    bvec3 low = lessThanEqual(x, vec3(0.0031308));
    return mix(1.055 * pow(x, vec3(1.0 / 2.4)) - 0.055, 12.92 * x, low);
}

void histogramPass() {
    uvec2 g = gl_GlobalInvocationID.xy;
    uint stride = max(1u, uint(abs(pc.histogramStride)));
    uint x = g.x * stride;
    uint y = g.y * stride;
    if (x >= pc.previewWidth || y >= pc.previewHeight) return;

    uint d = max(1u, pc.cfaCellDecimation);
    int baseX = int((x >> 1u) * 2u * d + (x & 1u));
    int baseY = int((y >> 1u) * 2u * d + (y & 1u));
    bool sensorClipped = false;
    bool reconstructed = false;
    float raw = reconstructRawHighlightDirect(baseX, baseY, sensorClipped, reconstructed);
    uint sampledColor = cfaColorLocal(baseX, baseY);

    // Phase 11G: meter sparse demosaiced/characterized RGB, matching the render and capture
    // evidence domain rather than treating sensor green as an RGB-neutral scene sample.
    vec3 meteredSensorRgb = commonScaleReconstructedHighlight(
            max(vec3(0.0), demosaicAt(int(x), int(y))), false);
    vec3 meteredCalibratedRgb = colorTransform(meteredSensorRgb);
    float v = clamp(dot(meteredCalibratedRgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
    uint bin = min(255u, uint(v * 255.0 + 0.5));
    atomicAdd(statsBuffer[bin], 1u);
    uint q = uint(clamp(raw, 0.0, 1.0) * 1000000.0 + 0.5);
    atomicMin(statsBuffer[RAW_MIN_INDEX], q);
    atomicMax(statsBuffer[RAW_MAX_INDEX], q);
    atomicAdd(statsBuffer[RAW_SAMPLE_COUNT_INDEX], 1u);
    // Measure true sensor saturation on the original CFA sample, before highlight reconstruction.
    if (rawSensorNormalizedDirect(baseX, baseY) >= RAW_TRUE_SATURATION_THRESHOLD) {
        atomicAdd(statsBuffer[RAW_TRUE_SATURATED_COUNT_INDEX], 1u);
    }
    if (sensorClipped) {
        atomicAdd(statsBuffer[RAW_NEAR_CLIP_COUNT_INDEX], 1u);
        if (sampledColor == 0u) atomicAdd(statsBuffer[RAW_R_CLIP_COUNT_INDEX], 1u);
        else if (sampledColor == 1u) atomicAdd(statsBuffer[RAW_G_CLIP_COUNT_INDEX], 1u);
        else atomicAdd(statsBuffer[RAW_B_CLIP_COUNT_INDEX], 1u);
    }
    if (reconstructed) atomicAdd(statsBuffer[RAW_RECONSTRUCTED_SAMPLE_COUNT_INDEX], 1u);

    vec3 sensorRgb = commonScaleReconstructedHighlight(max(vec3(0.0), demosaicAt(int(x), int(y))), false);
    vec3 postWb = sensorRgb * vec3(pc.wbR, pc.wbG, pc.wbB);
    if (any(greaterThanEqual(postWb, vec3(1.0)))) {
        atomicAdd(statsBuffer[POST_WB_CLIP_COUNT_INDEX], 1u);
    }
    vec3 postCcm = vec3(
            pc.ccm0 * postWb.r + pc.ccm1 * postWb.g + pc.ccm2 * postWb.b,
            pc.ccm3 * postWb.r + pc.ccm4 * postWb.g + pc.ccm5 * postWb.b,
            pc.ccm6 * postWb.r + pc.ccm7 * postWb.g + pc.ccm8 * postWb.b);
    if (any(greaterThanEqual(postCcm, vec3(1.0)))) {
        atomicAdd(statsBuffer[POST_CCM_CLIP_COUNT_INDEX], 1u);
    }
}

float previewPhysicalNoiseSigma(float signal) {
    float s = uintBitsToFloat(statsBuffer[PHYSICAL_NOISE_GREEN_S_INDEX]);
    float o = uintBitsToFloat(statsBuffer[PHYSICAL_NOISE_GREEN_O_INDEX]);
    float confidence = clamp(uintBitsToFloat(statsBuffer[PHYSICAL_NOISE_CONFIDENCE_INDEX]), 0.0, 1.0);
    if (!(confidence > 0.0) || isnan(s) || isnan(o) || s < 0.0 || o < 0.0) return 0.0;
    return sqrt(max(0.0, s * max(0.0, signal) + o));
}

float previewPhysicalNoisePressure(float signal) {
    float confidence = clamp(uintBitsToFloat(statsBuffer[PHYSICAL_NOISE_CONFIDENCE_INDEX]), 0.0, 1.0);
    float sigma = previewPhysicalNoiseSigma(signal);
    float relativeSigma = sigma / max(0.025, signal);
    return confidence * smoothstep(0.025, 0.16, relativeSigma);
}

float histogramPercentile(uint total, float fraction) {
    if (total == 0u) return 0.0;
    uint target = uint(round(float(total - 1u) * fraction));
    uint cumulative = 0u;
    for (uint i = 0u; i < 256u; ++i) {
        cumulative += statsBuffer[i];
        if (cumulative > target) return float(i) / 255.0;
    }
    return 1.0;
}

void exposurePass() {
    if (gl_LocalInvocationIndex != 0u) return;
    uint total = 0u;
    for (uint i = 0u; i < 256u; ++i) total += statsBuffer[i];

    float previousGain = uintBitsToFloat(previewExposureState[0]);
    bool previousGainValid = !isnan(previousGain) && !isinf(previousGain) &&
            previousGain >= exp2(-0.50) && previousGain <= exp2(1.25);
    if (total == 0u) {
        float heldGain = previousGainValid ? clamp(previousGain, exp2(-0.50), exp2(1.25)) : 1.0;
        statsBuffer[EXPOSURE_INDEX] = floatBitsToUint(heldGain);
        statsBuffer[MIDTONE_INDEX] = floatBitsToUint(0.0);
        statsBuffer[PREVIEW_REQUESTED_EV_INDEX] = floatBitsToUint(0.0);
        statsBuffer[PREVIEW_HIGHLIGHT_LIMITED_EV_INDEX] = floatBitsToUint(0.0);
        statsBuffer[PREVIEW_APPLIED_EV_INDEX] = floatBitsToUint(previewSceneSafeLog2(heldGain));
        statsBuffer[PREVIEW_SCENE_KEY_INDEX] = floatBitsToUint(0.148);
        statsBuffer[PREVIEW_HIGHLIGHT_HEADROOM_EV_INDEX] = floatBitsToUint(0.0);
        statsBuffer[PREVIEW_SCENE_RANGE_EV_INDEX] = floatBitsToUint(0.0);
        statsBuffer[TONE_SCENE_KEY_INDEX] = floatBitsToUint(0.148);
        statsBuffer[TONE_RESERVED_0_INDEX] = floatBitsToUint(0.86);
        statsBuffer[TONE_RESERVED_1_INDEX] = floatBitsToUint(0.0);
        statsBuffer[TONE_RESERVED_2_INDEX] = floatBitsToUint(0.0);
        statsBuffer[TONE_RESERVED_3_INDEX] = floatBitsToUint(0.0);
        statsBuffer[TONE_RESERVED_4_INDEX] = floatBitsToUint(0.0);
        statsBuffer[TONE_DYNAMIC_RANGE_PRESSURE_INDEX] = floatBitsToUint(0.0);
        statsBuffer[FLLF_STRENGTH_INDEX] = floatBitsToUint(0.0);
        statsBuffer[FLLF_MAX_LIFT_EV_INDEX] = floatBitsToUint(0.0);
        statsBuffer[FLLF_MAX_COMPRESS_EV_INDEX] = floatBitsToUint(0.0);
        return;
    }

    float p35 = histogramPercentile(total, 0.35);
    float p50 = histogramPercentile(total, 0.50);
    float p75 = histogramPercentile(total, 0.75);
    float p90 = histogramPercentile(total, 0.90);
    float p95 = histogramPercentile(total, 0.95);
    float p99 = histogramPercentile(total, 0.99);
    float rawSampleCount = float(statsBuffer[RAW_SAMPLE_COUNT_INDEX]);
    float rawClipFraction = rawSampleCount > 0.0
            ? float(statsBuffer[RAW_NEAR_CLIP_COUNT_INDEX]) / rawSampleCount : 0.0;
    uint nearWhiteCount = 0u;
    for (uint bin = 250u; bin < 256u; ++bin) nearWhiteCount += statsBuffer[bin];
    float nearWhiteFraction = float(nearWhiteCount) / float(max(1u, total));
    float previewReferenceSignal = max(0.025, 0.65 * p50 + 0.35 * p75);
    float previewNoiseSigmaY = previewPhysicalNoiseSigma(previewReferenceSignal);
    float previewNoiseConfidence = clamp(
            uintBitsToFloat(statsBuffer[PHYSICAL_NOISE_CONFIDENCE_INDEX]), 0.0, 1.0);
    float sensorSaturatedFraction = rawSampleCount > 0.0
            ? float(statsBuffer[RAW_TRUE_SATURATED_COUNT_INDEX]) / rawSampleCount : 0.0;

    PreviewSceneExposurePlan exposurePlan = resolvePreviewSceneExposurePolicy(
            p35, p50, p75, p90, p95, p99,
            rawClipFraction, sensorSaturatedFraction,
            previewNoiseSigmaY, previewNoiseConfidence,
            previousGain, previousGainValid);
    PreviewGlobalToneMappingPlan gtmPlan = resolvePreviewGlobalToneMappingPlan(
            p90, p95, p99, nearWhiteFraction,
            max(rawClipFraction, sensorSaturatedFraction),
            exposurePlan.sceneRangeEv, exposurePlan.appliedEv);

    statsBuffer[EXPOSURE_INDEX] = floatBitsToUint(exp2(exposurePlan.appliedEv));
    previewExposureState[0] = floatBitsToUint(exp2(exposurePlan.appliedEv));
    statsBuffer[MIDTONE_INDEX] = floatBitsToUint(exposurePlan.midtone);
    statsBuffer[TONE_SCENE_KEY_INDEX] = floatBitsToUint(exposurePlan.sceneKey);
    statsBuffer[PREVIEW_REQUESTED_EV_INDEX] = floatBitsToUint(exposurePlan.requestedEv);
    statsBuffer[PREVIEW_HIGHLIGHT_LIMITED_EV_INDEX] = floatBitsToUint(exposurePlan.highlightLimitedEv);
    statsBuffer[PREVIEW_APPLIED_EV_INDEX] = floatBitsToUint(exposurePlan.appliedEv);
    statsBuffer[PREVIEW_SCENE_KEY_INDEX] = floatBitsToUint(exposurePlan.sceneKey);
    statsBuffer[PREVIEW_HIGHLIGHT_HEADROOM_EV_INDEX] = floatBitsToUint(exposurePlan.highlightHeadroomEv);
    statsBuffer[PREVIEW_SCENE_RANGE_EV_INDEX] = floatBitsToUint(exposurePlan.sceneRangeEv);
    statsBuffer[TONE_SCENE_KEY_INDEX] = floatBitsToUint(exposurePlan.sceneKey);
    statsBuffer[TONE_RESERVED_0_INDEX] = floatBitsToUint(gtmPlan.shoulderStart);
    statsBuffer[TONE_RESERVED_1_INDEX] = floatBitsToUint(gtmPlan.shoulderStrength);
    statsBuffer[TONE_RESERVED_2_INDEX] = floatBitsToUint(gtmPlan.highlightPressure);
    statsBuffer[TONE_RESERVED_3_INDEX] = floatBitsToUint(gtmPlan.p95CompressionEv);
    statsBuffer[TONE_RESERVED_4_INDEX] = floatBitsToUint(gtmPlan.p99CompressionEv);

    // Lightweight FLLF policy mirrors the full preview authority while retaining the fast path's
    // 1/8-resolution local base. It owns local contrast only; no second global exposure exists.
    float shadowPressure = clamp(
            0.62 * (1.0 - smoothstep(0.055, 0.20, p50)) +
            0.38 * (1.0 - smoothstep(0.13, 0.38, p75)), 0.0, 1.0);
    float brightTail = clamp(
            0.50 * smoothstep(0.58, 0.92, p95) +
            0.30 * smoothstep(0.76, 1.04, p99) +
            0.20 * smoothstep(0.0025, 0.045, nearWhiteFraction), 0.0, 1.0);
    float sensorClipPct = 100.0 * sensorSaturatedFraction;
    float sensorClip = clamp(
            0.70 * smoothstep(0.05, 0.60, sensorClipPct) +
            0.30 * smoothstep(0.60, 2.00, sensorClipPct), 0.0, 1.0);
    float highlightPressure = clamp(max(brightTail, 0.80 * sensorClip), 0.0, 1.0);
    float dynamicRangePressure = clamp(max(
            smoothstep(1.55, 3.85, exposurePlan.sceneRangeEv) * smoothstep(0.28, 0.72, p95),
            shadowPressure * highlightPressure), 0.0, 1.0);
    float noisePressure = previewPhysicalNoisePressure(previewReferenceSignal);
    bool lowLight = (pc.captureIso >= 700.0) ||
            (pc.captureIso >= 250.0 && pc.captureExposureMs >= 20.0) ||
            (p50 < 0.070 && p95 < 0.250);
    float fllfStrength = 0.30 + 0.24 * dynamicRangePressure +
            0.10 * shadowPressure + 0.08 * highlightPressure;
    fllfStrength *= 1.0 - (lowLight ? 0.34 : 0.16) * noisePressure;
    fllfStrength = clamp(fllfStrength, 0.26, 0.70);
    float fllfLift = (0.40 + 0.58 * shadowPressure + 0.18 * dynamicRangePressure) *
            (1.0 - (lowLight ? 0.42 : 0.24) * noisePressure);
    float fllfMaxLift = clamp(fllfLift, 0.20, 1.10);
    float fllfMaxCompress = clamp(
            0.38 + 0.48 * highlightPressure + 0.24 * dynamicRangePressure, 0.34, 1.10);
    statsBuffer[TONE_DYNAMIC_RANGE_PRESSURE_INDEX] = floatBitsToUint(dynamicRangePressure);
    statsBuffer[FLLF_STRENGTH_INDEX] = floatBitsToUint(fllfStrength);
    statsBuffer[FLLF_MAX_LIFT_EV_INDEX] = floatBitsToUint(fllfMaxLift);
    statsBuffer[FLLF_MAX_COMPRESS_EV_INDEX] = floatBitsToUint(fllfMaxCompress);
}

void physicalAwbPass() {
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= PHYSICAL_AWB_GRID_COLUMNS || g.y >= PHYSICAL_AWB_GRID_ROWS) return;
    if (pc.previewWidth < PHYSICAL_AWB_GRID_COLUMNS || pc.previewHeight < PHYSICAL_AWB_GRID_ROWS) return;
    uint x = min(pc.previewWidth - 1u, ((2u * g.x + 1u) * pc.previewWidth) / (2u * PHYSICAL_AWB_GRID_COLUMNS));
    uint y = min(pc.previewHeight - 1u, ((2u * g.y + 1u) * pc.previewHeight) / (2u * PHYSICAL_AWB_GRID_ROWS));
    vec3 s = demosaicAt(int(x), int(y));
    float luma = dot(s, vec3(0.2126, 0.7152, 0.0722));
    float centre = sensorGreenAt(int(x), int(y));
    float structure = 0.25 * (
            abs(sensorGreenAt(int(x) - 1, int(y)) - centre) +
            abs(sensorGreenAt(int(x) + 1, int(y)) - centre) +
            abs(sensorGreenAt(int(x), int(y) - 1) - centre) +
            abs(sensorGreenAt(int(x), int(y) + 1) - centre));
    uint sampleIndex = g.y * PHYSICAL_AWB_GRID_COLUMNS + g.x;
    uint base = PHYSICAL_AWB_START_INDEX + sampleIndex * PHYSICAL_AWB_SAMPLE_WORDS;
    statsBuffer[base + 0u] = floatBitsToUint(luma);
    statsBuffer[base + 1u] = floatBitsToUint(s.r - s.g);
    statsBuffer[base + 2u] = floatBitsToUint(s.b - s.g);
    statsBuffer[base + 3u] = floatBitsToUint(max(0.0, structure));
    uint tileX = min(15u, (g.x * 16u) / PHYSICAL_AWB_GRID_COLUMNS);
    uint tileY = min(11u, (g.y * 12u) / PHYSICAL_AWB_GRID_ROWS);
    statsBuffer[base + 4u] = tileY * 16u + tileX;
}

// Phase 11H corrective cleanup:
// Spatial exposure is retired. The statistics buffer is cleared before every submission, so
// the reserved ABI range above remains deterministically zero without legacy mode-5/6 passes.

void recordDisplay(uvec2 gid, vec3 rgb) {
    if ((gid.x & 3u) != 0u || (gid.y & 3u) != 0u) return;
    float y = clamp(dot(rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
    uint y8 = uint(round(y * 255.0));
    uint y64 = min(63u, uint(y * 64.0));
    uint r64 = min(63u, uint(clamp(rgb.r, 0.0, 1.0) * 64.0));
    uint g64 = min(63u, uint(clamp(rgb.g, 0.0, 1.0) * 64.0));
    uint b64 = min(63u, uint(clamp(rgb.b, 0.0, 1.0) * 64.0));
    atomicAdd(statsBuffer[DISPLAY_HISTOGRAM_START_INDEX + min(15u, y8 >> 4u)], 1u);
    atomicAdd(statsBuffer[DISPLAY_LUMA_HISTOGRAM64_START_INDEX + y64], 1u);
    atomicAdd(statsBuffer[DISPLAY_R_HISTOGRAM64_START_INDEX + r64], 1u);
    atomicAdd(statsBuffer[DISPLAY_G_HISTOGRAM64_START_INDEX + g64], 1u);
    atomicAdd(statsBuffer[DISPLAY_B_HISTOGRAM64_START_INDEX + b64], 1u);
    atomicAdd(statsBuffer[DISPLAY_SAMPLE_COUNT_INDEX], 1u);
    if (rgb.r >= 0.985) atomicAdd(statsBuffer[DISPLAY_R_CLIP_COUNT_INDEX], 1u);
    if (rgb.g >= 0.985) atomicAdd(statsBuffer[DISPLAY_G_CLIP_COUNT_INDEX], 1u);
    if (rgb.b >= 0.985) atomicAdd(statsBuffer[DISPLAY_B_CLIP_COUNT_INDEX], 1u);
    if (y8 < 30u) atomicAdd(statsBuffer[DISPLAY_SHADOW_COUNT_INDEX], 1u);
    if (y8 > 220u) {
        uint weight = y8 - 219u;
        atomicAdd(statsBuffer[DISPLAY_HIGHLIGHT_COUNT_INDEX], 1u);
        atomicAdd(statsBuffer[DISPLAY_HIGHLIGHT_WEIGHT_INDEX], weight);
        atomicAdd(statsBuffer[DISPLAY_HIGHLIGHT_X_WEIGHT_INDEX], gid.x * weight);
        atomicAdd(statsBuffer[DISPLAY_HIGHLIGHT_Y_WEIGHT_INDEX], gid.y * weight);
    }

    if (compactNv21Enabled()) {
        uint aw = compactNv21Width();
        uint ah = compactNv21Height();
        uint ax = gid.x >> 2u;
        uint ay = gid.y >> 2u;
        if (ax < aw && ay < ah) {
            uint yi = ay * aw + ax;
            statsBuffer[ANALYSIS_NV21_START_INDEX + yi] = y8;
            if ((ax & 1u) == 0u && (ay & 1u) == 0u && ax + 1u < aw) {
                float r = clamp(rgb.r, 0.0, 1.0);
                float g = clamp(rgb.g, 0.0, 1.0);
                float b = clamp(rgb.b, 0.0, 1.0);
                uint v8 = uint(round(clamp(0.5 + 0.5 * r - 0.418688 * g - 0.081312 * b, 0.0, 1.0) * 255.0));
                uint u8 = uint(round(clamp(0.5 - 0.168736 * r - 0.331264 * g + 0.5 * b, 0.0, 1.0) * 255.0));
                uint ci = ANALYSIS_NV21_START_INDEX + aw * ah + (ay >> 1u) * aw + ax;
                statsBuffer[ci] = v8;
                statsBuffer[ci + 1u] = u8;
            }
        }
    }
}

void renderPass() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.previewWidth || gid.y >= pc.previewHeight) return;

    vec3 sensor = commonScaleReconstructedHighlight(
            demosaicAt(int(gid.x), int(gid.y)), true);

    // Small, noise-gated luminance detail assist for focus readability. No chroma overshoot.
    float g0 = sensorGreenAt(int(gid.x), int(gid.y));
    float cross = 0.25 * (
            sensorGreenAt(int(gid.x) - 1, int(gid.y)) +
            sensorGreenAt(int(gid.x) + 1, int(gid.y)) +
            sensorGreenAt(int(gid.x), int(gid.y) - 1) +
            sensorGreenAt(int(gid.x), int(gid.y) + 1));
    float detail = g0 - cross;
    float isoGate = 1.0 - smoothstep(500.0, 2600.0, max(100.0, pc.captureIso));
    float tonalGate = smoothstep(0.035, 0.16, g0) * (1.0 - smoothstep(0.78, 0.96, g0));
    float detailDelta = clamp(detail * 0.18 * isoGate * tonalGate * mix(0.75, 1.0, focusPriority()), -0.018, 0.018);
    sensor += vec3(detailDelta);

    vec3 rgb = colorTransform(max(sensor, vec3(0.0)));
    float preToneLuma = max(1.0e-6, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
    // Phase 11G capture/viewfinder parity: same authority order as RAW capture.
    rgb *= autoExposureMultiplier();
    rgb = applyPreviewGtm(rgb);
    float popSourceLuma = previewGtmLuma(preToneLuma * autoExposureMultiplier());
    rgb = applyPreviewFllf(gid, rgb);
    rgb = khronosNeutral(rgb);
    rgb *= profileExposureMultiplier();
    rgb = applyProfileToneLook(rgb);
    float popControl = profileDecodedPop(pc.profileSaturation);
    float popLocalBase = popControl > 1.0e-4 ? samplePreviewFllfBase(gid) : popSourceLuma;
    rgb = applyProfileColorPreview(rgb, popSourceLuma, popLocalBase);
    rgb = gamutCompress(rgb);
    rgb = srgbEncode(rgb);
    rgb = clamp(rgb, vec3(0.0), vec3(1.0));

    recordDisplay(gid, rgb);
    imageStore(outputImage, ivec2(gid), vec4(rgb, 1.0));
}

void main() {
    uint mode = dispatchMode();
    if (mode == 0u) histogramPass();
    else if (mode == 1u) exposurePass();
    else if (mode == 3u) buildPreviewFllfBase(gl_GlobalInvocationID.xy);
    else if (mode == 4u) physicalAwbPass();
    else renderPass();
}
