#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InputRgbBuffer {
    vec4 inputPixels[]; // Linear RGBA float (R, G, B, 1.0)
};

layout(std430, set = 0, binding = 1) buffer OutputRgbBuffer {
    vec4 outputPixels[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float lumaSigmaS; // Spatial sigma (e.g. 1.5)
    float lumaSigmaR; // Range sigma (e.g. 0.08)
} pc;

float getLuma(vec3 rgb) {
    return 0.2126 * rgb.r + 0.7152 * rgb.g + 0.0722 * rgb.b;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= int(pc.width) || y >= int(pc.height)) return;

    int pixelIdx = y * int(pc.width) + x;
    vec3 centerRgb = inputPixels[pixelIdx].rgb;
    float centerLuma = getLuma(centerRgb);

    vec3 sumRgb = vec3(0.0);
    float sumWeight = 0.0;

    int radius = 2; // 5x5 bilateral filter window
    float inv2SigmaS2 = 0.5 / (pc.lumaSigmaS * pc.lumaSigmaS);
    float inv2SigmaR2 = 0.5 / (pc.lumaSigmaR * pc.lumaSigmaR);

    for (int dy = -radius; dy <= radius; ++dy) {
        int cy = clamp(y + dy, 0, int(pc.height) - 1);
        for (int dx = -radius; dx <= radius; ++dx) {
            int cx = clamp(x + dx, 0, int(pc.width) - 1);

            int nIdx = cy * int(pc.width) + cx;
            vec3 neighborRgb = inputPixels[nIdx].rgb;
            float neighborLuma = getLuma(neighborRgb);

            float spatialDist2 = float(dx * dx + dy * dy);
            float rangeDist2 = (neighborLuma - centerLuma) * (neighborLuma - centerLuma);

            float w = exp(-spatialDist2 * inv2SigmaS2 - rangeDist2 * inv2SigmaR2);

            sumRgb += neighborRgb * w;
            sumWeight += w;
        }
    }

    vec3 denoisedRgb = (sumWeight > 1e-6) ? (sumRgb / sumWeight) : centerRgb;
    outputPixels[pixelIdx] = vec4(denoisedRgb, 1.0);
}
