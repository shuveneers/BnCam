#version 450

// SPECTRA 2 Milestone 8H-I
// Resident JPEG-only Bayer finalization. The expensive full-frame correction path remains on
// Vulkan between Pass 3 and demosaic. CPU authority is limited to the compact G1/G2 median
// evidence decision. Correction is permitted only after paired 2x2 G samples prove a
// spatially consistent 1%-12% split; scene-dependent median differences do not qualify.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SourceBuffer { float sourceMosaic[]; };
layout(std430, binding = 1) buffer OutputBuffer { float outputMosaic[]; };
layout(std430, binding = 2) buffer GreenSamples { vec4 greenSamples[]; };
layout(std430, binding = 3) buffer TelemetryBuffer { uint telemetry[]; };
layout(std430, binding = 4) readonly buffer LensBuffer { float lensShading[]; };

// Exact per-workgroup telemetry reduction for the full-frame finalize pass.
// The previous implementation issued several globally contended atomics per pixel,
// including an unconditional atomicMax, which can serialize tens of millions of
// invocations on mobile GPUs. Keep exact counters while reducing global atomics
// to at most five operations per 16x16 workgroup.
shared uvec4 finalizeCounts[256];
shared uint finalizeMaxGainBits[256];

// Phase 5: one-workgroup scene resolver. All full-frame work stays resident on Vulkan; these
// shared values only coordinate the 64x48 compact exposure policy within the command buffer.
shared uint exposureValidCount;
shared float exposureP10;
shared float exposureP25;
shared float exposureP35;
shared float exposureP50;
shared float exposureP75;
shared float exposureP90;
shared float exposureP95;
shared float exposureP99;
shared float exposureMeasuredDrEv;
shared float exposureLowerNeutralEv;
shared float exposureUpperNeutralEv;
shared float exposureSpatialAuthority;

layout(push_constant) uniform Params {
    uint frameWidth;
    uint frameHeight;
    uint effectiveCfaPattern;
    uint sensorCfaPattern;
    int cfaOffsetX;
    int cfaOffsetY;
    uint mode; // 0 green sampling, 1 finalization, 2 auto-scene, 3 exposure tiles, 4 exposure resolve, 5 exposure apply
    uint xStep;
    uint yStep;
    uint sampleColumns;
    uint sampleRows;
    uint lensColumns;
    uint lensRows;
    uint lensEnabled;
    float baseDefectThreshold;
    float greenEvenScale;
    float greenOddScale;
    float greenCalibrationRatio;
    uint noiseModelEnabled;
    float s0;
    float s1;
    float s2;
    float s3;
    float o0;
    float o1;
    float o2;
    float o3;
} pc;

bool finite1(float v) { return !(isnan(v) || isinf(v)); }
uint linearIndex(int x, int y) { return uint(y) * pc.frameWidth + uint(x); }
float sceneClamp(float v) { return finite1(v) ? clamp(v, 0.0, 4.0) : 0.0; }

int cfaChannel4(uint pattern, int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    uint p = min(pattern, 3u);
    if (p == 0u) return ym == 0 ? (xm == 0 ? 0 : 1) : (xm == 0 ? 2 : 3); // RGGB
    if (p == 1u) return ym == 0 ? (xm == 0 ? 1 : 0) : (xm == 0 ? 3 : 2); // GRBG
    if (p == 2u) return ym == 0 ? (xm == 0 ? 1 : 3) : (xm == 0 ? 0 : 2); // GBRG
    return ym == 0 ? (xm == 0 ? 3 : 1) : (xm == 0 ? 2 : 0); // BGGR
}

// BnCam S/O arrays are canonical [R, Gr, Gb, B], unlike Camera2 lens-shading
// channels which are [R, Geven, Godd, B]. Keep these mappings intentionally separate.
int noiseChannel4(uint pattern, int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    uint p = min(pattern, 3u);
    if (p == 0u) return ym == 0 ? (xm == 0 ? 0 : 1) : (xm == 0 ? 2 : 3); // RGGB
    if (p == 1u) return ym == 0 ? (xm == 0 ? 1 : 0) : (xm == 0 ? 3 : 2); // GRBG
    if (p == 2u) return ym == 0 ? (xm == 0 ? 2 : 3) : (xm == 0 ? 0 : 1); // GBRG
    return ym == 0 ? (xm == 0 ? 3 : 2) : (xm == 0 ? 1 : 0); // BGGR
}

float noiseS(int ch) {
    return ch == 0 ? pc.s0 : (ch == 1 ? pc.s1 : (ch == 2 ? pc.s2 : pc.s3));
}
float noiseO(int ch) {
    return ch == 0 ? pc.o0 : (ch == 1 ? pc.o1 : (ch == 2 ? pc.o2 : pc.o3));
}
float predictedNoiseVariance(float signal, int ch) {
    if (pc.noiseModelEnabled == 0u) return 0.0;
    float s = noiseS(ch);
    float o = noiseO(ch);
    if (!finite1(s) || !finite1(o)) return 0.0;
    float safeSignal = finite1(signal) ? clamp(signal, 0.0, 1.0) : 0.0;
    return max(0.0, max(0.0, s) * safeSignal + max(0.0, o));
}
float predictedNoiseSigma(float signal, int ch) {
    return sqrt(predictedNoiseVariance(signal, ch));
}


float greenCalibrationScale(int channel) {
    float ratio = finite1(pc.greenCalibrationRatio) ? clamp(pc.greenCalibrationRatio, 0.50, 2.0) : 1.0;
    // Arithmetic-mean-normalized pair keeps overall green luminance neutral while preserving
    // the calibrated green-even/green-odd response ratio.
    if (channel == 1) return (2.0 * ratio) / (ratio + 1.0);
    if (channel == 2) return 2.0 / (ratio + 1.0);
    return 1.0;
}
float sourceAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return sourceMosaic[linearIndex(x, y)];
}

void sort8(inout float v[8]) {
    for (int i = 1; i < 8; ++i) {
        float key = v[i];
        int j = i - 1;
        while (j >= 0 && v[j] > key) {
            v[j + 1] = v[j];
            --j;
        }
        v[j + 1] = key;
    }
}

float defectCorrectedAt(int x, int y, float center, out bool corrected) {
    corrected = false;
    if (x < 2 || y < 2 || x >= int(pc.frameWidth) - 2 || y >= int(pc.frameHeight) - 2) {
        return center;
    }
    float n0 = sourceAt(x - 2, y);
    float n1 = sourceAt(x + 2, y);
    float n2 = sourceAt(x, y - 2);
    float n3 = sourceAt(x, y + 2);
    float neighbourMin = min(min(n0, n1), min(n2, n3));
    float neighbourMax = max(max(n0, n1), max(n2, n3));
    int noiseChannel = noiseChannel4(pc.effectiveCfaPattern, x, y);
    float localSignal = 0.5 * (neighbourMin + neighbourMax);
    float noiseFloor = 5.0 * predictedNoiseSigma(localSignal, noiseChannel);
    float preThreshold = max(max(pc.baseDefectThreshold,
                                 3.0 * max(0.006, neighbourMax - neighbourMin)),
                             noiseFloor);

    // P0 defect policy: hot-pixel admission is based on positive same-CFA outlier
    // significance, not on an absolute scene brightness. The former center > 0.20
    // gate made physically impossible single-pixel excursions survive in dark RAW.
    // Real spatial structure remains protected by the four-site range term here
    // and the robust eight-site median/spread confirmation below.
    bool preHot = center > neighbourMax + preThreshold;
    bool preCold = center < 0.04 && neighbourMin > 0.10 && neighbourMin - center > preThreshold;
    if (!preHot && !preCold) return center;

    float neighbours[8];
    neighbours[0] = n0; neighbours[1] = n1; neighbours[2] = n2; neighbours[3] = n3;
    neighbours[4] = sourceAt(x - 2, y - 2);
    neighbours[5] = sourceAt(x + 2, y - 2);
    neighbours[6] = sourceAt(x - 2, y + 2);
    neighbours[7] = sourceAt(x + 2, y + 2);
    sort8(neighbours);
    float median = 0.5 * (neighbours[3] + neighbours[4]);
    float spread = max(0.006, neighbours[6] - neighbours[1]);
    float finalNoiseFloor = 6.0 * predictedNoiseSigma(median, noiseChannel);
    float threshold = max(max(pc.baseDefectThreshold, spread * 4.0), finalNoiseFloor);

    // A hot sample must still clear the robust local median by the larger of:
    // the format safety floor, 4x robust same-CFA spread, or 6 sigma from S/O.
    // Multiple elevated same-CFA neighbours widen `spread`, preserving supported
    // point/edge structure instead of treating every bright local maximum as a defect.
    bool hot = center > median + threshold;
    bool cold = center < 0.04 && median > 0.10 && median - center > threshold;
    if (hot || cold) {
        corrected = true;
        return median;
    }
    return center;
}

// Baseline SPECTRA denoise is a physical-model owner, not a Neural feature.
// It operates on one Bayer plane at a time (all offsets are even), so R/Gr/Gb/B are never
// mixed. Dynamic ISO has already been folded into the effective S/O supplied here; this pass
// must not apply the coefficient again. Neural, when enabled, receives this denoised mosaic
// and is therefore only a residual/add-on refinement of the physical baseline.
float baselineNoiseReducedAt(int x, int y, float center) {
    if (pc.noiseModelEnabled == 0u || !finite1(center)) return center;
    if (x < 4 || y < 4 || x >= int(pc.frameWidth) - 4 || y >= int(pc.frameHeight) - 4) {
        return center;
    }

    int channel = noiseChannel4(pc.effectiveCfaPattern, x, y);
    float centerNoiseVariance = predictedNoiseVariance(center, channel);
    if (!(centerNoiseVariance > 1.0e-12) || !finite1(centerNoiseVariance)) return center;

    // Two same-CFA spatial scales. The near 3x3 Bayer-plane support removes fine grain. The
    // radius-4 support reduces lower-frequency sensor noise only when the intervening radius-2
    // sample agrees with the center. This makes high effective S/O materially smoother while a
    // low Dynamic-ISO model stays crisp, without adding a second strength parameter or mixing CFA.
    const ivec2 nearOffsets[8] = ivec2[8](
        ivec2(-2,  0), ivec2( 2,  0), ivec2( 0, -2), ivec2( 0,  2),
        ivec2(-2, -2), ivec2( 2, -2), ivec2(-2,  2), ivec2( 2,  2));
    const ivec2 farOffsets[8] = ivec2[8](
        ivec2(-4,  0), ivec2( 4,  0), ivec2( 0, -4), ivec2( 0,  4),
        ivec2(-4, -4), ivec2( 4, -4), ivec2(-4,  4), ivec2( 4,  4));
    float nearSamples[8];
    float nearWeights[8];
    float farSamples[8];
    float farWeights[8];

    float nearRangeVariance = max(4.0 * centerNoiseVariance, 1.0e-12);
    float farRangeVariance = max(6.0 * centerNoiseVariance, 1.0e-12);
    float weightSum = 1.0;
    float weightedSum = center;

    for (int i = 0; i < 8; ++i) {
        float rawNear = sourceAt(x + nearOffsets[i].x, y + nearOffsets[i].y);
        bool nearFinite = finite1(rawNear);
        float nearValue = nearFinite ? rawNear : center;
        nearSamples[i] = nearValue;
        float nearDelta = nearValue - center;
        float nearDistance = (nearDelta * nearDelta) / nearRangeVariance;
        float nearWeight = nearFinite && finite1(nearDistance)
            ? 1.0 / (1.0 + max(nearDistance, 0.0))
            : 0.0;
        if (!finite1(nearWeight) || nearWeight < 0.0) nearWeight = 0.0;
        nearWeights[i] = nearWeight;
        weightSum += nearWeight;
        weightedSum += nearWeight * nearValue;

        float rawFar = sourceAt(x + farOffsets[i].x, y + farOffsets[i].y);
        bool farFinite = finite1(rawFar);
        float farValue = farFinite ? rawFar : center;
        farSamples[i] = farValue;
        float farDelta = farValue - center;
        float farDistance = (farDelta * farDelta) / farRangeVariance;
        float farRangeWeight = farFinite && finite1(farDistance)
            ? 1.0 / (1.0 + max(farDistance, 0.0))
            : 0.0;
        if (!finite1(farRangeWeight) || farRangeWeight < 0.0) farRangeWeight = 0.0;

        // Radius four is exactly twice the spatial distance of the near support, so its base
        // spatial authority is one half. Multiplication by nearWeight is a continuity gate:
        // a far sample cannot contribute strongly across an edge that was already rejected at r=2.
        float farWeight = 0.5 * nearWeight * farRangeWeight;
        if (!finite1(farWeight) || farWeight < 0.0) farWeight = 0.0;
        farWeights[i] = farWeight;
        weightSum += farWeight;
        weightedSum += farWeight * farValue;
    }
    if (!finite1(weightSum) || !finite1(weightedSum) || !(weightSum > 1.0e-12)) return center;

    float localMean = weightedSum / weightSum;
    if (!finite1(localMean)) return center;
    float localVarianceSum = (center - localMean) * (center - localMean);
    for (int i = 0; i < 8; ++i) {
        float nearDelta = nearSamples[i] - localMean;
        float farDelta = farSamples[i] - localMean;
        localVarianceSum += nearWeights[i] * nearDelta * nearDelta;
        localVarianceSum += farWeights[i] * farDelta * farDelta;
    }
    if (!finite1(localVarianceSum)) return center;
    float localVariance = localVarianceSum / weightSum;
    if (!finite1(localVariance) || localVariance < 0.0) return center;

    // Local Wiener shrinkage: variance explained by the resolved physical S/O is suppressed;
    // variance in excess of that prediction is treated as scene structure. Dynamic ISO therefore
    // controls baseline pixel denoise only through the one upstream-resolved S/O model.
    float noiseVariance = predictedNoiseVariance(localMean, channel);
    if (!finite1(noiseVariance) || noiseVariance < 0.0) return center;
    float signalVariance = max(localVariance - noiseVariance, 0.0);
    float denominator = signalVariance + noiseVariance;
    float detailGain = denominator > 1.0e-12 ? signalVariance / denominator : 1.0;
    if (!finite1(detailGain)) return center;
    float filtered = localMean + clamp(detailGain, 0.0, 1.0) * (center - localMean);
    return finite1(filtered) ? sceneClamp(filtered) : center;
}

float safeLensGain(float value) {
    return finite1(value) ? clamp(value, 0.25, 3.5) : 1.0;
}

float lensGainAt(int channel, int x, int y) {
    if (pc.lensEnabled == 0u || pc.lensColumns == 0u || pc.lensRows == 0u) return 1.0;
    float cf = pc.frameWidth > 1u
        ? float(x) * float(pc.lensColumns - 1u) / float(pc.frameWidth - 1u) : 0.0;
    float rf = pc.frameHeight > 1u
        ? float(y) * float(pc.lensRows - 1u) / float(pc.frameHeight - 1u) : 0.0;
    int c0 = clamp(int(floor(cf)), 0, int(pc.lensColumns) - 1);
    int r0 = clamp(int(floor(rf)), 0, int(pc.lensRows) - 1);
    int c1 = min(c0 + 1, int(pc.lensColumns) - 1);
    int r1 = min(r0 + 1, int(pc.lensRows) - 1);
    float tx = clamp(cf - float(c0), 0.0, 1.0);
    float ty = clamp(rf - float(r0), 0.0, 1.0);
    uint stride = pc.lensColumns * 4u;
    int ch = clamp(channel, 0, 3);
    float g00 = safeLensGain(lensShading[uint(r0) * stride + uint(c0 * 4 + ch)]);
    float g10 = safeLensGain(lensShading[uint(r0) * stride + uint(c1 * 4 + ch)]);
    float g01 = safeLensGain(lensShading[uint(r1) * stride + uint(c0 * 4 + ch)]);
    float g11 = safeLensGain(lensShading[uint(r1) * stride + uint(c1 * 4 + ch)]);
    return safeLensGain(mix(mix(g00, g10, tx), mix(g01, g11, tx), ty));
}

void sampleGreen() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.sampleColumns || gid.y >= pc.sampleRows) return;
    uint sampleIndex = gid.y * pc.sampleColumns + gid.x;
    greenSamples[sampleIndex] = vec4(0.0);
    int x = int(gid.x * pc.xStep);
    int y = int(gid.y * pc.yStep);
    if (x < 0 || y < 0 || x + 1 >= int(pc.frameWidth) || y + 1 >= int(pc.frameHeight)) return;
    float g1 = 0.0, g2 = 0.0;
    float v1 = 0.0, v2 = 0.0;
    for (int dy = 0; dy < 2; ++dy) {
        for (int dx = 0; dx < 2; ++dx) {
            int ch = cfaChannel4(pc.effectiveCfaPattern, x + dx, y + dy);
            float value = sourceAt(x + dx, y + dy);
            if (!finite1(value)) continue;
            if (ch == 1) { g1 = sceneClamp(value * greenCalibrationScale(1)); v1 = 1.0; }
            else if (ch == 2) { g2 = sceneClamp(value * greenCalibrationScale(2)); v2 = 1.0; }
        }
    }
    greenSamples[sampleIndex] = vec4(g1, g2, v1, v2);
}

float outputAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return outputMosaic[linearIndex(x, y)];
}

bool coherentSameSign(float center, float a, float b) {
    return center * a > 0.0 && center * b > 0.0 &&
           abs(a) >= 0.015 && abs(b) >= 0.015;
}

void sampleAutoScene() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.sampleColumns || gid.y >= pc.sampleRows) return;
    uint sampleIndex = gid.y * pc.sampleColumns + gid.x;
    greenSamples[sampleIndex] = vec4(0.0);
    int x = 4 + int(gid.x * pc.xStep);
    int y = 4 + int(gid.y * pc.yStep);
    if (x >= int(pc.frameWidth) - 4 || y >= int(pc.frameHeight) - 4) return;
    float center = outputAt(x, y);
    float signedDx = 0.5 * (outputAt(x + 2, y) - outputAt(x - 2, y));
    float signedDy = 0.5 * (outputAt(x, y + 2) - outputAt(x, y - 2));
    float dx = abs(signedDx);
    float dy = abs(signedDy);
    float gradient = max(dx, dy);
    bool isCoherent = false;
    if (dx >= 0.030 && dx > 1.5 * dy + 0.005) {
        float above = 0.5 * (outputAt(x + 2, y - 2) - outputAt(x - 2, y - 2));
        float below = 0.5 * (outputAt(x + 2, y + 2) - outputAt(x - 2, y + 2));
        isCoherent = coherentSameSign(signedDx, above, below);
    } else if (dy >= 0.030 && dy > 1.5 * dx + 0.005) {
        float left = 0.5 * (outputAt(x - 2, y + 2) - outputAt(x - 2, y - 2));
        float right = 0.5 * (outputAt(x + 2, y + 2) - outputAt(x + 2, y - 2));
        isCoherent = coherentSameSign(signedDy, left, right);
    }
    greenSamples[sampleIndex] = vec4(center, gradient, isCoherent ? 1.0 : 0.0,
                                     center < 0.060 ? 1.0 : 0.0);
}

// Phase-5 compact exposure ABI inside TelemetryBuffer. Words 0..4 remain the legacy
// raw-finalize counters. Histograms are GPU-only scratch; summary words are read back after the
// same submission for diagnostics/noise propagation, never for production pixel decisions.
const uint EXP_SUMMARY_VALID_COUNT = 5u;
const uint EXP_SUMMARY_P10 = 6u;
const uint EXP_SUMMARY_P25 = 7u;
const uint EXP_SUMMARY_P50 = 8u;
const uint EXP_SUMMARY_P75 = 9u;
const uint EXP_SUMMARY_P90 = 10u;
const uint EXP_SUMMARY_P95 = 11u;
const uint EXP_SUMMARY_P99 = 12u;
const uint EXP_SUMMARY_DR = 13u;
const uint EXP_SUMMARY_LOWER_NEUTRAL = 14u;
const uint EXP_SUMMARY_UPPER_NEUTRAL = 15u;
const uint EXP_SUMMARY_AUTHORITY = 16u;
const uint EXP_SUMMARY_MIN_EV = 17u;
const uint EXP_SUMMARY_P10_EV = 18u;
const uint EXP_SUMMARY_P50_EV = 19u;
const uint EXP_SUMMARY_P90_EV = 20u;
const uint EXP_SUMMARY_MAX_EV = 21u;
const uint EXP_SUMMARY_MEAN_POS_EV = 22u;
const uint EXP_SUMMARY_MEAN_NEG_EV = 23u;
const uint EXP_SUMMARY_POS_FRAC = 24u;
const uint EXP_SUMMARY_NEU_FRAC = 25u;
const uint EXP_SUMMARY_NEG_FRAC = 26u;
const uint EXP_SUMMARY_MEAN_GAIN2 = 27u;
const uint EXP_SUMMARY_P90_POS_GAIN = 28u;
const uint EXP_SUMMARY_STATUS = 29u;
const uint EXP_LUMA_HIST_START = 32u;
const uint EXP_LUMA_HIST_BINS = 192u;
const uint EXP_EV_HIST_START = EXP_LUMA_HIST_START + EXP_LUMA_HIST_BINS;
const uint EXP_EV_HIST_BINS = 256u;
const uint EXP_POS_EV_HIST_START = EXP_EV_HIST_START + EXP_EV_HIST_BINS;
const uint EXP_POS_EV_HIST_BINS = 128u;
const uint EXPOSURE_MAP_RECORD_OFFSET = 64u * 48u;

float exposureSafeLog2(float value) { return log2(max(value, 1.0e-6)); }
float exposureSmoothstep(float e0, float e1, float value) {
    if (!(e1 > e0)) return value >= e1 ? 1.0 : 0.0;
    float t = clamp((value - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}
uint exposureLumaBin(float luma) {
    float logL = clamp(exposureSafeLog2(luma), -14.0, 0.0);
    return uint(clamp(floor(((logL + 14.0) / 14.0) * float(EXP_LUMA_HIST_BINS - 1u)),
                      0.0, float(EXP_LUMA_HIST_BINS - 1u)));
}
float exposureLumaFromBin(uint bin) {
    float normalized = (float(bin) + 0.5) / float(EXP_LUMA_HIST_BINS);
    return exp2(-14.0 + normalized * 14.0);
}
float exposureLumaPercentile(uint total, float percentile) {
    uint target = uint(floor(float(max(total, 1u) - 1u) * clamp(percentile, 0.0, 1.0)));
    uint cumulative = 0u;
    for (uint bin = 0u; bin < EXP_LUMA_HIST_BINS; ++bin) {
        cumulative += telemetry[EXP_LUMA_HIST_START + bin];
        if (cumulative > target) return exposureLumaFromBin(bin);
    }
    return 1.0;
}
uint exposureEvBin(float ev) {
    float normalized = clamp((ev + 6.0) / 8.0, 0.0, 1.0);
    return uint(clamp(floor(normalized * float(EXP_EV_HIST_BINS - 1u)),
                      0.0, float(EXP_EV_HIST_BINS - 1u)));
}
float exposureEvFromBin(uint bin) {
    float normalized = (float(bin) + 0.5) / float(EXP_EV_HIST_BINS);
    return -6.0 + normalized * 8.0;
}
float exposureEvPercentile(uint total, float percentile) {
    uint target = uint(floor(float(max(total, 1u) - 1u) * clamp(percentile, 0.0, 1.0)));
    uint cumulative = 0u;
    for (uint bin = 0u; bin < EXP_EV_HIST_BINS; ++bin) {
        cumulative += telemetry[EXP_EV_HIST_START + bin];
        if (cumulative > target) return exposureEvFromBin(bin);
    }
    return 0.0;
}
uint exposurePositiveEvBin(float ev) {
    float normalized = clamp(ev / 2.0, 0.0, 1.0);
    return uint(clamp(floor(normalized * float(EXP_POS_EV_HIST_BINS - 1u)),
                      0.0, float(EXP_POS_EV_HIST_BINS - 1u)));
}
float exposurePositiveEvFromBin(uint bin) {
    return ((float(bin) + 0.5) / float(EXP_POS_EV_HIST_BINS)) * 2.0;
}
float exposurePositiveEvPercentile(uint total, float percentile) {
    if (total == 0u) return 0.0;
    uint target = uint(floor(float(total - 1u) * clamp(percentile, 0.0, 1.0)));
    uint cumulative = 0u;
    for (uint bin = 0u; bin < EXP_POS_EV_HIST_BINS; ++bin) {
        cumulative += telemetry[EXP_POS_EV_HIST_START + bin];
        if (cumulative > target) return exposurePositiveEvFromBin(bin);
    }
    return 0.0;
}

void sort16(inout float v[16]) {
    for (int i = 1; i < 16; ++i) {
        float key = v[i];
        int j = i - 1;
        while (j >= 0 && v[j] > key) {
            v[j + 1] = v[j];
            --j;
        }
        v[j + 1] = key;
    }
}

void sampleExposureTile() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.sampleColumns || gid.y >= pc.sampleRows) return;
    uint sampleIndex = gid.y * pc.sampleColumns + gid.x;
    greenSamples[sampleIndex] = vec4(0.0);
    if (pc.sampleColumns == 0u || pc.sampleRows == 0u) return;

    float lumaValues[16];
    float highValues[16];
    float snrValues[16];
    int valid = 0;
    int clipped = 0;
    for (int sy = 0; sy < 4; ++sy) {
        for (int sx = 0; sx < 4; ++sx) {
            float fx = (float(gid.x) + (float(sx) + 0.5) / 4.0) / float(pc.sampleColumns);
            float fy = (float(gid.y) + (float(sy) + 0.5) / 4.0) / float(pc.sampleRows);
            int x0 = clamp((int(floor(fx * float(pc.frameWidth))) & ~1), 0, max(0, int(pc.frameWidth) - 2));
            int y0 = clamp((int(floor(fy * float(pc.frameHeight))) & ~1), 0, max(0, int(pc.frameHeight) - 2));
            float greenSum = 0.0;
            float greenVariance = 0.0;
            int greenCount = 0;
            float cellHigh = 0.0;
            bool cellClipped = false;
            for (int dy = 0; dy < 2; ++dy) {
                for (int dx = 0; dx < 2; ++dx) {
                    int x = x0 + dx;
                    int y = y0 + dy;
                    float value = outputAt(x, y);
                    cellHigh = max(cellHigh, value);
                    cellClipped = cellClipped || value >= 1.0;
                    int effectiveChannel = cfaChannel4(pc.effectiveCfaPattern, x, y);
                    if (effectiveChannel != 1 && effectiveChannel != 2) continue;
                    greenSum += max(0.0, value);
                    ++greenCount;
                    if (pc.noiseModelEnabled != 0u) {
                        int sensorChannel = cfaChannel4(
                            pc.sensorCfaPattern, x + pc.cfaOffsetX, y + pc.cfaOffsetY);
                        float lensGain = lensGainAt(sensorChannel, x, y);
                        float preLensSignal = max(0.0, value) / max(lensGain, 1.0e-4);
                        int noiseChannel = noiseChannel4(pc.effectiveCfaPattern, x, y);
                        float sigma = predictedNoiseSigma(preLensSignal, noiseChannel) * lensGain;
                        greenVariance += sigma * sigma;
                    }
                }
            }
            if (greenCount <= 0) continue;
            float cellLuma = greenSum / float(greenCount);
            float sigmaAverage = pc.noiseModelEnabled != 0u
                ? sqrt(max(0.0, greenVariance)) / float(greenCount) : 0.0;
            lumaValues[valid] = cellLuma;
            highValues[valid] = cellHigh;
            snrValues[valid] = sigmaAverage > 1.0e-7 ? cellLuma / sigmaAverage : 0.0;
            if (cellClipped) ++clipped;
            ++valid;
        }
    }
    if (valid < 8) return;
    // The 4x4 sampler normally produces all 16 records. Pad a rare incomplete tile with its last
    // valid value so fixed-size sorting remains deterministic without introducing a false zero tail.
    for (int i = valid; i < 16; ++i) {
        lumaValues[i] = lumaValues[valid - 1];
        highValues[i] = highValues[valid - 1];
        snrValues[i] = snrValues[valid - 1];
    }
    sort16(lumaValues);
    sort16(highValues);
    sort16(snrValues);
    float medianLuma = 0.5 * (lumaValues[7] + lumaValues[8]);
    float robustHigh = highValues[14];
    float medianSnr = 0.5 * (snrValues[7] + snrValues[8]);
    float clipFraction = float(clipped) / float(valid);
    // w >= 1 is an explicit validity tag; w - 1 is the sampled sensor-clip fraction.
    greenSamples[sampleIndex] = vec4(medianLuma, robustHigh, medianSnr, 1.0 + clipFraction);
    if (medianLuma > 0.0 && finite1(medianLuma)) {
        atomicAdd(telemetry[EXP_LUMA_HIST_START + exposureLumaBin(medianLuma)], 1u);
    }
}

float rawSpatialExposureEv(uint tile) {
    vec4 evidence = greenSamples[tile];
    float luma = evidence.x;
    float high = evidence.y;
    float snr = evidence.z;
    if (!(evidence.w >= 1.0) || !(luma > 0.0) || !finite1(luma)) return 0.0;
    float relativeEv = exposureSafeLog2(luma / max(exposureP50, 1.0e-6));
    float ev = 0.0;
    if (relativeEv < exposureLowerNeutralEv) {
        float distance = exposureLowerNeutralEv - relativeEv;
        float snrAuthority = pc.noiseModelEnabled != 0u && finite1(snr)
                ? exposureSmoothstep(1.5, 6.0, snr) : 0.0;
        float percentileDistance = max(0.25, abs(exposureLowerNeutralEv));
        float requested = distance * (0.20 + 0.20 * exposureSmoothstep(
                percentileDistance, percentileDistance * 3.0, distance));
        float headroomEv = max(0.0, exposureSafeLog2(0.98 / max(max(high, luma), 1.0e-6)));
        ev = min(requested, headroomEv) * snrAuthority * exposureSpatialAuthority;
    }
    // Pre-demosaic spatial exposure is a shadow-recovery owner only. Bright-tail protection is
    // downstream tone work (GTM -> FLLF -> AgX). A negative Bayer-domain exposure cannot recover
    // sensor clipping and was darkening ordinary bright objects before color/tone processing.
    return finite1(ev) ? max(ev, 0.0) : 0.0;
}

void resolveExposureMap() {
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u || gl_WorkGroupID.z != 0u) return;
    uint lane = gl_LocalInvocationIndex;
    uint tileCount = pc.sampleColumns * pc.sampleRows;
    if (lane == 0u) {
        uint total = 0u;
        for (uint bin = 0u; bin < EXP_LUMA_HIST_BINS; ++bin) total += telemetry[EXP_LUMA_HIST_START + bin];
        exposureValidCount = total;
        if (total >= tileCount / 4u && tileCount > 0u) {
            exposureP10 = exposureLumaPercentile(total, 0.10);
            exposureP25 = exposureLumaPercentile(total, 0.25);
            exposureP35 = exposureLumaPercentile(total, 0.35);
            exposureP50 = exposureLumaPercentile(total, 0.50);
            exposureP75 = exposureLumaPercentile(total, 0.75);
            exposureP90 = exposureLumaPercentile(total, 0.90);
            exposureP95 = exposureLumaPercentile(total, 0.95);
            exposureP99 = exposureLumaPercentile(total, 0.99);
            exposureMeasuredDrEv = max(0.0, exposureSafeLog2(exposureP90) - exposureSafeLog2(exposureP10));
            exposureLowerNeutralEv = exposureSafeLog2(max(exposureP35, 1.0e-6) / max(exposureP50, 1.0e-6));
            exposureUpperNeutralEv = exposureSafeLog2(max(exposureP75, 1.0e-6) / max(exposureP50, 1.0e-6));
            float interquartileEv = max(0.0, exposureSafeLog2(max(exposureP75, 1.0e-6)) -
                                               exposureSafeLog2(max(exposureP25, 1.0e-6)));
            exposureSpatialAuthority = max(exposureSmoothstep(0.55, 2.2, interquartileEv),
                    0.75 * exposureSmoothstep(1.4, 4.8, exposureMeasuredDrEv));
        } else {
            exposureP10=0.0; exposureP25=0.0; exposureP35=0.0; exposureP50=0.0; exposureP75=0.0;
            exposureP90=0.0; exposureP95=0.0; exposureP99=0.0; exposureMeasuredDrEv=0.0;
            exposureLowerNeutralEv=0.0; exposureUpperNeutralEv=0.0; exposureSpatialAuthority=0.0;
        }
    }
    barrier();
    for (uint tile = lane; tile < tileCount; tile += 256u) {
        greenSamples[EXPOSURE_MAP_RECORD_OFFSET + tile] = vec4(rawSpatialExposureEv(tile), 0.0, 0.0, 0.0);
    }
    memoryBarrierBuffer();
    barrier();
    for (uint tile = lane; tile < tileCount; tile += 256u) {
        float ev = greenSamples[EXPOSURE_MAP_RECORD_OFFSET + tile].x;
        if (ev > 1.0e-4) {
            int x = int(tile % pc.sampleColumns);
            int y = int(tile / pc.sampleColumns);
            int support = 1, possible = 1;
            const ivec2 offsets[4] = ivec2[4](ivec2(-1,0), ivec2(1,0), ivec2(0,-1), ivec2(0,1));
            for (int n = 0; n < 4; ++n) {
                int nx=x+offsets[n].x, ny=y+offsets[n].y;
                if (nx<0 || ny<0 || nx>=int(pc.sampleColumns) || ny>=int(pc.sampleRows)) continue;
                ++possible;
                uint ni=uint(ny)*pc.sampleColumns+uint(nx);
                float nev=greenSamples[EXPOSURE_MAP_RECORD_OFFSET+ni].x;
                if (nev > 1.0e-4) ++support;
            }
            ev *= exposureSmoothstep(0.20,0.80,float(support)/float(possible));
            greenSamples[EXPOSURE_MAP_RECORD_OFFSET+tile].x = finite1(ev) ? max(ev, 0.0) : 0.0;
        }
    }
    memoryBarrierBuffer();
    barrier();
    for (uint tile = lane; tile < tileCount; tile += 256u) {
        if (greenSamples[tile].w < 1.0) continue;
        float ev=greenSamples[EXPOSURE_MAP_RECORD_OFFSET+tile].x;
        atomicAdd(telemetry[EXP_EV_HIST_START + exposureEvBin(ev)], 1u);
        if (ev > 0.015) atomicAdd(telemetry[EXP_POS_EV_HIST_START + exposurePositiveEvBin(ev)], 1u);
    }
    memoryBarrierBuffer();
    barrier();
    if (lane == 0u) {
        uint valid=0u, pos=0u, neu=0u, neg=0u;
        float minEv=1.0e20, maxEv=-1.0e20, sumPos=0.0, sumNeg=0.0, sumGain2=0.0;
        for (uint tile=0u; tile<tileCount; ++tile) {
            if (greenSamples[tile].w < 1.0) continue;
            float ev=greenSamples[EXPOSURE_MAP_RECORD_OFFSET+tile].x;
            ++valid; minEv=min(minEv,ev); maxEv=max(maxEv,ev);
            float gain=exp2(ev); sumGain2 += gain*gain;
            if (ev>0.015) { ++pos; sumPos+=ev; }
            else if (ev<-0.015) { ++neg; sumNeg+=ev; }
            else ++neu;
        }
        float denom=max(float(valid),1.0);
        telemetry[EXP_SUMMARY_VALID_COUNT]=valid;
        telemetry[EXP_SUMMARY_P10]=floatBitsToUint(exposureP10);
        telemetry[EXP_SUMMARY_P25]=floatBitsToUint(exposureP25);
        telemetry[EXP_SUMMARY_P50]=floatBitsToUint(exposureP50);
        telemetry[EXP_SUMMARY_P75]=floatBitsToUint(exposureP75);
        telemetry[EXP_SUMMARY_P90]=floatBitsToUint(exposureP90);
        telemetry[EXP_SUMMARY_P95]=floatBitsToUint(exposureP95);
        telemetry[EXP_SUMMARY_P99]=floatBitsToUint(exposureP99);
        telemetry[EXP_SUMMARY_DR]=floatBitsToUint(exposureMeasuredDrEv);
        telemetry[EXP_SUMMARY_LOWER_NEUTRAL]=floatBitsToUint(exposureLowerNeutralEv);
        telemetry[EXP_SUMMARY_UPPER_NEUTRAL]=floatBitsToUint(exposureUpperNeutralEv);
        telemetry[EXP_SUMMARY_AUTHORITY]=floatBitsToUint(exposureSpatialAuthority);
        telemetry[EXP_SUMMARY_MIN_EV]=floatBitsToUint(valid>0u?minEv:0.0);
        telemetry[EXP_SUMMARY_P10_EV]=floatBitsToUint(valid>0u?exposureEvPercentile(valid,0.10):0.0);
        telemetry[EXP_SUMMARY_P50_EV]=floatBitsToUint(valid>0u?exposureEvPercentile(valid,0.50):0.0);
        telemetry[EXP_SUMMARY_P90_EV]=floatBitsToUint(valid>0u?exposureEvPercentile(valid,0.90):0.0);
        telemetry[EXP_SUMMARY_MAX_EV]=floatBitsToUint(valid>0u?maxEv:0.0);
        telemetry[EXP_SUMMARY_MEAN_POS_EV]=floatBitsToUint(pos>0u?sumPos/float(pos):0.0);
        telemetry[EXP_SUMMARY_MEAN_NEG_EV]=floatBitsToUint(neg>0u?sumNeg/float(neg):0.0);
        telemetry[EXP_SUMMARY_POS_FRAC]=floatBitsToUint(float(pos)/denom);
        telemetry[EXP_SUMMARY_NEU_FRAC]=floatBitsToUint(float(neu)/denom);
        telemetry[EXP_SUMMARY_NEG_FRAC]=floatBitsToUint(float(neg)/denom);
        telemetry[EXP_SUMMARY_MEAN_GAIN2]=floatBitsToUint(valid>0u?sumGain2/denom:1.0);
        float p90PosEv=pos>0u?exposurePositiveEvPercentile(pos,0.90):0.0;
        telemetry[EXP_SUMMARY_P90_POS_GAIN]=floatBitsToUint(pos>0u?exp2(p90PosEv):1.0);
        uint status = exposureValidCount < tileCount/4u ? 1u :
                (exposureP50 <= 1.0e-6 ? 2u : (exposureSpatialAuthority>0.01?3u:4u));
        telemetry[EXP_SUMMARY_STATUS]=status;
    }
}

float exposureEvAtPixel(int x, int y) {
    if (pc.sampleColumns == 0u || pc.sampleRows == 0u) return 0.0;
    float gx = (float(x) + 0.5) * float(pc.sampleColumns) / float(pc.frameWidth) - 0.5;
    float gy = (float(y) + 0.5) * float(pc.sampleRows) / float(pc.frameHeight) - 0.5;
    int x0 = clamp(int(floor(gx)), 0, int(pc.sampleColumns) - 1);
    int y0 = clamp(int(floor(gy)), 0, int(pc.sampleRows) - 1);
    int x1 = min(x0 + 1, int(pc.sampleColumns) - 1);
    int y1 = min(y0 + 1, int(pc.sampleRows) - 1);
    float tx = clamp(gx - float(x0), 0.0, 1.0);
    float ty = clamp(gy - float(y0), 0.0, 1.0);
    float e00 = greenSamples[EXPOSURE_MAP_RECORD_OFFSET + uint(y0) * pc.sampleColumns + uint(x0)].x;
    float e10 = greenSamples[EXPOSURE_MAP_RECORD_OFFSET + uint(y0) * pc.sampleColumns + uint(x1)].x;
    float e01 = greenSamples[EXPOSURE_MAP_RECORD_OFFSET + uint(y1) * pc.sampleColumns + uint(x0)].x;
    float e11 = greenSamples[EXPOSURE_MAP_RECORD_OFFSET + uint(y1) * pc.sampleColumns + uint(x1)].x;
    return mix(mix(e00, e10, tx), mix(e01, e11, tx), ty);
}

void applyExposurePixel() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.frameWidth || gid.y >= pc.frameHeight) return;
    int x = int(gid.x), y = int(gid.y);
    uint index = linearIndex(x, y);
    float value = outputMosaic[index];
    float ev = exposureEvAtPixel(x, y);
    // One scalar gain is applied to the Bayer mosaic. CFA phase and channel ratios are untouched.
    outputMosaic[index] = sceneClamp(value * exp2(ev));
}

const float PHASE9_SOURCE_CLIP_CONFIDENCE_START = 0.940;
const float PHASE9_SOURCE_CLIP_CONFIDENCE_ZERO = 1.000;
const float PHASE9_SOURCE_HARD_CLIP = 0.990;

float sourceClipSampleConfidence(float value) {
    if (!finite1(value)) return 0.0;
    return 1.0 - smoothstep(
            PHASE9_SOURCE_CLIP_CONFIDENCE_START,
            PHASE9_SOURCE_CLIP_CONFIDENCE_ZERO,
            value);
}

void writeSourceClipConfidenceCell(int x, int y) {
    // One confidence value per physical 2x2 Bayer cell. This is computed from the
    // immutable pre-finalize RAW source, before defect correction, green balancing,
    // lens shading and the signed spatial exposure map can alter the sensor ceiling.
    if ((x & 1) != 0 || (y & 1) != 0) return;
    uint clipWidth = (pc.frameWidth + 1u) / 2u;
    uint cellX = uint(x) / 2u;
    uint cellY = uint(y) / 2u;
    float v00 = sourceAt(x, y);
    float v10 = sourceAt(x + 1, y);
    float v01 = sourceAt(x, y + 1);
    float v11 = sourceAt(x + 1, y + 1);
    int hardCount = (v00 >= PHASE9_SOURCE_HARD_CLIP ? 1 : 0) +
                    (v10 >= PHASE9_SOURCE_HARD_CLIP ? 1 : 0) +
                    (v01 >= PHASE9_SOURCE_HARD_CLIP ? 1 : 0) +
                    (v11 >= PHASE9_SOURCE_HARD_CLIP ? 1 : 0);
    // Combine minimum and average confidence so isolated single-channel saturation
    // rolls off smoothly without hard rectangular block dropouts.
    float c00 = sourceClipSampleConfidence(v00);
    float c10 = sourceClipSampleConfidence(v10);
    float c01 = sourceClipSampleConfidence(v01);
    float c11 = sourceClipSampleConfidence(v11);
    float minConf = min(min(c00, c10), min(c01, c11));
    float avgConf = 0.25 * (c00 + c10 + c01 + c11);
    float confidence = mix(minConf, avgConf, 0.45);
    if (hardCount == 4) confidence = 0.0;
    uint framePixels = pc.frameWidth * pc.frameHeight;
    outputMosaic[framePixels + cellY * clipWidth + cellX] = clamp(confidence, 0.0, 1.0);
}

void finalizePixel() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uint lane = gl_LocalInvocationIndex;
    bool inFrame = gid.x < pc.frameWidth && gid.y < pc.frameHeight;

    uvec4 localCounts = uvec4(0u);
    uint localMaxGainBits = floatBitsToUint(1.0);

    if (inFrame) {
        int x = int(gid.x), y = int(gid.y);
        uint index = linearIndex(x, y);
        float original = sourceMosaic[index];
        if (finite1(original) && original >= 1.0) localCounts.x = 1u;
        // Preserve exact source-domain clipping provenance in the appended resident map.
        // Later AWB+CCM consumes this map; no tone/exposure stage may recreate it.
        writeSourceClipConfidenceCell(x, y);

        bool defectCorrected = false;
        float value = defectCorrectedAt(x, y, original, defectCorrected);
        if (defectCorrected) localCounts.y = 1u;

        // Physical baseline NR owns first-pass noise removal. It consumes the already-resolved
        // effective per-channel S/O and therefore remains active with Neural OFF. Neural ON is
        // downstream and receives this result; it never replaces this stage.
        value = baselineNoiseReducedAt(x, y, value);

        int effectiveChannel = cfaChannel4(pc.effectiveCfaPattern, x, y);
        if (effectiveChannel == 1) value = sceneClamp(value * greenCalibrationScale(1) * pc.greenEvenScale);
        else if (effectiveChannel == 2) value = sceneClamp(value * greenCalibrationScale(2) * pc.greenOddScale);

        int sensorChannel = cfaChannel4(
            pc.sensorCfaPattern, x + pc.cfaOffsetX, y + pc.cfaOffsetY);
        float gain = lensGainAt(sensorChannel, x, y);
        if (gain > 1.001) localCounts.z = 1u;
        localMaxGainBits = floatBitsToUint(gain);
        value = sceneClamp(value * gain);
        if (value > 1.0) localCounts.w = 1u;
        outputMosaic[index] = value;
    }

    finalizeCounts[lane] = localCounts;
    finalizeMaxGainBits[lane] = localMaxGainBits;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            finalizeCounts[lane] += finalizeCounts[lane + stride];
            finalizeMaxGainBits[lane] = max(
                finalizeMaxGainBits[lane], finalizeMaxGainBits[lane + stride]);
        }
        barrier();
    }

    if (lane == 0u) {
        uvec4 counts = finalizeCounts[0];
        if (counts.x != 0u) atomicAdd(telemetry[0], counts.x);
        if (counts.y != 0u) atomicAdd(telemetry[1], counts.y);
        if (counts.z != 0u) atomicAdd(telemetry[2], counts.z);
        if (counts.w != 0u) atomicAdd(telemetry[3], counts.w);
        atomicMax(telemetry[4], finalizeMaxGainBits[0]);
    }
}

void main() {
    if (pc.mode == 0u) sampleGreen();
    else if (pc.mode == 1u) finalizePixel();
    else if (pc.mode == 2u) sampleAutoScene();
    else if (pc.mode == 3u) sampleExposureTile();
    else if (pc.mode == 4u) resolveExposureMap();
    else applyExposurePixel();
}
