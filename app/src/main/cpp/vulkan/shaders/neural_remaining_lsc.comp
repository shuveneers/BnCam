#version 450

// Phase 5 remaining software LSC. Hard defect/green correction has already run
// before neural inference. This shader never denoises and never reconstructs CFA.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SourceBuffer { float sourceMosaic[]; };
layout(std430, binding = 1) buffer OutputBuffer { float outputMosaic[]; };
layout(std430, binding = 2) readonly buffer LensBuffer { float lensShading[]; };
layout(std430, binding = 3) buffer AutoSamplesBuffer { vec4 autoSamples[]; };
layout(std430, binding = 4) buffer TelemetryBuffer { uint telemetry[]; };

shared uvec2 lscCounts[256];
shared uint lscMaxGainBits[256];

layout(push_constant) uniform Params {
    uint frameWidth;
    uint frameHeight;
    uint sensorCfaPattern;
    int cfaOffsetX;
    int cfaOffsetY;
    uint lensColumns;
    uint lensRows;
    uint lensEnabled;
    uint mode; // 0 = LSC/identity, 1 = compact Auto scene observer
    uint sampleColumns;
    uint sampleRows;
    uint sampleStride;
} pc;

bool finite1(float value) { return !(isnan(value) || isinf(value)); }
uint linearIndex(int x, int y) { return uint(y) * pc.frameWidth + uint(x); }
float sceneClamp(float value) { return finite1(value) ? clamp(value, 0.0, 4.0) : 0.0; }

int cfaChannel4(uint pattern, int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    uint p = min(pattern, 3u);
    if (p == 0u) return ym == 0 ? (xm == 0 ? 0 : 1) : (xm == 0 ? 2 : 3);
    if (p == 1u) return ym == 0 ? (xm == 0 ? 1 : 0) : (xm == 0 ? 3 : 2);
    if (p == 2u) return ym == 0 ? (xm == 0 ? 1 : 3) : (xm == 0 ? 0 : 2);
    return ym == 0 ? (xm == 0 ? 3 : 1) : (xm == 0 ? 2 : 0);
}

float safeLensGain(float value) {
    return finite1(value) ? clamp(value, 0.25, 3.5) : 1.0;
}

float lensGainAt(int channel, int x, int y) {
    if (pc.lensEnabled == 0u || pc.lensColumns == 0u || pc.lensRows == 0u) return 1.0;
    float cf = pc.frameWidth > 1u
            ? float(x) * float(pc.lensColumns - 1u) / float(pc.frameWidth - 1u) : 0.0;
    float rf = pc.frameHeight > 1u
            ? float(y) * float(pc.lensRows - 1u) / float(pc.frameHeight - 1u) : 0.0;
    int c0 = clamp(int(floor(cf)), 0, int(pc.lensColumns) - 1);
    int r0 = clamp(int(floor(rf)), 0, int(pc.lensRows) - 1);
    int c1 = min(c0 + 1, int(pc.lensColumns) - 1);
    int r1 = min(r0 + 1, int(pc.lensRows) - 1);
    float tx = clamp(cf - float(c0), 0.0, 1.0);
    float ty = clamp(rf - float(r0), 0.0, 1.0);
    uint stride = pc.lensColumns * 4u;
    int ch = clamp(channel, 0, 3);
    float g00 = safeLensGain(lensShading[uint(r0) * stride + uint(c0 * 4 + ch)]);
    float g10 = safeLensGain(lensShading[uint(r0) * stride + uint(c1 * 4 + ch)]);
    float g01 = safeLensGain(lensShading[uint(r1) * stride + uint(c0 * 4 + ch)]);
    float g11 = safeLensGain(lensShading[uint(r1) * stride + uint(c1 * 4 + ch)]);
    return safeLensGain(mix(mix(g00, g10, tx), mix(g01, g11, tx), ty));
}

float outputAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return outputMosaic[linearIndex(x, y)];
}

bool coherentSameSign(float center, float a, float b) {
    return center * a > 0.0 && center * b > 0.0 && abs(a) >= 0.015 && abs(b) >= 0.015;
}

void applyRemainingLsc() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uint lane = gl_LocalInvocationIndex;
    bool inFrame = gid.x < pc.frameWidth && gid.y < pc.frameHeight;
    uvec2 localCounts = uvec2(0u);
    uint localMaxGainBits = floatBitsToUint(1.0);
    if (inFrame) {
        int x = int(gid.x), y = int(gid.y);
        uint index = linearIndex(x, y);
        float value = sourceMosaic[index];
        int sensorChannel = cfaChannel4(
                pc.sensorCfaPattern, x + pc.cfaOffsetX, y + pc.cfaOffsetY);
        float gain = lensGainAt(sensorChannel, x, y);
        if (gain > 1.001) localCounts.x = 1u;
        localMaxGainBits = floatBitsToUint(gain);
        value = sceneClamp(value * gain);
        if (value > 1.0) localCounts.y = 1u;
        outputMosaic[index] = value;
    }
    lscCounts[lane] = localCounts;
    lscMaxGainBits[lane] = localMaxGainBits;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            lscCounts[lane] += lscCounts[lane + stride];
            lscMaxGainBits[lane] = max(lscMaxGainBits[lane], lscMaxGainBits[lane + stride]);
        }
        barrier();
    }
    if (lane == 0u) {
        if (lscCounts[0].x != 0u) atomicAdd(telemetry[0], lscCounts[0].x);
        if (lscCounts[0].y != 0u) atomicAdd(telemetry[1], lscCounts[0].y);
        atomicMax(telemetry[2], lscMaxGainBits[0]);
    }
}

void sampleAutoScene() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.sampleColumns || gid.y >= pc.sampleRows) return;
    uint sampleIndex = gid.y * pc.sampleColumns + gid.x;
    autoSamples[sampleIndex] = vec4(0.0);
    int x = 4 + int(gid.x * pc.sampleStride);
    int y = 4 + int(gid.y * pc.sampleStride);
    if (x >= int(pc.frameWidth) - 4 || y >= int(pc.frameHeight) - 4) return;
    float center = outputAt(x, y);
    float signedDx = 0.5 * (outputAt(x + 2, y) - outputAt(x - 2, y));
    float signedDy = 0.5 * (outputAt(x, y + 2) - outputAt(x, y - 2));
    float dx = abs(signedDx), dy = abs(signedDy);
    float gradient = max(dx, dy);
    bool edgeCoherent = false;
    if (dx >= 0.030 && dx > 1.5 * dy + 0.005) {
        float above = 0.5 * (outputAt(x + 2, y - 2) - outputAt(x - 2, y - 2));
        float below = 0.5 * (outputAt(x + 2, y + 2) - outputAt(x - 2, y + 2));
        edgeCoherent = coherentSameSign(signedDx, above, below);
    } else if (dy >= 0.030 && dy > 1.5 * dx + 0.005) {
        float left = 0.5 * (outputAt(x - 2, y + 2) - outputAt(x - 2, y - 2));
        float right = 0.5 * (outputAt(x + 2, y + 2) - outputAt(x + 2, y - 2));
        edgeCoherent = coherentSameSign(signedDy, left, right);
    }
    autoSamples[sampleIndex] = vec4(center, gradient, edgeCoherent ? 1.0 : 0.0,
                                    center < 0.060 ? 1.0 : 0.0);
}

void main() {
    if (pc.mode == 0u) applyRemainingLsc();
    else if (pc.mode == 1u) sampleAutoScene();
}
