#version 450

layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputBuffer { float data[]; } src;
layout(set=0,binding=1,std430) writeonly buffer OutputBuffer { float data[]; } dst;
layout(set=0,binding=2,std430) readonly buffer CleanBuffer { float data[]; } cleanBuf;
layout(set=0,binding=3,std430) readonly buffer PosteriorBuffer { float data[]; } posteriorBuf;

layout(push_constant) uniform PC {
    uint rawWidth;
    uint rawHeight;
    uint packedWidth;
    uint packedHeight;
    uint mode; // 0=mosaic->C4, 1=C4->mosaic, 2=posterior sum, 3=neural effect summary
    uint off0x; uint off0y;
    uint off1x; uint off1y;
    uint off2x; uint off2y;
    uint off3x; uint off3y;
    float shotS0; float shotS1; float shotS2; float shotS3;
    float readO0; float readO1; float readO2; float readO3;
} pc;

const uint EFFECT_SLOT_COUNT = 13u;
const uint LOCAL_COUNT = 64u;
const float HIGH_SNR_THRESHOLD = 8.0;
const float INV_SQRT2 = 0.7071067811865475;

uvec2 channelOffset(uint c) {
    if (c == 0u) return uvec2(pc.off0x, pc.off0y);
    if (c == 1u) return uvec2(pc.off1x, pc.off1y);
    if (c == 2u) return uvec2(pc.off2x, pc.off2y);
    return uvec2(pc.off3x, pc.off3y);
}

vec4 shotS() { return vec4(pc.shotS0, pc.shotS1, pc.shotS2, pc.shotS3); }
vec4 readO() { return vec4(pc.readO0, pc.readO1, pc.readO2, pc.readO3); }

shared vec4 reductionPartial[EFFECT_SLOT_COUNT * LOCAL_COUNT];

vec4 finiteNonNegativePosteriorFromSrc(uint packedBase) {
    vec4 v = vec4(src.data[packedBase + 0u], src.data[packedBase + 1u],
                  src.data[packedBase + 2u], src.data[packedBase + 3u]);
    for (uint c = 0u; c < 4u; ++c) {
        if (isnan(v[c]) || isinf(v[c]) || v[c] < 0.0) v[c] = 0.0;
    }
    return v;
}

vec4 finiteNonNegativePosterior(uint packedBase) {
    vec4 v = vec4(posteriorBuf.data[packedBase + 0u], posteriorBuf.data[packedBase + 1u],
                  posteriorBuf.data[packedBase + 2u], posteriorBuf.data[packedBase + 3u]);
    for (uint c = 0u; c < 4u; ++c) {
        if (isnan(v[c]) || isinf(v[c]) || v[c] < 0.0) v[c] = 0.0;
    }
    return v;
}

bool finiteVec4(vec4 v) {
    return !(any(isnan(v)) || any(isinf(v)));
}

void accumulateEffectSample(uint packedBase, inout vec4 sums[EFFECT_SLOT_COUNT]) {
    const vec4 x = vec4(src.data[packedBase + 0u], src.data[packedBase + 1u],
                        src.data[packedBase + 2u], src.data[packedBase + 3u]);
    const vec4 clean = vec4(cleanBuf.data[packedBase + 0u], cleanBuf.data[packedBase + 1u],
                            cleanBuf.data[packedBase + 2u], cleanBuf.data[packedBase + 3u]);
    const vec4 posterior = finiteNonNegativePosterior(packedBase);
    sums[12] += posterior;

    if (!finiteVec4(x) || !finiteVec4(clean)) {
        sums[0].x = uintBitsToFloat(0x7fc00000u);
        return;
    }

    const vec4 delta = x - clean;
    const vec4 absDelta = abs(delta);
    const vec4 variance = max(shotS() * clamp(x, vec4(0.0), vec4(1.0)) + readO(), vec4(1.0e-12));
    const vec4 sigma = sqrt(variance);
    const vec4 deltaSigma = delta / sigma;
    const vec4 snr = clamp(x, vec4(0.0), vec4(1.0)) / sigma;

    sums[0] += delta;
    sums[1] += absDelta;
    sums[2] += delta * delta;
    sums[3] += deltaSigma * deltaSigma;
    sums[4] += mix(vec4(0.0), vec4(1.0), greaterThanEqual(absDelta, 0.5 * sigma));
    sums[5] += mix(vec4(0.0), vec4(1.0), greaterThanEqual(absDelta, sigma));
    sums[6] += mix(vec4(0.0), vec4(1.0), greaterThanEqual(absDelta, 2.0 * sigma));
    sums[7] += posterior / variance;

    const float commonDelta = 0.5 * (delta.r + delta.g + delta.b + delta.a);
    const float redBlue = INV_SQRT2 * (delta.r - delta.a);
    const float chromaGreen = 0.5 * (delta.r + delta.a - delta.g - delta.b);
    const float greenSplit = INV_SQRT2 * (delta.g - delta.b);
    const vec4 basis = vec4(commonDelta, redBlue, chromaGreen, greenSplit);
    sums[8] += basis * basis;

    const float totalVariance = variance.r + variance.g + variance.b + variance.a;
    const vec4 basisVariance = max(vec4(
        0.25 * totalVariance,
        0.5 * (variance.r + variance.a),
        0.25 * totalVariance,
        0.5 * (variance.g + variance.b)), vec4(1.0e-12));
    sums[9] += (basis * basis) / basisVariance;

    const bvec4 highSnr = greaterThanEqual(snr, vec4(HIGH_SNR_THRESHOLD));
    const vec4 highSnrMask = mix(vec4(0.0), vec4(1.0), highSnr);
    sums[10] += highSnrMask * (deltaSigma * deltaSigma);
    sums[11] += highSnrMask;
}

void reduceAndWrite(uint outputGroupIndex, uint slotCount) {
    const uint lid = gl_LocalInvocationID.y * 8u + gl_LocalInvocationID.x;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lid < stride) {
            for (uint slot = 0u; slot < slotCount; ++slot) {
                reductionPartial[slot * LOCAL_COUNT + lid] +=
                    reductionPartial[slot * LOCAL_COUNT + lid + stride];
            }
        }
        barrier();
    }
    if (lid == 0u) {
        const uint outBase = outputGroupIndex * slotCount * 4u;
        for (uint slot = 0u; slot < slotCount; ++slot) {
            vec4 value;
            value = reductionPartial[slot * LOCAL_COUNT];
            dst.data[outBase + slot * 4u + 0u] = value.x;
            dst.data[outBase + slot * 4u + 1u] = value.y;
            dst.data[outBase + slot * 4u + 2u] = value.z;
            dst.data[outBase + slot * 4u + 3u] = value.w;
        }
    }
}

void main() {
    const uint lid = gl_LocalInvocationID.y * 8u + gl_LocalInvocationID.x;

    if (pc.mode == 3u) {
        vec4 sums[EFFECT_SLOT_COUNT];
        for (uint slot = 0u; slot < EFFECT_SLOT_COUNT; ++slot) sums[slot] = vec4(0.0);

        const uint startX = gl_WorkGroupID.x * 32u + gl_LocalInvocationID.x * 4u;
        const uint startY = gl_WorkGroupID.y * 32u + gl_LocalInvocationID.y * 4u;
        for (uint dy = 0u; dy < 4u; ++dy) {
            const uint py = startY + dy;
            if (py >= pc.packedHeight) continue;
            for (uint dx = 0u; dx < 4u; ++dx) {
                const uint px = startX + dx;
                if (px >= pc.packedWidth) continue;
                const uint packedBase = (py * pc.packedWidth + px) * 4u;
                accumulateEffectSample(packedBase, sums);
            }
        }
        for (uint slot = 0u; slot < EFFECT_SLOT_COUNT; ++slot) {
            reductionPartial[slot * LOCAL_COUNT + lid] = sums[slot];
        }
        const uint groupsX = (pc.packedWidth + 31u) / 32u;
        const uint groupIndex = gl_WorkGroupID.y * groupsX + gl_WorkGroupID.x;
        reduceAndWrite(groupIndex, EFFECT_SLOT_COUNT);
        return;
    }

    const uint px = gl_GlobalInvocationID.x;
    const uint py = gl_GlobalInvocationID.y;
    bool insidePacked;
    insidePacked = (px < pc.packedWidth) && (py < pc.packedHeight);
    const uint packedBase = insidePacked ? (py * pc.packedWidth + px) * 4u : 0u;

    if (pc.mode == 2u) {
        reductionPartial[lid] = insidePacked ? finiteNonNegativePosteriorFromSrc(packedBase) : vec4(0.0);
        const uint groupsX = (pc.packedWidth + 7u) / 8u;
        const uint groupIndex = gl_WorkGroupID.y * groupsX + gl_WorkGroupID.x;
        reduceAndWrite(groupIndex, 1u);
        return;
    }

    if (!insidePacked) return;
    const uint rawBaseX = px * 2u;
    const uint rawBaseY = py * 2u;
    for (uint c = 0u; c < 4u; ++c) {
        const uvec2 o = channelOffset(c);
        const uint x = rawBaseX + o.x;
        const uint y = rawBaseY + o.y;
        if (x >= pc.rawWidth || y >= pc.rawHeight) continue;
        const uint rawIndex = y * pc.rawWidth + x;
        if (pc.mode == 0u) dst.data[packedBase + c] = src.data[rawIndex];
        else dst.data[rawIndex] = src.data[packedBase + c];
    }
}
