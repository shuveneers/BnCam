#version 450

// N006H: read-only normalized RAW signal observer.
// One invocation owns one grid tile and visits every sample in that tile.
// The output is compact metadata only: four CFA sums, counts, minima and maxima.
// This shader has no pixel output and cannot perform denoise or correction.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer {
    float inputMosaic[];
};

layout(std430, binding = 1) buffer OutputBuffer {
    float outputData[];
};

layout(push_constant) uniform Push {
    uint frameWidth;
    uint frameHeight;
    uint cfaPattern;
    uint gridCols;
    uint gridRows;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} pc;

bool finite1(float value) {
    return !(isnan(value) || isinf(value));
}

uint linearIndex(int x, int y) {
    return uint(y) * pc.frameWidth + uint(x);
}

float inputAt(int x, int y) {
    return inputMosaic[linearIndex(x, y)];
}

int cfaChannel(int x, int y) {
    int xm = x & 1;
    int ym = y & 1;

    if (pc.cfaPattern == 0u) {
        return ym == 0 ? (xm == 0 ? 0 : 1)
                       : (xm == 0 ? 2 : 3);
    }
    if (pc.cfaPattern == 1u) {
        return ym == 0 ? (xm == 0 ? 1 : 0)
                       : (xm == 0 ? 3 : 2);
    }
    if (pc.cfaPattern == 2u) {
        return ym == 0 ? (xm == 0 ? 1 : 3)
                       : (xm == 0 ? 0 : 2);
    }

    return ym == 0 ? (xm == 0 ? 3 : 1)
                   : (xm == 0 ? 2 : 0);
}

void main() {
    uint cell = gl_GlobalInvocationID.x;
    uint cells = pc.gridCols * pc.gridRows;

    if (cell >= cells ||
        pc.gridCols == 0u ||
        pc.gridRows == 0u ||
        pc.frameWidth == 0u ||
        pc.frameHeight == 0u) {
        return;
    }

    uint gx = cell % pc.gridCols;
    uint gy = cell / pc.gridCols;

    int x0 = int((gx * pc.frameWidth) / pc.gridCols);
    int x1 = int(((gx + 1u) * pc.frameWidth) / pc.gridCols);
    int y0 = int((gy * pc.frameHeight) / pc.gridRows);
    int y1 = int(((gy + 1u) * pc.frameHeight) / pc.gridRows);

    float sums[4] =
            float[4](0.0, 0.0, 0.0, 0.0);
    float counts[4] =
            float[4](0.0, 0.0, 0.0, 0.0);
    float signalMin[4] =
            float[4](3.402823e38, 3.402823e38, 3.402823e38, 3.402823e38);
    float signalMax[4] =
            float[4](-3.402823e38, -3.402823e38, -3.402823e38, -3.402823e38);

    for (int y = y0; y < y1; ++y) {
        for (int x = x0; x < x1; ++x) {
            float value = inputAt(x, y);
            if (!finite1(value)) {
                continue;
            }

            int channel = cfaChannel(x, y);
            if (channel < 0 || channel >= 4) {
                continue;
            }

            float normalized = clamp(value, 0.0, 1.0);
            sums[channel] += normalized;
            counts[channel] += 1.0;
            signalMin[channel] =
                    min(signalMin[channel], normalized);
            signalMax[channel] =
                    max(signalMax[channel], normalized);
        }
    }

    uint base = cell * 16u;
    for (uint channel = 0u; channel < 4u; ++channel) {
        outputData[base + channel] = sums[channel];
        outputData[base + 4u + channel] = counts[channel];
        outputData[base + 8u + channel] =
                counts[channel] > 0.0
                ? signalMin[channel]
                : 0.0;
        outputData[base + 12u + channel] =
                counts[channel] > 0.0
                ? signalMax[channel]
                : 0.0;
    }
}
