#version 450

// SPECTRA 2 Milestone 8H-H
// Compact Pass-3 planning directly from the device-resident Pass-2 mosaic.
// One invocation owns one row/channel, column/channel, or low-frequency cell.
// The CPU only receives compact profiles/grids; no full RAW mosaic readback is needed.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer { float inputMosaic[]; };
layout(std430, binding = 1) buffer OutputBuffer { float outputData[]; };

layout(push_constant) uniform Push {
    uint frameWidth;
    uint frameHeight;
    uint cfaPattern;
    uint mode;       // 0=row profiles, 1=column profiles, 2=low-frequency R/B cells
    uint gridCols;
    uint gridRows;
    float textureGate;
    float reserved0;
} pc;

bool finite1(float v) { return !(isnan(v) || isinf(v)); }
uint linearIndex(int x, int y) { return uint(y) * pc.frameWidth + uint(x); }
float inputAt(int x, int y) {
    x = clamp(x, 0, int(pc.frameWidth) - 1);
    y = clamp(y, 0, int(pc.frameHeight) - 1);
    return inputMosaic[linearIndex(x, y)];
}

int cfaChannel(int x, int y) {
    int xm = x & 1;
    int ym = y & 1;
    if (pc.cfaPattern == 0u) return ym == 0 ? (xm == 0 ? 0 : 1) : (xm == 0 ? 2 : 3);
    if (pc.cfaPattern == 1u) return ym == 0 ? (xm == 0 ? 1 : 0) : (xm == 0 ? 3 : 2);
    if (pc.cfaPattern == 2u) return ym == 0 ? (xm == 0 ? 1 : 3) : (xm == 0 ? 0 : 2);
    return ym == 0 ? (xm == 0 ? 3 : 1) : (xm == 0 ? 2 : 0);
}

float median96(inout float values[96], int count) {
    for (int i = 1; i < count; ++i) {
        float key = values[i];
        int j = i - 1;
        while (j >= 0 && values[j] > key) {
            values[j + 1] = values[j];
            --j;
        }
        values[j + 1] = key;
    }
    if (count <= 0) return 0.0;
    return values[count / 2];
}

float median64(inout float values[64], int count) {
    for (int i = 1; i < count; ++i) {
        float key = values[i];
        int j = i - 1;
        while (j >= 0 && values[j] > key) {
            values[j + 1] = values[j];
            --j;
        }
        values[j + 1] = key;
    }
    if (count <= 0) return 0.0;
    return values[count / 2];
}

uint rowBase() { return 0u; }
uint columnBase() { return 4u * pc.frameHeight; }
uint gridBase() { return columnBase() + 4u * pc.frameWidth; }
uint gridSize() { return pc.gridCols * pc.gridRows; }
uint statsBase() { return gridBase() + 4u * gridSize(); }

int alignedAtOrAfter(int value, int origin, int step) {
    if (value <= origin) return origin;
    int delta = value - origin;
    return origin + ((delta + step - 1) / step) * step;
}

float greenReference(int x, int y) {
    return 0.25 * (inputAt(x, y - 1) + inputAt(x, y + 1) +
                   inputAt(x - 1, y) + inputAt(x + 1, y));
}
float chromaResidual(int x, int y) { return inputAt(x, y) - greenReference(x, y); }
float crossMeanResidual(int x, int y, int radius) {
    return 0.25 * (chromaResidual(x - radius, y) + chromaResidual(x + radius, y) +
                   chromaResidual(x, y - radius) + chromaResidual(x, y + radius));
}

void planRow() {
    int y = int(gl_GlobalInvocationID.x);
    int ch = int(gl_GlobalInvocationID.y);
    if (y < 2 || y >= int(pc.frameHeight) - 2 || ch < 0 || ch >= 4) return;
    uint outIndex = rowBase() + uint(ch) * pc.frameHeight + uint(y);
    outputData[outIndex] = 0.0;

    int startX = 4;
    while (startX < 6 && cfaChannel(startX, y) != ch) ++startX;
    if (startX >= 6 || cfaChannel(startX, y) != ch) return;
    int available = max(1, int(pc.frameWidth) - 8);
    int step = max(2, (available / 96) & ~1);
    float values[96];
    int count = 0;
    for (int x = startX; x < int(pc.frameWidth) - 4 && count < 96; x += step) {
        if (cfaChannel(x, y) != ch) continue;
        float center = inputAt(x, y);
        float up = inputAt(x, y - 2);
        float down = inputAt(x, y + 2);
        float left = inputAt(x - 2, y);
        float right = inputAt(x + 2, y);
        if (!finite1(center) || !finite1(up) || !finite1(down) || !finite1(left) || !finite1(right)) continue;
        if (center < -0.01 || center > 0.85) continue;
        if (abs(left - right) > pc.textureGate || abs(up - down) > pc.textureGate * 2.0) continue;
        values[count++] = center - 0.5 * (up + down);
    }
    if (count >= 24) outputData[outIndex] = clamp(median96(values, count), -0.0035, 0.0035);
}

void planColumn() {
    int x = int(gl_GlobalInvocationID.x);
    int ch = int(gl_GlobalInvocationID.y);
    if (x < 2 || x >= int(pc.frameWidth) - 2 || ch < 0 || ch >= 4) return;
    uint outIndex = columnBase() + uint(ch) * pc.frameWidth + uint(x);
    outputData[outIndex] = 0.0;

    int startY = 4;
    while (startY < 6 && cfaChannel(x, startY) != ch) ++startY;
    if (startY >= 6 || cfaChannel(x, startY) != ch) return;
    int available = max(1, int(pc.frameHeight) - 8);
    int step = max(2, (available / 96) & ~1);
    float values[96];
    int count = 0;
    for (int y = startY; y < int(pc.frameHeight) - 4 && count < 96; y += step) {
        if (cfaChannel(x, y) != ch) continue;
        float center = inputAt(x, y);
        float up = inputAt(x, y - 2);
        float down = inputAt(x, y + 2);
        float left = inputAt(x - 2, y);
        float right = inputAt(x + 2, y);
        if (!finite1(center) || !finite1(up) || !finite1(down) || !finite1(left) || !finite1(right)) continue;
        if (center < -0.01 || center > 0.85) continue;
        if (abs(up - down) > pc.textureGate || abs(left - right) > pc.textureGate * 2.0) continue;
        values[count++] = center - 0.5 * (left + right);
    }
    if (count >= 18) outputData[outIndex] = clamp(median96(values, count), -0.0035, 0.0035);
}

void planLowCell() {
    uint cell = gl_GlobalInvocationID.x;
    uint cells = gridSize();
    if (cell >= cells || pc.gridCols == 0u || pc.gridRows == 0u) return;
    uint gx = cell % pc.gridCols;
    uint gy = cell / pc.gridCols;
    uint base = gridBase();
    uint rBase = base;
    uint bBase = base + cells;
    uint rValidBase = base + 2u * cells;
    uint bValidBase = base + 3u * cells;
    outputData[rBase + cell] = 0.0;
    outputData[bBase + cell] = 0.0;
    outputData[rValidBase + cell] = 0.0;
    outputData[bValidBase + cell] = 0.0;

    int x0 = max(2, int(float(gx) * float(pc.frameWidth) / float(pc.gridCols)));
    int x1 = min(int(pc.frameWidth) - 2, int(float(gx + 1u) * float(pc.frameWidth) / float(pc.gridCols)));
    int y0 = max(2, int(float(gy) * float(pc.frameHeight) / float(pc.gridRows)));
    int y1 = min(int(pc.frameHeight) - 2, int(float(gy + 1u) * float(pc.frameHeight) / float(pc.gridRows)));
    if (x1 <= x0 + 2 || y1 <= y0 + 2) return;

    float rValues[64];
    float bValues[64];
    int rCount = 0;
    int bCount = 0;
    // Uniform 8x8 stratified lattice. Each 2x2 phase block contributes at most one R and one B.
    for (int sy = 0; sy < 8; ++sy) {
        int by = y0 + ((2 * sy + 1) * max(2, y1 - y0 - 2)) / 16;
        by = clamp(by & ~1, y0, y1 - 2);
        for (int sx = 0; sx < 8; ++sx) {
            int bx = x0 + ((2 * sx + 1) * max(2, x1 - x0 - 2)) / 16;
            bx = clamp(bx & ~1, x0, x1 - 2);
            for (int py = 0; py < 2; ++py) {
                int y = by + py;
                for (int px = 0; px < 2; ++px) {
                    int x = bx + px;
                    int ch = cfaChannel(x, y);
                    if (ch != 0 && ch != 3) continue;
                    float center = inputAt(x, y);
                    float green = 0.25 * (inputAt(x, y - 1) + inputAt(x, y + 1) + inputAt(x - 1, y) + inputAt(x + 1, y));
                    if (!finite1(center) || !finite1(green) || center < -0.01 || center > 0.85 || green > 0.75) continue;
                    float gradient = abs(inputAt(x, y - 1) - inputAt(x, y + 1)) +
                                     abs(inputAt(x - 1, y) - inputAt(x + 1, y));
                    if (gradient > pc.textureGate * 1.5) continue;
                    float residual = center - green;
                    if (ch == 0 && rCount < 64) rValues[rCount++] = residual;
                    if (ch == 3 && bCount < 64) bValues[bCount++] = residual;
                }
            }
        }
    }
    if (rCount >= 24) { outputData[rBase + cell] = median64(rValues, rCount); outputData[rValidBase + cell] = 1.0; }
    if (bCount >= 24) { outputData[bBase + cell] = median64(bValues, bCount); outputData[bValidBase + cell] = 1.0; }
}


// Compact resident observation. One invocation owns one existing 24x18 planner
// cell and accumulates the same deterministic RAW/chroma sample lattices used by
// the CPU reference. Only 20 floats per cell cross back to the host.
void observeCell() {
    uint cell = gl_GlobalInvocationID.x;
    uint cells = gridSize();
    if (cell >= cells || pc.gridCols == 0u || pc.gridRows == 0u) return;
    uint gx = cell % pc.gridCols;
    uint gy = cell / pc.gridCols;
    int cellX0 = int((gx * pc.frameWidth) / pc.gridCols);
    int cellX1 = int(((gx + 1u) * pc.frameWidth) / pc.gridCols);
    int cellY0 = int((gy * pc.frameHeight) / pc.gridRows);
    int cellY1 = int(((gy + 1u) * pc.frameHeight) / pc.gridRows);

    float residualSq = 0.0;
    float residualCount = 0.0;
    float chromaSq = 0.0;
    float chromaCount = 0.0;

    int rawStartY = alignedAtOrAfter(max(cellY0, 2), 2, 4);
    int rawEndY = min(cellY1, int(pc.frameHeight) - 3);
    int rawStartX = alignedAtOrAfter(max(cellX0, 2), 2, 4);
    int rawEndX = min(cellX1, int(pc.frameWidth) - 3);
    for (int baseY = rawStartY; baseY < rawEndY; baseY += 4) {
        for (int baseX = rawStartX; baseX < rawEndX; baseX += 4) {
            for (int dy = 0; dy < 2; ++dy) {
                int y = baseY + dy;
                for (int dx = 0; dx < 2; ++dx) {
                    int x = baseX + dx;
                    float center = inputAt(x, y);
                    float neighbourMean = 0.25 * (inputAt(x, y - 2) + inputAt(x, y + 2) +
                                                   inputAt(x - 2, y) + inputAt(x + 2, y));
                    if (finite1(center) && finite1(neighbourMean)) {
                        float d = center - neighbourMean;
                        residualSq += d * d;
                        residualCount += 1.0;
                    }
                }
            }
        }
    }

    int chromaStartY = alignedAtOrAfter(max(cellY0, 3), 3, 4);
    int chromaEndY = min(cellY1, int(pc.frameHeight) - 3);
    int chromaStartX = alignedAtOrAfter(max(cellX0, 3), 3, 4);
    int chromaEndX = min(cellX1, int(pc.frameWidth) - 3);
    for (int baseY = chromaStartY; baseY < chromaEndY; baseY += 4) {
        for (int baseX = chromaStartX; baseX < chromaEndX; baseX += 4) {
            for (int dy = 0; dy < 2; ++dy) {
                int y = baseY + dy;
                for (int dx = 0; dx < 2; ++dx) {
                    int x = baseX + dx;
                    int ch = cfaChannel(x, y);
                    if (ch != 0 && ch != 3) continue;
                    float center = chromaResidual(x, y);
                    float neighbourMean = 0.25 * (chromaResidual(x - 2, y) + chromaResidual(x + 2, y) +
                                                   chromaResidual(x, y - 2) + chromaResidual(x, y + 2));
                    if (finite1(center) && finite1(neighbourMean)) {
                        float d = center - neighbourMean;
                        chromaSq += d * d;
                        chromaCount += 1.0;
                    }
                }
            }
        }
    }

    float fineSum = 0.0;
    float midSum = 0.0;
    float lowSum = 0.0;
    float rowSum = 0.0;
    float colSum = 0.0;
    float samples = 0.0;
    float redCount = 0.0;
    float blueCount = 0.0;
    vec3 redBands = vec3(0.0);
    vec3 blueBands = vec3(0.0);
    int bandStartY = alignedAtOrAfter(max(cellY0, 9), 9, 16);
    int bandEndY = min(cellY1, int(pc.frameHeight) - 10);
    int bandStartX = alignedAtOrAfter(max(cellX0, 9), 9, 16);
    int bandEndX = min(cellX1, int(pc.frameWidth) - 10);
    for (int baseY = bandStartY; baseY < bandEndY; baseY += 16) {
        for (int baseX = bandStartX; baseX < bandEndX; baseX += 16) {
            for (int phaseY = 0; phaseY < 2; ++phaseY) {
                for (int phaseX = 0; phaseX < 2; ++phaseX) {
                    int x = baseX + phaseX;
                    int y = baseY + phaseY;
                    int ch = cfaChannel(x, y);
                    if (ch != 0 && ch != 3) continue;
                    float centerGreen = greenReference(x, y);
                    float horizontalStructure = abs(greenReference(x + 2, y) - greenReference(x - 2, y));
                    float verticalStructure = abs(greenReference(x, y + 2) - greenReference(x, y - 2));
                    float normalizedStructure = (horizontalStructure + verticalStructure) /
                            max(0.02, abs(centerGreen));
                    if (!finite1(centerGreen) || !finite1(normalizedStructure) || normalizedStructure > 0.28) continue;
                    float center = chromaResidual(x, y);
                    float local = crossMeanResidual(x, y, 2);
                    float middle = crossMeanResidual(x, y, 4);
                    float broad = crossMeanResidual(x, y, 8);
                    float rowBefore = chromaResidual(x, y - 8);
                    float rowAfter = chromaResidual(x, y + 8);
                    float colBefore = chromaResidual(x - 8, y);
                    float colAfter = chromaResidual(x + 8, y);
                    if (!finite1(center) || !finite1(local) || !finite1(middle) || !finite1(broad) ||
                        !finite1(rowBefore) || !finite1(rowAfter) || !finite1(colBefore) || !finite1(colAfter)) continue;
                    float fine = center - local;
                    float mid = local - middle;
                    float low = middle - broad;
                    vec3 bandSq = vec3(fine * fine, mid * mid, low * low);
                    float rowPattern = 0.5 * (rowBefore - rowAfter);
                    float colPattern = 0.5 * (colBefore - colAfter);
                    fineSum += bandSq.x;
                    midSum += bandSq.y;
                    lowSum += bandSq.z;
                    rowSum += rowPattern * rowPattern;
                    colSum += colPattern * colPattern;
                    samples += 1.0;
                    if (ch == 0) { redCount += 1.0; redBands += bandSq; }
                    else { blueCount += 1.0; blueBands += bandSq; }
                }
            }
        }
    }

    uint base = statsBase() + cell * 20u;
    outputData[base + 0u] = residualSq;
    outputData[base + 1u] = residualCount;
    outputData[base + 2u] = chromaSq;
    outputData[base + 3u] = chromaCount;
    outputData[base + 4u] = fineSum;
    outputData[base + 5u] = midSum;
    outputData[base + 6u] = lowSum;
    outputData[base + 7u] = rowSum;
    outputData[base + 8u] = colSum;
    outputData[base + 9u] = samples;
    outputData[base + 10u] = redCount;
    outputData[base + 11u] = blueCount;
    outputData[base + 12u] = redBands.x;
    outputData[base + 13u] = redBands.y;
    outputData[base + 14u] = redBands.z;
    outputData[base + 15u] = 0.0;
    outputData[base + 16u] = blueBands.x;
    outputData[base + 17u] = blueBands.y;
    outputData[base + 18u] = blueBands.z;
    outputData[base + 19u] = 0.0;
}


// Phase 13 exact compact spatial-noise input. One invocation owns one tile and
// visits every normalized RAW sample in that tile. Only sixteen floats per tile
// are read back: four CFA sums, four CFA counts, four per-CFA minima and maxima.
void observeNoiseTile() {
    uint cell = gl_GlobalInvocationID.x;
    uint cells = gridSize();
    if (cell >= cells || pc.gridCols == 0u || pc.gridRows == 0u) return;
    uint gx = cell % pc.gridCols;
    uint gy = cell / pc.gridCols;
    int x0 = int((gx * pc.frameWidth) / pc.gridCols);
    int x1 = int(((gx + 1u) * pc.frameWidth) / pc.gridCols);
    int y0 = int((gy * pc.frameHeight) / pc.gridRows);
    int y1 = int(((gy + 1u) * pc.frameHeight) / pc.gridRows);

    float sums[4] = float[4](0.0, 0.0, 0.0, 0.0);
    float counts[4] = float[4](0.0, 0.0, 0.0, 0.0);
    float signalMin[4] = float[4](3.402823e38, 3.402823e38, 3.402823e38, 3.402823e38);
    float signalMax[4] = float[4](-3.402823e38, -3.402823e38, -3.402823e38, -3.402823e38);
    for (int y = y0; y < y1; ++y) {
        for (int x = x0; x < x1; ++x) {
            float value = inputAt(x, y);
            if (!finite1(value)) continue;
            int ch = cfaChannel(x, y);
            if (ch < 0 || ch >= 4) continue;
            float normalized = clamp(value, 0.0, 1.0);
            sums[ch] += normalized;
            counts[ch] += 1.0;
            signalMin[ch] = min(signalMin[ch], normalized);
            signalMax[ch] = max(signalMax[ch], normalized);
        }
    }
    uint base = cell * 16u;
    for (uint ch = 0u; ch < 4u; ++ch) {
        outputData[base + ch] = sums[ch];
        outputData[base + 4u + ch] = counts[ch];
        outputData[base + 8u + ch] = counts[ch] > 0.0 ? signalMin[ch] : 0.0;
        outputData[base + 12u + ch] = counts[ch] > 0.0 ? signalMax[ch] : 0.0;
    }
}

void main() {
    if (pc.mode == 0u) planRow();
    else if (pc.mode == 1u) planColumn();
    else if (pc.mode == 2u && gl_GlobalInvocationID.y == 0u) planLowCell();
    else if (pc.mode == 3u && gl_GlobalInvocationID.y == 0u) observeCell();
    else if (pc.mode == 4u && gl_GlobalInvocationID.y == 0u) observeNoiseTile();
}
