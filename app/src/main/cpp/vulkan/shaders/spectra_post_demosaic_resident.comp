bool finite1(float v) { return !(isnan(v) || isinf(v)); }
bool finite3(vec3 v) { return finite1(v.x) && finite1(v.y) && finite1(v.z); }
bool telemetrySample(uint x, uint y) {
    // One stratified diagnostic sample per 16x16 image tile. Pixel processing remains full-rate.
    return (x & 15u) == 0u && (y & 15u) == 0u;
}
float smoothstepExact(float edge0, float edge1, float value) {
    if (!finite1(value) || !(edge1 > edge0)) return 0.0;
    float t = clamp((value - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// Mode-1 Lightroom Detail aliases. The host reuses four mode-0-only float slots before
// the second dispatch so the guaranteed 128-byte push-constant layout stays unchanged.
float profileDetailAmount() { return clamp(pc.appliedLumaSigma, 0.0, 1.0); }
float profileDetailRadius() { return clamp(pc.lumaRangeThresholdMean, 0.50, 3.00); }
float profileDetailValue() { return clamp(pc.chromaRangeThresholdMean, 0.0, 1.0); }
float profileDetailMasking() { return clamp(pc.outerRingAuthority, 0.0, 1.0); }

float centeredDetailDelta(float value, float center, float minimum, float maximum) {
    if (value >= center) return clamp((value - center) / max(maximum - center, 1.0e-6), 0.0, 1.0);
    return clamp((value - center) / max(center - minimum, 1.0e-6), -1.0, 0.0);
}
float detailRadiusDelta() { return centeredDetailDelta(profileDetailRadius(), 1.0, 0.5, 3.0); }
float detailTextureDelta() { return centeredDetailDelta(profileDetailValue(), 0.25, 0.0, 1.0); }
float detailMasterOffset() { return clamp(-1.0 + 2.25 * profileDetailAmount(), -1.0, 1.0); }
float detailMasterScale() { return clamp(1.0 + detailMasterOffset(), 0.0, 2.0); }
float detailFineBias() { return clamp(-0.20 + 0.55 * detailTextureDelta() - 0.20 * detailRadiusDelta(), -1.0, 1.0); }
float detailMidBias() { return clamp(0.08 + 0.25 * detailTextureDelta() + 0.30 * detailRadiusDelta(), -1.0, 1.0); }
float detailBroadBias() { return clamp(0.45 * detailRadiusDelta(), -1.0, 1.0); }
float detailEdgeBias() { return clamp(-0.10 + 0.25 * detailTextureDelta(), -1.0, 1.0); }
float detailOvershootGuard() { return clamp(0.45 + 0.55 * profileDetailMasking(), 0.0, 1.0); }
float positiveProfileSharpenIntent() {
    return clamp(max(max(max(max(max(detailMasterOffset(), detailFineBias()), detailMidBias()),
                             detailBroadBias()), detailEdgeBias()), 0.0), 0.0, 1.0);
}

float resolveVisibleCoarseGuideBlend(
        float visibleAuthority, float coarseMahalanobisSquared,
        float coarseSupportFraction, float lumaEdgeSigma, float colourEdgeSigma,
        float luminance, float localNoiseScale) {
    float authority = clamp(finite1(visibleAuthority) ? visibleAuthority : 0.0, 0.0, 1.0);
    float coarseDistance = max(0.0, finite1(coarseMahalanobisSquared) ? coarseMahalanobisSquared : 0.0);
    float support = clamp(finite1(coarseSupportFraction) ? coarseSupportFraction : 0.0, 0.0, 1.0);
    float noiseNeed = smoothstepExact(0.12, 2.10, coarseDistance);
    float supportWeight = smoothstepExact(0.12, 0.48, support);
    float lumaProtection = smoothstepExact(1.25, 2.30, max(0.0, lumaEdgeSigma));
    float colourProtection = smoothstepExact(1.85, 3.35, max(0.0, colourEdgeSigma));
    float contextRelease = clamp(1.0 - (0.58 * lumaProtection + 0.42 * colourProtection), 0.0, 1.0);
    float y = clamp(finite1(luminance) ? luminance : 0.0, 0.0, 1.0);
    float shadowContext = 0.45 + 0.55 * (1.0 - smoothstepExact(0.18, 0.62, y));
    float noiseScale = clamp(finite1(localNoiseScale) ? localNoiseScale : 1.0, 0.55, 2.25);
    float noiseScaleGain = clamp(0.80 + 0.20 * (noiseScale - 0.55) / 1.70, 0.80, 1.0);
    return clamp(authority * 0.72 * noiseNeed * supportWeight *
                 contextRelease * shadowContext * noiseScaleGain, 0.0, 0.65);
}
vec3 opponent(vec3 rgb) {
    return vec3(dot(rgb, vec3(kLumaR, kLumaG, kLumaB)), rgb.r - rgb.g, rgb.b - rgb.g);
}
float saturationOf(vec3 rgb) {
    float maximum = max(rgb.r, max(rgb.g, rgb.b));
    float minimum = min(rgb.r, min(rgb.g, rgb.b));
    return (maximum - minimum) / max(0.02, maximum);
}

// Phase 13 publication hardening: reproduce the legacy SPECTRA-off edge-aware
// sharpening in the resident GPU chain. The legacy CPU algorithm first quantizes
// tone-linear RGB to 8-bit sRGB, converts that BGR8 surface back to float, sharpens
// Y with a Gaussian sigma=0.85 and retains chroma. These helpers reproduce that
// domain before the final host publication readback.
const float legacyGaussian9[9] = float[](
    0.00000728942992, 0.000925853487, 0.0294639751, 0.234931246, 0.469343272,
    0.234931246, 0.0294639751, 0.000925853487, 0.00000728942992
);

int reflect101Index(int value, int length) {
    if (length <= 1) return 0;
    int v = value;
    while (v < 0 || v >= length) {
        if (v < 0) v = -v;
        else v = 2 * length - v - 2;
    }
    return v;
}

vec3 fetchGlobalReflect101(int x, int y) {
    int safeX = reflect101Index(x, int(pc.frameWidth));
    int safeY = reflect101Index(y, int(pc.frameHeight));
    int localY = pc.padding1 > 0.5
        ? safeY
        : clamp(safeY - int(pc.inputOriginY), 0, int(pc.inputRows) - 1);
    uint base = (uint(localY) * pc.frameWidth + uint(safeX)) * 3u;
    return vec3(inputValues[base], inputValues[base + 1u], inputValues[base + 2u]);
}

uint exactSrgbByte(float linearValue) {
    float v = clamp(linearValue, 0.0, 1.0);
    uint lutIndex = uint(floor(v * 4096.0 + 0.5));
    return srgbByteLut[min(lutIndex, 4096u)];
}

float legacyQuantizedSrgbChannel(float linearValue) {
    return float(exactSrgbByte(linearValue)) * (1.0 / 255.0);
}

vec3 legacyQuantizedSrgb(vec3 linearRgb) {
    return vec3(legacyQuantizedSrgbChannel(linearRgb.r),
                legacyQuantizedSrgbChannel(linearRgb.g),
                legacyQuantizedSrgbChannel(linearRgb.b));
}

float legacyY(vec3 srgb) {
    return dot(srgb, vec3(0.299, 0.587, 0.114));
}

vec3 runLegacySrgbSharpen(int x, int y, float maximumAmount) {
    vec3 center = legacyQuantizedSrgb(fetchGlobalReflect101(x, y));
    float yv = legacyY(center);
    float blurred = 0.0;
    for (int dy = -4; dy <= 4; ++dy) {
        float wy = legacyGaussian9[dy + 4];
        for (int dx = -4; dx <= 4; ++dx) {
            float wx = legacyGaussian9[dx + 4];
            blurred += wx * wy * legacyY(legacyQuantizedSrgb(
                    fetchGlobalReflect101(x + dx, y + dy)));
        }
    }
    float detail = yv - blurred;
    float edgeMask = smoothstepExact(0.004, 0.035, abs(detail));
    float highlightGuard = 1.0 - smoothstepExact(0.72, 0.94, yv);
    float shadowGuard = smoothstepExact(0.025, 0.12, yv);
    float haloGuard = 1.0 - smoothstepExact(0.045, 0.12, abs(detail));
    float amount = clamp(maximumAmount, 0.0, 0.30) *
            edgeMask * highlightGuard * shadowGuard * haloGuard;
    float delta = detail * amount;
    return clamp(center + vec3(delta), vec3(0.0), vec3(1.0));
}

float profileLuma(vec3 rgb) {
    return dot(rgb, vec3(kLumaR, kLumaG, kLumaB));
}

float localSigma(uint x, uint y);

vec3 applyProfileSharpnessLinear(int x, int y, vec3 outputCenter, float legacyBaseAmount) {
    if (profileDetailAmount() <= 1.0e-6) return outputCenter;
    float fineBias = detailFineBias();
    float midBias = detailMidBias();
    float broadBias = detailBroadBias();
    float edgeBias = detailEdgeBias();

    float centerY = profileLuma(fetchGlobalReflect101(x, y));
    float sum3 = 0.0;
    float sum5 = 0.0;
    float gx = 0.0;
    float gy = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            float ny = profileLuma(fetchGlobalReflect101(x + dx, y + dy));
            if (dx != 0 || dy != 0) sum5 += ny;
            if (abs(dx) <= 1 && abs(dy) <= 1 && (dx != 0 || dy != 0)) sum3 += ny;
            if (abs(dx) <= 1 && abs(dy) <= 1) {
                float sx = float(dx) * (dy == 0 ? 2.0 : 1.0);
                float sy = float(dy) * (dx == 0 ? 2.0 : 1.0);
                gx += sx * ny;
                gy += sy * ny;
            }
        }
    }
    float avg3 = sum3 * (1.0 / 8.0);
    float avg5 = sum5 * (1.0 / 24.0);
    float hpHigh = centerY - avg3;
    float mpMid = avg3 - avg5;
    float lpLow = avg5 - centerY;
    float edgeEnergy = sqrt(gx * gx + gy * gy);
    float sigma = max(pc.visibleSigmaY * clamp(localSigma(uint(x), uint(y)) /
            max(pc.meanSpatialSigma, 1.0e-6), 0.55, 2.25), 0.0015);
    float edgeSnr = edgeEnergy / sigma;
    float structureConfidence = smoothstepExact(1.6, 4.5, edgeSnr);
    float noiseGate = mix(0.08, 1.0, structureConfidence);

    float fineGain = max(0.0, 1.0 + fineBias * 1.20) * noiseGate;
    float midGain = max(0.0, 1.0 + midBias * 1.00) * noiseGate;
    float broadGain = max(0.0, 1.0 + broadBias * 0.70);
    float edgeGain = max(0.0, 1.0 + edgeBias * 1.40) * structureConfidence;
    // Default Amount=0.40 with Detail master scale=0.90 must retain the established ~0.135
    // capture authority. The former positive-intent remap collapsed this to ~0.007 with SPECTRA On.
    float profileAmount = 0.375 * profileDetailAmount();
    float amount = clamp(max(legacyBaseAmount, profileAmount) * detailMasterScale(), 0.0, 0.30);

    float sharpenDelta = (hpHigh * fineGain + mpMid * midGain +
                          lpLow * broadGain * 0.15 + hpHigh * edgeGain) * amount;
    float maxOvershoot = 0.07 * (1.0 - 0.65 * detailOvershootGuard());
    sharpenDelta = clamp(sharpenDelta, -maxOvershoot, maxOvershoot);

    // Amount=0 is a hard no-sharpening contract; no independent legacy profile authority remains.
    return clamp(outputCenter + vec3(sharpenDelta), vec3(0.0), vec3(1.0));
}
vec3 applyProfileSharpnessSrgb(int x, int y, float legacyBaseAmount) {
    vec3 center = legacyQuantizedSrgb(fetchGlobalReflect101(x, y));
    if (profileDetailAmount() <= 1.0e-6) return center;
    float fineBias = detailFineBias();
    float midBias = detailMidBias();
    float broadBias = detailBroadBias();
    float edgeBias = detailEdgeBias();
    float centerY = legacyY(center);
    float sum3 = 0.0;
    float sum5 = 0.0;
    float gx = 0.0;
    float gy = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            float ny = legacyY(legacyQuantizedSrgb(fetchGlobalReflect101(x + dx, y + dy)));
            if (dx != 0 || dy != 0) sum5 += ny;
            if (abs(dx) <= 1 && abs(dy) <= 1 && (dx != 0 || dy != 0)) sum3 += ny;
            if (abs(dx) <= 1 && abs(dy) <= 1) {
                float sx = float(dx) * (dy == 0 ? 2.0 : 1.0);
                float sy = float(dy) * (dx == 0 ? 2.0 : 1.0);
                gx += sx * ny;
                gy += sy * ny;
            }
        }
    }
    float avg3 = sum3 * (1.0 / 8.0);
    float avg5 = sum5 * (1.0 / 24.0);
    float hpHigh = centerY - avg3;
    float mpMid = avg3 - avg5;
    float lpLow = avg5 - centerY;
    float edgeEnergy = sqrt(gx * gx + gy * gy);
    float sigma = max(pc.visibleSigmaY * clamp(localSigma(uint(x), uint(y)) /
            max(pc.meanSpatialSigma, 1.0e-6), 0.55, 2.25), 0.0015);
    float structureConfidence = smoothstepExact(1.6, 4.5, edgeEnergy / sigma);
    float noiseGate = mix(0.08, 1.0, structureConfidence);
    float fineGain = max(0.0, 1.0 + fineBias * 1.20) * noiseGate;
    float midGain = max(0.0, 1.0 + midBias * 1.00) * noiseGate;
    float broadGain = max(0.0, 1.0 + broadBias * 0.70);
    float edgeGain = max(0.0, 1.0 + edgeBias * 1.40) * structureConfidence;
    // Default Amount=0.40 with Detail master scale=0.90 must retain the established ~0.135
    // capture authority. The former positive-intent remap collapsed this to ~0.007 with SPECTRA On.
    float profileAmount = 0.375 * profileDetailAmount();
    float amount = clamp(max(legacyBaseAmount, profileAmount) * detailMasterScale(), 0.0, 0.30);
    float delta = (hpHigh * fineGain + mpMid * midGain + lpLow * broadGain * 0.15 +
                   hpHigh * edgeGain) * amount;
    float maxOvershoot = 0.07 * (1.0 - 0.65 * detailOvershootGuard());
    delta = clamp(delta, -maxOvershoot, maxOvershoot);
    // Negative global authority only scales sharpening via masterScale above;
    // it must never become a hidden blur/noise-reduction stage.
    return clamp(center + vec3(delta), vec3(0.0), vec3(1.0));
}

float localSigma(uint x, uint y) {
    if (pc.gridWidth == 0u || pc.gridHeight == 0u) return pc.meanSpatialSigma;
    float normX = (float(x) + 0.5) / float(max(pc.frameWidth, 1u));
    float normY = (float(y) + 0.5) / float(max(pc.frameHeight, 1u));
    float gx = clamp(normX * float(pc.gridWidth) - 0.5, 0.0, float(pc.gridWidth - 1u));
    float gy = clamp(normY * float(pc.gridHeight) - 0.5, 0.0, float(pc.gridHeight - 1u));
    uint x0 = uint(gx);
    uint y0 = uint(gy);
    uint x1 = min(x0 + 1u, pc.gridWidth - 1u);
    uint y1 = min(y0 + 1u, pc.gridHeight - 1u);
    float fx = gx - float(x0);
    float fy = gy - float(y0);
    float s00 = spatialSigma[y0 * pc.gridWidth + x0];
    float s10 = spatialSigma[y0 * pc.gridWidth + x1];
    float s01 = spatialSigma[y1 * pc.gridWidth + x0];
    float s11 = spatialSigma[y1 * pc.gridWidth + x1];
    return mix(mix(s00, s10, fx), mix(s01, s11, fx), fy);
}
vec3 fetchGlobal(int x, int y) {
    int safeX = clamp(x, 0, int(pc.frameWidth) - 1);
    int safeY = clamp(y, 0, int(pc.frameHeight) - 1);
    // 8H-K: resident upstream buffers cover the full frame. Host-staged inputs still
    // contain only the current strip and therefore retain local-row addressing.
    int localY = pc.padding1 > 0.5
        ? safeY
        : clamp(safeY - int(pc.inputOriginY), 0, int(pc.inputRows) - 1);
    uint base = (uint(localY) * pc.frameWidth + uint(safeX)) * 3u;
    return vec3(inputValues[base], inputValues[base + 1u], inputValues[base + 2u]);
}
void storeFloatOutput(uint localY, uint x, vec3 rgb) {
    uint base = (localY * pc.frameWidth + x) * 3u;
    outputWords[base] = floatBitsToUint(rgb.r);
    outputWords[base + 1u] = floatBitsToUint(rgb.g);
    outputWords[base + 2u] = floatBitsToUint(rgb.b);
}

uint publicationByte(float value, bool alreadySrgb) {
    if (!alreadySrgb) return exactSrgbByte(value);
    return uint(floor(clamp(value, 0.0, 1.0) * 255.0 + 0.5));
}

uint packByte4(uint b0, uint b1, uint b2, uint b3) {
    return (b0 & 255u) | ((b1 & 255u) << 8u) | ((b2 & 255u) << 16u) | ((b3 & 255u) << 24u);
}

// One 16x16 workgroup stages 16 BGR pixels (48 bytes) per local row. Neighbourhood math
// remains one invocation per pixel; only the final byte stores are coalesced after the barrier.
shared uint publicationTileBytes[16 * 16 * 3];

void stagePublicationPixel(uint localX, uint localY, vec3 rgb, bool alreadySrgb) {
    uint base = (localY * 16u + localX) * 3u;
    publicationTileBytes[base] = publicationByte(rgb.b, alreadySrgb);
    publicationTileBytes[base + 1u] = publicationByte(rgb.g, alreadySrgb);
    publicationTileBytes[base + 2u] = publicationByte(rgb.r, alreadySrgb);
}

void flushPublicationWord(uint localX, uint localY, uint publicationRow) {
    if (localX >= 12u) return;
    uint byteBase = localY * 48u + localX * 4u;
    uint packed = packByte4(publicationTileBytes[byteBase],
                            publicationTileBytes[byteBase + 1u],
                            publicationTileBytes[byteBase + 2u],
                            publicationTileBytes[byteBase + 3u]);
    uint wordsPerRow = (pc.frameWidth * 3u + 3u) / 4u;
    uint wordInRow = gl_WorkGroupID.x * 12u + localX;
    if (wordInRow >= wordsPerRow) return;
    uint wordBase = publicationRow * wordsPerRow + wordInRow;
    outputWords[wordBase] = packed;
}
float mahalanobis2(float dRG, float dBG, float localNoiseScale) {
    float scale = clamp(finite1(localNoiseScale) ? localNoiseScale : 1.0, 0.35, 3.0);
    float value = (pc.inverse00 * dRG * dRG + 2.0 * pc.inverse01 * dRG * dBG +
                   pc.inverse11 * dBG * dBG) / (scale * scale);
    return finite1(value) ? max(0.0, value) : 0.0;
}

void addSpatialSample(float lumaDelta, float chromaDelta, float neighbourAcceptance,
                      float nonCentreWeight, float totalWeight, float appliedBlend,
                      float structConf, float lumaBlend) {
    atomicAdd(stats[3], 1u);
    atomicAdd(stats[4], uint(clamp(lumaDelta, 0.0, 1.0) * 65535.0 + 0.5));
    atomicAdd(stats[5], uint(clamp(chromaDelta, 0.0, 1.0) * 65535.0 + 0.5));
    atomicAdd(stats[8], uint(clamp(neighbourAcceptance, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[9], uint(clamp(nonCentreWeight / 64.0, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[10], uint(clamp(totalWeight / 256.0, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[11], uint(clamp(appliedBlend, 0.0, 1.0) * 4095.0 + 0.5));
    atomicMax(stats[6], floatBitsToUint(max(0.0, lumaDelta)));
    atomicMax(stats[7], floatBitsToUint(max(0.0, chromaDelta)));

    atomicAdd(stats[12], uint(clamp(structConf, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[13], uint(clamp(lumaBlend, 0.0, 1.0) * 4095.0 + 0.5));
    if (structConf < 0.25) atomicAdd(stats[14], 1u);
    if (structConf > 0.65) atomicAdd(stats[15], 1u);
}

void runSpatialNr(uint x, uint localOutputY, uint y) {
    bool sampleTelemetry = telemetrySample(x, y);
    if (sampleTelemetry) atomicAdd(stats[0], 1u);
    vec3 center = fetchGlobal(int(x), int(y));
    // When the post-demosaic chain is entered only to keep legacy sharpening on GPU,
    // spatial NR is a strict identity pass.
    if (pc.spectraNoiseActive == 0u && pc.appliedLumaSigma <= 1.0e-7 &&
        pc.visibleSigmaY <= 1.0e-7 && pc.profileNrColor <= 1.0e-7 &&
        pc.outerRingAuthority <= 1.0e-7 && pc.chromaNrStrength <= 1.0e-7) {
        storeFloatOutput(localOutputY, x, center);
        return;
    }
    if (!finite3(center)) {
        storeFloatOutput(localOutputY, x, center);
        if (sampleTelemetry) atomicAdd(stats[12], 1u);
        return;
    }
    float centerY = dot(center, vec3(kLumaR, kLumaG, kLumaB));
    float centerChromaR = center.r - centerY;
    float centerChromaB = center.b - centerY;
    float maxRgb = max(center.r, max(center.g, center.b));
    float minRgb = min(center.r, min(center.g, center.b));
    float relativeSaturation = (maxRgb - minRgb) / max(centerY, 0.02);

    // Channel clipping and saturation reliability weight (prevents false color bleeding on white-clipped highlights)
    float clippingUncertainty = smoothstepExact(0.90, 0.98, maxRgb);
    float channelReliability = 1.0 - 0.65 * clippingUncertainty;

    float localNoiseRatio = clamp(localSigma(x, y) / max(pc.meanSpatialSigma, 1.0e-6), 0.5, 2.0);
    // Smooth highlight gate: retain full denoise authority across midtones and shadows.
    float highlightGate = 1.0 - 0.40 * smoothstepExact(0.85, 0.98, centerY);

    // Phase 4: classification uses the propagated residual covariance, while appliedLumaSigma
    // is only the bounded correction target. The old path classified with the correction sigma
    // itself, then added ISO/noise heuristics to recover authority; that double-counted noise
    // semantics and could smooth real texture. Spatial LSC/exposure shape is dimensionless and
    // therefore scales both residual and target sigma without reconstructing Camera2 S/O.
    float predNoiseSigma = max(1.0e-4, pc.inputResidualLumaSigma * localNoiseRatio);
    float targetLumaSigma = max(0.0, pc.appliedLumaSigma * localNoiseRatio);
    float pixLumaThreshold = max(1.0e-5, predNoiseSigma * 2.70);
    float pixChromaThreshold = max(1.0e-5, pc.chromaRangeThresholdMean * localNoiseRatio * 1.50);
    float inverseLumaThreshold2 = 1.0 / (pixLumaThreshold * pixLumaThreshold);
    float inverseChromaThreshold2 = 1.0 / (pixChromaThreshold * pixChromaThreshold);

    // =========================================================================
    // GPU-RESIDENT STRUCTURE / NOISE CLASSIFIER
    // Physical residual sigma + coherent structure evidence, both in the same output domain.
    // =========================================================================

    // Sobel 3x3 on local Luma for gradient magnitude & directional structure tensor
    vec3 r_m1_m1 = fetchGlobal(int(x) - 1, int(y) - 1);
    vec3 r_0_m1  = fetchGlobal(int(x),     int(y) - 1);
    vec3 r_p1_m1 = fetchGlobal(int(x) + 1, int(y) - 1);
    vec3 r_m1_0  = fetchGlobal(int(x) - 1, int(y));
    vec3 r_p1_0  = fetchGlobal(int(x) + 1, int(y));
    vec3 r_m1_p1 = fetchGlobal(int(x) - 1, int(y) + 1);
    vec3 r_0_p1  = fetchGlobal(int(x),     int(y) + 1);
    vec3 r_p1_p1 = fetchGlobal(int(x) + 1, int(y) + 1);

    float y_m1_m1 = dot(r_m1_m1, vec3(kLumaR, kLumaG, kLumaB));
    float y_0_m1  = dot(r_0_m1,  vec3(kLumaR, kLumaG, kLumaB));
    float y_p1_m1 = dot(r_p1_m1, vec3(kLumaR, kLumaG, kLumaB));
    float y_m1_0  = dot(r_m1_0,  vec3(kLumaR, kLumaG, kLumaB));
    float y_p1_0  = dot(r_p1_0,  vec3(kLumaR, kLumaG, kLumaB));
    float y_m1_p1 = dot(r_m1_p1, vec3(kLumaR, kLumaG, kLumaB));
    float y_0_p1  = dot(r_0_p1,  vec3(kLumaR, kLumaG, kLumaB));
    float y_p1_p1 = dot(r_p1_p1, vec3(kLumaR, kLumaG, kLumaB));

    float gxTop = y_p1_m1 - y_m1_m1;
    float gxMid = y_p1_0 - y_m1_0;
    float gxBottom = y_p1_p1 - y_m1_p1;
    float gyLeft = y_m1_p1 - y_m1_m1;
    float gyMid = y_0_p1 - y_0_m1;
    float gyRight = y_p1_p1 - y_p1_m1;
    float gx = gxTop + 2.0 * gxMid + gxBottom;
    float gy = gyLeft + 2.0 * gyMid + gyRight;
    float gradMag = sqrt(gx * gx + gy * gy);

    // Directional agreement distinguishes coherent local edge/texture traces from random
    // high-frequency noise. The former rank-1 tensor expression was ~1 for every non-zero
    // Sobel gradient and therefore could not make that distinction.
    float coherentX = abs(gx) /
        max(1.0e-6, abs(gxTop) + 2.0 * abs(gxMid) + abs(gxBottom));
    float coherentY = abs(gy) /
        max(1.0e-6, abs(gyLeft) + 2.0 * abs(gyMid) + abs(gyRight));
    float dirCoherence = clamp(max(coherentX, coherentY), 0.0, 1.0);

    // Calculate 5x5 local luma variance
    float lumaSum = 0.0;
    float lumaSqSum = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            vec3 nRgb = fetchGlobal(int(x) + dx, int(y) + dy);
            float nY = dot(nRgb, vec3(kLumaR, kLumaG, kLumaB));
            lumaSum += nY;
            lumaSqSum += nY * nY;
        }
    }
    float lumaMean = lumaSum * 0.04;
    float localLumaVar = max(0.0, lumaSqSum * 0.04 - lumaMean * lumaMean);

    float normLocalStd = sqrt(localLumaVar) / max(1.0e-4, predNoiseSigma);
    float normGrad = gradMag / max(1.0e-4, predNoiseSigma);
    float rawStructure = (0.50 * normLocalStd + 0.50 * normGrad) * (0.75 + 0.75 * dirCoherence);

    // Coherent one-pixel detail guard. Sobel has four units of directional gain, so compare
    // gradient evidence against 4*sigma. This only releases denoise; it never sharpens.
    float coherentGradientSigma = gradMag / max(4.0e-4, 4.0 * predNoiseSigma);
    float microDetailConfidence =
        smoothstepExact(1.20, 3.20, coherentGradientSigma) *
        smoothstepExact(0.48, 0.86, dirCoherence);

    float detailMod = clamp(pc.padding3, -1.0, 1.0); // Detail protection slider
    float structureThresh = 2.20 * (1.0 - 0.40 * detailMod);
    float structureConfidence = clamp(smoothstepExact(structureThresh * 0.5, structureThresh * 2.0, rawStructure), 0.0, 1.0);

    // A center-relative bilateral chroma gate has a pathological failure mode: an isolated
    // green/magenta noisy center rejects its normal neighbours precisely because it is noisy.
    // Detect that topology with the already-loaded cardinal samples. Opposite-neighbour
    // disagreement protects real colour boundaries; luminance/real-saturation evidence protects
    // thin coloured detail. Only a center outlier in locally coherent colour gets an affinity floor.
    vec2 leftChroma = vec2(r_m1_0.r - y_m1_0, r_m1_0.b - y_m1_0);
    vec2 rightChroma = vec2(r_p1_0.r - y_p1_0, r_p1_0.b - y_p1_0);
    vec2 upChroma = vec2(r_0_m1.r - y_0_m1, r_0_m1.b - y_0_m1);
    vec2 downChroma = vec2(r_0_p1.r - y_0_p1, r_0_p1.b - y_0_p1);
    vec2 cardinalMeanChroma = 0.25 * (leftChroma + rightChroma + upChroma + downChroma);
    float centreOutlierSigma = length(vec2(centerChromaR, centerChromaB) - cardinalMeanChroma) /
        max(pixChromaThreshold, 1.0e-5);
    float oppositeColourDisagreement = max(length(leftChroma - rightChroma),
                                            length(upChroma - downChroma)) /
        max(pixChromaThreshold, 1.0e-5);
    float centreOutlierConfidence = smoothstepExact(0.85, 2.40, centreOutlierSigma);
    float coherentNeighbourConfidence = 1.0 - smoothstepExact(1.25, 3.25, oppositeColourDisagreement);
    float reliableRealColour = smoothstepExact(0.10, 0.28, centerY) *
        smoothstepExact(0.32, 0.78, relativeSaturation);
    float chromaOutlierRelease = centreOutlierConfidence * coherentNeighbourConfidence *
        (1.0 - 0.78 * structureConfidence) * (1.0 - 0.82 * reliableRealColour);
    float maximumAffinityFloor = pc.spectraNoiseActive != 0u ? 0.58 : 0.42;
    float chromaAffinityFloor = mix(0.025, maximumAffinityFloor,
                                    clamp(chromaOutlierRelease, 0.0, 1.0));

    // Signal-dependent shadow scaling (stronger cleanup in dark regions)
    float shadowFactor = 1.0 + 0.65 * (1.0 - clamp(centerY / 0.25, 0.0, 1.0));

    // Optional SPECTRA luma-character modifier. The physical baseline is independent from
    // SPECTRA; with SPECTRA Off this multiplier is exactly 1.0.
    float lumaSliderVal = clamp(pc.padding2, -1.0, 1.0);
    float lumaUserMult = pc.spectraNoiseActive != 0u
        ? ((lumaSliderVal >= 0.0)
            ? (1.0 + lumaSliderVal * 1.20)
            : (1.0 + lumaSliderVal * 0.85))
        : 1.0;

    // Chroma Noise slider modifier
    float chromaSliderVal = clamp(pc.chromaNrStrength, -1.0, 1.0);
    float chromaUserMult = (chromaSliderVal >= 0.0) ? (1.0 + chromaSliderVal * 1.10) : (1.0 + chromaSliderVal * 0.75);

    float sumWeightChroma = 0.0;
    float sumWeightLuma = 0.0;
    float sumRedChroma = 0.0;
    float sumBlueChroma = 0.0;
    float sumLuma = 0.0;
    uint acceptedNeighbours = 0u;
    uint edgeProtectedNeighbours = 0u;
    float nonCentreWeight = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            vec3 neighbour = fetchGlobal(int(x) + dx, int(y) + dy);
            float neighbourY = dot(neighbour, vec3(kLumaR, kLumaG, kLumaB));
            float deltaY = neighbourY - centerY;
            float normalizedEdge = abs(deltaY) / predNoiseSigma;
            float edgeProtection = 1.0 - smoothstepExact(1.5, 3.5, normalizedEdge);
            if (sampleTelemetry && edgeProtection < 0.5) edgeProtectedNeighbours++;
            float lumaRangeWeight = exp(-0.5 * deltaY * deltaY * inverseLumaThreshold2) * (1.0 - 0.85 * structureConfidence * (1.0 - edgeProtection));
            float neighbourChromaR = neighbour.r - neighbourY;
            float neighbourChromaB = neighbour.b - neighbourY;
            float deltaChromaR = neighbourChromaR - centerChromaR;
            float deltaChromaB = neighbourChromaB - centerChromaB;
            float hardChromaAffinity = exp(-0.5 * (deltaChromaR * deltaChromaR + deltaChromaB * deltaChromaB) * inverseChromaThreshold2);
            float chromaRangeWeight = chromaAffinityFloor +
                (1.0 - chromaAffinityFloor) * hardChromaAffinity;
            float spatialWeight = spatialNrInnerWeight[(dy + 2) * 5 + (dx + 2)];
            float chromaWeight = spatialWeight * lumaRangeWeight * chromaRangeWeight;
            float lumaWeight = spatialWeight * lumaRangeWeight;
            if (chromaWeight > 0.05) acceptedNeighbours++;
            if (dx != 0 || dy != 0) nonCentreWeight += chromaWeight;
            sumWeightChroma += chromaWeight;
            sumRedChroma += chromaWeight * neighbourChromaR;
            sumBlueChroma += chromaWeight * neighbourChromaB;
            sumWeightLuma += lumaWeight;
            sumLuma += lumaWeight * neighbourY;
        }
    }
    float lowFreqOuterAuth = pc.outerRingAuthority * (1.0 + 0.5 * clamp(pc.outerRingAuthority, 0.0, 1.0));
    if (lowFreqOuterAuth > 0.001) {
        for (int dy = -3; dy <= 3; ++dy) {
            for (int dx = -3; dx <= 3; ++dx) {
                if (abs(dx) <= 2 && abs(dy) <= 2) continue;
                vec3 neighbour = fetchGlobal(int(x) + dx, int(y) + dy);
                float neighbourY = dot(neighbour, vec3(kLumaR, kLumaG, kLumaB));
                float deltaY = neighbourY - centerY;
                float lumaRangeWeight = exp(-0.5 * deltaY * deltaY * inverseLumaThreshold2);
                if (abs(deltaY) > 3.0 * pixLumaThreshold) lumaRangeWeight = 0.0;
                float neighbourChromaR = neighbour.r - neighbourY;
                float neighbourChromaB = neighbour.b - neighbourY;
                float deltaChromaR = neighbourChromaR - centerChromaR;
                float deltaChromaB = neighbourChromaB - centerChromaB;
                float hardChromaAffinity = exp(-0.5 * (deltaChromaR * deltaChromaR + deltaChromaB * deltaChromaB) * inverseChromaThreshold2);
                float chromaRangeWeight = chromaAffinityFloor +
                    (1.0 - chromaAffinityFloor) * hardChromaAffinity;
                float chromaWeight = lowFreqOuterAuth * 0.5 * lumaRangeWeight * chromaRangeWeight;
                float lumaWeight = lowFreqOuterAuth * 0.5 * lumaRangeWeight;
                if (chromaWeight > 0.05) acceptedNeighbours++;
                nonCentreWeight += chromaWeight;
                sumWeightChroma += chromaWeight;
                sumRedChroma += chromaWeight * neighbourChromaR;
                sumBlueChroma += chromaWeight * neighbourChromaB;
                sumWeightLuma += lumaWeight;
                sumLuma += lumaWeight * neighbourY;
            }
        }
    }

    // SPECTRA/physical NR remains the base. Lightroom NR consumes only residual
    // headroom, so strong physical cleanup automatically leaves less room for
    // creative smoothing instead of being linearly counted twice.
    float profileNrLuminance = clamp(pc.visibleSigmaY, 0.0, 1.0);
    float profileNrLuminanceDetail = clamp(pc.visibleAuthority, 0.0, 1.0);
    float profileNrLuminanceContrast = clamp(pc.visibleMaximumCorrection, 0.0, 1.0);
    float profileNrColorAmount = clamp(pc.profileNrColor, 0.0, 1.0);
    float profileNrColorDetail = clamp(pc.inverse00, 0.0, 1.0);

    // Chroma user scale remains SPECTRA residual authority only.
    // SPECTRA Off must be exact physical-baseline semantics.
    float spectraResidualGate = pc.spectraNoiseActive != 0u ? 1.0 : 0.0;
    float chromaUserBoost = spectraResidualGate *
        clamp((pc.chromaUserScale - 1.0) * 0.12, 0.0, 0.45) * pc.downstreamChromaAuthority;
    float baseChromaBlend = clamp(((max(pc.chromaNrStrength, 0.0) + chromaUserBoost) * chromaUserMult) *
        (1.0 - 0.55 * structureConfidence) * shadowFactor * highlightGate * channelReliability, 0.0, 0.98);
    float profileColorProtection = 0.35 + 0.50 * profileNrColorDetail;
    float profileColorGate = clamp(1.0 - profileColorProtection * structureConfidence, 0.10, 1.0);
    float profileChromaCreative = profileNrColorAmount * 0.55 * profileColorGate *
        shadowFactor * highlightGate * channelReliability;
    float effectiveChromaBlend = clamp(baseChromaBlend + (0.98 - baseChromaBlend) *
        clamp(profileChromaCreative, 0.0, 1.0), 0.0, 0.98);

    // Phase 4 residual-luma owner: local Wiener/noise-dominance shrinkage. The predicted
    // residual is the covariance propagated to this exact domain; appliedLumaSigma is the
    // bounded correction envelope. No ISO, render-gain, brightness or RAW-format proxy may
    // add authority here. Random high-frequency energy alone is insufficient: coherent
    // structure and one-pixel directional persistence release smoothing aggressively.
    float predictedResidualVariance = predNoiseSigma * predNoiseSigma;
    float estimatedSignalVariance = max(0.0, localLumaVar - predictedResidualVariance);
    float wienerSignalGain = estimatedSignalVariance /
        max(estimatedSignalVariance + predictedResidualVariance, 1.0e-12);
    float noiseDominance = clamp(1.0 - wienerSignalGain, 0.0, 1.0);
    float normalizedLocalSigma = sqrt(localLumaVar) / max(predNoiseSigma, 1.0e-4);
    float flatNoiseEvidence = 1.0 - smoothstepExact(1.0, 2.35, normalizedLocalSigma);
    float correctionFraction = clamp(targetLumaSigma / max(predNoiseSigma, 1.0e-4), 0.0, 1.0);
    float structureLumaRelease = 1.0 - 0.82 * structureConfidence;
    float microDetailLumaRelease = 1.0 - 0.78 * microDetailConfidence;
    float physicalLumaShrink = correctionFraction * noiseDominance *
        mix(0.70, 1.0, flatNoiseEvidence);
    float baseLumaBlend = clamp(physicalLumaShrink * lumaUserMult *
        structureLumaRelease * microDetailLumaRelease * highlightGate *
        pc.downstreamLumaAuthority, 0.0, 0.88);
    float profileLumaDetailProtection = 0.45 + 0.40 * profileNrLuminanceDetail;
    float profileLumaContrastProtection = 0.25 * profileNrLuminanceContrast * structureConfidence;
    float profileLumaGate = clamp(1.0 -
        (profileLumaDetailProtection + profileLumaContrastProtection) * structureConfidence, 0.08, 1.0);
    float profileLumaCreative = profileNrLuminance * 0.45 * profileLumaGate *
        shadowFactor * highlightGate * pc.downstreamLumaAuthority;
    float effectiveLumaBlend = clamp(baseLumaBlend + (0.95 - baseLumaBlend) *
        clamp(profileLumaCreative, 0.0, 1.0), 0.0, 0.95);

    vec3 finalRgb = center;
    if (sumWeightChroma > 1.0e-5 || sumWeightLuma > 1.0e-5) {
        float filteredRedChroma = sumWeightChroma > 1.0e-5 ? sumRedChroma / sumWeightChroma : centerChromaR;
        float filteredBlueChroma = sumWeightChroma > 1.0e-5 ? sumBlueChroma / sumWeightChroma : centerChromaB;
        float filteredLuma = sumWeightLuma > 1.0e-5 ? sumLuma / sumWeightLuma : centerY;
        float targetLuma = centerY + (filteredLuma - centerY) * effectiveLumaBlend;
        float targetRedChroma = centerChromaR + (filteredRedChroma - centerChromaR) * effectiveChromaBlend;
        float targetBlueChroma = centerChromaB + (filteredBlueChroma - centerChromaB) * effectiveChromaBlend;
        float targetGreenChroma = (-kLumaR * targetRedChroma - kLumaB * targetBlueChroma) / kLumaG;
        float minimumDeviation = min(targetRedChroma, min(targetGreenChroma, targetBlueChroma));
        float gamutScale = minimumDeviation < 0.0 ? min(1.0, targetLuma / -minimumDeviation) : 1.0;
        finalRgb = clamp(vec3(targetLuma + targetRedChroma * gamutScale,
                              targetLuma + targetGreenChroma * gamutScale,
                              targetLuma + targetBlueChroma * gamutScale), 0.0, 1.0);
    }
    float finalY = dot(finalRgb, vec3(kLumaR, kLumaG, kLumaB));
    float lumaDelta = abs(finalY - centerY);
    float chromaDelta = length(vec2((finalRgb.r - centerY) - centerChromaR,
                                    (finalRgb.b - centerY) - centerChromaB));
    if (sampleTelemetry) {
        if (lumaDelta > 0.0002 || chromaDelta > 0.0002) atomicAdd(stats[1], 1u);
        if (edgeProtectedNeighbours != 0u) atomicAdd(stats[2], edgeProtectedNeighbours);
        addSpatialSample(lumaDelta, chromaDelta, float(acceptedNeighbours) / 49.0,
                         nonCentreWeight, sumWeightChroma, effectiveChromaBlend,
                         structureConfidence, effectiveLumaBlend);
    }
    storeFloatOutput(localOutputY, x, finalRgb);
}

void addVisibleSample(float acceptance, float colourShift, float noiseImprovement,
                      float structureWeight, float colourEdgeWeight) {
    atomicAdd(stats[9], 1u);
    atomicAdd(stats[10], uint(clamp(acceptance, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[11], uint(clamp(colourShift, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[12], uint(clamp(noiseImprovement, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[13], uint(clamp((1.0 - structureWeight) * acceptance, 0.0, 1.0) * 4095.0 + 0.5));
    atomicAdd(stats[14], uint(clamp((1.0 - colourEdgeWeight) * acceptance, 0.0, 1.0) * 4095.0 + 0.5));
    atomicMax(stats[15], floatBitsToUint(max(0.0, colourShift)));
}

vec3 runVisibleChroma(uint x, uint localOutputY, uint y) {
    bool sampleTelemetry = telemetrySample(x, y);
    if (sampleTelemetry) atomicAdd(stats[0], 1u);
    vec3 center = fetchGlobal(int(x), int(y));
    if (pc.visibleChromaEnabled == 0u) {
        bool profileNeutral = profileDetailAmount() <= 1.0e-6;
        vec3 outputRgb = profileNeutral && pc.visibleAuthority > 1.0e-6
                ? runLegacySrgbSharpen(int(x), int(y), pc.visibleAuthority)
                : applyProfileSharpnessSrgb(int(x), int(y), pc.visibleAuthority);
        if (sampleTelemetry) atomicAdd(stats[8], 1u);
        return outputRgb;
    }
    vec3 centerOpponent = opponent(center);
    if (!finite3(center) || !finite3(centerOpponent)) {
        if (sampleTelemetry) atomicAdd(stats[8], 1u);
        return center;
    }
    float centerY = centerOpponent.x;
    float centerRG = centerOpponent.y;
    float centerBG = centerOpponent.z;
    float saturation = saturationOf(center);
    float localNoiseScale = clamp(localSigma(x, y) / max(pc.meanSpatialSigma, 1.0e-6), 0.55, 2.25);
    float maximumLumaDifference = 0.0;
    float maximumColourDistanceSquared = 0.0;
    float robustLumaSigmaSum = 0.0;
    float robustColourSigmaSum = 0.0;
    float weightedRG = 0.0;
    float weightedBG = 0.0;
    float weightSum = 0.0;
    uint robustSampleCount = 0u;
    uint supportedNeighbours = 0u;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            vec3 n = opponent(fetchGlobal(int(x) + dx, int(y) + dy));
            if (!finite3(n)) continue;
            float deltaY = n.x - centerY;
            float deltaRG = n.y - centerRG;
            float deltaBG = n.z - centerBG;
            maximumLumaDifference = max(maximumLumaDifference, abs(deltaY));
            float distance2 = mahalanobis2(deltaRG, deltaBG, localNoiseScale);
            maximumColourDistanceSquared = max(maximumColourDistanceSquared, distance2);
            float lumaSigmaScale = max(1.0e-5, pc.visibleSigmaY * localNoiseScale);
            float lumaDistance = deltaY / lumaSigmaScale;
            if (dx != 0 || dy != 0) {
                robustLumaSigmaSum += min(abs(lumaDistance), 4.0);
                robustColourSigmaSum += min(sqrt(max(0.0, distance2)), 5.0);
                robustSampleCount++;
            }
            float lumaWeight = exp(-0.5 * lumaDistance * lumaDistance);
            // Luma owns neighbourhood support. Chroma distance remains a soft affinity only:
            // otherwise the exact green/magenta outlier we want to remove can reject normal
            // neighbours and preserve itself after WB/CCM/tone amplification. Real colour edges
            // remain protected by colourEdgeWeight/hardColourEdge and the No-Regret decision.
            float legacyColourAffinity = 1.0 / (1.0 + 0.15 * distance2);
            float colourWeight = 0.50 + 0.50 * legacyColourAffinity;
            float weight = visibleSpatialWeight[(dy + 2) * 5 + (dx + 2)] * lumaWeight * colourWeight;
            if ((dx != 0 || dy != 0) && weight >= 0.015) supportedNeighbours++;
            weightedRG += weight * n.y;
            weightedBG += weight * n.z;
            weightSum += weight;
        }
    }
    float fineFilteredRG = weightSum > 1.0e-6 ? weightedRG / weightSum : centerRG;
    float fineFilteredBG = weightSum > 1.0e-6 ? weightedBG / weightSum : centerBG;

    // Context Fusion coarse guide: twelve sparse radius-3/4 taps provide broad
    // opponent-colour context without a dense 9x9 pass or another image buffer.
    const ivec2 coarseOffsets[12] = ivec2[12](
        ivec2(-4,0), ivec2(4,0), ivec2(0,-4), ivec2(0,4),
        ivec2(-3,-3), ivec2(3,-3), ivec2(-3,3), ivec2(3,3),
        ivec2(-3,0), ivec2(3,0), ivec2(0,-3), ivec2(0,3));
    float coarseWeightedRG = 0.0;
    float coarseWeightedBG = 0.0;
    float coarseWeightSum = 0.0;
    uint coarseSupportedNeighbours = 0u;
    for (int i = 0; i < 12; ++i) {
        ivec2 o = coarseOffsets[i];
        vec3 n = opponent(fetchGlobal(int(x) + o.x, int(y) + o.y));
        if (!finite3(n)) continue;
        float deltaY = n.x - centerY;
        float lumaDistance = deltaY / max(1.0e-5, pc.visibleSigmaY * localNoiseScale * 1.35);
        float distance2 = mahalanobis2(n.y - centerRG, n.z - centerBG, localNoiseScale);
        bool radius4 = abs(o.x) == 4 || abs(o.y) == 4;
        float spatial = radius4 ? 0.45 : 0.62;
        float coarseWeight = spatial * exp(-0.5 * lumaDistance * lumaDistance) /
                             (1.0 + 0.12 * distance2);
        if (coarseWeight >= 0.020) coarseSupportedNeighbours++;
        coarseWeightedRG += coarseWeight * n.y;
        coarseWeightedBG += coarseWeight * n.z;
        coarseWeightSum += coarseWeight;
    }
    float coarseFilteredRG = coarseWeightSum > 1.0e-6 ? coarseWeightedRG / coarseWeightSum : fineFilteredRG;
    float coarseFilteredBG = coarseWeightSum > 1.0e-6 ? coarseWeightedBG / coarseWeightSum : fineFilteredBG;

    float robustCount = float(max(robustSampleCount, 1u));
    float lumaEdgeSigma = robustLumaSigmaSum / robustCount;
    float colourEdgeSigma = robustColourSigmaSum / robustCount;
    float maximumLumaEdgeSigma = maximumLumaDifference / max(1.0e-5, pc.visibleSigmaY * localNoiseScale);
    float maximumColourEdgeSigma = sqrt(max(0.0, maximumColourDistanceSquared));
    float coarseMahalanobis = mahalanobis2(
            coarseFilteredRG - centerRG, coarseFilteredBG - centerBG, localNoiseScale);
    float coarseSupportFraction = float(coarseSupportedNeighbours) / 12.0;
    float coarseBlend = resolveVisibleCoarseGuideBlend(
            pc.visibleAuthority, coarseMahalanobis, coarseSupportFraction,
            lumaEdgeSigma, colourEdgeSigma, centerY, localNoiseScale);
    // SPECTRA is the opt-in residual model and should have visible added value over the physical
    // baseline. Give its already edge/noise-gated coarse opponent guide modest extra authority;
    // the final no-regret, hard-edge, saturation and gamut guards still bound the correction.
    if (pc.spectraNoiseActive != 0u) {
        coarseBlend = clamp(coarseBlend * 1.22, 0.0, 0.72);
    }
    float filteredRG = mix(fineFilteredRG, coarseFilteredRG, coarseBlend);
    float filteredBG = mix(fineFilteredBG, coarseFilteredBG, coarseBlend);
    float deltaRG = filteredRG - centerRG;
    float deltaBG = filteredBG - centerBG;
    float mahalanobisBefore = mahalanobis2(deltaRG, deltaBG, localNoiseScale);
    float noiseNeed = smoothstepExact(0.15, 2.50, mahalanobisBefore);

    // Context Fusion deliberately separates a robust neighbourhood estimate from
    // a hard-edge guard. A single chroma/luma noise outlier must not veto the
    // whole 5x5 correction, which was the dominant failure in device telemetry.
    float structureWeight = clamp(1.0 - 0.80 * smoothstepExact(1.25, 2.30, lumaEdgeSigma), 0.20, 1.0);
    float colourEdgeWeight = clamp(1.0 - 0.78 * smoothstepExact(1.85, 3.35, colourEdgeSigma), 0.22, 1.0);
    bool hardLumaEdge = maximumLumaEdgeSigma > 7.0 && lumaEdgeSigma > 1.55;
    bool hardColourEdge = maximumColourEdgeSigma > 7.0 && colourEdgeSigma > 2.20;
    if (hardLumaEdge) structureWeight *= 0.25;
    if (hardColourEdge) colourEdgeWeight *= 0.25;

    // Apparent saturation in deep shadows is frequently chroma noise itself.
    // Only trust saturation as real colour once luminance and neighbourhood
    // structure provide supporting evidence.
    float luminanceReliability = smoothstepExact(0.10, 0.32, centerY);
    float colourStructureReliability = smoothstepExact(1.70, 3.20, colourEdgeSigma);
    float saturationProtection = smoothstepExact(0.30, 0.80, saturation) * luminanceReliability *
                                 (0.45 + 0.55 * colourStructureReliability);
    float saturationWeight = clamp(1.0 - 0.85 * saturationProtection, 0.15, 1.0);
    float supportFraction = float(supportedNeighbours) / 24.0;
    float supportWeight = smoothstepExact(0.03, 0.25, supportFraction);
    float requestedRG = deltaRG * pc.visibleAuthority * noiseNeed;
    float requestedBG = deltaBG * pc.visibleAuthority * noiseNeed;
    float requestedMagnitude = length(vec2(requestedRG, requestedBG));
    float colourDriftWeight = requestedMagnitude > 1.0e-9
        ? clamp(pc.visibleMaximumCorrection / requestedMagnitude, 0.0, 1.0) : 1.0;
    float oversmoothingWeight = clamp(0.70 + 0.30 * colourEdgeWeight, 0.0, 1.0);
    // `noiseNeed` already scales requestedRG/requestedBG. Do not apply it twice: doing so
    // squares moderate noise evidence and was observed on device as near-zero visible-chroma
    // authority despite thousands of candidates.
    float acceptance = clamp(structureWeight * colourEdgeWeight * saturationWeight *
        supportWeight * colourDriftWeight * oversmoothingWeight, 0.0, 1.0);
    vec2 correction = vec2(requestedRG, requestedBG) * acceptance;
    float correctionMagnitude = length(correction);
    if (correctionMagnitude > pc.visibleMaximumCorrection && correctionMagnitude > 1.0e-9) {
        correction *= pc.visibleMaximumCorrection / correctionMagnitude;
        correctionMagnitude = pc.visibleMaximumCorrection;
    }
    vec2 outputOpponent = vec2(centerRG, centerBG) + correction;
    vec2 remaining = vec2(filteredRG, filteredBG) - outputOpponent;
    float mahalanobisAfter = mahalanobis2(remaining.x, remaining.y, localNoiseScale);
    float noiseImprovement = mahalanobisBefore > 1.0e-9
        ? clamp((mahalanobisBefore - mahalanobisAfter) / mahalanobisBefore, -1.0, 1.0) : 0.0;
    bool supported = correctionMagnitude >= 1.0e-6 && acceptance >= 0.005 && noiseImprovement >= -0.05;
    if (sampleTelemetry) {
        if (mahalanobisBefore > 0.30) atomicAdd(stats[1], 1u);
        if (structureWeight < 0.50) atomicAdd(stats[3], 1u);
        if (colourEdgeWeight < 0.50) atomicAdd(stats[4], 1u);
        if (saturation > 0.45) atomicAdd(stats[5], 1u);
    }
    vec3 finalRgb = center;
    float actualAcceptance = acceptance;
    float actualShift = 0.0;
    if (supported) {
        float candidateG = centerY - kLumaR * outputOpponent.x - kLumaB * outputOpponent.y;
        vec3 candidate = vec3(candidateG + outputOpponent.x, candidateG, candidateG + outputOpponent.y);
        float gamutScale = 1.0;
        for (int channel = 0; channel < 3; ++channel) {
            float d = candidate[channel] - center[channel];
            if (d < -1.0e-9) gamutScale = min(gamutScale, center[channel] / -d);
            else if (d > 1.0e-9) gamutScale = min(gamutScale, (1.0 - center[channel]) / d);
        }
        gamutScale = clamp(gamutScale, 0.0, 1.0);
        actualAcceptance *= gamutScale;
        candidate = center + (candidate - center) * gamutScale;
        vec2 actualOpponent = vec2(candidate.r - candidate.g, candidate.b - candidate.g);
        actualShift = length(actualOpponent - vec2(centerRG, centerBG));
        if (finite3(candidate) && actualShift >= 1.0e-6) {
            finalRgb = clamp(candidate, 0.0, 1.0);
            if (sampleTelemetry) {
                atomicAdd(stats[2], 1u);
                if (actualAcceptance >= 0.999) atomicAdd(stats[6], 1u);
                else atomicAdd(stats[7], 1u);
            }
        } else {
            if (sampleTelemetry) atomicAdd(stats[8], 1u);
            actualAcceptance = 0.0;
            actualShift = 0.0;
        }
    } else {
        if (sampleTelemetry) atomicAdd(stats[8], 1u);
        actualAcceptance = 0.0;
        actualShift = 0.0;
    }
    // Sharpness owns detail rendering only after denoise/chroma correction. A neutral
    // profile keeps the historical SPECTRA-On output unchanged.
    finalRgb = applyProfileSharpnessLinear(int(x), int(y), finalRgb, 0.0);
    if (sampleTelemetry) {
        addVisibleSample(actualAcceptance, actualShift, max(0.0, noiseImprovement),
                         structureWeight, colourEdgeWeight);
    }
    return finalRgb;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint localOutputY = gl_GlobalInvocationID.y;

    if (pc.mode == 0u) {
        if (x >= pc.frameWidth || localOutputY >= pc.outputRows) return;
        uint y = pc.outputOriginY + localOutputY;
        if (y >= pc.frameHeight) return;
        runSpatialNr(x, localOutputY, y);
        return;
    }

    uint y = pc.outputOriginY + localOutputY;
    bool validY = localOutputY < pc.outputRows && y < pc.frameHeight;
    bool validX = x < pc.frameWidth;

    // FASE 15 explicit typed fallback. The host sets padding2=0 only for the legacy/debug
    // FP32 publication contract; production sets padding2=1 and takes the packed path below.
    if (pc.padding2 <= 0.5) {
        if (validX && validY) {
            storeFloatOutput(localOutputY, x, runVisibleChroma(x, localOutputY, y));
        }
        return;
    }

    // FASE 15 fused publication. All packed mode-1 lanes reach the barrier, including tail
    // lanes, while valid lanes retain the original one-pixel visible-chroma computation.
    bool alreadySrgb = pc.visibleChromaEnabled == 0u;
    vec3 published = validX && validY ? runVisibleChroma(x, localOutputY, y) : vec3(0.0);
    stagePublicationPixel(gl_LocalInvocationID.x, gl_LocalInvocationID.y, published, alreadySrgb);
    barrier();
    if (validY) {
        // FASE 15 batched resident publication uses padding1 < 0 as an addressing-only
        // marker. fetchGlobal() still treats it as strip-local, while the packed output
        // lands directly in its absolute full-frame row. Single-strip fallback stays local.
        uint publicationRow = pc.padding1 < -0.5 ? y : localOutputY;
        flushPublicationWord(gl_LocalInvocationID.x, gl_LocalInvocationID.y, publicationRow);
    }
}
